CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
# size first: ESP-IDF at -Os, the engine and main.c at -O2 (main/CMakeLists.txt); no assertion texts, no error names, newlib's small printf
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
# the program's bytecode is read from the flash (main/main.c): 80 MHz, as the WROOM-32 module is rated
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
