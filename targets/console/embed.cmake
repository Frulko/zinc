# cmake -DZBC=program.zbc [-DRES=resources.bin] [-DPACK=default.zpk] -DOUT=embedded_program.c -P embed.cmake: the program as C arrays for a core
# that reads no file (core_main.cpp's zn_console_program and zn_console_resources, host_console.cpp's zn_console_pack: the asset pack).
function(zn_array var file out align)
  file(READ ${file} hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
  file(APPEND ${out} "static const unsigned char ${var}_bytes[${bytes} + 1] __attribute__((aligned(${align}))) = {${body}0};\nconst unsigned char* zn_console_${var} = ${var}_bytes;\nunsigned long zn_console_${var}_size = ${bytes};\n")
endfunction()
file(WRITE ${OUT} "/* generated by targets/console/embed.cmake */\n")
zn_array(program ${ZBC} ${OUT} 8)
if(RES)
  zn_array(resources ${RES} ${OUT} 8)
endif()
if(PACK)   # its entries are aligned within the pack: the pack itself on a 64-byte boundary
  zn_array(pack ${PACK} ${OUT} 64)
endif()
