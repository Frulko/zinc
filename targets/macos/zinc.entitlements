<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- JavaScriptCore and V8 compile to machine code (ZN-773): without it the system's JavaScriptCore runs its interpreter only, about 15 times slower -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- zinc loads the plugin libraries a user compiles on their machine (signed ad hoc): the hardened runtime must not refuse them -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
