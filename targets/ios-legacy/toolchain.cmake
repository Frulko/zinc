set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR armv7)
set(CMAKE_OSX_ARCHITECTURES armv7)
set(CMAKE_OSX_DEPLOYMENT_TARGET 7.0)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
foreach(name ZINC_IOS_LEGACY_SDK ZINC_IOS_LLVM_BIN ZINC_IOS_LIBCXX_BUILD)
  if(NOT DEFINED ENV{${name}})
    message(FATAL_ERROR "${name} is required; use tools/build-ios-legacy")
  endif()
endforeach()
set(CMAKE_OSX_SYSROOT "$ENV{ZINC_IOS_LEGACY_SDK}")
set(CMAKE_C_COMPILER "$ENV{ZINC_IOS_LLVM_BIN}/clang")
set(CMAKE_CXX_COMPILER "$ENV{ZINC_IOS_LLVM_BIN}/clang++")
set(CMAKE_OBJCXX_COMPILER "$ENV{ZINC_IOS_LLVM_BIN}/clang++")
set(CMAKE_C_COMPILER_TARGET armv7-apple-ios7.0)
set(CMAKE_CXX_COMPILER_TARGET armv7-apple-ios7.0)
set(CMAKE_OBJCXX_COMPILER_TARGET armv7-apple-ios7.0)
set(CMAKE_CXX_FLAGS_INIT "-nostdinc++ -isystem \"$ENV{ZINC_IOS_LIBCXX_BUILD}/include/c++/v1\" -D_LIBCPP_DISABLE_AVAILABILITY")
set(CMAKE_OBJCXX_FLAGS_INIT "${CMAKE_CXX_FLAGS_INIT}")
execute_process(COMMAND xcrun --find ld-classic OUTPUT_VARIABLE legacy_ld OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=\"${legacy_ld}\" -nostdlib++ \"$ENV{ZINC_IOS_LIBCXX_BUILD}/lib/libc++.a\" \"$ENV{ZINC_IOS_LIBCXX_BUILD}/lib/libc++abi.a\"")
