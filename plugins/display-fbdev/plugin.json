{
  "name": "display-fbdev",
  "kind": "display",
  "description": "Linux framebuffer (/dev/fb0, 16/24/32 bpp) with evdev keyboard, mouse and multitouch",
  "options": { "device": "/dev/fb0", "input": true, "grab": true, "fps": 60 },
  "targets": {
    "linux": { "sources": ["fbdev.cpp"], "linkFlags": ["-pthread"] },
    "rpi1": { "sources": ["fbdev.cpp"], "packages": ["linux-headers"], "linkFlags": ["-pthread"] }
  }
}
