{
  "name": "three",
  "kind": "module",
  "deterministic": true,
  "module": "three",
  "entry": "index.ts",
  "modules": {
    "three/addons/loaders/GLTFLoader.js": "addons/GLTFLoader.ts",
    "three/examples/jsm/loaders/GLTFLoader.js": "addons/GLTFLoader.ts",
    "three/addons/controls/OrbitControls.js": "addons/OrbitControls.ts",
    "three/examples/jsm/controls/OrbitControls.js": "addons/OrbitControls.ts"
  },
  "description": "three.js API subset on zinc:3d: scene graph, geometries, materials, lights, cameras, raycasting, GLTFLoader, OrbitControls",
  "web": {
    "entry": "web/index.ts",
    "bridge": false,
    "needs": ["webgl2"],
    "modules": {
      "three/addons/loaders/GLTFLoader.js": "web/GLTFLoader.ts",
      "three/examples/jsm/loaders/GLTFLoader.js": "web/GLTFLoader.ts",
      "three/addons/controls/OrbitControls.js": "web/OrbitControls.ts",
      "three/examples/jsm/controls/OrbitControls.js": "web/OrbitControls.ts"
    }
  },
  "targets": { "macos": {}, "linux": {}, "windows": {}, "rpi1": {}, "wasm": {}, "ios": {} }
}
