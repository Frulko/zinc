{
  "name": "svg",
  "kind": "module",
  "deterministic": true,
  "module": "zinc:svg",
  "entry": "index.ts",
  "description": "Runtime SVG rendering (paths, shapes, transforms, gradients, CSS classes) on the vector rasterizer",
  "targets": {
    "macos": { "defines": ["ZRT_POINT_POOL=262144"] },
    "linux": { "defines": ["ZRT_POINT_POOL=262144"] },
    "windows": { "defines": ["ZRT_POINT_POOL=262144"] },
    "android": {"defines": ["ZRT_POINT_POOL=262144"]},
    "ios": {"defines": ["ZRT_POINT_POOL=262144"]},
    "rpi1": { "defines": ["ZRT_POINT_POOL=262144"] },
    "wasm": { "defines": ["ZRT_POINT_POOL=262144"] }
  },
  "web": { "native": "SvgEngine", "impl": "web/svg.js", "needs": ["canvas2d"] }
}
