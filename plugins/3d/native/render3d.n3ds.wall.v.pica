; zinc:3d World on the PICA200 (render3d.n3ds.cpp): faces with a picture of their own (walls). A face has no normal: the sector of the
; compass it looks to picks its light from seventeen, filled once a frame (16 sectors, then what looks up or down). Pocket Tokyo's 3DS program
; (pocket-nexus/pocket-tokyo n3ds/src/wall.v.pica, MIT).
.fvec mvp[4]
; xy: the uv's scale inside the power-of-two texture (y negative: t from the top), zw: (0, 1)
.fvec tsc
; rgb: the batch's colour / 255 (the vertex colours are 0..255), w: 1 / 255
.fvec base
; rgb: the batch's emissive colour, added before the picture
.fvec emit
.fvec lights[17]
.constf consts(0.0, 1.0, 0.0, 1.0)
.in inpos v0
; y: the sector
.in inao v1
.in inclr v2
.in intex v3
.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.entry wall
.proc wall
    mov r0.xyz, inpos.xyz
    mov r0.w, consts.w
    dp4 outpos.x, mvp[0], r0
    dp4 outpos.y, mvp[1], r0
    dp4 outpos.z, mvp[2], r0
    dp4 outpos.w, mvp[3], r0
    mul r1.xy, tsc.xy, intex.xy
    add r1.xy, tsc.zw, r1.xy
    mov r1.z, consts.x
    mov r1.w, consts.w
    mov outtc0, r1
    mov outtc1, r1
    mov outtc2, r1
    mova a0.x, inao.y
    mov r2, lights[a0.x]
    mul r3, base, inclr
    mul r3.xyz, r2.xyz, r3.xyz
    add r3.xyz, emit.xyz, r3.xyz
    min r3.xyz, consts.yyy, r3.xyz
    mov r3.w, consts.w
    mov outclr, r3
    end
.end
