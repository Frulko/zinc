#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""BlueZ/PyBluez adapter for the receiver's existing raw RFCOMM stdio interface."""
import argparse
import os
import re
import select
import socket
import subprocess
import sys

IAP2_UUID = '00000000-deca-fade-deca-deafdecacafe'


def address(text):
    if not re.fullmatch(r'(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}', text):
        raise argparse.ArgumentTypeError('expected a Bluetooth address AA:BB:CC:DD:EE:FF')
    return text.upper()


def pump(sock, stdin=0, stdout=1):
    while True:
        ready, _, _ = select.select([sock, stdin], [], [])
        if sock in ready:
            data = sock.recv(65536)
            if not data:
                return
            while data:
                data = data[os.write(stdout, data):]
        if stdin in ready:
            data = os.read(stdin, 4096)
            if not data:
                return
            sock.sendall(data)


def local_address():
    result = subprocess.run(['bluetoothctl', 'show'], check=True,
                            capture_output=True, text=True, timeout=10)
    match = re.search(r'^Controller ((?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2})\b',
                      result.stdout, re.MULTILINE)
    if match is None or not re.search(r'^\s+Powered: yes$', result.stdout, re.MULTILINE):
        raise RuntimeError('No powered Bluetooth adapter')
    return address(match.group(1))


def open_rfcomm(peer, port):
    sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM,
                         socket.BTPROTO_RFCOMM)
    try:
        sock.settimeout(15)
        sock.connect((peer, port))
        sock.settimeout(None)
        return sock
    except OSError:
        sock.close()
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument('--print-address', action='store_true')
    mode.add_argument('--list', action='store_true')
    mode.add_argument('--address', type=address)
    args = parser.parse_args()
    if args.list:
        result = subprocess.run(['bluetoothctl', 'devices', 'Paired'], check=True,
                                capture_output=True, text=True, timeout=10)
        for line in result.stdout.splitlines():
            if line.startswith('Device '):
                print(line[7:])
        return
    if args.print_address:
        print(local_address())
        return
    try:
        import bluetooth
    except ImportError:
        parser.exit(1, 'Install BlueZ and python3-bluez (Raspberry Pi OS: sudo apt install bluez python3-bluez)\n')
    services = bluetooth.find_service(uuid=IAP2_UUID, address=args.address)
    service = next((s for s in services if s.get('protocol') == 'RFCOMM' and isinstance(s.get('port'), int) and 1 <= s['port'] <= 30), None)
    if service is None:
        parser.exit(1, 'No iAP2 RFCOMM service found; pair/trust the iPhone with bluetoothctl first\n')
    sock = open_rfcomm(args.address, service['port'])
    try:
        print('bt-bridge: BlueZ iAP2 RFCOMM connected', file=sys.stderr)
        pump(sock)
    finally:
        sock.close()


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'bt-bridge: {error}', file=sys.stderr)
        sys.exit(1)
