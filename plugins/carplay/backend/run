#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
backend="$root/build/carplay/playport"
export JAVA_OPTS="${JAVA_OPTS:-} --enable-native-access=ALL-UNNAMED"
export ZINC_CARPLAY_USB_LIBRARY="$root/build/carplay/usb/libcarplay_usb.dylib"
case "$(uname -s)" in
  Darwin) bt_bridge="$backend/macos/bt-bridge/bt-bridge" ;;
  Linux) bt_bridge="$root/plugins/carplay/backend/linux/bt-bridge" ;;
  *) echo 'CarPlay backend supports macOS and Linux' >&2; exit 1 ;;
esac
usb=0
case "${1:-}" in
  --usb-list|--usb-switch)
    action=$1
    shift
    if [ ! -f "$ZINC_CARPLAY_USB_LIBRARY" ]; then
      echo 'Run plugins/carplay/backend/build first (native USB library missing)' >&2
      exit 1
    fi
    case "$action" in
      --usb-list) set -- --list "$@" ;;
      --usb-switch) set -- --switch-mode "$@" ;;
    esac
    exec java --enable-native-access=ALL-UNNAMED -cp "$backend/server/build/install/server/lib/*" com.playport.server.WiredBootstrapKt "$@"
    ;;
  --usb)
    if [ "$(uname -s)" != Darwin ]; then echo 'Native wired USB currently requires macOS; use --wireless on Linux' >&2; exit 1; fi
    usb=1
    shift
    : "${ZINC_CARPLAY_USB_SERIAL:?Set ZINC_CARPLAY_USB_SERIAL from backend/run --usb-list}"
    if [ ! -f "$ZINC_CARPLAY_USB_LIBRARY" ]; then
      echo 'Run plugins/carplay/backend/build first (native USB library missing)' >&2
      exit 1
    fi
    ;;
  *) unset ZINC_CARPLAY_USB_SERIAL ;;
esac
if [ "$usb" = 1 ]; then
  for arg in "$@"; do
    if [ "$arg" = --wireless ]; then
      echo 'Choose either --usb or --wireless for this receiver process' >&2
      exit 1
    fi
  done
fi
: "${ZINC_CARPLAY_IDENTITY:?Set ZINC_CARPLAY_IDENTITY to the directory containing offline-mfi/certificate.p7b and identity.pk8}"
for file in certificate.p7b identity.pk8; do
  if [ ! -s "$ZINC_CARPLAY_IDENTITY/offline-mfi/$file" ]; then
    echo "Missing identity file: $file" >&2
    exit 1
  fi
done
if [ ! -x "$backend/server/build/install/server/bin/server" ]; then
  echo 'Run plugins/carplay/backend/build first' >&2
  exit 1
fi
if [ "$usb" = 1 ]; then
  state_dir=${ZINC_CARPLAY_STATE_DIR:-$root/build/carplay/state}
else
  state_dir=${ZINC_CARPLAY_STATE_DIR:-$HOME/.local/share/zinc/carplay-experiment/wireless-state}
fi
umask 077
cd "$backend"
exec server/build/install/server/bin/server --identity-dir "$ZINC_CARPLAY_IDENTITY" --state-dir "$state_dir" --bt-bridge "$bt_bridge" --http "$@"
