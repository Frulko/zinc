#!/bin/sh
set -eu
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../../../.." && pwd)
build="$root/build/carplay/usb"
export JAVA_HOME=${JAVA_HOME:-$(/usr/libexec/java_home -v 21)}
cmake -S "$here/native" -B "$build" -DCMAKE_BUILD_TYPE=Debug
BUILD_DIR="$build" "$root/tools/build" carplay_usb carplay_usb_descriptors
"$build/carplay_usb_descriptors"
