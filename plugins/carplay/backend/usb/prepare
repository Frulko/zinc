#!/bin/sh
# Idempotent overlay applied only to the backend build checkout, never to Zinc.
set -eu
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
backend=$1
cp "$here"/protocol/*.kt "$backend/protocol/src/main/java/com/shilapi/xcertplay/transport/"
cp "$here"/tests/*.kt "$backend/protocol/src/test/java/com/shilapi/xcertplay/transport/"
cp "$here"/server/*.kt "$backend/server/src/main/kotlin/com/playport/server/"
cp "$here"/server-tests/*.kt "$backend/server/src/test/kotlin/com/playport/server/"
python3 - "$backend" <<'PY'
from pathlib import Path
import sys
import subprocess
root=Path(sys.argv[1])
p=root/'protocol/build.gradle.kts';t=p.read_text();needle='dependencies {'
if 'net.sf.kxml:kxml2' not in t:
 t=t.replace(needle,needle+'\n    implementation("net.sf.kxml:kxml2:2.3.0")')
if 'org.bouncycastle:bctls-jdk18on' not in t:
 t=t.replace(needle,needle+'\n    implementation("org.bouncycastle:bctls-jdk18on:1.79")')
if 'jvmArgs("--enable-native-access=ALL-UNNAMED")' not in t:
 t += '\ntasks.test { jvmArgs("--enable-native-access=ALL-UNNAMED") }\n'
p.write_text(t)
p=root/'server/src/main/kotlin/com/playport/server/Main.kt'
# A warm overlay must produce the same source as a fresh pinned checkout.
t=subprocess.check_output(['git', '-C', str(root), 'show', 'HEAD:server/src/main/kotlin/com/playport/server/Main.kt']).decode()
assert t.count('    val server = CarPlayServer(config, store)') == 1, 'Unexpected upstream Main.kt'
# Add cleanup before inserting the initializer, whose catch cannot reference wired.
t=t.replace('        exitProcess(1)', '        runCatching { wired?.close() }\n        exitProcess(1)')
if 'WiredBootstrap' not in t:
 t=t.replace('    val server = CarPlayServer(config, store)', '    val wired = System.getenv("ZINC_CARPLAY_USB_SERIAL")?.let { WiredBootstrap(it) }\n    val server = CarPlayServer(if (wired != null) config.copy(bindAddress = wired.bindAddress) else config, store)')
 t=t.replace('    http.start(wait = false)', '    http.start(wait = false)\n    wired?.start(server)')
 t=t.replace('            runCatching { server.close() }','            runCatching { wired?.close() }\n            runCatching { server.close() }')
t=t.replace('    val wired = System.getenv("ZINC_CARPLAY_USB_SERIAL")?.let { WiredBootstrap(it) }',
    '    val wired = try {\n        System.getenv("ZINC_CARPLAY_USB_SERIAL")?.let {\n            MfiIdentity.load(config)\n            WiredBootstrap(it)\n        }\n    } catch (error: Exception) {\n        System.err.println("Wired USB unavailable: ${error.message}")\n        exitProcess(1)\n    }')
p.write_text(t)
p=root/'server/src/main/kotlin/com/playport/server/CarPlayServer.kt'
t=subprocess.check_output(['git', '-C', str(root), 'show', 'HEAD:server/src/main/kotlin/com/playport/server/CarPlayServer.kt']).decode()
assert t.count('microphone = false') == 1, 'Unexpected upstream CarPlayServer microphone setting'
t=t.replace('microphone = false', 'microphone = true')
t=t.replace('"night" -> message.night?.let(session::setNightMode)', '''"night" -> message.night?.let {
                    val sent = session.setNightMode(it)
                    log.info("CarPlay nightMode={} sent={}", it, sent)
                }''')
t=t.replace('    private val listener = object : AirPlaySessionListener {', '    private var lastResourceSummary: String? = null\n\n    private val listener = object : AirPlaySessionListener {')
t=t.replace('        override fun onCommand(session: AirPlaySession, type: String, params: Map<String, Any?>) {', '''        override fun onCommand(session: AirPlaySession, type: String, params: Map<String, Any?>) {
            if (type == "modesChanged") {
                val summary = params["resources"]?.toString()
                if (summary != null && summary != lastResourceSummary) {
                    log.info("CarPlay resource ownership {}", summary)
                    lastResourceSummary = summary
                }
            }''')
p.write_text(t)
p=root/'protocol/src/main/java/com/shilapi/xcertplay/airplay/AirPlaySession.kt'
t=subprocess.check_output(['git', '-C', str(root), 'show', 'HEAD:protocol/src/main/java/com/shilapi/xcertplay/airplay/AirPlaySession.kt']).decode()
needle='if (message.method.startsWith("RTSP/") || message.method.startsWith("HTTP/")) continue'
assert t.count(needle) == 1, 'Unexpected upstream event response handler'
t=t.replace('        eventCseq++', '        eventCseq++\n        if (command["type"] == "setNightMode") debugLog("airplay event night command cseq=$eventCseq")')
t=t.replace(needle, '''if (message.method.startsWith("RTSP/") || message.method.startsWith("HTTP/")) {
                        val result = if (message.body.isNotEmpty()) runCatching { BplistCodec.decode(message.body) as? Map<*, *> }.getOrNull() else null
                        debugLog("airplay event response cseq=${message.headers["cseq"]} status=${message.path} resultStatus=${result?.get("status")} bodyBytes=${message.body.size}")
                        continue
                    }''')
p.write_text(t)
p=root/'server/src/main/kotlin/com/playport/server/WebBridge.kt'
t=subprocess.check_output(['git', '-C', str(root), 'show', 'HEAD:server/src/main/kotlin/com/playport/server/WebBridge.kt']).decode()
t=t.replace('        val uplink = MicUplink(config)', '        org.slf4j.LoggerFactory.getLogger("mic").info("Microphone uplink requested rate={} channels={} port={}", config.sampleRate, config.channels, config.port)\n        val uplink = MicUplink(config)')
p.write_text(t)
p=root/'server/src/main/kotlin/com/playport/server/MicUplink.kt'
t=subprocess.check_output(['git', '-C', str(root), 'show', 'HEAD:server/src/main/kotlin/com/playport/server/MicUplink.kt']).decode()
t=t.replace('            socket.send(DatagramPacket(packet, packet.size, config.host, config.port))', '            socket.send(DatagramPacket(packet, packet.size, config.host, config.port))\n            if (counters.nonce == 1L) log.info("Microphone first UDP packet sent bytes={} samples={}", packet.size, samples)')
p.write_text(t)
p=root/'protocol/src/main/java/com/shilapi/xcertplay/airplay/AirPlayInfoPlist.kt'
t=subprocess.check_output(['git', '-C', str(root), 'show', 'HEAD:protocol/src/main/java/com/shilapi/xcertplay/airplay/AirPlayInfoPlist.kt']).decode()
needle='            "primaryInputDevice" to display.primaryInputDevice,'
assert t.count(needle) == 1, 'Unexpected upstream display descriptor'
t=t.replace(needle, needle + '\n            "uiAppearanceMode" to 0,\n            "uiAppearanceSetting" to 0,\n            "mapAppearanceMode" to 0,\n            "mapAppearanceSetting" to 0,')
p.write_text(t)
p=root/'server/src/main/kotlin/com/playport/server/TlsCertificate.kt'
t=subprocess.check_output(['git', '-C', str(root), 'show', 'HEAD:server/src/main/kotlin/com/playport/server/TlsCertificate.kt']).decode()
t=t.replace('import org.bouncycastle.asn1.x500.X500Name', 'import org.bouncycastle.asn1.DEROctetString\nimport org.bouncycastle.asn1.x500.X500Name')
needle='GeneralName(GeneralName.iPAddress, it.hostAddress)'
assert t.count(needle) == 1, 'Unexpected upstream TlsCertificate.kt'
t=t.replace(needle, 'GeneralName(GeneralName.iPAddress, DEROctetString(it.address))')
p.write_text(t)
PY
