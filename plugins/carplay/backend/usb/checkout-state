#!/usr/bin/env python3
"""Protect local backend edits while allowing repeat builds of our owned overlay."""
import hashlib
import json
from pathlib import Path
import subprocess
import sys

root = Path(sys.argv[1]).resolve()
manifest = root.parent / 'usb-overlay-state.json'

def changed():
    paths = set()
    for args in [('diff', '--name-only', '-z', 'HEAD'), ('ls-files', '--others', '--exclude-standard', '-z')]:
        paths.update(p for p in subprocess.check_output(['git', '-C', str(root), *args]).decode().split('\0') if p)
    return paths

def digest(path):
    p = root / path
    if p.is_symlink() or not p.is_file():
        raise SystemExit('Refusing non-file backend overlay path: ' + path)
    return hashlib.sha256(p.read_bytes()).hexdigest()

if sys.argv[2] == 'verify':
    expected = json.loads(manifest.read_text()) if manifest.exists() else {}
    actual = {p: digest(p) for p in changed()}
    if actual != expected:
        raise SystemExit('CarPlay backend has unmanaged local changes; refusing to overwrite them')
elif sys.argv[2] == 'record':
    manifest.write_text(json.dumps({p: digest(p) for p in sorted(changed())}, indent=2) + '\n')
else:
    raise SystemExit('Expected verify or record')
