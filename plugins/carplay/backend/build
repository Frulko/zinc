#!/bin/sh
# Build the separately distributed GPL receiver; no protocol code is linked into Zinc.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
dest="$root/build/carplay/playport"
rev=9a0882dd0ffe48e467b59d58b12d81391df55ade
if [ ! -d "$dest/.git" ]; then
  mkdir -p "$(dirname "$dest")"
  git clone --no-checkout https://github.com/youcci/playport.git "$dest"
  git -C "$dest" checkout --detach "$rev"
fi
"$root/plugins/carplay/backend/usb/checkout-state" "$dest" verify
git -C "$dest" checkout --detach "$rev"
case "$(uname -s)" in
  Darwin) "$root/plugins/carplay/backend/usb/build" ;;
  Linux) : ;; # Wireless uses BlueZ; native wired USB currently targets macOS.
  *) echo 'CarPlay backend supports macOS and Linux' >&2; exit 1 ;;
esac
export ZINC_CARPLAY_USB_LIBRARY="$root/build/carplay/usb/libcarplay_usb.dylib"
"$root/plugins/carplay/backend/usb/prepare" "$dest"
"$root/plugins/carplay/backend/usb/checkout-state" "$dest" record
(cd "$dest" && ./gradlew --no-daemon --max-workers=2 :protocol:test :server:test :server:installDist)
if [ "$(uname -s)" = Darwin ]; then (cd "$dest" && macos/bt-bridge/build.sh); fi
echo "Built $dest/server/build/install/server/bin/server"
