{
  "name": "link",
  "kind": "module",
  "module": "zinc:link",
  "entry": "index.ts",
  "description": "Two Zinc programs find each other (DNS-SD), pair once with a 6-digit code (TLS EC J-PAKE) and talk over an encrypted channel (TLS 1.3 with the paired key): JSON and bytes, reconnecting while paired; the protocol of zinc agent",
  "requires": ["net"],
  "targets": {
    "macos": {
      "sources": ["../../src/net/dnssd.cpp", "../../src/host/tls.cpp"],
      "defines": ["TLS_NS=linktls"],
      "flags": ["-I../../third_party/mbedtls/include", "-I../../third_party/mbedtls/tf-psa-crypto/include", "-I../../third_party/mbedtls/tf-psa-crypto/drivers/builtin/include"]
    },
    "linux": {
      "sources": ["../../src/net/dnssd.cpp", "../../src/host/tls.cpp"],
      "defines": ["TLS_NS=linktls"],
      "flags": ["-I../../third_party/mbedtls/include", "-I../../third_party/mbedtls/tf-psa-crypto/include", "-I../../third_party/mbedtls/tf-psa-crypto/drivers/builtin/include"]
    },
    "android": {
      "sources": ["../../src/net/dnssd.cpp", "../../src/host/tls.cpp", "native/android/LinkLife.java"],
      "defines": ["TLS_NS=linktls"],
      "flags": ["-I../../third_party/mbedtls/include", "-I../../third_party/mbedtls/tf-psa-crypto/include", "-I../../third_party/mbedtls/tf-psa-crypto/drivers/builtin/include"],
      "lifecycle": "dev.zinc.plugins.link.LinkLife",
      "manifest": { "permissions": ["INTERNET", "CHANGE_WIFI_MULTICAST_STATE"] }
    },
    "ios": {
      "sources": ["../../src/net/dnssd.cpp", "../../src/host/tls.cpp"],
      "defines": ["TLS_NS=linktls"],
      "flags": ["-I../../third_party/mbedtls/include", "-I../../third_party/mbedtls/tf-psa-crypto/include", "-I../../third_party/mbedtls/tf-psa-crypto/drivers/builtin/include"],
      "plist": { "NSLocalNetworkUsageDescription": "Pairs with your other devices on this network.", "NSBonjourServices": ["_zinclink._tcp"] }
    }
  }
}
