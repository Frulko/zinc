{
  "name": "video",
  "kind": "module",
  "live": true,
  "module": "zinc:video",
  "entry": "index.ts",
  "description": "Video playback (FFmpeg with VideoToolbox / V4L2 M2M decode; GStreamer with the hardware decoder on webOS; MediaCodec on Android, AVFoundation on iOS), gapless playlists as runtime images",
  "options": { "buffers": 4, "hwdecode": true },
  "targets": {
    "macos": { "pkg": ["libavformat", "libavcodec", "libavutil", "libswscale"] },
    "linux": { "pkg": ["libavformat", "libavcodec", "libavutil", "libswscale"], "packages": ["pkg-config", "libavformat-dev", "libavcodec-dev", "libavutil-dev", "libswscale-dev"], "linkFlags": ["-pthread"] },
    "windows": { "pkg": ["libavformat", "libavcodec", "libavutil", "libswscale"] },
    "rpi1": { "pkg": ["libavformat", "libavcodec", "libavutil", "libswscale"], "packages": ["ffmpeg-dev"], "linkFlags": ["-pthread"] },
    "webos": { "linkFlags": ["-ldl", "-pthread"] },
    "android": { "libs": ["mediandk", "android", "log"] },
    "ios": { "frameworks": ["AVFoundation", "CoreMedia", "CoreVideo", "Foundation"] }
  },
  "web": { "entry": "web/index.ts" }
}
