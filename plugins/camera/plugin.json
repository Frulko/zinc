{
  "name": "camera",
  "kind": "module",
  "deterministic": true,
  "module": "zinc:camera",
  "entry": "index.ts",
  "description": "Webcams, phone and built-in cameras (AVFoundation on macOS and iOS, V4L2 on Linux, camera2 on Android): list, open at a size and rate, frames as a runtime image, stills, PNG photos encoded off the main thread; a generated test pattern camera when there is none",
  "options": { "fake": false },
  "requires": ["camera"],
  "native": { "impl": { "macos": "native/camera.macos.mm", "ios": "native/camera.ios.mm" } },
  "targets": {
    "macos": { "sources": ["vendor/quirc/quirc.c", "vendor/quirc/decode.c", "vendor/quirc/identify.c", "vendor/quirc/version_db.c"], "frameworks": ["AVFoundation", "CoreMedia", "CoreVideo", "Foundation"] },
    "linux": { "sources": ["vendor/quirc/quirc.c", "vendor/quirc/decode.c", "vendor/quirc/identify.c", "vendor/quirc/version_db.c"], "linkFlags": ["-pthread"] },
    "windows": {},
    "rpi1": { "sources": ["vendor/quirc/quirc.c", "vendor/quirc/decode.c", "vendor/quirc/identify.c", "vendor/quirc/version_db.c"], "linkFlags": ["-pthread"] },
    "android": { "sources": ["vendor/quirc/quirc.c", "vendor/quirc/decode.c", "vendor/quirc/identify.c", "vendor/quirc/version_db.c"], "libs": ["camera2ndk", "mediandk", "android", "log"] },
    "ios": { "sources": ["vendor/quirc/quirc.c", "vendor/quirc/decode.c", "vendor/quirc/identify.c", "vendor/quirc/version_db.c"], "frameworks": ["AVFoundation", "CoreMedia", "CoreVideo", "Foundation"] }
  },
  "web": { "entry": "web/index.ts", "needs": ["getUserMedia"] }
}
