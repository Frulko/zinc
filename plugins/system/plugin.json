{
  "name": "system",
  "kind": "module",
  "deterministic": true,
  "module": "zinc:system",
  "entry": "index.ts",
  "description": "Desktop and phone integration: notifications, menus, tray, dialogs and pickers, window control, shortcuts, deep links, autostart, dock, power, clipboard, opener, share sheet (one native call, JSON ops, permission gate; recording simulator)",
  "native": { "impl": { "android": "native/system.host.cpp", "ios": "native/system.host.cpp" } },
  "targets": {
    "macos": {
      "sources": [
        "native/system.macos.mm"
      ],
      "frameworks": [
        "Foundation",
        "AppKit",
        "UserNotifications",
        "Carbon",
        "IOKit"
      ],
      "flags": [
        "-fobjc-arc"
      ],
      "defines": ["ZN_SYSTEM_LIVE"]
    },
    "linux": {},
    "android": {
      "sources": ["native/system.android.cpp", "native/android/SystemBackend.java"],
      "defines": ["ZN_SYSTEM_LIVE"],
      "lifecycle": "dev.zinc.system.SystemBackend",
      "manifest": { "permissions": ["POST_NOTIFICATIONS"] }
    },
    "ios": {
      "sources": ["native/system.ios.mm"],
      "frameworks": ["UIKit", "UserNotifications", "UniformTypeIdentifiers", "PhotosUI"],
      "flags": ["-fobjc-arc"],
      "defines": ["ZN_SYSTEM_LIVE", "ZN_SYSTEM_URL_DROPS"]
    }
  },
  "modules": {
    "zinc:system/notification": "notification.ts",
    "zinc:system/menu": "menu.ts",
    "zinc:system/dock": "dock.ts",
    "zinc:system/tray": "tray.ts",
    "zinc:system/dialog": "dialog.ts",
    "zinc:system/window": "window.ts",
    "zinc:system/shortcut": "shortcut.ts",
    "zinc:system/instance": "instance.ts",
    "zinc:system/autostart": "autostart.ts",
    "zinc:system/deeplink": "deeplink.ts",
    "zinc:system/opener": "opener.ts",
    "zinc:system/share": "share.ts",
    "zinc:system/power": "power.ts",
    "zinc:system/clipboard": "clipboard.ts",
    "zinc:system/update": "update.ts"
  }
}
