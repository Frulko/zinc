{
  "name": "system",
  "kind": "module",
  "deterministic": true,
  "module": "zinc:system",
  "entry": "index.ts",
  "description": "Desktop integration: notifications, menus, tray, dialogs, window control, shortcuts, deep links, autostart, dock, power, clipboard, opener (one native call, JSON ops, permission gate; recording simulator)",
  "targets": {
    "macos": {
      "sources": [
        "native/system.macos.mm"
      ],
      "frameworks": [
        "Foundation",
        "AppKit",
        "UserNotifications",
        "Carbon"
      ],
      "flags": [
        "-fobjc-arc"
      ]
    },
    "linux": {}
  },
  "modules": {
    "zinc:system/notification": "notification.ts",
    "zinc:system/menu": "menu.ts",
    "zinc:system/dock": "dock.ts",
    "zinc:system/tray": "tray.ts",
    "zinc:system/dialog": "dialog.ts",
    "zinc:system/window": "window.ts",
    "zinc:system/shortcut": "shortcut.ts"
  }
}
