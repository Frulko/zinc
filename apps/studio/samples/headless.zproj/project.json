{
  "format": "zincstudio/1",
  "name": "Headless counter",
  "target": "sim", "width": 480, "height": 320, "device": "",
  "boxes": [
    {"id":"b1","type":"timer","title":"Tick","x":40,"y":60,"params":[{"name":"interval","value":"0.2"}],"script":""},
    {"id":"b2","type":"counter","title":"Count","x":280,"y":60,"params":[],"script":""},
    {"id":"b3","type":"if","title":"Five?","x":520,"y":60,"params":[{"name":"op","value":">="},{"name":"threshold","value":"5"}],"script":""},
    {"id":"b4","type":"log","title":"Log count","x":520,"y":200,"params":[{"name":"message","value":""},{"name":"level","value":"log"}],"script":""},
    {"id":"b5","type":"script","title":"Report","x":760,"y":60,"params":[],"script":"// runs once the counter reaches 5\nconsole.info('counted to five, stopping');\nonDone();\n"}
  ],
  "links": [
    {"from":"@start","out":"onStart","to":"b1","inp":"onStart"},
    {"from":"b1","out":"onTick","to":"b2","inp":"increment"},
    {"from":"b2","out":"count","to":"b4","inp":"message"},
    {"from":"b2","out":"count","to":"b3","inp":"value"},
    {"from":"b3","out":"onTrue","to":"b5","inp":"onStart"},
    {"from":"b5","out":"onDone","to":"@end","inp":"onStopped"}
  ]
}
