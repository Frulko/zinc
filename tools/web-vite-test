#!/usr/bin/env python3
"""A Zinc app built and developed with Vite and @zinc/vite in headless Chrome (docs/targets/web.md, "Vite and other bundlers"; tests/t1/web_vite.sh).
Lays tests/fixtures/web-vite out as a project (pkgs/ becomes node_modules, @zinc/vite linked to packages/vite-plugin-zinc, Vite itself installed once into $ZINC_HOME/cache/web-vite), then:
  1. `vite build` and the dist folder in Chrome: the page shows the app, a click counts, the CommonJS package runs with NODE_ENV production;
  2. `vite` (dev): the same page with NODE_ENV development; a component is edited and hot-updated by Vite (the text changes, the counter and the page stay);
     a broken file shows Vite's overlay; the state module changes and the page reloads.
usage: web-vite-test <zinc> <fixture-dir>    Exit 77 (skip) without Chrome, node, npm or a network for the first install of Vite. Chrome only: Firefox and Safari are not tested here."""
import functools, hashlib, http.server, json, os, shutil, socket, subprocess, sys, tempfile, threading, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from cdp import Chrome, find_chrome

zinc, fixture = os.path.abspath(sys.argv[1]), sys.argv[2]
here = os.path.dirname(os.path.abspath(__file__))
plugin = os.path.abspath(os.path.join(here, "..", "packages", "vite-plugin-zinc"))
if not find_chrome() or not shutil.which("node") or not shutil.which("npm"):
    print("SKIP no Chrome, node or npm"); sys.exit(77)
work = tempfile.mkdtemp(prefix="zinc-web-vite-")
proj = os.path.join(work, "app")
shutil.copytree(fixture, proj)
home = os.environ.get("ZINC_HOME") or os.path.expanduser("~/.zinc")
vite_version = json.load(open(os.path.join(proj, "package.json")))["devDependencies"]["vite"]
cache = os.path.join(home, "cache", "web-vite", vite_version)
env = dict(os.environ, ZINC=zinc, ZINC_BACKGROUND="1")
dev = srv = None
steps, log = {}, []
def cleanup():
    if dev:
        dev.terminate()
        try: dev.wait(5)
        except Exception: dev.kill()
    if srv: srv.shutdown()
    shutil.rmtree(work, ignore_errors=True)
def fail(why):
    steps["failed"] = why
    print(json.dumps({"steps": steps, "devlog": log[-12:]})); cleanup(); sys.exit(1)

if not os.path.isdir(os.path.join(cache, "node_modules", "vite")):   # Vite, once
    os.makedirs(cache, exist_ok=True)
    open(os.path.join(cache, "package.json"), "w").write('{"name":"vite-cache","private":true}')
    r = subprocess.run(["npm", "install", "--save-exact", "vite@" + vite_version], cwd=cache, capture_output=True, text=True, timeout=300)
    if r.returncode != 0: print("SKIP npm install vite failed (offline?): " + r.stderr[-300:]); cleanup(); sys.exit(77)
nm = os.path.join(proj, "node_modules")
os.makedirs(nm)
for e in os.listdir(os.path.join(cache, "node_modules")):
    os.symlink(os.path.join(cache, "node_modules", e), os.path.join(nm, e))
os.makedirs(os.path.join(nm, "@zinc"), exist_ok=True)
os.symlink(plugin, os.path.join(nm, "@zinc", "vite"))
for p in os.listdir(os.path.join(proj, "pkgs")): shutil.move(os.path.join(proj, "pkgs", p), os.path.join(nm, p))
os.rmdir(os.path.join(proj, "pkgs"))
vite = [shutil.which("node"), os.path.join(cache, "node_modules", "vite", "bin", "vite.js")]

def wait_for(c, js, timeout=20):
    end = time.time() + timeout
    while time.time() < end:
        try: v = c.eval(js, 10)
        except Exception: v = None
        if v: return v
        c._recv(-1, 0.15)
    return None
def text(c): return c.eval("document.body.innerText") or ""
def click_text(c, label):
    r = c.eval("(() => { const w = document.createTreeWalker(document.body, NodeFilter.SHOW_ELEMENT); let n; while ((n = w.nextNode())) if (n.children.length === 0 && n.textContent === %s) { const b = n.getBoundingClientRect(); return [b.x + b.width / 2, b.y + b.height / 2]; } return null; })()" % json.dumps(label))
    if not r: return False
    for ty in ("mousePressed", "mouseReleased"):
        c.call("Input.dispatchMouseEvent", {"type": ty, "x": r[0], "y": r[1], "button": "left", "buttons": 1 if ty == "mousePressed" else 0, "clickCount": 1}); c._recv(-1, 0.2)
    return True
def counted(c, n):
    tries = 0
    while ("Add one" in text(c)) and (": %d " % n) not in text(c) and tries < 10:
        if not click_text(c, "Add one"): return False
        time.sleep(0.4); tries += 1
    return (": %d " % n) in text(c)
def edit(path, fn):
    p = os.path.join(proj, path)
    t = fn(open(p).read())
    open(p, "w").write(t)

# 1. the production build
r = subprocess.run(vite + ["build"], cwd=proj, env=env, capture_output=True, text=True, timeout=180)
if r.returncode != 0: fail("vite build failed: " + (r.stdout + r.stderr)[-600:])
class Quiet(http.server.SimpleHTTPRequestHandler):
    extensions_map = dict(http.server.SimpleHTTPRequestHandler.extensions_map, **{".js": "text/javascript", ".mjs": "text/javascript", ".wasm": "application/wasm"})
    def log_message(self, *a): pass
srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), functools.partial(Quiet, directory=os.path.join(proj, "dist")))
threading.Thread(target=srv.serve_forever, daemon=True).start()
with Chrome(["--window-size=800,500"]) as c:
    c.open("http://127.0.0.1:%d/" % srv.server_address[1])
    if not wait_for(c, "document.body.innerText.includes('Label A: 0')"): fail("build: the page did not show the app (%r) %s" % (text(c)[:200], c.console[:4]))
    if "cjs:production" not in text(c): fail("build: process.env.NODE_ENV is not production (%r)" % text(c)[:100])
    if not counted(c, 1): fail("build: a click did not count (%r)" % text(c)[:100])
    steps["build"] = text(c).split("\n")[0]
srv.shutdown(); srv = None

# 2. the dev server
s = socket.socket(); s.bind(("127.0.0.1", 0)); port = s.getsockname()[1]; s.close()
dev = subprocess.Popen(vite + ["--port", str(port), "--strictPort", "--host", "127.0.0.1"], cwd=proj, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
threading.Thread(target=lambda: [log.append(l.rstrip()) for l in dev.stdout], daemon=True).start()
t0 = time.time()
while time.time() - t0 < 60 and not any("127.0.0.1:%d" % port in l for l in log): time.sleep(0.1)
if not any("127.0.0.1:%d" % port in l for l in log): fail("the Vite dev server did not start")
with Chrome(["--window-size=800,500"]) as c:
    c.open("http://127.0.0.1:%d/" % port)
    if not wait_for(c, "document.body.innerText.includes('Label A: 0')", 40): fail("dev: the page did not show the app (%r) %s" % (text(c)[:200], c.console[:4]))
    if "cjs:development" not in text(c): fail("dev: process.env.NODE_ENV is not development (%r)" % text(c)[:100])
    if not counted(c, 2): fail("dev: clicks did not count (%r)" % text(c)[:100])
    steps["dev"] = text(c).split("\n")[0]
    c.eval("window.__marker = 42")
    # a component changes: Vite hot-updates it, the counter stays
    edit("src/Label.tsx", lambda t: t.replace("Label A", "Label B"))
    if not wait_for(c, "document.body.innerText.includes('Label B: 2 ')", 25): fail("dev: no hot update to Label B: 2 (%r) %s" % (text(c)[:200], log[-4:]))
    steps["hmr"] = {"text": text(c).split("\n")[0], "samePage": c.eval("window.__marker") == 42, "updates": c.eval("globalThis.__zincUpdates || 0")}
    if not steps["hmr"]["samePage"] or not steps["hmr"]["updates"]: fail("dev: the page reloaded instead of hot-updating")
    if not counted(c, 3): fail("dev: the counter did not go on after the update")
    # a broken file: Vite's overlay
    edit("src/Label.tsx", lambda t: t.replace("Label B", "Label B' +"))
    if not wait_for(c, "!!document.querySelector('vite-error-overlay')", 20): fail("dev: no error overlay for a broken file %s" % log[-4:])
    steps["overlay"] = True
    edit("src/Label.tsx", lambda t: t.replace("Label B' +", "Label C"))
    if not wait_for(c, "document.body.innerText.includes('Label C')", 25): fail("dev: the fix did not show (%r)" % text(c)[:200])
    # the state module changes: the page reloads (its exports are values)
    edit("src/state.ts", lambda t: t + "\nexport const touched = 1;\n")
    if not wait_for(c, "document.body.innerText.includes('Label C: 0 ') && window.__marker !== 42", 25): fail("dev: the state module did not reload the page (%r)" % text(c)[:200])
    steps["reload"] = True
print(json.dumps({"steps": steps}))
cleanup()
