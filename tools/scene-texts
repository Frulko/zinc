#!/usr/bin/env python3
"""scene-texts [--same|--cmds] DUMP...: the texts a frame draws, read from its scene dump (ZINC_SCENE_DUMP, runtime/gfx.cpp scene_write: 8 words
of header, the commands, the text pool, the point pool). One line per TEXT command, plain or under a matrix (XFORM), in drawing order.
With --same nothing is printed unless a dump draws other texts than the first one: then the first difference, and exit 1 (a test of
what stays written while something moves: the lines of a card that is zoomed). With --cmds every command, one line each: its kind
(runtime/zrt_raster.h Kind), its box, its first colour and a TEXT's text (what a frame draws, for a golden). Standard library only."""
import sys, struct

def texts(path):
    d = open(path, "rb").read()
    magic, version, w, h, size, ncmd, ntext, npts = struct.unpack("<8I", d[:32])
    if magic != 0x4e43535a or size != 48: sys.exit("%s: not a scene dump of this layout" % path)
    text = d[32 + ncmd * size:32 + ncmd * size + ntext]; pts = 32 + ncmd * size + ntext
    out = []
    for i in range(ncmd):
        c = d[32 + i * size:32 + (i + 1) * size]
        kind = c[0]; off, n = struct.unpack("<II", c[40:48])
        if kind == 11:   # XFORM: the command's own kind first, the text's offset and length last
            p = pts + off * 4
            if struct.unpack("<f", d[p:p + 4])[0] != 5: continue
            off, n = struct.unpack("<II", d[p + 52:p + 60])
        elif kind != 5: continue
        out.append(text[off:off + n].decode("utf-8", "replace"))
    return out

KINDS = ["CLEAR", "RECT", "BORDER", "SHADOW", "LINE", "TEXT", "IMAGE", "POLY", "CLIP", "UNCLIP", "STROKE", "XFORM", "SHADER"]

def cmds(path):
    d = open(path, "rb").read()
    magic, version, w, h, size, ncmd, ntext, npts = struct.unpack("<8I", d[:32])
    if magic != 0x4e43535a or size != 48: sys.exit("%s: not a scene dump of this layout" % path)
    text = d[32 + ncmd * size:32 + ncmd * size + ntext]
    out = []
    for i in range(ncmd):
        c = d[32 + i * size:32 + (i + 1) * size]
        x, y, cw, ch = struct.unpack("<4f", c[8:24]); c1, = struct.unpack("<I", c[32:36]); off, n = struct.unpack("<II", c[40:48])
        line = "%s %g %g %g %g #%06x" % (KINDS[c[0]] if c[0] < len(KINDS) else c[0], x, y, cw, ch, c1)
        out.append(line + (" " + text[off:off + n].decode("utf-8", "replace") if c[0] == 5 else ""))
    return out

args = sys.argv[1:]
if not args or args in (["--same"], ["--cmds"]): sys.exit(__doc__)
if args[0] == "--cmds":
    for p in args[1:]: print("\n".join(cmds(p)))
    sys.exit(0)
if args[0] != "--same":
    for p in args: print("\n".join(texts(p)))
    sys.exit(0)
want = texts(args[1])
for p in args[2:]:
    got = texts(p)
    if got != want:
        a, b = ([(x, y) for x, y in zip(want, got) if x != y] or [("%d lines" % len(want), "%d lines" % len(got))])[0]
        print("%s does not draw the texts of %s: %r became %r" % (p, args[1], a, b)); sys.exit(1)
