#!/bin/sh
# Writes lib/ui.d.ts, the editor's declarations of zinc:ui, from lib/std/ui.ts (ZN-799): tsc's declaration emit (the repo's tsc 7, or $TSC),
# wrapped as `declare module 'zinc:ui'` so a project's tsconfig.json (zinc tsconfig) shows PointerEvent, KeyEvent and the API with their docs.
# Run it after changing the exports of lib/std/ui.ts; tests/t0/ui_dts.sh fails while the committed file is stale.
#   tools/ui-dts            rewrite lib/ui.d.ts
#   tools/ui-dts --stdout   print it
root=$(cd "$(dirname "$0")/.." && pwd)
tsc=${TSC:-$root/node_modules/.bin/tsc}
"$tsc" --version >/dev/null 2>&1 || { echo "ui-dts: no tsc at $tsc (pnpm install, or TSC=<path>)" >&2; exit 2; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
# ui.ts imports engine-internal modules that have no declarations (zinc:platform, zinc:__layout, zinc:ui/dom): tsc reports them and still emits
(cd "$root" && "$tsc" --declaration --emitDeclarationOnly --noLib --types "" --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler \
  --outDir "$tmp" lib/zinc.d.ts lib/gfx.d.ts lib/modules.d.ts lib/std/ui.ts) > "$tmp/log" 2>&1
[ -s "$tmp/ui.d.ts" ] && [ -s "$tmp/overscroller.d.ts" ] || { echo "ui-dts: tsc emitted nothing:" >&2; cat "$tmp/log" >&2; exit 1; }
{
  echo "// zinc:ui, generated by tools/ui-dts from lib/std/ui.ts: do not edit, run tools/ui-dts after changing its exports."
  echo "declare module 'zinc:ui' {"
  echo "  namespace OS {   // lib/std/overscroller.ts, the type of a fling"
  sed -e 's/^export declare /export /' -e 's/^/    /' "$tmp/overscroller.d.ts"
  echo "  }"
  sed -e '/^import \* as OS from/d' -e '/^export {};$/d' -e 's/^export declare /export /' -e 's/^declare //' -e 's/^/  /' "$tmp/ui.d.ts"
  echo "}"
} > "$tmp/out"
if [ "$1" = "--stdout" ]; then cat "$tmp/out"; else cp "$tmp/out" "$root/lib/ui.d.ts" && echo "wrote lib/ui.d.ts"; fi
