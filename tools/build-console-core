#!/bin/sh
# Builds the console core (targets/console, ZN-455) for a console with its pinned SDK (zinc toolchain install <console>, ZN-456):
#   tools/build-console-core <psp|vita|ps2|n3ds> [--pure] [--gxp3d] [--vitagl] [--embed program.zbc [resources.bin] [default.zpk] | --aot project] [--frames N] [--input script] [--env NAME=VALUE]... [--title NAME] [--id ABCD12345] [--size WxH] [--player] [-B dir]
# --pure: without the graphics host (text programs); --embed: the program linked into the binary (the emulators that give it no file system),
# with its fonts and images (resources.bin) and its asset pack (zinc pack's packs/default.zpk: zinc:assets, sprite atlases, tile maps);
# --aot: the program (a project directory or an entry file) compiled to C++ for the console's profile and linked in instead of the interpreter
# (ZN-480): its fonts and images are in its C++, its asset pack is made by zinc pack and linked in as --embed does;
# --vitagl: the Vita draws through vitaGL and the GLES 2 replay (needs ur0:data/libshacccg.suprx on the console) instead of GXM;
# --frames N: the HAL stops after N frames (the emulator tests; never for a copy a person plays); --input: the `pad` and `padup` lines of a
# ZINC_INPUT script, held on top of the console's pad (targets/console/console_pad.h); --env: the program's environment (ZINC_PROFILE=1: the
# frame times at exit); --title: the name in the console's menu (PSP, Vita, 3DS), --id: the Vita title id (one per program, else they replace each
# other); --size: the program's surface when it is not the screen's (zinc.json targets.<console>; the Vita shows 480x272 doubled);
# --player: the device player (ZN-792) instead of one program: it waits for zinc device on the network and runs what it sends (title
# "Zinc Player", Vita title id ZNPL00001, unless --title and --id say otherwise).
# Output: <dir> (default build/console-<console>[-pure|-player]) with EBOOT.PBP (psp),
# zinc.vpk (vita), zinc-core (ps2, an ELF) or zinc-core.3dsx (n3ds). Prints the path of that file last. The 3DS builds in devkitPro's pinned
# docker image unless $DEVKITPRO names a local install.
set -e
here=$(cd "$(dirname "$0")/.." && pwd -P)
console=$1; [ -n "$console" ] && shift || { echo "usage: tools/build-console-core <psp|vita|ps2|n3ds> [--pure] [--gxp3d] [--vitagl] [--embed program.zbc [resources.bin] [default.zpk] | --aot project] [--frames N] [--input script] [--env NAME=VALUE]... [--title NAME] [--id ABCD12345] [--size WxH] [--player] [-B dir]" >&2; exit 2; }
gfx=${gfx:-ON}; aot=; embed=; res=; pack=; frames=0; dir=; input=; env=; title=Zinc; id=ZINC00001; want_size=; gxp3d=OFF; vitagl=OFF; player=OFF; named=; ided=
while [ $# -gt 0 ]; do
  case $1 in
    --pure) gfx=OFF ;;
    --gxp3d) gxp3d=ON ;;
    --vitagl) vitagl=ON ;;
    --player) player=ON ;;
    --embed) embed=$(cd "$(dirname "$2")" && pwd -P)/$(basename "$2"); shift
             case ${2:-} in *.bin) res=$(cd "$(dirname "$2")" && pwd -P)/$(basename "$2"); shift ;; esac
             case ${2:-} in *.zpk) pack=$(cd "$(dirname "$2")" && pwd -P)/$(basename "$2"); shift ;; esac ;;
    --frames) frames=$2; shift ;;
    --input) [ -f "$2" ] || { echo "build-console-core: no input script $2" >&2; exit 2; }
             input=$(awk '$2 == "pad" { print $1 "+" $3 } $2 == "padup" { print $1 "-" $3 }' "$2" | sort -n -s | paste -sd, -); shift ;;
    --env) env=${env:+$env,}$2; shift ;;
    --title) title=$2; named=1; shift ;;
    --id) id=$2; ided=1; shift ;;
    --size) want_size=$2; shift ;;
    --aot) [ -e "$2" ] || { echo "build-console-core: no program $2" >&2; exit 2; }
           aot=$(cd "$(dirname "$2")" && pwd -P)/$(basename "$2"); shift ;;
    -B) dir=$2; shift ;;
    *) echo "build-console-core: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
Z=${ZINC:-$here/build/zinc}
version=
if [ $player = ON ]; then   # the version the player reports: zinc's, read here (the 3DS builds in docker, without git)
  [ -n "$named" ] || title="Zinc Player"; [ -n "$ided" ] || id=ZNPL00001
  version=$("$Z" --version | sed 's/^zinc-next //')
fi
sdk=$("$Z" toolchain install "$console")
docker=
case $console in
  psp)  export PSPDEV="$sdk"; tc=$sdk/psp/share/pspdev.cmake; size=480x272; out=EBOOT.PBP ;;
  vita) export VITASDK="$sdk"; tc=$sdk/share/vita.toolchain.cmake; size=960x544; out=zinc.vpk ;;
  ps2)  export PS2DEV="$sdk" PS2SDK="$sdk/ps2sdk" GSKIT="$sdk/gsKit"; tc=$sdk/share/ps2dev.cmake; size=640x448; out=zinc-core ;;
  n3ds) size=400x240; out=zinc-core.3dsx
        case $sdk in docker.io/*) docker=$sdk; tc=/opt/devkitpro/cmake/3DS.cmake ;; *) export DEVKITPRO="$sdk" DEVKITARM="$sdk/devkitARM"; tc=$sdk/cmake/3DS.cmake ;; esac ;;
  *) echo "build-console-core: no console core for '$console' (psp, vita, ps2, n3ds)" >&2; exit 2 ;;
esac
[ -z "$want_size" ] || size=$want_size
export PATH="$sdk/bin:$sdk/ee/bin:$sdk/ps2sdk/bin:$PATH"   # ps2dev keeps its EE compiler in ee/bin, its pkg-config in ps2sdk/bin
[ -n "$dir" ] || { dir=$here/build/console-$console; [ $gfx = ON ] || dir=$dir-pure; [ $player = OFF ] || dir=$dir-player; }
mkdir -p "$dir"
if [ -n "$embed" ]; then   # inside the build directory: the 3DS container sees the repository only
  cp "$embed" "$dir/embed-program.zbc"; embed=$dir/embed-program.zbc
  [ -z "$res" ] || { cp "$res" "$dir/embed-resources.bin"; res=$dir/embed-resources.bin; }
  [ -z "$pack" ] || { cp "$pack" "$dir/embed-default.zpk"; pack=$dir/embed-default.zpk; }
fi
aotdir=
if [ -n "$aot" ]; then   # the program's C++ for the console's profile (zinc build, as zinc export does for a phone), and its asset pack
  [ -z "$embed" ] && [ $player = OFF ] || { echo "build-console-core: --aot takes the place of --embed and --player" >&2; exit 2; }
  aotdir=$dir/aot; rm -rf "$aotdir"; mkdir -p "$aotdir"
  [ ! -d "$dir/CMakeFiles" ] || find "$dir/CMakeFiles" -name 'program*.cpp.o' -delete   # another program's objects (make's clock counts seconds)
  ZN_AOT_CPP_ONLY=1 "$Z" build --profile "$console" "$aot" -o "$aotdir/program" >"$aotdir/build.log" 2>&1 ||
    { tail -20 "$aotdir/build.log" >&2; echo "build-console-core: zinc build --profile $console failed on $aot" >&2; exit 1; }
  if [ -d "$aot" ] && "$Z" pack --profile "$console" "$aot" -o "$aotdir/program.zapp" >>"$aotdir/build.log" 2>&1 &&
     tar -tf "$aotdir/program.zapp" | grep -qx 'packs/default.zpk'; then
    tar -xf "$aotdir/program.zapp" -C "$aotdir" packs/default.zpk && pack=$aotdir/packs/default.zpk
  fi
fi
# zinc:3d in the core (its native module Render3D): the C++ interface and the ABI thunk generated from the spec here, on this machine (the 3DS
# builds in docker, where no zinc runs)
gen=
if [ $gfx = ON ]; then
  gen=$dir/gen; mkdir -p "$gen"
  "$Z" native-gen "$here/plugins/3d/native/render3d.spec.ts" "$gen" >/dev/null && "$Z" native-gen --thunk "$here/plugins/3d/native/render3d.spec.ts" "$gen" >/dev/null ||
    { echo "build-console-core: zinc native-gen failed on the zinc:3d spec" >&2; exit 1; }
fi
cores=$(sysctl -n hw.physicalcpu 2>/dev/null || nproc 2>/dev/null || echo 4)
configure="cmake -S '$here/targets/console' -B '$dir' -DCMAKE_TOOLCHAIN_FILE='$tc' -DCMAKE_BUILD_TYPE=Release -DZN_CONSOLE=$console -DZN_CONSOLE_GFX=$gfx -DZN_CONSOLE_SIZE=$size -DZN_CONSOLE_FRAMES=$frames -DZN_CONSOLE_INPUT='$input' -DZN_CONSOLE_ENV='$env' -DZN_CONSOLE_TITLE='$title' -DZN_CONSOLE_ID='$id' -DZN_CONSOLE_EMBED='$embed' -DZN_CONSOLE_EMBED_RES='$res' -DZN_CONSOLE_EMBED_PACK='$pack' -DZN_VITA_GXP_3D=$gxp3d -DZN_VITA_GL=$vitagl -DZN_CONSOLE_GEN='$gen' -DZN_CONSOLE_PLAYER=$player -DZN_CONSOLE_VERSION='$version' -DZN_CONSOLE_AOT='$aotdir'"
build="cmake --build '$dir' -j $cores -- -l $cores"
if [ -n "$docker" ]; then
  root=$here
  docker run --rm -v "$root:$root" -w "$here" -e DEVKITPRO=/opt/devkitpro -e DEVKITARM=/opt/devkitpro/devkitARM "$docker" sh -c "$configure && $build" >"$dir.log" 2>&1 ||
    { grep -m 20 -E "error|undefined" "$dir.log" >&2 || tail -30 "$dir.log" >&2; exit 1; }
else
  sh -c "$configure" >"$dir.log" 2>&1 || { tail -30 "$dir.log" >&2; exit 1; }
  sh -c "$build" >>"$dir.log" 2>&1 || { grep -m 20 -E "error|undefined" "$dir.log" >&2 || tail -30 "$dir.log" >&2; exit 1; }
fi
echo "$dir/$out"
