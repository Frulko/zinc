#!/usr/bin/env python3
"""Generates plugins/system/ops.d.ts (typings) and plugins/system/native/ops.gen.h (the permission gate table) from plugins/system/ops.json (ZN-232).
usage: tools/system-ops [--check]   (--check writes nothing and exits 1 when a generated file differs: the drift guard of tests/t0/system_ops.sh)"""
import json, os, sys
root = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "plugins", "system")
d = json.load(open(os.path.join(root, "ops.json")))

dts = ["// Generated by tools/system-ops from ops.json: do not edit.", "export interface MenuItem { id?: string; label?: string; role?: string; accelerator?: string; enabled?: boolean; checked?: boolean; submenu?: MenuItem[]; type?: 'separator' }", "", "export interface OpArgs {"]
res = ["export interface OpResult {"]
for o in d["ops"]:
    fields = "; ".join("%s%s: %s" % (k.rstrip("?"), "?" if k.endswith("?") else "", v) for k, v in o["params"].items())
    dts.append("  '%s': { %s };" % (o["op"], fields))
    res.append("  '%s': %s;" % (o["op"], o["returns"]))
dts += ["}", ""] + res + ["}", "", "export type OpName = keyof OpArgs;", "export type EventName = %s;" % " | ".join("'%s'" % e for e in d["events"]), "", "/** The permission id an op needs. */", "export const PERMISSION_OF: { [op in OpName]: string };", ""]
h = ["// Generated by tools/system-ops from plugins/system/ops.json: do not edit.", "#pragma once", "struct ZnSystemOp { const char* op; const char* permission; const char* sim; };", "static const ZnSystemOp kSystemOps[] = {"]
h += ['  {"%s", "%s", "%s"},' % (o["op"], o["permission"], o["sim"].replace('"', '\\"')) for o in d["ops"]]
h += ["};", "static const char* const kSystemEvents[] = {%s};" % ", ".join('"%s"' % e for e in d["events"]), ""]
files = {os.path.join(root, "ops.d.ts"): "\n".join(dts), os.path.join(root, "native", "ops.gen.h"): "\n".join(h)}
bad = 0
for path, text in files.items():
    if "--check" in sys.argv:
        if not os.path.exists(path) or open(path).read() != text:
            print("%s is out of date: run tools/system-ops" % os.path.relpath(path)); bad = 1
    else:
        open(path, "w").write(text)
sys.exit(bad)
