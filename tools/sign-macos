#!/bin/sh
# Signing and notarization of the macOS downloads (ZN-053), scripted end to end. Needs an Apple Developer ID and a notarytool keychain profile:
#   ZINC_SIGN_IDENTITY   "Developer ID Application: Name (TEAMID)"
#   ZINC_NOTARY_PROFILE  the name given to `xcrun notarytool store-credentials`
#   tools/sign-macos [--dry-run] dist/Zinc-Atelier-<version>-macos-<arch>.zip   # the app
#   tools/sign-macos [--dry-run] dist/zinc-<version>-macos-<arch>.tar.gz        # the CLI
# --dry-run prints each command and runs none (what tests/t0/package.sh checks); without it the script stops at the first failing step.
# Steps: unpack, sign every Mach-O (dylibs first, then zinc) with the hardened runtime, zip, submit and wait for notarization; the app: staple the
# ticket to the bundle, check it with spctl, zip again. The CLI: a ticket cannot be stapled to a bare executable, so the archive is packed again as
# signed and Gatekeeper finds the ticket online when a quarantined copy is first run (docs/guide/07-distribution.md, "Zinc itself").
# Out: <name>-notarized.zip or <name>-notarized.tar.gz beside the input.
set -e
dry=0
[ "$1" = "--dry-run" ] && { dry=1; shift; }
pkg=$1
case "$pkg" in
  *.zip) kind=app ;;
  *.tar.gz) kind=cli ;;
  *) echo "usage: tools/sign-macos [--dry-run] <Zinc-Atelier-...-macos-...zip | zinc-...-macos-...tar.gz>" >&2; exit 2 ;;
esac
if [ $dry -eq 0 ]; then
  [ -n "$ZINC_SIGN_IDENTITY" ] || { echo "set ZINC_SIGN_IDENTITY to your Developer ID Application identity" >&2; exit 2; }
  [ -n "$ZINC_NOTARY_PROFILE" ] || { echo "set ZINC_NOTARY_PROFILE to a notarytool keychain profile" >&2; exit 2; }
fi
ID=${ZINC_SIGN_IDENTITY:-"Developer ID Application: (dry run)"}
PROFILE=${ZINC_NOTARY_PROFILE:-dry-run}
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
step() { echo "+ $*"; [ $dry -eq 1 ] || "$@"; }
# zinc loads the plugin libraries a user compiles on their machine (signed ad hoc): the hardened runtime must not refuse them
ent="$work/zinc.entitlements"
printf '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict><key>com.apple.security.cs.disable-library-validation</key><true/></dict></plist>\n' > "$ent"
sign() {   # sign <dir of zinc> <dir of the bundled dylibs> <share/zinc>: the plugins' libraries too (ZN-718): notarization refuses an unsigned Mach-O
  for f in "$2"/*.dylib "$1"/*.dylib "$3"/plugins/*/prebuilt/macos/*.dylib; do
    [ $dry -eq 1 ] || [ -e "$f" ] || continue   # an empty glob (no bundled dylib) stays as written
    step codesign --force --timestamp --options runtime --sign "$ID" "$f"
  done
  step codesign --force --timestamp --options runtime --entitlements "$ent" --sign "$ID" "$1/zinc"
}
if [ $kind = app ]; then
  app="$work/Zinc Atelier.app"
  step ditto -x -k "$pkg" "$work"
  [ $dry -eq 1 ] && app="<unpacked>/Zinc Atelier.app"
  sign "$app/Contents/MacOS" "$app/Contents/Frameworks" "$app/Contents/Resources/zinc"
  step codesign --force --timestamp --options runtime --sign "$ID" "$app"
  step codesign --verify --deep --strict "$app"
  step ditto -c -k --keepParent "$app" "$work/notarize.zip"
  step xcrun notarytool submit "$work/notarize.zip" --keychain-profile "$PROFILE" --wait
  step xcrun stapler staple "$app"
  step spctl --assess --type execute --verbose "$app"
  out="${pkg%.zip}-notarized.zip"
  step ditto -c -k --keepParent "$app" "$out"
else
  name=$(basename "$pkg" .tar.gz)
  root="$work/$name"
  step tar -xzf "$pkg" -C "$work"
  [ $dry -eq 1 ] && root="<unpacked>/$name"
  sign "$root/bin" "$root/lib" "$root/share/zinc"
  step codesign --verify --strict "$root/bin/zinc"
  step ditto -c -k --keepParent "$root" "$work/notarize.zip"   # notarytool takes a zip, a dmg or a pkg, not a tar.gz
  step xcrun notarytool submit "$work/notarize.zip" --keychain-profile "$PROFILE" --wait
  out="${pkg%.tar.gz}-notarized.tar.gz"
  step env COPYFILE_DISABLE=1 tar -czf "$out" -C "$work" "$name"   # no ._ files: a signature lives inside the Mach-O, not in an attribute
fi
echo "signed and notarized: $out"
