#!/usr/bin/env python3
"""One bounded browser loading proof for tests/data/wasm_loading exported with --target wasm. No pixel golden or benchmark."""
import base64
import http.server
import importlib.machinery
import importlib.util
import json
import pathlib
import sys
import threading
import time
from cdp import Chrome

site = pathlib.Path(sys.argv[1]).resolve()
out = pathlib.Path(sys.argv[2] if len(sys.argv) > 2 else site / 'proof')
out.mkdir(parents=True, exist_ok=True)
release = threading.Event()
started = threading.Event()
packs = []
class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **kw): super().__init__(*a, directory=str(site), **kw)
    def log_message(self, *a): pass
    def end_headers(self):
        self.send_header('Cross-Origin-Opener-Policy', 'same-origin')
        self.send_header('Cross-Origin-Embedder-Policy', 'require-corp')
        self.send_header('Cache-Control', 'no-store')
        super().end_headers()
    def do_GET(self):
        if self.path.endswith('.zpk'): packs.append(self.path)
        if self.path == '/app.wasm' and not release.is_set():
            data = (site / 'app.wasm').read_bytes()
            self.send_response(200); self.send_header('Content-Type', 'application/wasm'); self.send_header('Content-Length', str(len(data))); self.end_headers()
            self.wfile.write(data[:64]); self.wfile.flush(); started.set()
            if not release.wait(15): return
            self.wfile.write(data[64:]); return
        super().do_GET()
server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Handler)
thread = threading.Thread(target=server.serve_forever, daemon=True); thread.start()
try:
    with Chrome(['--window-size=320,160', '--disable-background-networking']) as c:
        c.call('Network.enable'); c.call('Network.setCacheDisabled', {'cacheDisabled': True})
        c.open('http://127.0.0.1:%d/index.html?frames=45' % server.server_port)
        assert started.wait(5), 'wasm response never started'
        splash = c.eval("(() => { const s=document.getElementById('splash'); return !!s && getComputedStyle(s).display !== 'none' && s.getBoundingClientRect().width > 0 && document.title !== 'running'; })()", 5)
        assert splash, 'splash was not visible while wasm was held'
        shot = c.call('Page.captureScreenshot', {'format': 'png'}, 5)
        (out / 'splash.png').write_bytes(base64.b64decode(shot['data']))
        release.set()
        def finish():
            deadline = time.monotonic() + 15
            while time.monotonic() < deadline:
                if c.eval("!!document.getElementById('png')", 3):
                    log = c.eval("document.getElementById('log').textContent", 3)
                    assert 'exit 0,' in log and 'before false' in log and 'images 8 8 true' in log, (log, c.problems)
                    assert 'math NaN -0 5e-324 NaN -0' in log, log
                    return log, base64.b64decode(c.eval("document.getElementById('png').textContent", 3))
                c.pump(.05)
            raise AssertionError(('browser did not finish', c.eval("document.getElementById('log').textContent", 3), c.problems))
        log, png = finish(); (out / 'first.png').write_bytes(png)
        first = len(packs); assert first == 1, packs
        c.call('Page.reload', {'ignoreCache': True})
        log2, png2 = finish(); (out / 'second.png').write_bytes(png2)
        assert len(packs) == first, ('second visit fetched packs', packs)
        assert not c.problems, c.problems
    loader = importlib.machinery.SourceFileLoader('pngreader', str(pathlib.Path(__file__).with_name('pngdiff')))
    spec = importlib.util.spec_from_loader('pngreader', loader); reader = importlib.util.module_from_spec(spec); loader.exec_module(reader)
    w, h, bpp, data = reader.dec(str(out / 'first.png'))
    samples = [tuple(data[(4 * w + x) * bpp:(4 * w + x) * bpp + 3]) for x in (4, 12)]
    assert (w, h) == (16, 8), (w, h)
    for p in samples: assert all(abs(p[i] - (120, 40, 20)[i]) <= 5 for i in range(3)), samples
    result = {'splashBeforeWasm': splash, 'firstPackRequests': first, 'secondPackRequests': len(packs) - first, 'ktx2PremulAndStraightPixels': samples, 'log': log}
    (out / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
    print(json.dumps(result))
finally:
    release.set(); server.shutdown(); server.server_close(); thread.join(2)
