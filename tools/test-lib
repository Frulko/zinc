#!/bin/sh
# tools/test-lib NAME: prints the path of a third-party file a test needs and the repository does not carry, taking it once from its official
# release into a cache outside the repository (${ZINC_HOME:-~/.zinc}/cache/test-libs/NAME/) and checking it against the sha256 pinned below.
# A cached file whose hash is the pinned one is used as it is, with no network. Exit 1 with the reason on stderr when the file is neither
# cached nor downloadable (the test then exits 77), or when what came does not have the pinned hash (it is not kept).
#
# Why not third_party: RULES.md §3 keeps LGPL code out of the tree. p5.js is LGPL-2.1; the test loads it at run time and nothing of it
# is compiled, linked or packaged into zinc.
#   p5-1.11.13   p5.min.js of p5 1.11.13: lib/p5.min.js of the npm tarball p5-1.11.13.tgz (the release the p5 project publishes)
#   gsap-3.15.0  all.js of GSAP 3.15.0: dist/all.js of the npm tarball gsap-3.15.0.tgz, GSAP with every plugin in one file (GreenSock's "no
#                charge" licence is not an open-source one: the file is taken from GreenSock's own release, never kept in this repository)
#   spline-runtime-2.0.98   runtime.standalone.webgl.js of @splinetool/runtime 2.0.98: Spline's runtime for the scenes made in spline.design,
#                three.js inside, in one ES module (the package has no licence, "(c) Spline, Inc.": taken from Spline's npm release, never kept here),
#                with the two plain-JavaScript modules it imports beside itself: opentype.js (3D text) and howler.js (sound actions)
set -u
more=""   # other files of the same archive the library needs beside it: triples of file, member and sha256
case "${1:-}" in
  p5-1.11.13)
    file=p5.min.js
    url=https://registry.npmjs.org/p5/-/p5-1.11.13.tgz   # the archive's own sha256: 8f2c1e0e07b006c967d085154a6b92fd80906a9743373243944e4ea6cc737ec3
    member=package/lib/p5.min.js
    sha=e9df7d05fd7c3ff028fc09a312a43101241f23c43143b387bf89d96b2e4e0849 ;;
  gsap-3.15.0)
    file=all.js
    url=https://registry.npmjs.org/gsap/-/gsap-3.15.0.tgz   # the archive's own sha256: d2e33ad202d4811e9084883f7ff9a27967ac4095caef51ca4c9d20697a253b1c
    member=package/dist/all.js
    sha=cf0a1a9dded0ac5f5caa64208af0cec045a0f2ef79e6bfd47967eaf6f707b421 ;;
  spline-runtime-2.0.98)
    file=runtime.standalone.webgl.js
    url=https://registry.npmjs.org/@splinetool/runtime/-/runtime-2.0.98.tgz   # the archive's own sha256: 263d7bceea4a658c19d4e5450a08b5fa321b0ecadbff4b2b02c655ae8b53e089
    member=package/build/runtime.standalone.webgl.js
    sha=acec1fc77e8936899d8d0e015ad7599529815a661179698d9f977656ac18f262
    more="opentype.js package/build/opentype.js d7231cb597a44e3748828e0bfc7acfbf89caac5ef986462c752a465b5e9a6171 howler.js package/build/howler.js ee3778513d97db7a4c51a60cb44672986d73dbb9ccb4390f43e27b6e39c8c894" ;;
  *) echo "test-lib: unknown library '${1:-}' (p5-1.11.13, gsap-3.15.0, spline-runtime-2.0.98)" >&2; exit 2 ;;
esac
sum() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
dir="${ZINC_HOME:-$HOME/.zinc}/cache/test-libs/$1"
cached() {   # every file of the library is there with its pinned hash
  [ -f "$dir/$file" ] && [ "$(sum "$dir/$file")" = "$sha" ] || return 1
  set -- $more
  while [ $# -ge 3 ]; do [ -f "$dir/$1" ] && [ "$(sum "$dir/$1")" = "$3" ] || return 1; shift 3; done
}
if cached; then echo "$dir/$file"; exit 0; fi
command -v curl >/dev/null 2>&1 || { echo "test-lib: $1 is not cached and curl is missing" >&2; exit 1; }
mkdir -p "$dir" || { echo "test-lib: cannot create $dir" >&2; exit 1; }
tmp=$(mktemp -d "$dir/.fetch.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --max-time 120 -o "$tmp/archive" "$url" 2>"$tmp/err" || { echo "test-lib: $1 is not cached and cannot be downloaded from $url ($(head -c 120 "$tmp/err"))" >&2; exit 1; }
name=$1
take() {   # take <file> <member> <sha256>: one member, to a file of our own (nothing of the archive chooses a path), kept only with its pinned hash
  tar -xzOf "$tmp/archive" "$2" > "$tmp/$1" 2>/dev/null || { echo "test-lib: $2 is not in the archive of $url" >&2; exit 1; }
  got=$(sum "$tmp/$1")
  [ "$got" = "$3" ] || { echo "test-lib: $name ($1) from $url has sha256 $got, not the pinned $3: not kept" >&2; exit 1; }
}
take "$file" "$member" "$sha"
set -- $more
while [ $# -ge 3 ]; do take "$1" "$2" "$3"; shift 3; done
set -- $more
while [ $# -ge 3 ]; do mv "$tmp/$1" "$dir/$1" || exit 1; shift 3; done
mv "$tmp/$file" "$dir/$file" && echo "$dir/$file"
