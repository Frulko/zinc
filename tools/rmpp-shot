#!/usr/bin/env python3
"""Screenshot of a reMarkable Paper Pro (or Move) over ssh, with nothing installed on the tablet.

  tools/rmpp-shot [out.png] [--host root@10.11.99.1] [--top N]     (--top: only the first N rows, e.g. 130 for the header)

xochitl draws the screen into a QImage of 1620x2160 (Move: 960x1696), RGB32, 6528 (3840) bytes a line, the image framebuffer-spy
(asivery/rm-xovi-extensions) catches at its constructor. Here the image's QImageData is found in xochitl's heap (width, height,
depth 32, then its bytes per line, format 4 and data pointer), and the pixels are read through /proc/<pid>/mem. The pointer is
kept per xochitl pid in $TMPDIR, so the next shots read only the frame.
"""
import os, struct, subprocess, sys, tempfile, zlib

SIZES = [(1620, 2160, 6528), (960, 1696, 3840)]

def ssh(host, cmd, binary=False):
    out = subprocess.run(['/usr/bin/ssh', host, cmd], capture_output=True, check=True).stdout
    return out if binary else out.decode()

def read_mem(host, pid, addr, size):
    # dd from /proc/<pid>/mem in 16-byte blocks: addresses and sizes here are multiples of 16
    return ssh(host, f'dd if=/proc/{pid}/mem bs=16 skip={addr // 16} count={(size + 15) // 16} 2>/dev/null', True)[:size]

def find_image(host, pid):
    maps = ssh(host, f'cat /proc/{pid}/maps')
    for line in maps.splitlines():
        f = line.split()
        if not (f[1].startswith('rw') and (len(f) == 5 or f[5] == '[heap]')): continue
        start, end = (int(x, 16) for x in f[0].split('-'))
        if end - start < 1 << 20: continue
        data = read_mem(host, pid, start, end - start)
        for w, h, bpl in SIZES:
            needle = struct.pack('<ii', w, h)
            i = data.find(needle)
            while i >= 0:
                # QImageData: ref, width, height, depth, nbytes, devicePixelRatio, colortable, data, format, bytes_per_line
                # (Qt 6 layout varies); look near it for bpl, format 4 and a pointer, in this order
                near = data[i:i + 96]
                j = near.find(struct.pack('<q', bpl))
                if j >= 0 and struct.unpack_from('<i', near, j + 8)[0] == 4:
                    ptr = struct.unpack_from('<Q', near, j + 16)[0]
                    if ptr >> 40: return ptr, w, h, bpl
                i = data.find(needle, i + 4)
    sys.exit('rmpp-shot: no screen image in xochitl\'s memory')

def png(path, w, h, rows):
    raw = b''.join(b'\0' + r for r in rows)
    chunk = lambda t, d: struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d))
    with open(path, 'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0))
                + chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))

def main():
    args = sys.argv[1:]
    host, top, out = 'root@10.11.99.1', 0, 'rmpp-shot.png'
    while args:
        a = args.pop(0)
        if a == '--host': host = args.pop(0)
        elif a == '--top': top = int(args.pop(0))
        elif a.startswith('-'): sys.exit(__doc__)
        else: out = a
    pid = ssh(host, 'pidof xochitl').split()[0]
    cache = os.path.join(tempfile.gettempdir(), f'rmpp-shot-{host.replace("@", "_")}')
    found = None
    if os.path.exists(cache):
        c = open(cache).read().split()
        if c[0] == pid: found = (int(c[1], 16), int(c[2]), int(c[3]), int(c[4]))
    if not found:
        found = find_image(host, pid)
        open(cache, 'w').write(f'{pid} {found[0]:x} {found[1]} {found[2]} {found[3]}')
    ptr, w, h, bpl = found
    h = min(h, top) if top else h
    frame = read_mem(host, pid, ptr, bpl * h)
    rows = []
    for y in range(h):
        line = frame[y * bpl:y * bpl + w * 4]   # RGB32 in memory: B, G, R, X
        rgb = bytearray(w * 3)
        rgb[0::3], rgb[1::3], rgb[2::3] = line[2::4], line[1::4], line[0::4]
        rows.append(bytes(rgb))
    png(out, w, h, rows)
    print(out, f'{w}x{h}')

if __name__ == '__main__':
    main()
