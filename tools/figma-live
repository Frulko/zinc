#!/usr/bin/env python3
"""Local Figma design receiver; Zinc owns compilation, rendering and refresh."""
import argparse
import base64
import hashlib
import hmac
import json
import math
import os
from pathlib import Path
import re
import secrets
import shutil
import signal
import subprocess
import sys
