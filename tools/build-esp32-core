#!/bin/sh
# Builds the core firmware of an ESP32 (firmware/esp32) with ESP-IDF and writes the flash image kept in firmware/esp32/prebuilt (ZN-030).
# Needs git, python3 and network the first time: ESP-IDF 5.5.5 and its toolchain are installed into ~/.zinc (about 1.5 GB). Users do not run this:
# `zinc flash --target esp32` and `zinc run --target esp32 --qemu` use the image that is committed. Run it after changing src/dev, src/rt, src/vm,
# src/zbc or the firmware, and commit the new image.
# tools/build-esp32-core mquickjs: the same for the MicroQuickJS firmware of --engine mquickjs (firmware/esp32-mquickjs, its image
# prebuilt/zinc-mquickjs-flash.bin); run it after changing that firmware or third_party/mquickjs.
set -e
case "$1" in
  mquickjs) dir=esp32-mquickjs image=zinc-mquickjs-flash.bin ;;
  *) dir=esp32 image=esp32-core-flash.bin ;;
esac
cd "$(dirname "$0")/../firmware/$dir"
export IDF_TOOLS_PATH="$HOME/.zinc/esp-tools"
IDF="$HOME/.zinc/esp-idf"
if [ ! -d "$IDF" ]; then
  git clone --depth 1 -b v5.5.5 --recurse-submodules --shallow-submodules -j8 https://github.com/espressif/esp-idf "$IDF"
  (cd "$IDF" && ./install.sh esp32)
fi
. "$IDF/export.sh" >/dev/null
[ -f sdkconfig ] || idf.py set-target esp32
gen=; command -v ninja >/dev/null || gen="Unix Makefiles"   # ESP-IDF's tools carry no ninja on every machine
cores=$(sysctl -n hw.physicalcpu 2>/dev/null || nproc 2>/dev/null || echo 4)
export MAKEFLAGS="-j$cores -l$cores"   # as tools/build: no new job while the load average is above the core count (make reads it, idf.py -G make too)
idf() { if [ -n "$gen" ]; then nice -n 5 idf.py -G "$gen" "$@"; else nice -n 5 idf.py "$@"; fi; }
idf build
mkdir -p prebuilt
(cd build && esptool.py --chip esp32 merge_bin -o "../prebuilt/$image" @flash_args)   # offset 0, the used part only
echo "image: $(wc -c < "prebuilt/$image") bytes, sha256 $(shasum -a 256 "prebuilt/$image" | cut -d' ' -f1)"
if [ "$1" = mquickjs ]; then   # the emulator's build, its panel on SPI (esp32sim's T-Display board): zinc run --emulator
  idf -B build-sim -DZN_PANEL=spi build
  (cd build-sim && esptool.py --chip esp32 merge_bin -o ../prebuilt/zinc-mquickjs-sim-flash.bin @flash_args)
  echo "emulator image: $(wc -c < prebuilt/zinc-mquickjs-sim-flash.bin) bytes"
fi
