diff --color -ruN a/API/napi/zn_embed.cpp b/API/napi/zn_embed.cpp
--- a/API/napi/zn_embed.cpp	1970-01-01 01:00:00
+++ b/API/napi/zn_embed.cpp	2026-10-21 17:52:37
@@ -0,0 +1,169 @@
+// Zinc's entry points into Hermes (zinc's tools/hermes-patches/zinc-embed.patch): what an embedder of the Node-API needs that hermes_napi.h
+// gives only through the VM's C++ headers (a Runtime, its job queue, an optimised compile, bytecode for a file, a Static Hermes unit).
+// Compiled into hermesNapi, so libhermesvm exports them beside napi_*, and the embedder builds against the Node-API headers alone. The
+// Runtime itself and the Chrome DevTools agent are API/hermes/zn_cdp.cpp's (they need the JSI side of Hermes).
+#include "hermes_napi_internal.h"
+
+#include "hermes/BCGen/HBC/BCProvider.h"
+#include "hermes/BCGen/HBC/BytecodeStream.h"
+#include "hermes/BCGen/HBC/HBC.h"
+#include "hermes/Public/RuntimeConfig.h"
+#include "hermes/Support/Buffer.h"
+#include "hermes/VM/TwineChar16.h"
+#include "hermes/VM/static_h.h"
+
+#include "llvh/Support/SHA1.h"
+#include "llvh/Support/raw_ostream.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <memory>
+
+using namespace hermes;
+using namespace hermes::vm;
+
+extern "C" void *zn_hermes_make_runtime(bool jit);   // zn_cdp.cpp
+
+namespace {
+bool gDebug = false;   // zn_hermes_set_debug
+}
+
+extern "C" {
+
+/// A Runtime (microtask queue, block scoping, async generators, the JIT when \p jit and built with it) and its Node-API environment. One per
+/// process: it lives to the exit. The Runtime is a HermesRuntime's, so the Chrome DevTools agent of zn_cdp.cpp can attach to it.
+NAPI_EXTERN napi_env NAPI_CDECL zn_hermes_create(bool jit) {
+  return hermes_napi_create_env(zn_hermes_make_runtime(jit));
+}
+
+/// The scripts zn_hermes_run compiles from now on carry the full debug info (scopes and variables for a debugger) and async break checks
+/// (the debugger's requests heard while JavaScript runs).
+NAPI_EXTERN void NAPI_CDECL zn_hermes_set_debug(bool on) {
+  gDebug = on;
+}
+
+/// Run the jobs (promise reactions) queued so far; an exception becomes the env's pending one.
+NAPI_EXTERN napi_status NAPI_CDECL zn_hermes_drain(napi_env env) {
+  NAPI_PREAMBLE(env);
+  if (env->runtime.drainJobs() == ExecutionStatus::EXCEPTION)
+    return captureRuntimeException(env, napi_pending_exception);
+  return napi_clear_last_error(env);
+}
+
+static hbc::CompileFlags flags(bool optimize) {
+  hbc::CompileFlags f;
+  f.format = Execute;
+  f.includeLibHermes = false;
+  f.enableGenerator = true;
+  f.enableES6BlockScoping = true;
+  f.enableAsyncGenerators = true;
+  f.lazy = !optimize;
+  f.debug = gDebug;
+  f.emitAsyncBreakCheck = gDebug;
+  return f;
+}
+
+/// hermes_run_script with a name and a choice: \p optimize compiles eagerly through the full optimisation pipeline (what hermesc -O does),
+/// otherwise lazily (each function compiled at its first call: the fast start of a big bundle).
+NAPI_EXTERN napi_status NAPI_CDECL zn_hermes_run(
+    napi_env env,
+    const char *src,
+    size_t size,
+    const char *url,
+    bool optimize,
+    napi_value *result) {
+  NAPI_PREAMBLE(env);
+  auto bc = hbc::createBCProviderFromSrc(
+      std::make_unique<StdStringBuffer>(std::string(src, size)),
+      url ? url : "",
+      "",
+      flags(optimize),
+      "global",
+      nullptr,
+      nullptr,
+      optimize ? std::function<void(Module &)>(hbc::fullOptimizationPipeline)
+               : std::function<void(Module &)>());
+  if (!bc.first) {
+    (void)env->runtime.raiseSyntaxError(TwineChar16(bc.second));
+    return captureRuntimeException(env, napi_pending_exception);
+  }
+  auto res = env->runtime.runBytecode(
+      std::move(bc.first),
+      RuntimeModuleFlags{},
+      url ? url : "",
+      Runtime::makeNullHandle<Environment>());
+  if (res == ExecutionStatus::EXCEPTION)
+    return captureRuntimeException(env, napi_pending_exception);
+  *result = env->addToCurrentScope(*res);
+  return napi_clear_last_error(env);
+}
+
+/// \p src compiled to a file of Hermes bytecode (what hermesc -emit-binary writes, -O with \p optimize), without a Runtime: *\p out (malloc'd,
+/// the caller frees it) runs through hermes_run_bytecode. \p url names the script in its stack traces. False with *\p error (malloc'd) when
+/// the source does not compile.
+NAPI_EXTERN bool NAPI_CDECL zn_hermes_compile(
+    const char *src,
+    size_t size,
+    const char *url,
+    bool optimize,
+    uint8_t **out,
+    size_t *outSize,
+    char **error) {
+  hbc::CompileFlags f = flags(optimize);
+  f.format = EmitBundle;
+  f.lazy = false;
+  f.debug = false;
+  f.emitAsyncBreakCheck = false;
+  auto bc = hbc::createBCProviderFromSrc(
+      std::make_unique<StdStringBuffer>(std::string(src, size)),
+      url ? url : "",
+      "",
+      f,
+      "global",
+      nullptr,
+      nullptr,
+      optimize ? std::function<void(Module &)>(hbc::fullOptimizationPipeline)
+               : std::function<void(Module &)>());
+  if (!bc.first) {
+    *error = strdup(bc.second.c_str());
+    return false;
+  }
+  std::string bytes;
+  llvh::raw_string_ostream os(bytes);
+  BytecodeGenerationOptions opts(EmitBundle);
+  opts.optimizationEnabled = optimize;
+  hbc::serializeBytecodeModule(
+      *bc.first->getBytecodeModule(),
+      llvh::SHA1::hash(llvh::makeArrayRef(
+          reinterpret_cast<const uint8_t *>(src), size)),
+      os,
+      opts);
+  os.flush();
+  *out = static_cast<uint8_t *>(malloc(bytes.size()));
+  if (!*out) {
+    *error = strdup("out of memory");
+    return false;
+  }
+  std::memcpy(*out, bytes.data(), bytes.size());
+  *outSize = bytes.size();
+  return true;
+}
+
+/// Run a unit compiled by shermes (-c, -export-unit=<name>: \p creator is its sh_export_<name>) in this env's Runtime: native code in place of
+/// the bundle's source, the same globals and Node-API.
+NAPI_EXTERN napi_status NAPI_CDECL zn_hermes_run_unit(
+    napi_env env,
+    SHUnit *(*creator)(void),
+    napi_value *result) {
+  NAPI_PREAMBLE(env);
+  SHLegacyValue r;
+  if (!_sh_unit_init_guarded(&env->runtime, creator, &r)) {
+    (void)env->runtime.setThrownValue(HermesValue::fromRaw(r.raw));
+    return captureRuntimeException(env, napi_pending_exception);
+  }
+  *result = env->addToCurrentScope(HermesValue::fromRaw(r.raw));
+  return napi_clear_last_error(env);
+}
+
+} // extern "C"
