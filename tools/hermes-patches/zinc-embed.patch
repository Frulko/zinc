diff --color -ruN a/API/hermes/zn_cdp.cpp b/API/hermes/zn_cdp.cpp
--- a/API/hermes/zn_cdp.cpp	1970-01-01 01:00:00
+++ b/API/hermes/zn_cdp.cpp	2026-10-21 18:07:12
@@ -0,0 +1,143 @@
+// Zinc's entry points into Hermes's runtime and its Chrome DevTools agent (zinc's tools/hermes-patches/zinc-embed.patch): the Runtime of
+// zn_hermes_create made as a HermesRuntime, so the CDP agent of API/hermes/cdp (CDPDebugAPI, CDPAgent) attaches to it, and C calls for an
+// embedder that has its own transport (zinc's src/dbg/ws.cpp) and builds against the Node-API headers alone. Built with HERMES_ENABLE_DEBUGGER;
+// without it zn_hermes_cdp_start says false.
+#include "hermes.h"
+
+#ifdef HERMES_ENABLE_DEBUGGER
+#include <hermes/cdp/CDPAgent.h>
+#include <hermes/cdp/CDPDebugAPI.h>
+#endif
+
+#include <chrono>
+#include <deque>
+#include <memory>
+#include <mutex>
+
+#define ZN_EXPORT extern "C" __attribute__((visibility("default")))
+
+using namespace facebook;
+using namespace facebook::hermes;
+
+namespace {
+HermesRuntime *gRt = nullptr;   // the process's runtime, left to the process exit as zinc leaves its engines
+#ifdef HERMES_ENABLE_DEBUGGER
+// left to the process exit with the runtime, never destroyed: their destructors at exit, after the runtime's last use, crashed
+cdp::CDPDebugAPI *gApi = nullptr;
+std::mutex gAgentMu, gTaskMu;
+auto &gAgent = *new std::unique_ptr<cdp::CDPAgent>;     // the client's; one at a time, as src/dbg/ws.cpp serves one
+auto &gTasks = *new std::deque<debugger::RuntimeTask>;  // the agent's work for the JavaScript thread, run by zn_hermes_cdp_run
+void (*gSend)(const char *, size_t) = nullptr;
+void (*gWake)() = nullptr;
+#endif
+} // namespace
+
+/// The Runtime of zn_hermes_create (zn_embed.cpp): a HermesRuntime with a microtask queue, block scoping, async generators and the JIT when
+/// \p jit (and built with it); its VM runtime, for hermes_napi_create_env.
+ZN_EXPORT void *zn_hermes_make_runtime(bool jit) {
+  gRt = makeHermesRuntime(::hermes::vm::RuntimeConfig::Builder()
+                              .withMicrotaskQueue(true)
+                              .withES6BlockScoping(true)
+                              .withEnableAsyncGenerators(true)
+                              .withEnableJIT(jit)
+                              .build())
+            .release();
+  return gRt->getVMRuntimeUnsafe();
+}
+
+/// Starts the CDP debug API on the runtime: \p send gets each message for the client (from any thread), \p wake is called (from any thread)
+/// when work waits for zn_hermes_cdp_run on the JavaScript thread. Defines __zn_cdp_console(type, ...args), which shows a console call in
+/// DevTools' Console. False when Hermes was built without its debugger.
+ZN_EXPORT bool zn_hermes_cdp_start(void (*send)(const char *, size_t), void (*wake)()) {
+#ifdef HERMES_ENABLE_DEBUGGER
+  gSend = send;
+  gWake = wake;
+  gApi = cdp::CDPDebugAPI::create(*gRt).release();
+  auto name = jsi::PropNameID::forAscii(*gRt, "__zn_cdp_console");
+  gRt->global().setProperty(
+      *gRt,
+      name,
+      jsi::Function::createFromHostFunction(
+          *gRt,
+          name,
+          1,
+          [](jsi::Runtime &rt, const jsi::Value &, const jsi::Value *a, size_t n) {
+            const std::string t = n && a[0].isString() ? a[0].getString(rt).utf8(rt) : "log";
+            const cdp::ConsoleAPIType type = t == "error" ? cdp::ConsoleAPIType::kError
+                : t == "warn"                             ? cdp::ConsoleAPIType::kWarning
+                : t == "info"                             ? cdp::ConsoleAPIType::kInfo
+                : t == "debug"                            ? cdp::ConsoleAPIType::kDebug
+                : t == "dir"                              ? cdp::ConsoleAPIType::kDir
+                : t == "table"                            ? cdp::ConsoleAPIType::kTable
+                : t == "trace"                            ? cdp::ConsoleAPIType::kTrace
+                                                          : cdp::ConsoleAPIType::kLog;
+            std::vector<jsi::Value> args;
+            for (size_t i = 1; i < n; ++i)
+              args.emplace_back(rt, a[i]);
+            const double ms = std::chrono::duration<double, std::milli>(
+                                  std::chrono::system_clock::now().time_since_epoch())
+                                  .count();
+            gApi->addConsoleMessage({ms, type, std::move(args), gRt->getDebugger().captureStackTrace()});
+            return jsi::Value::undefined();
+          }));
+  return true;
+#else
+  (void)send;
+  (void)wake;
+  return false;
+#endif
+}
+
+/// A message of the client (from any thread): the agent is made at the first one; \p size 0 means the client went (its agent ends, a pause
+/// ends with it).
+ZN_EXPORT void zn_hermes_cdp_message(const char *json, size_t size) {
+#ifdef HERMES_ENABLE_DEBUGGER
+  std::lock_guard<std::mutex> lock(gAgentMu);
+  if (!size) {
+    gAgent.reset();
+    return;
+  }
+  if (!gAgent)
+    gAgent = cdp::CDPAgent::create(
+        1,
+        *gApi,
+        [](debugger::RuntimeTask task) {
+          {
+            std::lock_guard<std::mutex> l(gTaskMu);
+            gTasks.push_back(std::move(task));
+          }
+          gWake();
+        },
+        [](const std::string &m) { gSend(m.data(), m.size()); });
+  gAgent->handleCommand(std::string(json, size));
+#else
+  (void)json;
+  (void)size;
+#endif
+}
+
+/// The agent's work queued for the JavaScript thread, run now (on that thread). While the program runs or is paused, the debugger also runs
+/// it at its own checks; each task runs once.
+ZN_EXPORT void zn_hermes_cdp_run() {
+#ifdef HERMES_ENABLE_DEBUGGER
+  for (;;) {
+    debugger::RuntimeTask task;
+    {
+      std::lock_guard<std::mutex> l(gTaskMu);
+      if (gTasks.empty())
+        return;
+      task = std::move(gTasks.front());
+      gTasks.pop_front();
+    }
+    task(*gRt);
+  }
+#endif
+}
+
+/// Pause at the next statement the program runs, as DevTools' pause button does (--inspect-brk, on the JavaScript thread).
+ZN_EXPORT void zn_hermes_cdp_pause() {
+#ifdef HERMES_ENABLE_DEBUGGER
+  if (gApi)
+    gApi->debuggerDomainCoordinator().pause();
+#endif
+}
