#!/usr/bin/env python3
"""Bundle the shared scene validator with the Blender extension (no third-party deps)."""
from pathlib import Path
import sys
import zipfile

root = Path(__file__).resolve().parents[1]
destination = Path(sys.argv[1] if len(sys.argv) > 1 else '/tmp/zinc-scene.zip')
with zipfile.ZipFile(destination, 'w', zipfile.ZIP_DEFLATED) as archive:
    for name in ('__init__.py', 'blender_manifest.toml'):
        archive.write(root / 'integrations/blender/zinc_scene' / name, name)
    archive.write(root / 'tools/scene_exchange/__init__.py', 'scene_exchange/__init__.py')
print(destination)
