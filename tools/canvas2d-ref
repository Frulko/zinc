#!/usr/bin/env python3
"""canvas2d-ref: what headless Chrome draws and measures for the Canvas 2D tests of the web environment (ZN-570), with the bundled Inter loaded.

  tools/canvas2d-ref [WIDTH HEIGHT]     tests/golden/webenv/canvas2d/scene.js: writes scene-chrome.png (the scene, default 640 x 480) and
                                        chrome.json (the metrics) beside it, for tests/t1/webenv_canvas2d.sh
  tools/canvas2d-ref libs [NAME...]     the library pages of canvas2d/libs (pixi, phaser, phasercanvas, p5: the same scripts, the unmodified libraries):
                                        writes libs/NAME-chrome.png, 320 x 240, for tests/t1/webenv_canvas2d_libs.sh
  tools/canvas2d-ref out NAME...        a script that prints lines from an array named out (modes): writes NAME-chrome.out, the lines
                                        Chrome gives, for tests/t1/webenv_canvas2d_full.sh
Needs Google Chrome. Run it again only when a script changes: the references are in the repository.
"""
import base64, json, os, subprocess, sys, tempfile, time
HERE = os.path.dirname(os.path.abspath(__file__)); NEXT = os.path.dirname(HERE); DIR = os.path.join(NEXT, "tests", "golden", "webenv", "canvas2d")
sys.path.insert(0, HERE)
from cdp import Chrome

FONTS = os.path.join(NEXT, "lib", "fonts")
def font(name): return base64.b64encode(open(os.path.join(FONTS, name), "rb").read()).decode()

def scene(w, h):
    js = """(async () => {
  for (const [file, weight] of [[%s, '400'], [%s, '700']]) { const f = new FontFace('ZInter', 'url(data:font/ttf;base64,' + file + ')', { weight }); await f.load(); document.fonts.add(f); }
  %s
  const c = document.createElement('canvas'); c.width = %d; c.height = %d;
  scene(c.getContext('2d'), c.width, c.height, 'ZInter');
  const m = document.createElement('canvas'); m.width = 256; m.height = 80;
  return [c.toDataURL('image/png').split(',')[1], JSON.stringify(metrics(m.getContext('2d', { willReadFrequently: true }), 'ZInter'))];
})()""" % (json.dumps(font("Inter-Regular.ttf")), json.dumps(font("Inter-Bold.ttf")), open(os.path.join(DIR, "scene.js")).read(), w, h)
    with Chrome() as c:
        r = c.eval(js)
        if not r: sys.exit("canvas2d-ref: Chrome gave no answer")
        open(os.path.join(DIR, "scene-chrome.png"), "wb").write(base64.b64decode(r[0]))
        open(os.path.join(DIR, "chrome.json"), "w").write(json.dumps(json.loads(r[1]), indent=1) + "\n")
        print("canvas2d-ref: scene-chrome.png %d x %d, chrome.json %d entries" % (w, h, len(json.loads(r[1]))))

# A page per library: the fonts first (a library measures its text when it makes it), then the library and the script of the test
def libs(names):
    third = os.path.join(NEXT, "third_party")
    def p5(): return subprocess.run([os.path.join(HERE, "test-lib"), "p5-1.11.13"], capture_output=True, text=True, check=True).stdout.strip()
    url = lambda path: json.dumps("file://" + path)
    mine = lambda name: url(os.path.join(DIR, "libs", name))
    load = {"pixi": lambda: "window.PIXI = await import(%s); await script(%s);" % (url(os.path.join(third, "pixi", "pixi-8.22.0.min.mjs")), mine("pixi-text.js")),
            "phaser": lambda: "await script(%s); await script(%s);" % (url(os.path.join(third, "phaser", "phaser-3.90.0.min.js")), mine("phaser-text.js")),
            "phasercanvas": lambda: "await script(%s); await script(%s);" % (url(os.path.join(third, "phaser", "phaser-3.90.0.min.js")), mine("phaser-canvas.js")),
            "p5": lambda: "await script(%s); await script(%s);" % (mine("p5-sketch.js"), url(p5()))}   # p5 starts the sketch it finds when it arrives
    with tempfile.TemporaryDirectory() as tmp, Chrome(args=["--allow-file-access-from-files", "--window-size=320,240"]) as c:
        c.call("Emulation.setDeviceMetricsOverride", {"width": 320, "height": 240, "deviceScaleFactor": 1, "mobile": False})
        for name in names:
            html = """<!doctype html><html><head><style>
@font-face { font-family: ZInter; font-weight: 400; src: url(%s); } @font-face { font-family: ZInter; font-weight: 700; src: url(%s); }
html, body { margin: 0; background: #000; overflow: hidden; } canvas { display: block; }</style></head><body><script type="module">
window.FAMILY = 'ZInter';
const script = src => new Promise((ok, bad) => { const s = document.createElement('script'); s.src = src; s.onload = ok; s.onerror = bad; document.head.appendChild(s); });
await document.fonts.load('16px ZInter'); await document.fonts.load('bold 16px ZInter');
%s
window.READY = true;
</script></body></html>""" % (json.dumps("file://" + os.path.join(FONTS, "Inter-Regular.ttf")), json.dumps("file://" + os.path.join(FONTS, "Inter-Bold.ttf")), load[name]())
            page = os.path.join(tmp, name + ".html"); open(page, "w").write(html)
            c.open("file://" + page)
            for _ in range(100):
                time.sleep(0.1)
                if c.eval("window.READY === true && !!document.querySelector('canvas')"): break
            else: sys.exit("canvas2d-ref: %s did not start in Chrome" % name)
            time.sleep(1.5)   # a few frames: the library has drawn
            shot = c.call("Page.captureScreenshot", {"format": "png", "clip": {"x": 0, "y": 0, "width": 320, "height": 240, "scale": 1}})
            open(os.path.join(DIR, "libs", name + "-chrome.png"), "wb").write(base64.b64decode(shot["data"]))
            print("canvas2d-ref: libs/%s-chrome.png" % name)

def out(names):
    with Chrome() as c:
        for name in names:
            r = c.eval("(() => {\n%s\nreturn out.join('\\n'); })()" % open(os.path.join(DIR, name + ".js")).read())
            if not r: sys.exit("canvas2d-ref: Chrome gave no answer for %s" % name)
            open(os.path.join(DIR, name + "-chrome.out"), "w").write(r + "\n")
            print("canvas2d-ref: %s-chrome.out %d lines" % (name, len(r.split("\n"))))

if len(sys.argv) > 2 and sys.argv[1] == "out": out(sys.argv[2:])
elif len(sys.argv) > 1 and sys.argv[1] == "libs": libs(sys.argv[2:] or ["pixi", "phaser", "phasercanvas", "p5"])
else: scene(*((int(sys.argv[1]), int(sys.argv[2])) if len(sys.argv) > 2 else (640, 480)))
