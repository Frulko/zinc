#!/usr/bin/env python3
"""Generate the lazy picker catalog from pinned Unicode 17.0 test data; --check verifies it."""
import hashlib
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SOURCE = ROOT / 'third_party/unicode-emoji-17/emoji-test.txt'
OUTPUT = ROOT / 'lib/std/kit/picker-emoji.ts'
SHA256 = '1d8a944f88d7952f7ef7c5167fef3c67995bcae24543949710231b03a201acda'
TONES = set(range(0x1F3FB, 0x1F400))
source = SOURCE.read_bytes()
if hashlib.sha256(source).hexdigest() != SHA256:
    sys.exit('Unicode emoji source differs from the pinned SHA-256')
entries, groups, qualified = [], [], []
group = ''
for line in source.decode().splitlines():
    if line.startswith('# group: '):
        group = line.split(': ', 1)[1]
    match = re.match(r'([0-9A-F ]+);\s*fully-qualified\s*#\s*\S+\s+E[\d.]+\s+(.*)', line)
    if match is None or group == 'Component':
        continue
    sequence = tuple(int(point, 16) for point in match[1].split())
    qualified.append(sequence)
    if any(point in TONES for point in sequence):
        continue
    if group not in groups:
        groups.append(group)
    entries.append((sequence, match[2], groups.index(group)))

# Use only fully-qualified variants actually listed by Unicode, including compound ZWJ sequences.
def base(sequence):
    return tuple(point for point in sequence if point not in TONES and point != 0xFE0F)

variants = {}
for sequence in qualified:
    tones = {point for point in sequence if point in TONES}
    if len(tones) == 1:
        variants.setdefault(base(sequence), {})[next(iter(tones))] = sequence

rows, toned = [], 0
for sequence, name, group_index in entries:
    choices = variants.get(base(sequence), {})
    tones = [choices[tone] for tone in sorted(TONES)] if TONES <= choices.keys() else []
    toned += bool(tones)
    glyph = ''.join(map(chr, sequence))
    glyphs = ','.join(''.join(map(chr, variant)) for variant in tones)
    if any(mark in name for mark in ('|', '`', '${', '\n')):
        sys.exit('emoji name needs escaping')
    rows.append(f'{glyph}|{name}|{group_index}|{glyphs}')
assert len(rows) == 1914 and len(groups) == 9 and toned == 330, (len(rows), len(groups), toned)
assert all(len(row.split('|')) == 4 for row in rows)
text = '''// Generated by tools/gen-picker-emoji; Unicode 17.0, 1914 bases, nine groups, 330 tone sets.
// Source SHA-256: ''' + SHA256 + '''. License: third_party/unicode-emoji-17/LICENSE.txt.
export interface EmojiEntry { emoji: string; name: string; group: string; tone?: boolean; tones?: string[] }

/** Decodes data only when an EmojiPicker needs its default catalog. */
export function emojiCatalog(): EmojiEntry[] {
  const groups = ''' + repr(groups).replace('"', '\\"') + ''';
  const rows = `''' + '\n'.join(rows) + '''`.split('\\n');
  const items: EmojiEntry[] = [];
  for (const row of rows) {
    const fields = row.split('|');
    if (fields[3] === '') items.push({ emoji: fields[0], name: fields[1], group: groups[Number(fields[2])] });
    else items.push({ emoji: fields[0], name: fields[1], group: groups[Number(fields[2])], tones: fields[3].split(',') });
  }
  return items;
}
'''
if sys.argv[1:] == ['--check']:
    if OUTPUT.read_text() != text:
        sys.exit('picker-emoji.ts is stale; run tools/gen-picker-emoji')
elif sys.argv[1:]:
    sys.exit('usage: tools/gen-picker-emoji [--check]')
else:
    OUTPUT.write_text(text)
print(f'emoji catalog: {len(rows)} entries, {len(groups)} groups, {toned} tone sets')
