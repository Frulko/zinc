#!/bin/sh
# usage: tools/fuzz <parse|check|zbc|native|zpk|all> [seconds=60] [-- extra libFuzzer flags]
# Builds (if needed) the sanitized libFuzzer targets of tests/fuzz in build-fuzz with Homebrew's clang (or Apple's and tools/libfuzzer), seeds a corpus from tests/golden and the checker's programs, and runs the
# target for `seconds`. New corpus entries stay in build-fuzz/corpus/<target>; a crash leaves tests/fuzz/crashes/<target>-<hash> (promote it to a regression fixture, docs/reports/zinc-next-fuzzing.md).
cd "$(dirname "$0")/.." || exit 2
target=${1:-all}; secs=${2:-60}; [ $# -gt 2 ] && { shift 2; [ "$1" = "--" ] && shift; extra="$*"; }
LLVM=${LLVM:-$(brew --prefix llvm 2>/dev/null)}
link=
if [ -x "$LLVM/bin/clang++" ]; then cc="$LLVM/bin/clang"; cxx="$LLVM/bin/clang++"; libfuzzer=
  # Homebrew's clang is newer than the Xcode of a CI runner, whose ld refuses its objects ("invalid r_symbolnum"): LLVM's archiver and,
  # when installed (brew install lld), LLVM's linker
  link="-DCMAKE_AR=$LLVM/bin/llvm-ar -DCMAKE_RANLIB=$LLVM/bin/llvm-ranlib"
  lld=$(brew --prefix lld 2>/dev/null)/bin/ld64.lld
  [ -x "$lld" ] && link="$link -DCMAKE_EXE_LINKER_FLAGS=--ld-path=$lld -DCMAKE_SHARED_LINKER_FLAGS=--ld-path=$lld"
elif [ "$(uname)" = Darwin ]; then cc=clang; cxx=clang++; libfuzzer=$(tools/libfuzzer) || exit 2   # Apple's clang and a libFuzzer built from compiler-rt
else echo "tools/fuzz: needs a clang with libFuzzer (brew install llvm, or set LLVM=<prefix>)"; exit 2
fi
if [ ! -f build-fuzz/CMakeCache.txt ]; then
  cmake -S . -B build-fuzz -DCMAKE_C_COMPILER="$cc" -DCMAKE_CXX_COMPILER="$cxx" -DZN_LIBFUZZER="$libfuzzer" -DZN_SANITIZE=ON -DZN_FUZZ=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo $link >/dev/null || exit 2
fi
list=$target; [ "$target" = all ] && list="parse check zbc native zpk"
BUILD_DIR="$PWD/build-fuzz" tools/build $(for t in $list; do printf 'fuzz_%s ' $t; done) >/dev/null || { echo "tools/fuzz: the fuzz targets do not build"; exit 2; }
seed() {   # $1 target: fills build-fuzz/corpus/$1
  d=build-fuzz/corpus/$1; mkdir -p "$d"
  case $1 in
    parse|check)
      for f in tests/golden/run/*.ts tests/golden/checker/ok/*.ts tests/golden/checker/errors/*.ts tests/golden/unsupported/*.ts tests/conformance/*.ts; do [ -f "$f" ] && [ "$(wc -c < "$f")" -lt 30000 ] && cp "$f" "$d/$(echo "$f" | tr '/' '_')"; done ;;
    zbc)
      for f in tests/compat/*.zbc; do cp "$f" "$d/"; done
      for f in tests/golden/run/*.ts; do ./build/zinc --emit=zbc-bin "$f" "$d/$(basename "$f" .ts).zbc" 2>/dev/null; done ;;
    zpk)
      ./build/zpk_test seeds "$d" ;;
    native)
      printf 'i>i\\n12345678' > "$d/scalar"; printf 'siB>s\\nabcdefgh12345678' > "$d/mixed"; printf 'c(is>n)s>P(s)\\nxx' > "$d/callback"; printf 'SIDU>D\\n' > "$d/arrays" ;;
  esac
}
mkdir -p tests/fuzz/crashes
rc=0
for t in $list; do
  seed $t
  echo "== fuzz_$t ($secs s)"
  build-fuzz/fuzz_$t -max_total_time=$secs -rss_limit_mb=4096 -timeout=20 -artifact_prefix=tests/fuzz/crashes/$t- $extra build-fuzz/corpus/$t >build-fuzz/log-$t.txt 2>&1
  tail -4 build-fuzz/log-$t.txt
  # a crash: the sanitizer's report and the first frames of its stack (the tail alone shows only the shadow-memory legend), and the input in text
  if ls tests/fuzz/crashes/$t-* >/dev/null 2>&1; then
    grep -m1 -A16 "ERROR: \(Address\|Undefined\|Leak\)Sanitizer\|runtime error:" build-fuzz/log-$t.txt | cut -c1-220
    for c in tests/fuzz/crashes/$t-*; do echo "input $c ($(wc -c < "$c") bytes):"; head -c 400 "$c"; echo; done
  fi
  ls tests/fuzz/crashes/$t-* >/dev/null 2>&1 && { echo "CRASH: $(ls tests/fuzz/crashes/$t-*)"; rc=1; }
done
exit $rc
