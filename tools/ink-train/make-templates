#!/usr/bin/env python3
"""Built-in templates of zinc:ink (ZN-932): a few examples per class from the train writers of the dataset, written as
plugins/ink/templates.ts (a JSON string the plugin parses once). The held-out writers never contribute.

  tools/ink-train/make-templates [--set FILE] [--out FILE] [--per N]     (N examples per class and train writer, default 2)
"""
import argparse, json, os

here = os.path.dirname(os.path.abspath(__file__))
ap = argparse.ArgumentParser()
ap.add_argument('--set', default=os.path.join(here, 'data', 'ink-set.json'))
ap.add_argument('--out', default=os.path.join(here, '..', '..', 'plugins', 'ink', 'templates.ts'))
ap.add_argument('--per', type=int, default=2)
a = ap.parse_args()
d = json.load(open(a.set))
train = [w['id'] for w in d['writers'] if w['split'] == 'train']
SKIP = {'scribble'}   # the reject class has no template: a score below the threshold rejects
taken = {}
out = []
for s in d['samples']:
    if s['w'] not in train or s['c'] in SKIP:
        continue
    k = (s['w'], s['c'])
    if taken.get(k, 0) >= a.per:
        continue
    taken[k] = taken.get(k, 0) + 1
    out.append([s['c'], s['s']])
text = json.dumps(out, separators=(',', ':'))
with open(a.out, 'w') as f:
    f.write('// Generated by tools/ink-train/make-templates from tools/ink-train/data/ink-set.json (train writers only); do not edit.\n')
    f.write("// [label, strokes] pairs; strokes are flat x, y integer arrays. CC0, synthetic (see the set's licence).\n")
    f.write('export const TEMPLATES: string = ' + json.dumps(text) + ';\n')
print('%s: %d templates, %d bytes' % (a.out, len(out), len(text)))
