#!/usr/bin/env python3
"""The headers and libraries of a Linux target, for cross builds from this machine (docs/targets/linux.md).

  tools/linux-sysroot [--arch aarch64|armhf|x86_64|x86]...   fetch the packages of src/tc/linux-sysroot.lock into $ZINC_HOME/sysroots/<arch>-linux
  tools/linux-sysroot --lock                                 write the lock again from the Debian snapshot named below (a maintainer's step)

zig brings the C library; SDL3's X11 and KMS/DRM backends, display-gl, zinc:midi and zinc:ffi also need the headers of X11, DRM, GBM, EGL,
GLES, ALSA and libffi, and the libraries' files to read their sonames from (SDL3 loads them with dlopen; nothing of them is linked into zinc).
They come from Debian bookworm's -dev packages, frozen on snapshot.debian.org at one date and pinned by SHA-256: a changed archive is refused.
GL/X11/libffi packages are MIT/X11 or similarly permissive; ALSA is LGPL-2.1 and Debian FFmpeg includes GPL/LGPL code.
Copyright files stay under usr/share/doc. Only shared target libraries are kept; none is a dependency of the Zinc core build. armv7 builds use the armhf sysroot (same libraries; armv7-linux is a link to it).
ZINC_SYSROOT_MIRROR replaces both addresses, deb.debian.org and the snapshot's (a directory with the same pool/ paths).
"""
import argparse, fcntl, hashlib, io, lzma, os, shutil, subprocess, sys, tarfile, tempfile, time, urllib.error, urllib.request

SNAPSHOT = "20261001T000000Z"
SUITE = "bookworm"
DEBIAN = {"aarch64": "arm64", "armhf": "armhf", "x86_64": "amd64", "x86": "i386"}
PACKAGES = [
    # X11, for SDL3's X11 backend (the libraries for their sonames)
    "x11proto-dev", "libx11-dev", "libx11-6", "libxext-dev", "libxext6", "libxcursor-dev", "libxcursor1", "libxi-dev", "libxi6",
    "libxfixes-dev", "libxfixes3", "libxrandr-dev", "libxrandr2", "libxrender-dev", "libxrender1", "libxss-dev", "libxss1",
    "libxtst-dev", "libxtst6", "libxkbcommon-dev", "libxkbcommon0",
    # KMS/DRM and GL: SDL3's kmsdrm backend, display-gl
    "libdrm-dev", "libdrm2", "libgbm-dev", "libgbm1", "libegl-dev", "libegl1", "libgles-dev", "libgles2", "libgl-dev", "libgl1",
    "libglvnd-dev", "libglvnd0", "libglx-dev", "libglx0", "libgles1", "libopengl0",
    # zinc:midi (ALSA), zinc:ffi
    "libasound2-dev", "libasound2", "libffi-dev", "libffi8",
    # zinc:video: shared FFmpeg libraries, never static archives or core build dependencies
    "libavformat-dev", "libavformat59", "libavcodec-dev", "libavcodec59", "libavutil-dev", "libavutil57", "libswscale-dev", "libswscale6", "libswresample-dev", "libswresample4",
]
here = os.path.dirname(os.path.abspath(__file__))
LOCK = os.path.join(here, "..", "src", "tc", "linux-sysroot.lock")


def base():
    return os.environ.get("ZINC_SYSROOT_MIRROR", f"https://snapshot.debian.org/archive/debian/{SNAPSHOT}").rstrip("/")


def fetch(url):
    for attempt in range(5):   # snapshot.debian.org answers 503 now and then ("All backends failed or unhealthy"): try again, then give up
        try:
            with urllib.request.urlopen(url, timeout=120) as r:
                return r.read()
        except (urllib.error.URLError, TimeoutError) as e:
            if attempt == 4 or (isinstance(e, urllib.error.HTTPError) and e.code < 500): raise
            time.sleep(10 * (attempt + 1))


def package(path):
    """A locked .deb: Debian's mirror first, the snapshot (every version, but down for hours) once a point release has dropped it. The caller checks its SHA-256."""
    if "ZINC_SYSROOT_MIRROR" not in os.environ:
        try:
            return fetch(f"https://deb.debian.org/debian/{path}")
        except urllib.error.URLError:
            pass
    return fetch(f"{base()}/{path}")


def write_lock():
    lines = [f"# tools/linux-sysroot --lock: Debian {SUITE} at snapshot {SNAPSHOT}. arch package version pool-path sha256"]
    for arch, deb in DEBIAN.items():
        index = lzma.decompress(fetch(f"{base()}/dists/{SUITE}/main/binary-{deb}/Packages.xz")).decode()
        found = {}
        for stanza in index.split("\n\n"):
            f = dict(l.split(": ", 1) for l in stanza.splitlines() if ": " in l and not l.startswith(" "))
            if f.get("Package") in PACKAGES: found[f["Package"]] = f
        missing = [p for p in PACKAGES if p not in found]
        if missing: sys.exit(f"linux-sysroot: {SUITE}/{deb} has no {', '.join(missing)}")
        for p in PACKAGES:
            f = found[p]
            lines.append(f"{arch} {p} {f['Version']} {f['Filename']} {f['SHA256']}")
    open(LOCK, "w").write("\n".join(lines) + "\n")
    print(f"linux-sysroot: {LOCK}: {len(lines) - 1} packages")


def data_tar(deb):
    """The data.tar.* member of a .deb (an ar archive)."""
    if deb[:8] != b"!<arch>\n": raise ValueError("not a .deb")
    at = 8
    while at < len(deb):
        name, size = deb[at:at + 16].decode().strip().rstrip("/"), int(deb[at + 48:at + 58])
        if name.startswith("data.tar"):
            body = deb[at + 60:at + 60 + size]
            if name.endswith(".zst"):   # Python has no zstd before 3.14: the zstd command
                body = subprocess.run(["zstd", "-dc"], input=body, capture_output=True, check=True).stdout
            return tarfile.open(fileobj=io.BytesIO(body))
        at += 60 + size + (size & 1)
    raise ValueError("no data.tar in the .deb")


def identity(arch):
    return hashlib.sha256((hashlib.sha256(open(LOCK, "rb").read()).hexdigest() + arch + "v2").encode()).hexdigest()


def ready(root, want):
    try:
        with open(os.path.join(root, ".zinc-sysroot")) as f:
            header = f.readline().strip()
            files = [p.strip() for p in f]
            return header == "zinc-sysroot 2 " + want and bool(files) and all(p and not os.path.isabs(p) and ".." not in p.split("/") and os.path.lexists(os.path.join(root, p)) for p in files)
    except OSError:
        return False


def extract(deb, dest):
    with data_tar(deb) as t:
        members = []
        for m in t.getmembers():
            if not (m.isfile() or m.issym() or m.isdir()) or m.name.endswith(".a"):
                continue
            name = m.name.removeprefix("./")
            if name in ("", "."):
                continue
            if os.path.isabs(name) or ".." in name.split("/"):
                raise ValueError("unsafe path " + m.name)
            if name != "usr" and not name.startswith("usr/"):
                continue
            if m.issym() and m.linkname.startswith("/"):
                if not m.linkname.startswith("/usr/"):
                    raise ValueError("unsafe link " + m.linkname)
                m.linkname = os.path.relpath(m.linkname.lstrip("/"), os.path.dirname(name))
            members.append(m)
        for m in members:
            # macOS ships Python without extraction filters: check each path after preceding links were created.
            boundary = os.path.realpath(dest)
            path = os.path.realpath(os.path.join(dest, m.name))
            targets = [path]
            if m.issym():
                targets.append(os.path.realpath(os.path.join(os.path.realpath(os.path.dirname(os.path.join(dest, m.name))), m.linkname)))
            if any(os.path.commonpath([boundary, p]) != boundary for p in targets):
                raise ValueError("archive path or link escapes the sysroot: " + m.name)
            if hasattr(tarfile, "data_filter"):
                t.extract(m, dest, filter="data")
            else:
                t.extract(m, dest, set_attrs=False)


def install(arch, home):
    parent = os.path.join(home, "sysroots")
    os.makedirs(parent, exist_ok=True)
    root = os.path.join(parent, f"{arch}-linux")
    rows = [l.split() for l in open(LOCK) if l.strip() and not l.startswith("#")]
    rows = [r for r in rows if r[0] == arch]
    if not rows:
        raise ValueError(f"no package for {arch} in {LOCK}")
    want = identity(arch)
    previous = root + ".previous"
    with open(os.path.join(parent, f".{arch}.lock"), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not ready(root, want):
            tmp = tempfile.mkdtemp(prefix=f".{arch}-linux-", dir=parent)
            try:
                # Keep manually added libraries and old generations; only the managed link is replaced.
                source = root if os.path.exists(root) else previous
                if os.path.exists(source):
                    shutil.copytree(source, tmp, symlinks=True, dirs_exist_ok=True)
                for _, pkg, version, path, sha in rows:
                    deb = package(path)
                    got = hashlib.sha256(deb).hexdigest()
                    if got != sha:
                        raise ValueError(f"{pkg} {version}: SHA-256 {got}, the lock says {sha}: refused")
                    extract(deb, tmp)
                    print(f"  {pkg} {version}", flush=True)
                files = sorted(os.path.relpath(os.path.join(d, n), tmp) for d, dirs, names in os.walk(tmp)
                               for n in names + [n for n in dirs if os.path.islink(os.path.join(d, n))]
                               if n != ".zinc-sysroot")
                with open(os.path.join(tmp, ".zinc-sysroot"), "w") as receipt:
                    receipt.write("zinc-sysroot 2 " + want + "\n" + "\n".join(files) + "\n")
                link = tmp + ".link"
                os.symlink(os.path.basename(tmp), link)
                if os.path.lexists(root) and not os.path.islink(root):
                    if os.path.lexists(previous):
                        raise ValueError("previous root already retained at " + previous)
                    os.rename(root, previous)
                os.replace(link, root)
                tmp = ""
            finally:
                if tmp:
                    if os.path.lexists(tmp + ".link"):
                        os.unlink(tmp + ".link")
                    shutil.rmtree(tmp)
        if arch == "armhf":
            link = os.path.join(parent, "armv7-linux")
            if not os.path.lexists(link):
                os.symlink("armhf-linux", link)
    print(f"linux-sysroot: {root} (ready)")


def main():
    ap = argparse.ArgumentParser(usage=__doc__)
    ap.add_argument("--arch", action="append", choices=sorted(DEBIAN))
    ap.add_argument("--lock", action="store_true")
    a = ap.parse_args()
    if a.lock: return write_lock()
    home = os.environ.get("ZINC_HOME") or os.path.join(os.path.expanduser("~"), ".zinc")
    for arch in a.arch or ["aarch64"]: install(arch, home)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, tarfile.TarError) as e:
        sys.exit(f"linux-sysroot: {e}")
