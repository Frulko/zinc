#!/bin/sh
# Four kernels, five runs; --baseline-zinc measures a fixed reference build on this runner.
# Without it, compare the historic QuickJS ratios. Exit 3 for >15% slower, 1 for incorrect output.
cd "$(dirname "$0")/.." || exit 2
if [ -n "$ZINC_BENCH_BASELINE" ]; then set -- --baseline-zinc "$ZINC_BENCH_BASELINE" "$@"; fi
gate() { tools/bench-m4 --runs 5 --kernels fib,nbody,sort,strings --no-startup --md none --out /tmp/zn-bench-gate.json --baseline bench/m4.json --relative --check-regressions "$@" > /tmp/zn-bench-gate.txt; }
gate "$@"; rc=$?
# a slowdown is measured twice before it fails: one run on a shared runner can be 20% slow on a 15 ms kernel (fib aot 15 -> 18 ms, v0.4.0)
if [ $rc -eq 3 ]; then grep -E "^- " /tmp/zn-bench-gate.txt | sed 's/^/first run: /'; gate "$@"; rc=$?; fi
grep -E "^- |Regressions" /tmp/zn-bench-gate.txt
exit $rc
