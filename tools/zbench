# ---------------------------------------------------------------- parsing the engine's lines
def finished(text, env):
    """A launch is over when its numbers are out: the last scene of a sequence prints ZB_DONE, a single scene prints its profile."""
    if "ZB_ERROR" in text: return True
    if "ZB_PER" not in env: return "zinc profile json" in text
    # ZB_DONE is on stdout, which a webOS card does not log; the engine's closing summary of the whole process (a profile line without a section) is on stderr everywhere
    # (after the last section the engine has no frames left, so it prints no closing summary: the end is the last scene's section)
    want = env.get("ZB_SCENE", "")
    n = len(SUITES["render"]["scenes"]) if want == "all" else len(want.split(","))
    return "ZB_DONE" in text or len(re.findall(r'zinc profile json: .*"section":', text)) >= n


def parse_sections(text):
    """A sequence launch: one run record per scene. From the app's report file (a JSON document it wrote itself), else from the profile lines of a log that carry a section name."""
    out = {}
    if text.lstrip().startswith("{"):
        try: d = json.loads(text)
        except ValueError: d = None
        if d and d.get("schema") == "zbench-report/1":
            m = re.match(r"(\d+)x(\d+)", d.get("surface", ""))
            for p in d["sections"]:
                r = {"profile": p, "frame_hash": p.get("frame_hash"), "hash_size": p.get("hash_size"), "scene": p["section"], "size": p["window"]}
                if m: r["drawn"] = [int(m.group(1)), int(m.group(2))]
                out[p["section"]] = r
            return out
    d = re.search(r"ZB_SEQUENCE .* per=\d+ (\d+)x(\d+)", text)
    for m in re.finditer(r"zinc profile json: (\{.*\})\s*$", text, re.M):
        try: p = json.loads(m.group(1))
        except ValueError: continue
        if "section" not in p: continue
        w, h = p["window"]
        out[p["section"]] = {"profile": p, "frame_hash": p.get("frame_hash"), "hash_size": p.get("hash_size"), "scene": p["section"], "size": [w, h]}
        if d: out[p["section"]]["drawn"] = [int(d.group(1)), int(d.group(2))]
    return out


def parse_run(text):
    """The profile JSON, the frame hash and the scene line out of what a run printed (stdout and stderr, or a device log)."""
    out = {}
    m = re.search(r"zinc profile json: (\{.*\})\s*$", text, re.M)
    if m:
        try: out["profile"] = json.loads(m.group(1))
        except ValueError: pass
    m = re.search(r"framehash (\d+) (\d+x\d+) ([0-9a-f]+)", text)
    if m: out["frame_hash"] = m.group(3); out["hash_frame"] = int(m.group(1)); out["hash_size"] = m.group(2)
    m = re.search(r"ZB_SCENE (\w+) (\d+)x(\d+)", text)
    if m: out["scene"] = m.group(1); out["size"] = [int(m.group(2)), int(m.group(3))]
    v = re.findall(r"ZB_VIDEO (.*?) frames=(\d+) dropped=(\d+) position=([\d.]+)", text)
    if v: out["video"] = {"decoder": v[-1][0], "frames": int(v[-1][1]), "dropped": int(v[-1][2]), "position_s": float(v[-1][3])}
    if "ZB_ERROR" in text: out["error"] = re.search(r"ZB_ERROR (.*)", text).group(1).strip()
    return out


# ---------------------------------------------------------------- devices
class Device:
    label = "device"
    def report_path(self): return None          # where the app writes its report (ZB_OUT)
    def fetch_report(self): return ""            # the report file's text, with the device's own file transfer ("" when there is none yet)
    def wait_report(self, env, timeout, alive=None):
        """The app writes /where/it/is, a section at a time (render_suite/src/report.ts); this fetches it until it says done, the app is gone, or the time is up.
        A partial report is returned as it is: what was measured is kept."""
        t0, last = time.time(), ""
        while time.time() - t0 < timeout:
            time.sleep(3)
            txt = self.fetch_report()
            try: d = json.loads(txt)
            except ValueError: d = None
            if d and d.get("run") == env.get("ZB_RUN"):
                last = txt
                if d.get("done"): return txt
            if alive and not alive():
                txt = self.fetch_report()   # the app has quit: one last read, it may have written its end just before
                return txt or last
        return last or "ZB_TIMEOUT"
    def info(self): return {}
    def prepare(self, suite, args): pass
    def launch(self, env, timeout): raise NotImplementedError
    def cleanup(self): pass


class Mac(Device):
    label = "mac"
    def info(self):
        g = lambda c: sh(c).stdout.strip()
        gpu = re.findall(r"Chipset Model: (.*)", g("system_profiler SPDisplaysDataType 2>/dev/null"))
        return {"model": g("sysctl -n hw.model"), "cpu": g("sysctl -n machdep.cpu.brand_string"), "cores": g("sysctl -n hw.ncpu"), "os": "macOS " + platform.mac_ver()[0],
                "gpu": gpu, "thermal": g("pmset -g therm | tr '\\n' ' '"), "power": g("pmset -g batt | head -1"), "load": g("uptime").split("load averages:")[-1].strip()}
    def prepare(self, suite, args):
        self.exe = "/tmp/zbench_%s" % suite["name"]
        if not args["no_build"]:
            r = sh([ZINC, "build", suite["project"], "-o", self.exe], timeout=1800, env=dict(os.environ, ZINC_STEPS="0", ZINC_BACKGROUND="1"))
            if r.returncode: sys.exit("zbench: build failed:\n" + (r.stdout + r.stderr)[-1500:])
        self.size = args["size"]
    def report_path(self): return "/tmp/zbench_report_mac.json"
    def fetch_report(self):
        try: return open(self.report_path()).read()
        except OSError: return ""
    def launch(self, env, timeout):
        e = dict(os.environ, ZINC_BACKGROUND="1", ZINC_STEPS="0", ZINC_SIZE=self.size)
        e.update(env)
        if "ZB_OUT" in env:
            try: os.remove(env["ZB_OUT"])
            except OSError: pass
            p = subprocess.Popen([self.exe], env=e, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            txt = self.wait_report(env, timeout, alive=lambda: p.poll() is None)
            try: os.killpg(p.pid, signal.SIGKILL)
            except OSError: pass
            return txt
        p = subprocess.Popen([self.exe], env=e, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
        try: out = p.communicate(timeout=timeout)[0]
        except subprocess.TimeoutExpired:
            os.killpg(p.pid, signal.SIGKILL); out = p.communicate()[0] or ""; out += "\nZB_TIMEOUT"
        return out
    def cleanup(self):
        try: os.remove(self.exe)
        except OSError: pass


class Android(Device):
    label = "android"
    def __init__(self):
        out = sh("adb devices -l").stdout.splitlines()[1:]
        devs = [l.split()[0] for l in out if l.strip() and "device" in l.split()[1:2]]
        if len(devs) > 1 and not os.environ.get("ANDROID_SERIAL"):   # adb refuses every command then; waiting on a launch that never happened looks like a hang
            sys.exit("zbench: several adb devices, set ANDROID_SERIAL to the tablet's serial:\n" + "\n".join(l for l in out if l.strip()))
    def _adb(self, *a, timeout=120): return sh(["adb"] + list(a), timeout=timeout)
    def info(self):
        p = lambda k: self._adb("shell", "getprop", k).stdout.strip()
        cat = lambda path: self._adb("shell", "cat " + path + " 2>/dev/null").stdout.strip()
        cpus = {}
        for c in range(8):
            f = cat("/sys/devices/system/cpu/cpu%d/cpufreq/scaling_cur_freq" % c)
            if f: cpus["cpu%d" % c] = {"khz": f, "governor": cat("/sys/devices/system/cpu/cpu%d/cpufreq/scaling_governor" % c)}
        temps = {}
        for z in self._adb("shell", "ls /sys/class/thermal 2>/dev/null").stdout.split():
            if z.startswith("thermal_zone"): temps[z] = cat("/sys/class/thermal/%s/temp" % z)
        batt = {k: v for k, v in re.findall(r"^\s*(level|status|temperature|AC powered|USB powered): (.*)$", self._adb("shell", "dumpsys battery").stdout, re.M)}
        return {"model": p("ro.product.model"), "device": p("ro.product.device"), "os": "Android %s (API %s)" % (p("ro.build.version.release"), p("ro.build.version.sdk")), "abi": p("ro.product.cpu.abi"),
                "hardware": p("ro.hardware"), "cpus": cpus, "thermal": temps, "battery": batt, "screen": self._adb("shell", "wm size").stdout.strip(),
                "refresh": (re.findall(r"fps=([\d.]+)", self._adb("shell", "dumpsys display").stdout) or [""])[0]}
    def prepare(self, suite, args):
        d = sh("adb devices").stdout.split("\n")[1:]
        d = [l.split()[0] for l in d if l.strip().endswith("device")]
        ser = os.environ.get("ANDROID_SERIAL")
        if ser and ser not in d: sys.exit("zbench: ANDROID_SERIAL=%s is not an adb device now (found: %s)" % (ser, ", ".join(d)))
        if not ser and len(d) != 1: sys.exit("zbench: need exactly one adb device, found %d" % len(d))
        abi = self._adb("shell", "getprop", "ro.product.cpu.abi").stdout.strip()
        self.pkg = suite["app_id"]; self.act = "." + suite["app_id"].rsplit(".", 1)[1].capitalize() + "Activity"
        dist = os.path.join(REPO, "dist", suite["name"] + "-android")
        if not args["no_build"]:
            r = sh([ZINC, "export", suite["project"], "--target", "android", "-o", dist], timeout=900, env=dict(os.environ, ZINC_STEPS="0"))
            if r.returncode: sys.exit("zbench: export failed:\n" + (r.stdout + r.stderr)[-1500:])
            jdk = os.environ.get("ZINC_ANDROID_JDK", "/Applications/Android Studio.app/Contents/jbr/Contents/Home")
            r = sh(["./gradlew", "assembleDebug", "-Pzinc.abis=" + abi], cwd=dist, timeout=3600, env=dict(os.environ, JAVA_HOME=jdk))
            if r.returncode: sys.exit("zbench: gradle failed:\n" + (r.stdout + r.stderr)[-2500:])
        r = self._adb("install", "-r", os.path.join(dist, "app/build/outputs/apk/debug/app-debug.apk"), timeout=300)
        if "Success" not in r.stdout: sys.exit("zbench: install failed: " + r.stdout + r.stderr)
    def report_path(self): return "/data/data/%s/zb_report.json" % self.pkg   # the debug APK's own data directory: adb run-as reads it
    def fetch_report(self): return self._adb("shell", "run-as", self.pkg, "cat", "zb_report.json").stdout
    def launch(self, env, timeout):
        self._adb("shell", "am", "force-stop", self.pkg); self._adb("logcat", "-G", "16M"); self._adb("logcat", "-c")   # a 19-scene launch prints 50 KB of profiles among the system chatter: the default 256 KB ring loses the first scenes
        self._adb("shell", "am", "start", "-n", self.pkg + "/" + self.act, "--es", "zinc.env", "'" + " ".join("%s=%s" % kv for kv in env.items()) + "'")   # the device's shell splits on spaces: the inner quotes keep it one value
        if "ZB_OUT" in env:
            txt = self.wait_report(env, timeout, alive=lambda: self._adb("shell", "pidof", self.pkg).stdout.strip() != "")
            self._adb("shell", "am", "force-stop", self.pkg)
            return txt
        t0, text = time.time(), ""
        while time.time() - t0 < timeout:
            time.sleep(1.5)
            text = self._adb("logcat", "-d", "-s", "*:I").stdout
            if finished(text, env): break
        else: text += "\nZB_TIMEOUT"
        self._adb("shell", "am", "force-stop", self.pkg)
        return text
    def cleanup(self): self._adb("shell", "am", "force-stop", self.pkg)


class WebOS(Device):
    label = "webos"
    def report_path(self): return "/tmp/zinc/zb_report.json"
    def fetch_report(self): return self._run("cat /tmp/zinc/zb_report.json 2>/dev/null", 30)
    def _run(self, script, timeout=120):
        return subprocess.run(["novacom", "run", "file://bin/sh"], input=script.encode(), capture_output=True, timeout=timeout).stdout.decode(errors="replace")
    def info(self):
        s = self._run("uname -a; grep -m1 Processor /proc/cpuinfo; for c in /sys/devices/system/cpu/cpu*/cpufreq; do echo $c $(cat $c/scaling_governor) $(cat $c/scaling_cur_freq); done; free -m | sed -n 2p; cat /sys/class/power_supply/*/capacity 2>/dev/null | head -1")
        return {"model": "HP TouchPad", "os": "webOS 3.0.0", "raw": s.strip()}
    def prepare(self, suite, args):
        if not sh("novacom -l").stdout.strip(): sys.exit("zbench: no webOS device on novacom")
        self.id = "org.zinc.bench"; self.dir = "/media/cryptofs/apps/usr/palm/applications/" + self.id; self.name = suite["name"]
        exe = "/tmp/zbench_%s_webos" % self.name
        if not args["no_build"]:
            r = sh([ZINC, "build", "--target", "armv7-webos", suite["project"], "-o", exe], timeout=1800, env=dict(os.environ, ZINC_DISPLAY="", ZINC_NATIVE="real", ZINC_STEPS="0"))
            if r.returncode: sys.exit("zbench: webos build failed:\n" + (r.stdout + r.stderr)[-1500:])
        appinfo = json.dumps({"title": "Zinc bench", "type": "pdk", "main": self.name, "id": self.id, "version": "1.0.0", "vendor": "Zinc", "requiredMemory": 64})
        self._run("mkdir -p %s && chmod 777 %s; killall %s 2>/dev/null; true" % (self.dir, self.dir, self.name))
        subprocess.run(["novacom", "put", "file://%s/appinfo.json" % self.dir], input=appinfo.encode(), capture_output=True, check=True)
        with open(exe, "rb") as f: subprocess.run(["novacom", "put", "file://%s/%s" % (self.dir, self.name)], stdin=f, capture_output=True, check=True)
        self._run("chmod 755 %s/%s; luna-send -n 1 palm://com.palm.applicationManager/rescan '{}' < /dev/null > /dev/null 2>&1" % (self.dir, self.name))
        try: os.remove(exe)
        except OSError: pass
    def launch(self, env, timeout):
        envf = "\\n".join("%s=%s" % kv for kv in env.items())
        self._run("killall %s 2>/dev/null; mkdir -p /tmp/zinc; rm -f /tmp/zinc/log-*; printf '%s\\n' > /tmp/zinc/env" % (self.name, envf))
        self._run("luna-send -n 1 palm://com.palm.applicationManager/launch '{\"id\":\"%s\"}' < /dev/null > /dev/null 2>&1" % self.id)
        if "ZB_OUT" in env:
            txt = self.wait_report(env, timeout)
            self._run("killall %s 2>/dev/null; rm -f /tmp/zinc/env; true" % self.name)
            return txt
        t0, text = time.time(), ""
        while time.time() - t0 < timeout:
            time.sleep(2)
            text = self._run("cat /tmp/zinc/log-* 2>/dev/null")
            if finished(text, env): break
        else: text += "\nZB_TIMEOUT"
        self._run("killall %s 2>/dev/null; rm -f /tmp/zinc/env; true" % self.name)
        return text
    def cleanup(self): self._run("killall %s 2>/dev/null; rm -f /tmp/zinc/env; true" % self.name)


class IOS(Device):
    label = "ios"
    def __init__(self, app_id):
        self.app_id = app_id; self.pm = os.environ.get("ZINC_PYMD3", "pymobiledevice3"); self.udid = os.environ.get("ZINC_IOS_UDID", "")
        self.ud = ["--udid", self.udid] if self.udid else []
    def info(self):
        s = sh([self.pm, "lockdown", "info"] + self.ud).stdout
        try: li = json.loads(s[s.index("{"):])
        except ValueError: return {}
        return {"model": li.get("ProductType"), "device_name": li.get("DeviceName"), "os": "iOS " + str(li.get("ProductVersion")), "build": li.get("BuildVersion"), "cpu_arch": li.get("CPUArchitecture")}
    def prepare(self, suite, args):
        team = os.environ.get("ZINC_IOS_TEAM") or sys.exit("zbench: set ZINC_IOS_TEAM")
        work = os.path.expanduser(os.path.join(os.environ.get("ZINC_HOME", "~/.zinc"), "cache", "zbench-ios")); os.makedirs(work, exist_ok=True)
        out = os.path.join(work, "out"); app = os.path.join(out, "build-device", "Release-iphoneos", suite["name"] + ".app")
        if not args["no_build"]:
            shutil.rmtree(os.path.join(work, "proj"), ignore_errors=True)
            shutil.copytree(suite["project"], os.path.join(work, "proj"), ignore=shutil.ignore_patterns("floor"))
            zj = os.path.join(work, "proj", "zinc.json"); txt = open(zj).read(); open(zj, "w").write(txt.replace(suite["app_id"], self.app_id))
            keep = os.path.join(out, "build-device")
            hold = keep + ".keep"
            if os.path.isdir(keep): shutil.rmtree(hold, ignore_errors=True); os.rename(keep, hold)   # zinc export rewrites the folder; the 4-minute configure is kept
            r = sh([ZINC, "export", os.path.join(work, "proj"), "--target", "ios", "-o", out], timeout=900, env=apple_env())
            if os.path.isdir(hold): shutil.rmtree(keep, ignore_errors=True); os.rename(hold, keep)
            if r.returncode: sys.exit("zbench: export failed:\n" + (r.stdout + r.stderr)[-1500:])
            if not os.path.isdir(os.path.join(keep, suite["name"] + ".xcodeproj")):   # a configure that failed leaves the folder without the project
                shutil.rmtree(keep, ignore_errors=True)
                r = sh(["cmake", "-S", out, "-B", keep, "-G", "Xcode", "-DCMAKE_SYSTEM_NAME=iOS", "-DZINC_TEAM=" + team], timeout=1800, env=apple_env())
                if r.returncode: sys.exit("zbench: cmake failed:\n" + (r.stdout + r.stderr)[-1500:])
            r = sh(["xcodebuild", "-quiet", "-project", os.path.join(keep, suite["name"] + ".xcodeproj"), "-scheme", suite["name"], "-configuration", "Release", "-sdk", "iphoneos",
                    "-derivedDataPath", os.path.join(keep, "dd"), "CODE_SIGN_STYLE=Automatic", "PROVISIONING_PROFILE_SPECIFIER=", "DEVELOPMENT_TEAM=" + team,
                    "CODE_SIGN_IDENTITY=Apple Development", "build"], timeout=3600, env=apple_env())
            found = glob.glob(os.path.join(keep, "**", "Release-iphoneos", "*.app"), recursive=True)
            if found: app = found[0]
            if r.returncode or not found: sys.exit("zbench: xcodebuild failed (an Xcode-managed profile for %s that lists the device is needed):\n" % self.app_id + (r.stdout + r.stderr)[-2000:])
        if not os.path.isdir(app):
            app = (glob.glob(os.path.join(out, "build-device", "**", "Release-iphoneos", "*.app"), recursive=True) or [app])[0]
        r = sh([self.pm, "apps", "install", app] + self.ud, timeout=600)
        if "Installation succeed" not in r.stdout + r.stderr: sys.exit("zbench: install failed:\n" + (r.stdout + r.stderr)[-1200:])
        self.work = work; self.proc = suite["name"]
    def report_path(self): return "~/Documents/zb_report.json"   # ~ is the app's home, which only the app knows; the tool reads it through the app container (house_arrest)
    def fetch_report(self):
        tmp = os.path.join(self.work, "zb_report.json")
        try: os.remove(tmp)
        except OSError: pass
        sh([self.pm, "apps", "pull", self.app_id, "/Documents/zb_report.json", tmp] + self.ud, timeout=60)
        try: return open(tmp).read()
        except OSError: return ""
    def launch(self, env, timeout):
        env = dict(env); env.setdefault("ZINC_RENDERER", "cpu")
        if "ZB_OUT" in env:
            sh([self.pm, "developer", "dvt", "launch", self.app_id, "--kill-existing"] + sum((["--env", "%s=%s" % kv] for kv in env.items()), []) + self.ud, timeout=120)
            return self.wait_report(env, timeout)   # "auto" makes the app quit at once on iOS (no GL there: found 2026-10-18, see render-bench-design.md)
        log = os.path.join(self.work, "syslog.txt")
        with open(log, "w") as lf: sl = subprocess.Popen([self.pm, "syslog", "live", "-pn", self.proc] + self.ud, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)   # the whole device log is 50k lines a minute and drops messages
        time.sleep(3)
        args = [self.pm, "developer", "dvt", "launch", self.app_id, "--kill-existing"] + self.ud
        for k, v in env.items(): args += ["--env", "%s=%s" % (k, v)]
        sh(args, timeout=120)
        t0, text = time.time(), ""
        while time.time() - t0 < timeout:
            time.sleep(2)
            text = open(log, errors="replace").read()
            if finished(text, env): break
        else: text += "\nZB_TIMEOUT"
        os.killpg(sl.pid, signal.SIGTERM)
        return text


class Pi(Device):
    """A Raspberry Pi on a KMS screen over ssh (tools/device does the export and the copy). The display modes are compile-time options of display-gl, so a mode is an
    export of its own: zb_720 (mode 1280x720), zb_1080 (mode 1920x1080); the 720p picture upscaled to 1080p is zb_1080 told to draw 1280x720 (ZINC_SIZE: the GPU scales it)."""
    label = "pi"
    VARIANTS = {"pi720": ("zb", "1280x720", None), "pi1080": ("zb", "1920x1080", None), "pi720up": ("zb", "1920x1080", "1280x720")}
    def __init__(self, host): self.host = host
    def report_path(self): return "/tmp/zb_report.json"
    def fetch_report(self): return self._ssh("cat /tmp/zb_report.json 2>/dev/null", 30)
    def _ssh(self, cmd, timeout=60):
        try: return subprocess.run(["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", self.host, cmd], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout).stdout
        except subprocess.TimeoutExpired: return ""
    def info(self):
        s = self._ssh("tr -d '\\0' </proc/device-tree/model; echo; uname -mr; vcgencmd measure_clock arm; vcgencmd measure_temp; vcgencmd get_throttled; free -m | sed -n 2p; for f in /sys/class/drm/card*-HDMI*/modes; do sort -u $f | head -1; done; cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor")
        return {"model": (s.splitlines() or ["Raspberry Pi"])[0].strip(), "os": "linux", "raw": s.strip()}
    def prepare(self, suite, args):
        work = os.path.expanduser(os.path.join(os.environ.get("ZINC_HOME", "~/.zinc"), "cache", "zbench-pi"))
        if not args["no_build"]:
            proj = os.path.join(work, "zb"); shutil.rmtree(proj, ignore_errors=True); shutil.copytree(suite["project"], proj, ignore=shutil.ignore_patterns("floor", "dist"))
            r = sh([os.path.join(HERE, "device"), self.host, "push", proj, "zb", "ZINC_DISPLAY=gl"], timeout=1800)
            if r.returncode: sys.exit("zbench: push failed:\n" + (r.stdout + r.stderr)[-1500:])
    def launch(self, env, timeout):
        env = dict(env); var = env.pop("ZB_PIVAR", "pi1080"); name, mode, size = self.VARIANTS[var]
        env["ZINC_GL_MODE"] = mode   # the screen's mode, chosen at run time (kms.cpp); a size smaller than the mode is drawn by the program and scaled by the GPU
        if size: env["ZINC_SIZE"] = size
        env.setdefault("ZINC_BACKGROUND", "1")
        assigns = " ".join("%s=%s" % (k, shlex.quote(str(v))) for k, v in env.items())
        self._ssh("for p in $(pgrep -u $USER); do case \"$(readlink /proc/$p/cwd 2>/dev/null)\" in \"$HOME\"/zn/*) kill $p;; esac; done; sleep 1; rm -f /tmp/zbench.log")
        self._ssh("cd ~/zn/%s && (env %s setsid nohup ./run.sh >/tmp/zbench.log 2>&1 </dev/null &); sleep 1" % (name, assigns))
        if "ZB_OUT" in env:
            txt = self.wait_report(env, timeout)
            self._ssh("for p in $(pgrep -u $USER); do case \"$(readlink /proc/$p/cwd 2>/dev/null)\" in \"$HOME\"/zn/%s) kill $p;; esac; done" % name)
            return txt
        t0, text = time.time(), ""
        while time.time() - t0 < timeout:
            time.sleep(3)
            text = self._ssh("cat /tmp/zbench.log", 30)
            if finished(text, env): break
        else: text += "\nZB_TIMEOUT"
        self._ssh("for p in $(pgrep -u $USER); do case \"$(readlink /proc/$p/cwd 2>/dev/null)\" in \"$HOME\"/zn/%s) kill $p;; esac; done" % name)
        return text


def device_of(name, args):
    if name == "mac": return Mac()
    if name == "android": return Android()
    if name == "webos": return WebOS()
    if name == "ios":
        if not args["app_id"]: sys.exit("zbench: ios needs --app-id <bundle id of an app already on the device>: that app is replaced")
        return IOS(args["app_id"])
    if name == "pi": return Pi(args["host"] or os.environ.get("ZINC_PI", "pi@192.168.2.107"))
    sys.exit("zbench: unknown device " + name)


# ---------------------------------------------------------------- statistics
def med(v): return statistics.median(v) if v else 0.0
def spread(v): return (max(v) - min(v)) / med(v) if v and med(v) else 0.0


def summarize(runs, mode):
    """One scene, its runs: median of the per-run medians (never a mean), the spread between runs, the late frames, the frame hashes."""
    good = [r for r in runs if "profile" in r]
    s = {"runs": len(runs), "ok_runs": len(good)}
    if not good: return s
    ph = lambda r, p, k: r["profile"]["phases"][p][k]
    s["work_p50_us"] = med([ph(r, "work", "p50") for r in good]); s["work_p99_us"] = med([ph(r, "work", "p99") for r in good])
    s["interval_p50_us"] = med([ph(r, "interval", "p50") for r in good]); s["interval_p99_us"] = med([ph(r, "interval", "p99") for r in good])
    s["raster_p50_us"] = med([ph(r, "raster", "p50") for r in good]); s["present_p50_us"] = med([ph(r, "present", "p50") for r in good])
    s["frames"] = int(med([r["profile"]["frames"] for r in good]))
    s["window"] = good[0]["profile"].get("window")
    s["drawn"] = sorted({tuple(r["drawn"]) for r in good if "drawn" in r}) and [list(x) for x in sorted({tuple(r["drawn"]) for r in good if "drawn" in r})]
    s["late_work_gt_16_7"] = int(med([r["profile"]["late"]["work_gt_16_7"] for r in good]))
    s["late_interval_gt_25"] = int(med([r["profile"]["late"]["interval_gt_25"] for r in good]))
    s["fps"] = round(1e6 / s["interval_p50_us"], 1) if s["interval_p50_us"] else 0
    s["spread"] = round(spread([ph(r, "interval", "p50") for r in good]), 4)
    s["vsync_locked"] = 14000 < s["interval_p50_us"] < 18000 and s["spread"] < 0.1 and s["work_p50_us"] < s["interval_p50_us"] * 0.9
    hs = sorted({r.get("frame_hash") for r in good if r.get("frame_hash")})
    s["frame_hashes"] = hs
    s["retried_runs"] = sum(1 for r in runs if "first_failure" in r)
    infos = [r["profile"].get("info", {}) for r in good]
    gpu = {}
    for k in sorted({k for i in infos for k in i}):
        vals = [i[k] for i in infos if k in i]
        try: gpu[k] = round(med([float(v) for v in vals]), 1)
        except ValueError: gpu[k] = vals[0]
    if gpu: s["gpu"] = gpu
    s["window"] = good[0]["profile"].get("window")
    vids = [r["video"] for r in good if "video" in r]
    if vids: s["video"] = {"decoder": vids[0]["decoder"], "frames_decoded": int(med([v["frames"] for v in vids])), "dropped": int(med([v["dropped"] for v in vids])), "dropped_max": max(v["dropped"] for v in vids)}
    return s


def problems(scenes, config):
    out = []
    for sid, s in scenes.items():
        if s.get("ok_runs", 0) < s.get("runs", 0): out.append({"scene": sid, "kind": "run_failed", "detail": "%d of %d runs produced no profile (a timeout on a Mac usually means the window was covered or the display asleep: macOS stops drawing it)" % (s["runs"] - s.get("ok_runs", 0), s["runs"])})
        if s.get("retried_runs"): out.append({"scene": sid, "kind": "flaky_launch", "detail": "%d run(s) printed no profile at the first attempt (timeout or crash), the retry worked: see raw[].first_failure" % s["retried_runs"]})
        if s.get("ok_runs", 0) == 0: continue
        if s.get("drawn") and s.get("window") and not sid.startswith("ui_") and any(d != s["window"] for d in s["drawn"]): out.append({"scene": sid, "kind": "surface_mismatch", "detail": "the scene drew in %s on a %s surface: it did not fill the screen" % (s["drawn"], s["window"])})
        if len(s.get("frame_hashes", [])) > 1: out.append({"scene": sid, "kind": "frame_hash_unstable", "detail": "the last frame differs between runs: " + ", ".join(s["frame_hashes"])})
        if s["frames"] < config["frames"] - config["skip"] - 2: out.append({"scene": sid, "kind": "frames_missing", "detail": "%d frames measured, %d asked" % (s["frames"], config["frames"] - config["skip"])})
        if s.get("video") and s["video"]["dropped_max"] > 0: out.append({"scene": sid, "kind": "video_dropped", "detail": "%d frames dropped by the player (%s, %d decoded)" % (s["video"]["dropped_max"], s["video"]["decoder"], s["video"]["frames_decoded"])})
        if s["spread"] > 0.10: out.append({"scene": sid, "kind": "noisy", "detail": "run-to-run spread %.0f%% of the median interval" % (s["spread"] * 100)})
        if s["vsync_locked"] and s["late_interval_gt_25"] > 0.02 * s["frames"]: out.append({"scene": sid, "kind": "stutter", "detail": "%d frames longer than 25 ms while paced" % s["late_interval_gt_25"]})
    return out


# ---------------------------------------------------------------- commands
def cmd_run(a):
    suite_name = a["suite"]
    if suite_name == "boundary":
        r = subprocess.run([os.path.join(HERE, "bench-bridge"), a["device_name"]] + (["--app-id", a["app_id"]] if a["app_id"] else []) + (["--no-build"] if a["no_build"] else []))
        sys.exit(r.returncode)
    suite = SUITES.get(suite_name) or sys.exit("zbench: unknown suite " + suite_name)
    if a["device_name"] not in suite["devices"]: sys.exit("zbench: the %s suite runs on %s only (no video backend on the others yet)" % (suite_name, ", ".join(suite["devices"])))
    scenes = a["scene"].split(",") if a["scene"] else suite["scenes"]
    extra = dict(kv.split("=", 1) for kv in a["set"].split(",") if "=" in kv)   # --set K=V,K=V: engine switches for every launch (ZINC_GL_CORNERS=0, ZINC_GL_OCCLUDE=0 ...), recorded in config
    if suite_name == "media":
        extra["ZB_VIDEO"] = "/tmp/zbench_video.mp4"
        r = sh(["ffmpeg", "-y", "-loglevel", "error", "-f", "lavfi", "-i", "testsrc2=size=1280x720:rate=30", "-t", "12", "-pix_fmt", "yuv420p", "-c:v", "libx264", "-preset", "veryfast", "-crf", "23", extra["ZB_VIDEO"]])
        if r.returncode: sys.exit("zbench: ffmpeg is needed to make the test clip: " + r.stderr[-300:])
    dev = device_of(a["device_name"], a)
    say("preparing %s (one app for %d scenes)" % (dev.label, len(scenes)))
    dev.prepare(suite, a)
    env_before = dev.info()
    pace = ["uncapped", "paced"] if a["mode"] == "both" else [a["mode"]]
    backends = ("pi720,pi1080,pi720up" if dev.label == "pi" and a["backend"] == "auto" else a["backend"]).split(",")
    modes = [m if b == "auto" else "%s/%s" % (m, b) for m in pace for b in backends]
    config = {"set": extra, "frames": a["frames"], "skip": a["skip"], "runs": a["runs"], "modes": modes, "size": a["size"] if dev.label == "mac" else "native"}
    results = {m: {s: [] for s in scenes} for m in modes}
    renv = {"auto": {}, "cpu": {"ZINC_RENDERER": "cpu"}, "gl": {"ZINC_RENDERER": "gl"}, "glfinish": {"ZINC_RENDERER": "gl", "ZINC_GL_TIMER": "finish"}, "gl_nooccl": {"ZINC_RENDERER": "gl", "ZINC_GL_OCCLUDE": "0"},
            "pi720": {"ZB_PIVAR": "pi720", "ZINC_RENDERER": "gl"}, "pi1080": {"ZB_PIVAR": "pi1080", "ZINC_RENDERER": "gl"}, "pi720up": {"ZB_PIVAR": "pi720up", "ZINC_RENDERER": "gl"}}
    timeout = 40 + a["frames"] * 0.15 if dev.label == "mac" else 45 + a["frames"] * 0.1 if dev.label == "ios" else max(120, a["frames"] * 0.5)   # a Mac window that is covered or on a sleeping display stops drawing: do not wait for it
    sequence = suite_name == "render" and not a["one_by_one"]
    for run in range(a["runs"]):
        if sequence:   # one launch for all the scenes: the program closes a profile section after each (zinc:gfx profSection) and prints ZB_DONE at the end
            for m in modes:
                todo, first, miss = list(scenes), {}, []
                for attempt in range(2):
                    env = {"ZB_SCENE": "all" if sorted(todo) == sorted(suite["scenes"]) else ",".join(todo), "ZB_PER": str(a["skip"] + a["frames"]), "ZINC_PROFILE": "json", "ZINC_PROFILE_SKIP": str(a["skip"]), "ZINC_GL_STATS": "1"}
                    if m.split("/")[0] == "uncapped": env["ZINC_VSYNC"] = "0"
                    env.update(renv[m.split("/")[1] if "/" in m else "auto"]); env.update(extra)
                    if dev.report_path():   # the app writes its own report file; no log is read (a log truncates, loses lines and does not say when it is over)
                        env["ZB_OUT"] = dev.report_path(); env["ZB_RUN"] = "%d-%d" % (time.time(), run)
                    say("run %d/%d  %d scenes in one launch  %s%s" % (run + 1, a["runs"], len(todo), m, "  (retry)" if attempt else ""))
                    text = dev.launch(env, max(120, len(todo) * (min((a["skip"] + a["frames"]) * 0.2, 12) + 10) + 90))   # a scene is closed after 12 s (ZB_MAXS) whatever its speed
                    got = parse_sections(text)
                    for sid, r in got.items():
                        if sid in todo:
                            if sid in first: r["first_failure"] = first[sid]
                            results[m][sid].append(r)
                    miss = [t for t in todo if t not in got]
                    if not miss: break
                    tail = text.strip().splitlines()[-6:]
                    for t in miss: first[t] = tail
                    todo = miss
                    say("no profile from %s; trying once more" % ", ".join(miss))
                for t in miss: results[m][t].append({"scene": t, "first_failure": first.get(t), "raw_tail": text.strip().splitlines()[-6:]})
            continue
        for sid in scenes:
            for m in modes:
                env = {"ZB_SCENE": sid, "ZINC_PROFILE": "json", "ZINC_PROFILE_SKIP": str(a["skip"]), "ZINC_FRAMES": str(a["frames"]), "ZINC_FRAMEHASH": "last", "ZINC_GL_STATS": "1"}
                if m.split("/")[0] == "uncapped": env["ZINC_VSYNC"] = "0"
                env.update(renv[m.split("/")[1] if "/" in m else "auto"]); env.update(extra)
                say("run %d/%d  %-15s %s" % (run + 1, a["runs"], sid, m))
                text = dev.launch(env, timeout)
                r = parse_run(text)
                if "profile" not in r:   # one more try, and the failure stays on record (a launch that sometimes hangs is a finding, not noise to hide)
                    first = text.strip().splitlines()[-6:]
                    say("no profile from %s; trying once more" % sid)
                    text = dev.launch(env, timeout)
                    r = parse_run(text)
                    r["first_failure"] = first
                    if "profile" not in r: r["raw_tail"] = text.strip().splitlines()[-6:]
                results[m][sid].append(r)
    env_after = dev.info()
    dev.cleanup()
    doc = {"schema": "zbench/1", "suite": suite_name, "date": datetime.datetime.now().isoformat(timespec="seconds"), "tool": git_state(), "device": {"id": dev.label, "before": env_before, "after": env_after},
           "config": config, "modes": {}}
    for m in modes:
        sc = {sid: summarize(results[m][sid], m) for sid in scenes}
        doc["modes"][m] = {"scenes": sc, "problems": problems(sc, config), "raw": results[m]}
    label = re.sub(r"[^A-Za-z0-9._-]+", "_", "%s-%s" % (dev.label, (env_before.get("model") or env_before.get("device_name") or "").strip()))
    os.makedirs(OUT, exist_ok=True)
    path = os.path.join(OUT, "zbench-%s-%s-%s%s.json" % (suite_name, label, datetime.date.today().isoformat(), "-" + a["tag"] if a["tag"] else ""))   # --tag: an experiment keeps its own artifact
    json.dump(doc, open(path, "w"), indent=1)
    say("wrote", path)
    show([path])


def load(path): return json.load(open(path))


def show(paths):
    docs = [load(p) for p in paths]
    for mode in sorted({m for d in docs for m in d.get("modes", {})}):
        print("\n== %s mode (ms): w = CPU work p50, p = present p50, gpu = GPU time per frame where the driver gives it | i = interval p50/p99, fps, L = frames over 16.7 ms of work, ± = run-to-run spread, V = vsync-locked, x = work ratio to the first column ==" % mode)
        cols = [d for d in docs if mode in d.get("modes", {})]
        names = [re.sub(r"^zbench-[a-z]+-", "", os.path.basename(p)).replace(".json", "")[:34] for p, d in zip(paths, docs) if mode in d.get("modes", {})]
        print("%-16s" % "scene" + "".join("%-46s" % n for n in names))
        scenes = list(cols[0]["modes"][mode]["scenes"])
        for sid in scenes:
            row = "%-16s" % sid
            base = cols[0]["modes"][mode]["scenes"].get(sid, {}).get("work_p50_us")
            for d in cols:
                s = d["modes"][mode]["scenes"].get(sid)
                if not s or "work_p50_us" not in s: row += "%-46s" % "-"; continue
                ratio = ("x%.1f" % (s["work_p50_us"] / base)) if base and s is not cols[0]["modes"][mode]["scenes"][sid] else ""
                g = s.get("gpu", {})
                gpu = (" gpu%.2f" % (g["gl_gpu_us"] / 1000)) if g.get("gl_gpu_us") else ""
                row += "%-46s" % ("w%.2f p%.2f%s | i%.1f/%.1f %3.0ffps L%d ±%.0f%% %s%s" % (s["work_p50_us"] / 1000, s["present_p50_us"] / 1000, gpu, s["interval_p50_us"] / 1000, s["interval_p99_us"] / 1000, s["fps"], s["late_work_gt_16_7"], s["spread"] * 100, "V" if s["vsync_locked"] else "", ratio))
            print(row)
        for d, n in zip(cols, names):
            pr = d["modes"][mode]["problems"]
            if pr:
                print("  problems on %s:" % n)
                for p in pr: print("    - %-15s %-20s %s" % (p["scene"], p["kind"], p["detail"]))
    for p, d in zip(paths, docs):
        gpu = {}
        for m in d["modes"].values():
            for s in m["scenes"].values(): gpu.update(s.get("gpu", {}))
        b = d["device"]["before"]
        print("\n%s: %s %s | %s | gpu %s | engine %s%s" % (os.path.basename(p), b.get("model"), b.get("os"), b.get("cpu") or b.get("hardware") or "", gpu.get("gl_renderer", "software raster (no GL strings reported)"), d["tool"]["rev"], "+dirty" if d["tool"]["dirty"] else ""))


def cmd_gate(a):
    base, new = load(a["files"][0]), load(a["files"][1])
    bad, prob = [], []
    for mode in new["modes"]:
        if mode not in base["modes"]: continue
        for sid, s in new["modes"][mode]["scenes"].items():
            b = base["modes"][mode]["scenes"].get(sid)
            if not b or "work_p50_us" not in s or "work_p50_us" not in b: continue
            floor = max(a["tolerance"], 2 * max(s["spread"], b["spread"]))
            for k in ("work_p50_us", "work_p99_us"):
                if b[k] > 50 and s[k] > b[k] * (1 + floor): bad.append((mode, sid, k, b[k], s[k], floor))
            if b.get("frame_hashes") and s.get("frame_hashes") and b["frame_hashes"] != s["frame_hashes"]: prob.append((mode, sid, "frame hash changed", b["frame_hashes"], s["frame_hashes"]))
        for p in new["modes"][mode]["problems"]:
            if p["kind"] in ("run_failed", "frame_hash_unstable", "frames_missing", "flaky_launch"): prob.append((mode, p["scene"], p["kind"], p["detail"], ""))
    for m, sid, k, b, n, f in bad: print("SLOWER  %-8s %-15s %-12s %9.0f -> %9.0f us  (+%.0f%%, allowed %.0f%%)" % (m, sid, k, b, n, (n / b - 1) * 100, f * 100))
    for x in prob: print("PROBLEM %-8s %-15s %s %s %s" % x)
    if not bad and not prob: print("ok: no scene is slower than its noise allows, no rendering problem")
    sys.exit(3 if bad else 4 if prob else 0)


def parse_args(argv):
    a = {"suite": "render", "scene": "", "runs": 3, "frames": 240, "skip": 30, "mode": "uncapped", "backend": "auto", "size": "1024x768", "no_build": False, "one_by_one": False, "set": "", "tag": "", "host": "", "app_id": "", "tolerance": 0.15, "files": [], "device_name": ""}
    cmd = argv[0] if argv else "-h"
    rest = argv[1:]
    if cmd == "run" and rest and not rest[0].startswith("--"): a["device_name"] = rest.pop(0)
    i = 0
    while i < len(rest):
        x = rest[i]
        if x in ("--suite", "--scene", "--mode", "--backend", "--size", "--app-id", "--host", "--set", "--tag"): a[x[2:].replace("-", "_")] = rest[i + 1]; i += 2
        elif x in ("--runs", "--frames", "--skip"): a[x[2:]] = int(rest[i + 1]); i += 2
        elif x == "--tolerance": a["tolerance"] = float(rest[i + 1]); i += 2
        elif x == "--no-build": a["no_build"] = True; i += 1
        elif x == "--one-by-one": a["one_by_one"] = True; i += 1   # one launch per scene (the old way: to isolate a scene that breaks the others)
        else: a["files"].append(x); i += 1
    return cmd, a


if __name__ == "__main__":
    cmd, a = parse_args(sys.argv[1:])
    if cmd in ("-h", "--help"): print(__doc__)
    elif cmd == "run":
        if not a["device_name"]: sys.exit("zbench run DEVICE ...")
        cmd_run(a)
    elif cmd == "show": show(a["files"])
    elif cmd == "gate": cmd_gate(a)
    elif cmd == "list": print(" ".join(SCENES))
    else: sys.exit("unknown command " + cmd)
