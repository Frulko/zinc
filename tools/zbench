NXT = os.path.dirname(HERE)
REPO = NXT
ZINC = os.environ.get("ZINC", os.path.join(NXT, "build", "zinc"))
OUT = os.path.join(REPO, "docs", "reports", "bench")
SCENES = ["fill_opaque", "fill_blend", "quads_10k", "rounded_shadow", "gradients", "text_static", "text_churn", "clip_nested", "poly", "scroll_list", "image_update", "image_fill_only", "image_upload_only", "damage_small",
          "ui_scroll_fling", "ui_scroll_wheel", "ui_anim_transform", "ui_anim_layout", "ui_list_update"]
SUITES = {
    "render": {"project": os.path.join(NXT, "tests", "bench", "render_suite"), "app_id": "dev.zinc.bench.rendersuite", "name": "render_suite", "scenes": SCENES, "devices": ["mac", "android", "webos", "ios", "pi"]},
    # video: zinc:video has a decoder on macOS (VideoToolbox / FFmpeg) and iOS (AVFoundation); none on Android or webOS yet. The clip is a test pattern made by ffmpeg (nothing committed).
    "media": {"project": os.path.join(NXT, "tests", "bench", "render_media"), "app_id": "dev.zinc.bench.rendermedia", "name": "render_media", "scenes": ["video_play"], "devices": ["mac"]},
}


def sh(cmd, timeout=600, **kw):
    try:
        return subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, timeout=timeout, **kw)
    except subprocess.TimeoutExpired as e:
        return subprocess.CompletedProcess(cmd, 124, (e.stdout or b"").decode() if isinstance(e.stdout, bytes) else (e.stdout or ""), "timeout")


def apple_env(extra=None):
    """The environment for cmake, xcodebuild and `zinc export --target ios`: /usr/bin/python3 (the Xcode shim) injects SDKROOT (the macOS SDK), CPATH and
    LIBRARY_PATH into its children, which makes CMake look for a macOS compiler when it is asked for iOS."""
    e = {k: v for k, v in os.environ.items() if k not in ("SDKROOT", "CPATH", "LIBRARY_PATH", "MACOSX_DEPLOYMENT_TARGET")}
    e["ZINC_STEPS"] = "0"
    if extra: e.update(extra)
    return e


def say(*a):
    print("zbench:", *a, file=sys.stderr, flush=True)


def git_state():
    r = sh(["git", "-C", REPO, "rev-parse", "--short", "HEAD"]).stdout.strip()
    d = sh(["git", "-C", REPO, "status", "--porcelain", "--", "src", "runtime", "plugins", "lib"]).stdout.strip()
