#!/usr/bin/env python3
"""Choose CI jobs from changed repository paths; full runs remain scheduled/release gates."""
import json
import sys


def plan(paths, full=False, quick=False):
    code = [p for p in paths if not (
        p.startswith(("docs/", "backlog/", "tests/compat/results/")) or p.endswith(".md"))]
    performance = ("src/", "include/", "third_party/", "CMakeLists.txt",
                   "bench/", "corpus/bench/", "tools/bench-", "tests/data/bench_harness.py",
                   "tests/t0/bench_harness.sh", "tests/t2/bench_gate.sh",
                   "runtime/", "lib/", "plugins/", "targets/")
    workflow = ".github/workflows/zinc-next.yml" in code
    result = {
        "test": full or bool(code),
        "full": full,
        "bench": full or workflow or any(p.startswith(performance) for p in code),
        "reproducible": full or workflow or any(p.startswith((
            "CMakeLists.txt", "src/tc/plugin_build", "tools/package",
            "tools/plugin-split")) for p in code),
        "package": full or workflow or any(p.startswith((
            "tools/package", "tools/sign-macos")) for p in code),
    }
    if quick and not full:
        result.update(bench=False, reproducible=False, package=False)
    return result


if __name__ == "__main__":
    result = plan([line.strip() for line in sys.stdin if line.strip()], "--full" in sys.argv, "--quick" in sys.argv)
    for key, value in result.items():
        print(f"{key}={json.dumps(value)}")
