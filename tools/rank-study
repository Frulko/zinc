#!/usr/bin/env python3
"""Offline order-rank study (ZN-173, spike S1 of docs/reports/ui-rendering-architecture.md): draw calls of painter-order batching vs GPUI-style ranks, from scene dumps.

usage: tools/rank-study [--out ../docs/reports/render-rank-study.md] [dump.scn ...]    (no dumps: renders the hero and navigation frames 3, 8 and 12 itself)
rank(p) = 1 + max rank of any earlier primitive whose bounds (clipped by the active clip) intersect p's; then primitives are sorted by (rank, kind, texture) and runs merged.
painter: consecutive primitives with the same (kind, texture) merge; painter+clip: a clip change also breaks the batch (a scissor state change).
"""
import sys, os, subprocess, tempfile, struct, time, importlib.machinery, importlib.util

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(root)
spec = importlib.util.spec_from_loader("pixel-compare", importlib.machinery.SourceFileLoader("pixel-compare", "tools/pixel-compare"))
pc = importlib.util.module_from_spec(spec); spec.loader.exec_module(pc)
CLEAR, RECT, BORDER, SHADOW, LINE, TEXT, IMAGE, POLY, CLIP, UNCLIP = range(10)
NAMES = ["clear", "rect", "border", "shadow", "line", "text", "image", "poly", "clip", "unclip"]

def bounds(c):
    kind, alpha, grad, pad, res, x, y, w, h, r, s, c1, c2, off, n = c
    if kind == LINE: return (min(x, w) - s, min(y, h) - s, max(x, w) + s, max(y, h) + s)
    if kind == SHADOW: return (x - s, y - s, x + w + s, y + h + s)
    return (x, y, x + w, y + h)

def inter(a, b): return (max(a[0], b[0]), max(a[1], b[1]), min(a[2], b[2]), min(a[3], b[3]))
def empty(a): return a[2] <= a[0] or a[3] <= a[1]

def study(cmds, W, H):
    """-> dict of counts. The tree is a uniform grid of 32 px cells: ponytail, an R-tree only matters for the CPU cost, which is measured in R2.1."""
    cell, gw = 32, (W + 31) // 32 + 1
    grid = {}
    clips = []
    prims = []   # (kind, texture, rank, clip depth id)
    clip_id = 0
    cur_clip = (0, 0, W, H)
    ranks = []
    for c in cmds:
        k = c[0]
        if k == CLIP:
            clips.append((cur_clip, clip_id)); cur_clip = inter(cur_clip, bounds(c)); clip_id += 1000; clip_id += 1; continue
        if k == UNCLIP:
            if clips: cur_clip, _ = clips.pop()
            clip_id += 1; continue
        b = inter(bounds(c), cur_clip)
        tex = c[4] if k in (TEXT, IMAGE) else 0
        if k == CLEAR or empty(b): continue
        x0, y0, x1, y1 = int(max(b[0], 0)) // cell, int(max(b[1], 0)) // cell, int(min(b[2], W)) // cell, int(min(b[3], H)) // cell
        r = 0
        seen = set()
        for gy in range(y0, y1 + 1):
            for gx in range(x0, x1 + 1):
                for i in grid.get((gx, gy), ()):
                    if i in seen: continue
                    seen.add(i)
                    q = prims[i][4]
                    if not empty(inter(q, b)) and prims[i][2] > r: r = prims[i][2]
        r += 1
        idx = len(prims)
        prims.append((k, tex, r, clip_id, b))
        for gy in range(y0, y1 + 1):
            for gx in range(x0, x1 + 1): grid.setdefault((gx, gy), []).append(idx)
    n = len(prims)
    def runs(seq):
        out, last = 0, None
        for key in seq:
            if key != last: out += 1; last = key
        return out
    painter = runs((p[0], p[1]) for p in prims)
    painter_clip = runs((p[0], p[1], p[3]) for p in prims)
    ordered = sorted(prims, key=lambda p: (p[2], p[0], p[1]))
    ranked = runs((p[2], p[0], p[1]) for p in ordered)
    return {"prims": n, "painter": painter, "painter_clip": painter_clip, "ranked": ranked, "ranks": max([p[2] for p in prims], default=0)}

args = sys.argv[1:]
out = "../docs/reports/render-rank-study.md"
if "--out" in args: i = args.index("--out"); out = args[i + 1]; del args[i:i + 2]
tmp = tempfile.mkdtemp()
zinc = os.environ.get("ZINC", os.path.join(root, "build/zinc"))
frames = [(os.path.basename(a), a) for a in args]
if not frames:
    for name, prog in (("hero", "../examples/hero/src/main.tsx"), ("nav", "../examples/maps/navigation/src/main.tsx")):
        env = dict(os.environ, ZINC_HEADLESS="1", ZINC_DETERMINISTIC="1", ZINC_FRAMES="12", ZINC_SHOT_FRAMES="3,8,12", ZINC_SHOT=os.path.join(tmp, name + ".png"), ZINC_SCENE_DUMP=os.path.join(tmp, name + ".scn"))
        subprocess.run([zinc, "run", prog], env=env, capture_output=True, check=True)
        frames += [("%s frame %d" % (name, f), os.path.join(tmp, "%s-%d.scn" % (name, f))) for f in (3, 8, 12)]
rows = []
for label, path in frames:
    W, H, cmds = pc.read_scene(path)
    t0 = time.time(); s = study(cmds, W, H); s["ms"] = (time.time() - t0) * 1000; s["label"] = label; rows.append(s)
lines = ["# Order-rank study (ZN-173, spike S1)", "", "Generated by `tools/rank-study` from scene dumps (`ZINC_SCENE_DUMP`). Draw calls = batches after merging runs; no GPU involved.", "",
         "| frame | prims | ranks | painter (kind) | painter + clip | ranked | ranked / painter |", "|---|---:|---:|---:|---:|---:|---:|"]
for s in rows: lines.append("| %s | %d | %d | %d | %d | %d | %.0f%% |" % (s["label"], s["prims"], s["ranks"], s["painter"], s["painter_clip"], s["ranked"], 100.0 * s["ranked"] / max(1, s["painter"])))
tp, tr = sum(s["painter"] for s in rows), sum(s["ranked"] for s in rows)
lines += ["", "Total: painter %d draw calls, ranked %d (%.0f%%)." % (tp, tr, 100.0 * tr / max(1, tp))]
open(out, "w").write("\n".join(lines) + "\n")
print("\n".join(lines))
