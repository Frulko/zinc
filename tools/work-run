#!/usr/bin/env python3
"""Run one bounded heavy command, queued across this repository's worktrees."""
import fcntl
import math
import os
from pathlib import Path
import subprocess
import sys

try:
    seconds = float(sys.argv[1])
    if len(sys.argv) < 3 or not math.isfinite(seconds) or seconds <= 0:
        raise ValueError()
except (IndexError, ValueError):
    sys.exit("usage: tools/work-run SECONDS COMMAND [ARG...]")

common = Path(subprocess.check_output(["git", "rev-parse", "--git-common-dir"], text=True).strip()).resolve()
logs = common.parent / ".logs"
logs.mkdir(exist_ok=True)
fd = os.open(logs / "coordinator-heavy.lock", os.O_CREAT | os.O_RDWR, 0o600)
fcntl.flock(fd, fcntl.LOCK_EX)
os.set_inheritable(fd, True)
timeout = Path(__file__).resolve().parent / "compat" / "timeout"
os.execv(timeout, [str(timeout), *sys.argv[1:]])
