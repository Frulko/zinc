#!/usr/bin/env python3
"""Regenerate the QuickJS Intl copy with the pinned esbuild type stripper."""
import argparse
from pathlib import Path
import subprocess
import tempfile

p = argparse.ArgumentParser()
p.add_argument('--esbuild', required=True)
p.add_argument('--check', action='store_true')
a = p.parse_args()
root = Path(__file__).resolve().parent.parent
source = ''.join(part.split(')ZN";', 1)[0] for part in (root / 'src/frontend/intl_prelude.h').read_text().split('R"ZN(\n')[1:])
# Optional typed fields use a null slot; JavaScript uses undefined for an absent property.
source = source.replace('=== null', '== null').replace('!== null', '!= null').replace('__undef', 'undefined')
# These adapters cross Zinc's existing Dyn representation. The formatting/validation stays shared.
adapters = {
    '__intlLocales': """function __intlLocales(locales) {
  if (locales === undefined) return '';
  if (typeof locales === 'string') { if (!locales.length || locales.includes('\\n')) throw new RangeError('Invalid language tag'); return locales; }
  if (Array.isArray(locales)) { for (const tag of locales) if (typeof tag !== 'string') throw new TypeError('Intl locale entries must be strings'); for (const tag of locales) if (!tag.length || tag.includes('\\n')) throw new RangeError('Invalid language tag'); return locales.join('\\n'); }
  throw new TypeError('Intl locales must be a string or string array');
}
""",
    '__intlDateValue': 'function __intlDateValue(value) { return Number(value); }\n',
    '__intlDateThisValue': 'function __intlDateThisValue(date) { return Date.prototype.getTime.call(date); }\n',
    '__intlOptString': "function __intlOptString(o, key) { const v = o === undefined ? undefined : o[key]; if (typeof v === 'symbol') throw new TypeError('Cannot convert a Symbol value to a string'); return v === undefined ? null : String(v); }\n",
    '__intlOptNumber': 'function __intlOptNumber(o, key) { const v = o === undefined ? undefined : o[key]; return v === undefined ? null : Number(v); }\n',
    '__intlOptBool': 'function __intlOptBool(o, key) { const v = o === undefined ? undefined : o[key]; return v === undefined ? null : Boolean(v); }\n',
    '__intlOptionKeys': 'function __intlOptionKeys(o) { return o === undefined ? [] : Object.keys(o); }\n',
    '__intlOptionsCheck': "function __intlOptionsCheck(o) { if (o === null) throw new TypeError('Intl options cannot be null'); }\n",
}
for name, replacement in adapters.items():
    begin = source.index('function ' + name + '(')
    ends = [i for marker in ('\nfunction ', '\nclass ', '\ninterface ') if (i := source.find(marker, begin + 1)) >= 0]
    end = min(ends) + 1 if ends else len(source)
    source = source[:begin] + replacement + source[end:]
with tempfile.TemporaryDirectory() as tmp:
    ts = Path(tmp) / 'intl.ts'
    ts.write_text(source)
    js = subprocess.check_output([a.esbuild, str(ts), '--target=es2020', '--log-level=error'], text=True)
text = '// Generated by tools/gen-intl from frontend/intl_prelude.h.\nR"JS(\n' + js + ')JS"\n'
out = root / 'src/qjs/intl_js.h'
if a.check:
    assert out.read_text() == text, 'run tools/gen-intl with the pinned esbuild'
else:
    out.write_text(text)
