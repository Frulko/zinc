#!/bin/sh
# An AppLoad tile for a .zapp, run by the engine of this directory (ZN-841; docs/targets/remarkable-paper-pro.md, "The engine on the tablet").
#   zinc-tile <app.zapp> [--session]     the tile zinc-<name> (--session: zinc-<name>-session) in AppLoad's directory
#   zinc-tile --remove <tile>
# Default: AppLoad's shared framebuffer (qtfb), xochitl keeps running. --session: the ink session, xochitl stopped by the display lease and
# brought back on every way out; refused here when this OS's display engine is not one the engine verified (share/zinc/rmpp/verified).
# Then in AppLoad: reload, and tap the tile.
set -eu
Z=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
APPLOAD=${ZINC_APPLOAD:-/home/root/xovi/exthome/appload}
usage() { sed -n '3,4p' "$0" >&2; exit 2; }
[ $# -ge 1 ] || usage
if [ "$1" = --remove ]; then
  [ $# -eq 2 ] || usage
  case $2 in zinc-*) ;; *) echo "zinc-tile: $2 is not a tile of zinc-tile (zinc-<name>)" >&2; exit 2 ;; esac
  rm -rf "${APPLOAD:?}/$2"; echo "removed $2: reload AppLoad"; exit 0
fi
session=
[ "${2:-}" = --session ] && session=1
[ -f "$1" ] || { echo "zinc-tile: no file $1" >&2; exit 2; }
zapp=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")
name=$(basename "$zapp" .zapp)${session:+-session}
dir=$APPLOAD/zinc-$name
if [ -n "$session" ]; then
  V=$(sha256sum "${ZINC_QSGEPAPER:-/usr/lib/plugins/scenegraph/libqsgepaper.so}" | cut -c1-64)
  grep -qx "$V" "$Z/share/zinc/rmpp/verified" || { echo "zinc-tile: this OS's display engine ($V) is not verified for the ink session; use the qtfb tile" >&2; exit 1; }
fi
mkdir -p "$dir"
# the app's icon (zinc pack's icon.png member, from zinc.json app.icon) when it has one, else the engine's
if tar xOf "$zapp" icon.png > "$dir/icon.png" 2>/dev/null && [ "$(dd if="$dir/icon.png" bs=1 skip=1 count=3 2>/dev/null)" = PNG ]; then :
else cp "$Z/share/zinc/rmpp/icon.png" "$dir/icon.png"; fi
# a qtfb tile keeps AppLoad's window buttons: a tap opens it full screen, a swipe down from the top shows _ (minimize, the app keeps
# running) and X; an ink session has no AppLoad window
# zinc.json "display": {"keyboard": true} (in the .zapp): AppLoad shows its on-screen keyboard for the app (qtfb tiles only)
vkb=
if [ -z "$session" ] && tar xOf "$zapp" zinc.json 2>/dev/null | tr -d ' \n\t' | grep -q '"display":{[^}]*"keyboard":true'; then
  vkb=',\n  "supportsVirtualKeyboard": true'
fi
printf '{\n  "name": "%s",\n  "application": "launch.sh",\n  "qtfb": %s,\n  "workingDirectory": "%s",\n  "disablesWindowedMode": %s'"$vkb"'\n}\n' \
  "$name" "$([ -n "$session" ] && echo false || echo true)" "$dir" "$([ -n "$session" ] && echo true || echo false)" > "$dir/external.manifest.json"
if [ -n "$session" ]; then
  cat > "$dir/launch.sh.new" <<EOF
#!/bin/sh
# zinc-tile --session: the display lease runs $name with xochitl stopped and brings xochitl back on every way out
# (the app quits, crashes or hangs 10 s, a 2 s press on the power button, systemctl stop zinc-lease, 30 minutes at most).
V=\$(sha256sum "\${ZINC_QSGEPAPER:-/usr/lib/plugins/scenegraph/libqsgepaper.so}" | cut -c1-64)
grep -qx "\$V" "$Z/share/zinc/rmpp/verified" || { echo "$name: this OS's display engine (\$V) is not verified for the ink session" >&2; exit 1; }
exec "$Z/bin/lease" launch --watchdog 10 --vendor-sha256 "\$V" "$Z/bin/zinc-app" "$zapp"
EOF
else
  # ZINC_NEXT: an app (the hub's Open) writes a .zapp path there and quits; it runs in this window, then this tile's app comes back.
  # The tile's own app written there (the hub after its own update) just starts again. qtfb-hold stays attached meanwhile: AppLoad
  # closes the window when the last client of its framebuffer leaves.
  cat > "$dir/launch.sh.new" <<EOF
#!/bin/sh
export ZINC_NEXT=/tmp/zinc-next.\$\$
"$Z/bin/qtfb-hold" > /dev/null & hold=\$!
trap 'kill \$hold 2>/dev/null; rm -f "\$ZINC_NEXT"' EXIT
run() { rm -f "\$ZINC_NEXT"; "$Z/bin/zinc-app" "\$1"; }
run "$zapp"
while [ -s "\$ZINC_NEXT" ]; do next=\$(cat "\$ZINC_NEXT"); run "\$next"; [ "\$next" = "$zapp" ] || run "$zapp"; done
EOF
fi
# a new file put in place: the launch.sh running now (the hub updating itself) keeps reading its own
chmod 755 "$dir/launch.sh.new" && mv -f "$dir/launch.sh.new" "$dir/launch.sh"
echo "tile zinc-$name in $dir: open AppLoad, reload, then tap '$name'"
