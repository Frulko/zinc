             PropertyChanges {
                 target: root
                 x: root.widgetX
                 y: root.widgetY
-                width: windowCanvas.widgetRect.width + 2 * outline
-                height: barHeight + windowCanvas.widgetRect.height + outline
+                width: windowCanvas.widgetRect.width + 2 * cardPadding
+                height: barHeight + (collapsed ? 0 : windowCanvas.widgetRect.height + 2 * cardPadding)
             }
             PropertyChanges {
                 target: mainWindowView
                 width: windowCanvas.widgetRect.width
                 height: windowCanvas.widgetRect.height
-                anchors.rightMargin: outline
+                anchors.rightMargin: cardPadding
