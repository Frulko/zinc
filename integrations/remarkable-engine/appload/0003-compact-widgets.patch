@@ -334,12 +360,12 @@ FocusScope {
             anchors.bottom: parent.bottom
             anchors.left: parent.left
             anchors.right: parent.right
-            anchors.leftMargin: compact ? appIconBox.x + appIconBox.width + 12 : 0
-            anchors.rightMargin: compact ? closeButton.anchors.rightMargin + 2 * barHeight + 12 : 0
+            anchors.leftMargin: compact ? appIconBox.width : 0
+            anchors.rightMargin: compact ? 2 * barHeight + 16 : 0
             horizontalAlignment: compact ? Text.AlignLeft : Text.AlignHCenter
             verticalAlignment: Text.AlignVCenter
             elide: Text.ElideRight
-            font.pointSize: 20
