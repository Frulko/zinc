+            // A tap on a widget's header (no move beyond the drag threshold) collapses or expands it.
+            property real pressX: 0
+            property real pressY: 0
+            property real startX: 0
+            property real startY: 0
+            onPressed: (mouse) => {
+                pressX = mouse.x;
+                pressY = mouse.y;
+                startX = root.x;
+                startY = root.y;
+            }
             onClicked: () => {
                 root.forceActiveFocus();
             }
-            onReleased: () => {
-                if(widget) saveWidgetPosition();
+            onReleased: (mouse) => {
+                if(!widget) return;
+                const moved = root.x != startX || root.y != startY
+                    || Math.abs(mouse.x - pressX) > drag.threshold || Math.abs(mouse.y - pressY) > drag.threshold;
+                if(moved) saveWidget();
+                else toggleCollapsed();
             }
         }
 
