@@ -42,11 +42,20 @@ FocusScope {
     property bool widget: false
     readonly property bool hasWidget: windowCanvas.widgetRect.width > 0 && windowCanvas.widgetRect.height > 0
     readonly property bool compact: minimized || widget
-    readonly property int barHeight: 88
-    readonly property int outline: 3
+    // One look for the window bar, the widget card and the pill: 64 px cells (touch targets),
+    // 30 px icons, 2 px outlines, 1.5 px separators, one radius.
+    readonly property int barHeight: 64
+    readonly property int outline: 2
+    readonly property real hairline: 1.5
+    readonly property int cornerRadius: 12
+    readonly property int iconSize: 30
+    // The widget's content inset inside the card: clears the rounded corners.
+    readonly property int cardPadding: 6
     property int widgetX: 0
     property int widgetY: 0
-    readonly property int pillWidth: barHeight / 4 + barHeight + 12 + Math.min(_appName.implicitWidth, 560) + 12 + 2 * barHeight + barHeight / 4 + 8 // +8: slack for font metrics
+    // Collapsed widget card: the header alone, the client hidden (visibility 0). Saved per app.
+    property bool collapsed: false
+    readonly property int pillWidth: barHeight + Math.min(_appName.implicitWidth, 560) + 16 + 2 * barHeight + 4 // +4: slack for font metrics
 
     // Keyboard handling:
     property var virtualKeyboardLayout: null
@@ -150,23 +159,32 @@ FocusScope {
         }
     }
     function placeWidget() {
-        const w = windowCanvas.widgetRect.width + 2 * outline;
-        const h = barHeight + windowCanvas.widgetRect.height + outline;
         const saved = widgetPositions()[appId];
+        collapsed = !!(saved && saved.collapsed);
+        const w = windowCanvas.widgetRect.width + 2 * cardPadding;
+        const h = barHeight + (collapsed ? 0 : windowCanvas.widgetRect.height + 2 * cardPadding);
         const x = saved ? saved.x : globalWidth - w - 40;
         const y = saved ? saved.y : 160;
         // Keep the whole card on the screen (it may have rotated since).
         widgetX = Math.max(0, Math.min(x, globalWidth - w));
         widgetY = Math.max(0, Math.min(y, globalHeight - h));
     }
-    function saveWidgetPosition() {
-        if(root.x == widgetX && root.y == widgetY) return;
+    function saveWidget() {
         widgetX = root.x;
         widgetY = root.y;
         const all = widgetPositions();
-        all[appId] = { x: Math.round(root.x), y: Math.round(root.y) };
+        const old = all[appId];
+        const now = { x: Math.round(root.x), y: Math.round(root.y), collapsed: collapsed };
+        if(old && old.x == now.x && old.y == now.y && !!old.collapsed == now.collapsed) return;
+        all[appId] = now;
         library.writeWidgetPositions(JSON.stringify(all));
     }
+    function toggleCollapsed() {
+        collapsed = !collapsed;
+        // Expanded again near the bottom: keep the whole card on the screen.
+        root.y = Math.max(0, Math.min(root.y, globalHeight - root.height));
+        saveWidget();
+    }
 
     AppLoadLibrary {
         id: library
@@ -201,21 +219,23 @@ FocusScope {
             }
         },
         State {
-            // A card: the header, then the widget's rectangle pixel for pixel inside a black outline.
