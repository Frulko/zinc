 }
 
 qtfb::DeviceStateChangedContents FBController::formCapabilitiesPacket() {
     qtfb::DeviceStateChangedContents dscc = {
         .reason = STATE_CHANGED_REASON_CAPABILITIES,
-        .capabilities = { CAPABILITY_WINDOW_STATE | CAPABILITY_WIDGETS },
+        .capabilities = { CAPABILITY_WINDOW_STATE | CAPABILITY_WIDGETS | CAPABILITY_DOCKED },
     };
     return dscc;
+}
+
+qtfb::DeviceStateChangedContents FBController::formInsetsPacket() {
+    qtfb::DeviceStateChangedContents dscc = {
+        .reason = STATE_CHANGED_REASON_INSETS,
+        .insets = { dockTop },
+    };
+    return dscc;
+}
+
+void FBController::setShowDock(bool show) {
+    if(show == showDock) return;
+    showDock = show;
+    sendVisibility();
+    markedUpdate();
+}
+
+// The header's height can change (rotation, another xochitl view): the client hears it, and a docked window moves with it.
+void FBController::setDockTop(int top) {
+    if(top < 0 || top == dockTop) return;
+    dockTop = top;
+    qtfb::management::sendDeviceStateChange(framebufferID, formInsetsPacket());
+    if(showDock) markedUpdate();
 }
 
