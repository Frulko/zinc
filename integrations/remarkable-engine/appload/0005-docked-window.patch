+
+    // Docked windows (WINDOW_STATE_DOCKED): the height of xochitl's top header (burger, logo, battery), read from its live item
+    // tree, since xochitl's QML names are hashed and differ per OS release. Override: {"top": N} in dock.json in AppLoad's directory.
+    // Else the tallest visible item, outside AppLoad's own windows (under `skip`) and the popup overlay, that spans the screen's
+    // width at its top and is 48 to 240 px high. Else 120 px, the fallback. Each new answer is logged with the item it came from.
+    Q_INVOKABLE int xochitlHeaderHeight(QQuickItem *skip) {
+        static int last = -1;
+        auto answer = [](int top, const QString &why) {
+            if(top != last) qDebug() << "[AppLoad]: docked windows start at y" << top << "(" << why << ")";
+            last = top;
+            return top;
+        };
+        QFile file(QString(APPLICATION_DIRECTORY_ROOT) + "/dock.json");
+        if(file.open(QIODevice::ReadOnly)) {
+            int top = QJsonDocument::fromJson(file.readAll()).object().value("top").toInt(-1);
+            if(top >= 0 && top < 1000) return answer(top, "dock.json");
+        }
+        QQuickWindow *window = skip ? skip->window() : nullptr;
+        if(!window) return answer(120, "no window: fallback");
+        const qreal width = window->contentItem()->width();
+        qreal best = 0;
+        QString from;
+        std::function<void(QQuickItem *)> walk = [&](QQuickItem *item) {
+            if(item == skip || !item->isVisible() || item->opacity() <= 0 || item->inherits("QQuickOverlay")) return;
+            QRectF r = item->mapRectToScene(QRectF(0, 0, item->width(), item->height()));
+            if(qAbs(r.y()) < 1 && qAbs(r.x()) < 1 && qAbs(r.width() - width) < 2 && r.height() >= 48 && r.height() <= 240 && r.height() > best) {
+                best = r.height();
+                from = QString(item->metaObject()->className()) + " " + item->objectName();
+            }
+            for(QQuickItem *child : item->childItems()) walk(child);
+        };
+        walk(window->contentItem());
+        if(best > 0) return answer(qRound(best), "xochitl's " + from);
+        return answer(120, "no header item found: fallback");
+    }
+
+    // A popup of xochitl is open over the screen (its sidebar, a menu, a dialog: Qt Quick Controls put them in the window's overlay).
+    Q_INVOKABLE bool xochitlPopupOpen(QQuickItem *any) {
+        QQuickWindow *window = any ? any->window() : nullptr;
+        if(!window) return false;
+        for(QQuickItem *item : window->contentItem()->childItems()) {
+            if(!item->inherits("QQuickOverlay")) continue;
+            for(QQuickItem *popup : item->childItems()) if(popup->isVisible() && popup->opacity() > 0) return true;
+        }
+        return false;
     }
 
