     }
 
     Rectangle {
         id: topbar
-        visible: !fullscreen || forceTopBarVisible
+        visible: (!fullscreen || forceTopBarVisible) && !(docked && !minimized)
         width: parent.width
         height: visible ? barHeight : 0
         color: "white"
@@ -605,10 +690,13 @@
             // A collapsed widget is hidden for the client (visibility 0); expanding shows it again (2).
             clientVisible: !root.minimized && !(root.widget && root.collapsed)
             showWidget: root.widget
+            showDock: root.docked && !root.minimized
