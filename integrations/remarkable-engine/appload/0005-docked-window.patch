     // Window state requested by the qtfb client itself.
     function clientMinimize() {
         if(minimized) return;
+        if(docked) {
+            minimized = true; // stays docked: open brings it back under the header
+            return;
+        }
         if(widget) {
             // restoreToFullscreen is kept: open goes back to where the widget came from.
             minimized = true;
@@ -127,7 +138,17 @@
         minimized = true;
     }
     function clientRestore() {
-        if(!minimized && !widget) return;
+        if(docked && minimized) {
+            dockSuspended = false;
+            minimized = false; // back under the header; the client sends 1 again for the full window
+            return;
+        }
+        if(restoreToDock && (widget || minimized)) {
+            clientDock(); // the widget (or its pill) of a docked window opens docked again
+            return;
+        }
+        if(!minimized && !widget && !docked) return;
+        docked = false;
         widget = false;
         minimized = false;
         if(restoreToFullscreen) {
@@ -141,15 +162,67 @@
             return;
         }
         if(widget) return;
-        if(!minimized) {
+        if(docked) restoreToDock = true; // restoreToFullscreen is kept for when the client leaves the dock
+        else if(!minimized) {
             restoreToFullscreen = fullscreen;
             if(fullscreen) maximize(); // A widget is never full screen.
         }
         placeWidget();
-        widget = true; // Before minimized, so that the client sees a single visibility change.
+        widget = true; // Before docked and minimized, so that the client sees a single visibility change.
+        docked = false;
         minimized = false;
     }
 
+    function clientDock() {
+        if(docked && !minimized) return;
+        if(!docked && !minimized && !widget) {
+            restoreToFullscreen = fullscreen;
+            if(fullscreen) maximize(); // Docked is never full screen.
+        }
+        readDockTop();
+        docked = true; // Before widget and minimized, so that the client sees a single visibility change.
+        widget = false;
+        minimized = false;
+        dockSuspended = false;
+        restoreToDock = false;
+    }
+    function readDockTop() {
+        dockTop = library.xochitlHeaderHeight(root.parent);
+    }
+    // The header belongs to xochitl: a press on it reaches xochitl and minimizes the docked window. When that press opened a
+    // popup (the sidebar of the burger, a menu), the window docks again once it is closed; else it stays a pill.
+    function headerPressed() {
+        dockSuspended = true;
+        minimized = true;
+        dockWatch.sawPopup = false;
+        dockWatch.ticks = 0;
+        dockWatch.restart();
+    }
+    Timer {
+        id: dockWatch
+        interval: 250
+        repeat: true
+        property bool sawPopup: false
+        property int ticks: 0
+        onTriggered: () => {
+            if(!root.dockSuspended || !root.docked) return stop();
+            const open = library.xochitlPopupOpen(root);
+            if(open) sawPopup = true;
+            else if(sawPopup) {
+                stop();
+                root.dockSuspended = false;
+                root.minimized = false;
+            } else if(++ticks >= 6) stop(); // nothing opened in 1.5 s: stay minimized
+        }
+    }
+    // The header may change (the launcher's bar closed, a rotation): read it again while docked.
+    Timer {
+        interval: 2000
+        repeat: true
+        running: root.docked && !root.minimized
+        onTriggered: readDockTop()
+    }
