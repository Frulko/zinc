             onWindowStateRequested: (state) => {
                 if(state == 0) root.clientMinimize();
                 else if(state == 2) root.clientWidget();
+                else if(state == 3) root.clientDock();
                 else root.clientRestore();
             }
 
@@ -682,6 +770,20 @@
                     coord.close();
                 }
             }
+        }
+    }
+
+    // Over xochitl's header, above a docked window: sees the press and lets it through to xochitl.
+    MouseArea {
+        x: 0
+        y: -root.dockTop
+        width: root.width
+        height: root.dockTop
+        enabled: root.docked && !root.minimized
+        visible: enabled
+        onPressed: (mouse) => {
+            mouse.accepted = false;
+            root.headerPressed();
         }
     }
 
