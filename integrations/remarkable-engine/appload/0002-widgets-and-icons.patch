-    return { formRotationChangePacket(), formVisibilityChangePacket() };
+    sentVisibility = currentVisibility();
+    return { formRotationChangePacket(), formVisibilityChangePacket(), formCapabilitiesPacket() };
+}
+
+qtfb::DeviceStateChangedContents FBController::formCapabilitiesPacket() {
+    qtfb::DeviceStateChangedContents dscc = {
+        .reason = STATE_CHANGED_REASON_CAPABILITIES,
+        .capabilities = { CAPABILITY_WINDOW_STATE | CAPABILITY_WIDGETS },
+    };
+    return dscc;
+}
+
+// Sends the visibility only when it changed: a move between two states that sets
+// clientVisible and showWidget one after the other sends no intermediate value.
+void FBController::sendVisibility() {
+    int visibility = currentVisibility();
+    if(visibility == sentVisibility) return;
+    sentVisibility = visibility;
+    qtfb::management::sendDeviceStateChange(framebufferID, formVisibilityChangePacket());
+}
+
+void FBController::setShowWidget(bool show) {
+    if(show == showWidget) return;
+    showWidget = show;
+    sendVisibility();
+    markedUpdate();
+}
+
+void FBController::setWidgetRect(const QRect &rect) {
+    if(rect == _widgetRect) return;
+    _widgetRect = rect;
+    emit widgetRectChanged();
+    sendVisibility();
+    if(showWidget) markedUpdate();
 }
 
 qtfb::DeviceStateChangedContents FBController::formVisibilityChangePacket() {
     qtfb::DeviceStateChangedContents dscc = {
         .reason = STATE_CHANGED_REASON_VISIBILITY,
-        .visibility = { clientVisible ? 1 : 0 },
+        .visibility = { sentVisibility },
