         }
     }
+    function clientWidget() {
+        if(!hasWidget) {
+            clientMinimize();
+            return;
+        }
+        if(widget) return;
+        if(!minimized) {
+            restoreToFullscreen = fullscreen;
+            if(fullscreen) maximize(); // A widget is never full screen.
+        }
+        placeWidget();
+        widget = true; // Before minimized, so that the client sees a single visibility change.
