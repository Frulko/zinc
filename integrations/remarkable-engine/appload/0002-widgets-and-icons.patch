+    // Widget positions, per app id, kept in AppLoad's directory.
+    function widgetPositions() {
+        try {
+            return JSON.parse(library.readWidgetPositions()) || {};
+        } catch(e) {
+            return {};
+        }
+    }
+    function placeWidget() {
+        const w = windowCanvas.widgetRect.width + 2 * outline;
+        const h = barHeight + windowCanvas.widgetRect.height + outline;
+        const saved = widgetPositions()[appId];
+        const x = saved ? saved.x : globalWidth - w - 40;
+        const y = saved ? saved.y : 160;
+        // Keep the whole card on the screen (it may have rotated since).
+        widgetX = Math.max(0, Math.min(x, globalWidth - w));
+        widgetY = Math.max(0, Math.min(y, globalHeight - h));
+    }
+    function saveWidgetPosition() {
+        if(root.x == widgetX && root.y == widgetY) return;
+        widgetX = root.x;
+        widgetY = root.y;
+        const all = widgetPositions();
+        all[appId] = { x: Math.round(root.x), y: Math.round(root.y) };
+        library.writeWidgetPositions(JSON.stringify(all));
+    }
 
