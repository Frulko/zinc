index 0000000..9a3d4c3
--- /dev/null
+++ b/xovi/template/header.qmd
@@ -0,0 +1,40 @@
+; The header bar of a docked window (0010): the top docked window's title after the burger, its Home and Quit buttons before the
+; status icons, as xochitl's own header items (its label and icon buttons). AppLoadHeader holds them; hosted tells the windows that
+; they need not draw the bar over the header themselves. Written against xochitl 3.29's ContentHeader.qml.
+AFFECT /qml/device/view/navigator/ContentHeader.qml
+    IMPORT net.asivery.AppLoad 1.0
+    TRAVERSE FocusScope
+        LOCATE AFTER ALL
+        INSERT {
+            Item {
+                anchors.fill: parent
+                visible: AppLoadHeader.active
+                Component.onCompleted: { AppLoadHeader.hosted = true; }
+
+                ArkControls.Label {
+                    x: menuButton.x + menuButton.width + ArkTokens.Style.spacing.xsmall   // this item fills the header: same coordinates
+                    anchors.verticalCenter: parent.verticalCenter
+                    width: Math.max(0, parent.width / 2 - 160 - x)
+                    clip: true
+                    type: ArkControls.Label.LargeStrong
+                    text: AppLoadHeader.title
+                }
+
+                Row {
+                    anchors.right: parent.right
+                    anchors.rightMargin: header.topStatusIndicationRightMargin + topStatusIndication.width + header.topStatusIndicationRightMargin
+                    anchors.verticalCenter: parent.verticalCenter
+
+                    IconButton {
+                        iconSource: "qrc:/appload/icons/house"   // xochitl's own "house" is a pattern swatch
+                        onClicked: AppLoadHeader.press(1)
+                    }
+                    IconButton {
+                        iconSource: "qrc:/ark/icons/x_medium"
+                        onClicked: AppLoadHeader.press(2)
+                    }
+                }
+            }
+        }
+    END TRAVERSE
+END AFFECT
