index 4aac869..68ff44e 100644
--- a/src/AppLibrary.h
+++ b/src/AppLibrary.h
@@ -18,6 +18,9 @@
 #include <QPointer>
 #include <QHash>
 #include <QSet>
+#include <QVariantMap>
+#include <QFont>
+#include <QScreen>
 #include <functional>
 
 #include "library.h"
