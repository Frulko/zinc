+    // The header bar of a docked window (0010): where xochitl's header leaves room, and the size of its text and icons, so the app's title
+    // and its Home and Quit buttons sit in it as xochitl's own. The leaves of the scene in the header's band (items without visible
+    // children that draw, narrower than 90% of the screen) are what it shows: the gaps between them are free. The text size is the pixel size of
+    // its first text; the icon size the most common height of its square leaves. 0 when not found.
+    Q_INVOKABLE QVariantMap xochitlHeaderLayout(QQuickItem *skip, int top) {
+        QVariantMap out;
+        QQuickWindow *window = skip ? skip->window() : nullptr;
+        if(!window || top <= 0) return out;
+        const qreal width = window->contentItem()->width();
+        QList<QPair<qreal, qreal>> used;
+        int fontPx = 0;
+        QString family;
+        QMap<int, int> squares;
+        walkScene(window->contentItem(), skip, [&](QQuickItem *item) {
+            const QRectF r = sceneRect(item);
+            if(r.bottom() <= 0 || r.top() >= top || r.width() >= width * 0.9 || r.width() < 2) return;
+            if(!(item->flags() & QQuickItem::ItemHasContents)) return;   // draws nothing (a mouse area, a layout)
+            for(QQuickItem *c : item->childItems()) if(shown(c) && (c->flags() & QQuickItem::ItemHasContents)) return;   // a leaf
+            used.append({r.left(), r.right()});
+            const QVariant font = item->property("font");
+            if(!fontPx && font.canConvert<QFont>()) {
+                const QFont f = font.value<QFont>();
+                fontPx = f.pixelSize() > 0 ? f.pixelSize() : qRound(f.pointSizeF() * window->screen()->logicalDotsPerInch() / 72);
+                family = f.family();
+            }
+            if(qAbs(r.width() - r.height()) < 4 && r.height() >= top * 0.2 && r.height() <= top * 0.8) squares[qRound(r.height())]++;
+        });
+        std::sort(used.begin(), used.end());
+        QVariantList gaps;
+        qreal x = 0;
+        for(const auto &u : used) {
+            if(u.first > x) gaps.append(QVariantList{x, u.first});
+            x = qMax(x, u.second);
+        }
+        if(x < width) gaps.append(QVariantList{x, width});
+        int icon = 0, seen = 0;
+        for(auto it = squares.cbegin(); it != squares.cend(); ++it) if(it.value() > seen) { seen = it.value(); icon = it.key(); }
+        out["gaps"] = gaps;
+        out["font"] = fontPx;
+        out["icon"] = icon;
+        out["family"] = family;
+        return out;
+    }
+
     // A docked window and xochitl's own layers (0008, 0009). xochitl's sidebar and menus are items of its scene, not all in Qt Quick
     // Controls' overlay, and AppLoad's windows come after them: what a press on the header opens would show under the docked window. The
     // press keeps a picture of the scene (each visible item's rectangle); then what appeared or slid over the window is found and lifted
