+
+// The header bar (0010): the top docked window's title and Home / Quit, shown by xochitl's own header (header.qmd adds them to its
+// ContentHeader). The top docked window claims it and releases it; a press calls the owner's headerAction. `hosted` is set by the header
+// once the diff applied; until then (another OS release, the diff refused) each window draws the bar over the header itself.
+class AppLoadHeader : public QObject {
+    Q_OBJECT
+    Q_PROPERTY(QString title READ title NOTIFY changed)
+    Q_PROPERTY(bool active READ active NOTIFY changed)
+    Q_PROPERTY(bool hosted READ hosted WRITE setHosted NOTIFY hostedChanged)
+public:
+    static AppLoadHeader *instance() { static AppLoadHeader header; return &header; }
+    QString title() const { return owner ? _title : QString(); }
+    bool active() const { return !owner.isNull(); }
+    bool hosted() const { return _hosted; }
+    void setHosted(bool hosted) { if(hosted != _hosted) { _hosted = hosted; emit hostedChanged(); } }
+    Q_INVOKABLE void claim(QObject *by, const QString &title) {
+        if(owner == by && _title == title) return;
+        if(owner != by) connect(by, &QObject::destroyed, this, &AppLoadHeader::changed);
+        owner = by;
+        _title = title;
+        emit changed();
+    }
+    Q_INVOKABLE void release(QObject *by) { if(owner == by) { owner = nullptr; emit changed(); } }
+    Q_INVOKABLE void press(int action) { if(owner) QMetaObject::invokeMethod(owner, "headerAction", Q_ARG(QVariant, QVariant(action))); }
+signals:
+    void changed();
+    void hostedChanged();
+private:
+    QPointer<QObject> owner;
+    QString _title;
+    bool _hosted = false;
+};
