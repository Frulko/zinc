     qtfb::DeviceStateChangedContents dscc = {
         .reason = STATE_CHANGED_REASON_CAPABILITIES,
-        .capabilities = { CAPABILITY_WINDOW_STATE | CAPABILITY_WIDGETS | CAPABILITY_DOCKED | CAPABILITY_INSTANT_MODE },
+        .capabilities = { CAPABILITY_WINDOW_STATE | CAPABILITY_WIDGETS | CAPABILITY_DOCKED | CAPABILITY_INSTANT_MODE | CAPABILITY_HEADER_BAR },
     };
     return dscc;
 }
@@ -399,6 +399,13 @@ void FBController::setDockTop(int top) {
     if(showDock) markedUpdate();
 }
 
+// Home or Quit pressed in the header bar of a docked window: the client acts as its own bar's button would.
+void FBController::sendHeaderAction(int action) {
+    qtfb::DeviceStateChangedContents dscc = { .reason = STATE_CHANGED_REASON_ACTION };
+    dscc.action.action = action;
+    qtfb::management::sendDeviceStateChange(framebufferID, dscc);
+}
+
