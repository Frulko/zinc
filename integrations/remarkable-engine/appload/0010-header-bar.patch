Subject: [PATCH] window: the app's title and Home / Quit in xochitl's header

A docked window shows the app's name and two buttons, Home and Quit, in xochitl's header,
in the room its items leave (the widest free span left and right of the middle) and at its
sizes (the pixel size and family of its first text, the most common height of its square
icons; else 30% and 42% of the header's height). A press on a button reaches the client as
STATE_CHANGED_REASON_ACTION (4: ACTION_HOME 1, ACTION_QUIT 2); capability bit 4
(CAPABILITY_HEADER_BAR = 16) tells it, and the client then draws no bar of its own.

diff --git a/resources/qml/window.qml b/resources/qml/window.qml
index e371128..3e86311 100644
--- a/resources/qml/window.qml
+++ b/resources/qml/window.qml
@@ -188,6 +188,21 @@ FocusScope {
     }
     function readDockTop() {
         dockTop = library.xochitlHeaderHeight(root.parent);
+        headerLayout = library.xochitlHeaderLayout(root, dockTop);
+    }
+    // The header bar (0010): the app's title and its Home and Quit buttons in xochitl's header, at its sizes, in the room it leaves
+    property var headerLayout: ({})
+    readonly property int headerFont: headerLayout.font > 0 ? headerLayout.font : Math.round(dockTop * 0.3)
+    readonly property int headerIcon: headerLayout.icon > 0 ? headerLayout.icon : Math.round(dockTop * 0.42)
+    function headerGap(right) {   // the widest free span left (title) or right (buttons) of the screen's middle
+        const gaps = headerLayout.gaps || [];
+        let best = null;
+        for(const g of gaps) {
+            const mid = (g[0] + g[1]) / 2;
+            if((mid > globalWidth / 2) !== right) continue;
+            if(!best || g[1] - g[0] > best[1] - best[0]) best = g;
+        }
+        return best || (right ? [globalWidth / 2, globalWidth] : [0, globalWidth / 2]);
     }
     // The header belongs to xochitl and a press on it goes to xochitl: the docked window stays where it is, and what the press opens (the
     // burger's sidebar, a menu) is raised over it until it closes (AppLibrary's dockRaiseOpened).
@@ -761,6 +776,59 @@ FocusScope {
     }
 
 
+    Item {
+        id: headerBar
+        x: 0
+        y: -root.dockTop
+        width: root.width
+        height: root.dockTop
+        z: 2
+        visible: root.docked && !root.minimized && windowCanvas.visible
+        readonly property var left: root.headerGap(false)
+        readonly property var right: root.headerGap(true)
+        readonly property int pad: Math.round(root.headerIcon * 0.6)
+        Text {
+            x: headerBar.left[0] + headerBar.pad
+            width: Math.max(0, headerBar.left[1] - headerBar.left[0] - 2 * headerBar.pad)
+            height: parent.height
+            verticalAlignment: Text.AlignVCenter
+            elide: Text.ElideRight
+            text: root.appName
+            color: "black"
+            font.pixelSize: root.headerFont
+            font.family: root.headerLayout.family || Qt.application.font.family
+        }
+        Repeater {
+            model: [ { action: 2, glyph: "x" }, { action: 1, glyph: "house" } ]   // from the right: Quit, then Home
+            delegate: MouseArea {
+                required property var modelData
+                required property int index
+                width: root.dockTop
+                height: root.dockTop
+                x: headerBar.right[1] - headerBar.pad - (index + 1) * root.dockTop + (root.dockTop - root.headerIcon) / 2
+                onClicked: windowCanvas.sendHeaderAction(modelData.action)
+                Canvas {   // Lucide's house and x (ISC), at the header's icon size and stroke
+                    anchors.centerIn: parent
+                    width: root.headerIcon
+                    height: root.headerIcon
+                    onPaint: {
+                        const c = getContext("2d");
+                        c.reset();
+                        c.scale(width / 24, height / 24);
+                        c.strokeStyle = "black"; c.lineWidth = 2; c.lineCap = "round"; c.lineJoin = "round";
+                        c.beginPath();
+                        if(modelData.glyph === "x") { c.moveTo(18, 6); c.lineTo(6, 18); c.moveTo(6, 6); c.lineTo(18, 18); }
+                        else {
+                            c.moveTo(3, 10); c.lineTo(12, 2.5); c.lineTo(21, 10); c.lineTo(21, 21); c.lineTo(3, 21); c.closePath();
+                            c.moveTo(9, 21); c.lineTo(9, 13); c.lineTo(15, 13); c.lineTo(15, 21);
+                        }
+                        c.stroke();
+                    }
+                }
+            }
+        }
+    }
+
     // Over xochitl's header, above a docked window: sees the press and lets it through to xochitl.
     MouseArea {
         x: 0
