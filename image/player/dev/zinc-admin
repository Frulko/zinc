#!/bin/bash
# A zinc-admin that plays a Raspberry Pi, for the player on a computer (tools/pi-image player) and its test
# (tests/t1/pi_image_player.sh). It answers the verbs of image/files/usr/lib/zinc/zinc-admin with made-up values and
# keeps what they change in $ZINC_FAKE_PI (<name>.value files, shared with dev/bin/nmcli, which plays the network); the
# agent's pairing goes to $ZINC_PLAYER_AGENT_DIR as the real agent writes it. Each call is logged to $ZINC_FAKE_PI/calls.log.
set -u
state=${ZINC_FAKE_PI:?ZINC_FAKE_PI names the directory of the pretend Pi}
agent_dir=${ZINC_PLAYER_AGENT_DIR:-$state/agent}
mkdir -p "$state" "$agent_dir"
echo "zinc-admin $*" >>"$state/calls.log"
value() { cat "$state/$1.value" 2>/dev/null || echo "$2"; }
die() { echo "$*" >&2; exit 1; }
open_pairing() { printf '{"code":"%s","until":%d}\n' "$1" $(($(date +%s) + 300)) >"$agent_dir/pairing.json"; }

case ${1:-} in
  status)
    cat <<EOS
hostname=$(value hostname zinc)
model=Raspberry Pi 4 Model B Rev 1.5
os=Debian GNU/Linux 13 (trixie)
kernel=6.12.47+rpt-rpi-v8
uptime=42
temperature=47
memory=3104 3796
disk=24576 29696
ssh=$(value ssh off)
agent=$(value agent off)
country=$(value country FR)
boot=$(value boot running)
activity=$(value activity '')
EOS
    ;;
  wifi-country)
    [[ ${2:-} =~ ^[A-Z]{2}$ ]] || die "A country is two capital letters (FR, US, GB...)."
    echo "$2" >"$state/country.value"
    ;;
  ssh) echo "${2:-}" >"$state/ssh.value" ;;
  agent)
    echo "${2:-}" >"$state/agent.value"
    if [ "${2:-}" = on ]; then open_pairing 482913; else rm -f "$agent_dir/pairing.json"; fi
    ;;
  hostname)
    [[ ${2:-} =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || die "A name has small letters, digits and hyphens (not at its ends)."
    echo "$2" >"$state/hostname.value"
    ;;
  pair) open_pairing 731205 ;;
  network-restart)
    [ "$(value network-fail off)" != on ] || die "NetworkManager could not start. Check its system log."
    echo running >"$state/network.value"
    ;;
  update-status | update-check)
    # Opt in to available versions so ordinary player goldens keep their home screen.
    current=$(value engine "${ZINC_VERSION:-0.6.2}")
    current=${current##* }
    latest=$current
    versions="[]"
    if [ "${ZINC_FAKE_UPDATES:-0}" = 1 ]; then latest=0.7.0; versions='["0.7.0","0.6.2","0.5.2"]'; fi
    [ "${1:-}" != update-check ] || [ "$(value update-offline off)" != on ] || die "Cannot check versions while offline. Try again when connected."
    printf '{"current":"%s","previous":"%s","architecture":"aarch64","phase":"%s","message":"%s","latest":"%s","versions":%s}\n' \
      "$current" "$(value previous '')" "$(value update-phase idle)" "$(value update-message '')" "$latest" "$versions"
    ;;
  update-install)
    [[ ${2:-} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Choose a stable version."
    [ "$(value update-fail off)" != on ] || die "The player could not be rebuilt; nothing was changed."
    value engine "${ZINC_VERSION:-0.6.2}" >"$state/previous.value"
    echo "$2" >"$state/engine.value"
    echo done >"$state/update-phase.value"
    echo 'The engine and player are ready.' >"$state/update-message.value"
    ;;
  update-rollback)
    old=$(value previous '')
    [ -n "$old" ] || die "No previous version is saved yet."
    value engine 0.6.2 >"$state/previous.value"
    echo "$old" >"$state/engine.value"
    echo done >"$state/update-phase.value"
    echo 'The previous engine and player are back.' >"$state/update-message.value"
    ;;
  reboot | poweroff) ;;
  *) die "zinc-admin: unknown verb \"${1:-}\"" ;;
esac
