{
  "name": "zinc-player",
  "entry": "src/main.ts",
  "app": { "name": "Zinc Player", "id": "dev.zinc.player", "version": "0.2.0", "icon": "icon.png", "orientation": "landscape" },
  "requires": ["display", "pointer|touch|keyboard"],
  "permissions": ["fs", "net", "process"],
  "icons": [
    "settings", "wifi", "wifi-off", "wifi-high", "wifi-low", "wifi-zero", "ethernet-port", "lock", "chevron-left",
    "refresh-cw", "play", "rotate-ccw", "house", "delete", "arrow-big-up", "keyboard-off", "eye", "eye-off", "laptop",
    "palette", "cpu", "power", "triangle-alert", "circle-check", "download",
    "app-window", "plus", "x", "trash", "pencil", "check"
  ],
  "targets": {
    "linux": { "resize": "fill", "fullscreen": true },
    "macos": { "width": 800, "height": 480, "resize": "fill" }
  }
}
