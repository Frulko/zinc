# Maintained by Zinc. The agent makes the Pi a device of `zinc device` (push, run, logs from a computer). Off until
# a file named zinc-agent is put on the boot partition (it is consumed) or the player turns it on.
[Unit]
Description=Zinc agent
After=zinc-shell.service network.target
ConditionPathExists=|/var/lib/zinc/agent.enabled
ConditionPathExists=|/boot/firmware/zinc-agent

[Service]
User=zinc
# the programs it starts inherit its environment: the screen through /dev/fb0, as the session's (zinc-session gives it up to them)
Environment=ZINC_DISPLAY=fbdev ZINC_AGENT_SCREEN=/run/zinc
ExecStartPre=+/bin/sh -c 'if [ -e /boot/firmware/zinc-agent ]; then rm -f /boot/firmware/zinc-agent; touch /var/lib/zinc/agent.enabled; fi'
ExecStart=/bin/sh -c 'exec /usr/bin/zinc agent --name "$(hostname)"'
KillMode=process
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
