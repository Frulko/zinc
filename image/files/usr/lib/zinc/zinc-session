#!/bin/bash
# The Zinc session (zinc-shell.service). It runs the app and stays: when the app crashes, the player shows its exit
# status and its last output; when the app quits, or there is none, the player shows. The player exits 10 to start
# the app again.
# ponytail: a bash loop; a native `zinc player` replaces it once the engine supervises apps itself (and sends READY=1)
set -u
APP=${ZINC_APP:-/var/lib/zinc/app}
RUN=${ZINC_RUN:-/run/zinc}
PLAYER=${ZINC_PLAYER:-/usr/lib/zinc/current/player.zapp}
export ZINC_APP=$APP ZINC_RUN=$RUN
# the agent's folders: an app of agent/apps/<name> started here gets the agent's pid file and log, so `zinc device` lists it
# running, reads its log and stops it (src/agent/server.cpp: run/<name>.pid, logs/<name>.log)
AGENT=${ZINC_HOME:-$HOME/.zinc}/agent
export ZINC_SHOT_REQUEST=$RUN/shot.request   # zinc device screen: the agent asks the program on the screen for its frame
# the screen through /dev/fb0 (plugins/display-fbdev, compiled into the image): the driver the Pi was proven on. The
# SDL window asks for OpenGL 3.2, which the Pi's GPUs do not offer (vc4: 2.1, v3d: 3.1), and its fallback draws nothing.
# ponytail: every app on fbdev; a profile key for display-gl when an app needs the GPU
export ZINC_DISPLAY=${ZINC_DISPLAY:-fbdev}

# ponytail: ready 2 s after the start stands for "the first frame is on screen", which the engine will tell itself (READY=1)
(sleep 2; systemd-notify --ready) &

# Every app has its own group, including children spawned by zinc run.
foreground=0
stop_foreground() {
  [ "$foreground" -gt 1 ] || return 0
  kill -TERM -- "-$foreground" 2>/dev/null || :
  for ((n=0; n<20; n++)); do
    kill -0 -- "-$foreground" 2>/dev/null || break
    sleep 0.05
  done
  kill -KILL -- "-$foreground" 2>/dev/null || :
  wait "$foreground" 2>/dev/null || :
  foreground=0
}
trap 'stop_foreground; exit 0' TERM INT HUP

screen_owner() {
  local owner=''
  read -r owner 2>/dev/null <"$RUN/device-screen" || return 1
  [[ "$owner" =~ ^[0-9]+$ ]] && [ "$owner" -gt 1 ] && kill -0 "$owner" 2>/dev/null || return 1
  printf '%s' "$owner"
}

# Older engine releases have no lease protocol; preserve their display handoff on downgrade.
legacy_has_screen() {
  local p f screen
  while read -r p; do
    for f in /proc/"$p"/fd/*; do
      for screen in /dev/fb0 /dev/dri/card*; do [ "$f" -ef "$screen" ] && return 0; done
    done
  done 2>/dev/null </sys/fs/cgroup/system.slice/zinc-agent.service/cgroup.procs
  return 1
}

# The agent's child cannot execute until this acknowledgement: DRM and input are free first.
yield_screen() {
  local owner
  if ! owner=$(screen_owner); then
    legacy_has_screen || return 1
    stop_foreground
    while legacy_has_screen; do sleep 0.1; done
    return 0
  fi
  stop_foreground
  while owner=$(screen_owner); do
    printf '%s\n' "$owner" >"$RUN/screen-ready.tmp"
    mv "$RUN/screen-ready.tmp" "$RUN/screen-ready"
    sleep 0.1
  done
  sleep 0.5
  return 0
}

launch=1
[ ! -e /var/lib/zinc-update/activating ] || launch=0

# The shell (D194, docs/reports/zinc-shell/03-design.md §3): with ZINC_SHELL=1 the session runs the player as the shell and
# nothing else; the player starts the boot app and the tiles' apps itself (zinc:shell). A GL app's file lease still stops
# it (yield_screen) and starts it again after. Two failures within 60 s: this boot falls back to the loop below.
# ponytail: P3 default 0, the image switches it in P5
CONF=${ZINC_SESSION_CONF:-/etc/zinc/session.conf}
if [ -r "$CONF" ]; then
  conf_shell=$(sed -n 's/^[[:space:]]*ZINC_SHELL=["'\'']*\([01]\).*/\1/p' "$CONF" | tail -n 1)
  [ -z "$conf_shell" ] || ZINC_SHELL=$conf_shell
fi
if [ "${ZINC_SHELL:-0}" = 1 ]; then
  last_failure=0
  while :; do
    if yield_screen; then launch=0; continue; fi
    ZINC_VERSION=$(zinc --version 2>/dev/null | head -n 1)
    export ZINC_VERSION
    rm -f "$RUN/player-ready" "$RUN/next-app" "$RUN/shell.sock"
    ZINC_SHELL_SOCKET="$RUN/shell.sock" ZINC_BOOT_APP=$launch ZINC_PLAYER_READY_FILE="$RUN/player-ready" \
      setsid zinc run "$PLAYER" 0<&0 > >(tee "$RUN/shell.log") 2>&1 &
    foreground=$!
    launch=0
    yielded=0
    while kill -0 "$foreground" 2>/dev/null; do
      if yield_screen; then yielded=1; break; fi
      sleep 0.1
    done
    [ "$yielded" = 0 ] || continue
    wait "$foreground"
    status=$?
    foreground=0
    [ "$status" -ne 0 ] || continue
    now=$(date +%s)
    if [ "$last_failure" -gt 0 ] && [ $((now - last_failure)) -lt 60 ]; then
      { echo "time=$(date '+%Y-%m-%d %H:%M:%S')"; echo "The shell failed twice within 60 s (last status $status): this boot runs the player without it.";
        echo; tail -n 40 "$RUN/shell.log" 2>/dev/null; } >"$RUN/zinc-report.txt"
      launch=1
      break
    fi
    last_failure=$now
    sleep 1
  done
fi

while :; do
  if yield_screen; then launch=0; continue; fi
  ZINC_VERSION=$(zinc --version 2>/dev/null | head -n 1)
  export ZINC_VERSION
  is_app=0
  # an app sent to the device, chosen in the player: its folder (the agent's app.zapp or run.sh), once
  app=$APP
  if [ "$launch" = 1 ] && read -r chosen 2>/dev/null <"$RUN/next-app"; then app=$chosen; fi
  rm -f "$RUN/next-app"
  name=''
  case $app in "$AGENT"/apps/?*) name=${app#"$AGENT"/apps/}; name=${name%%/*} ;; esac
  if [ -f "$app/app.zapp" ]; then app=$app/app.zapp; fi
  if [ "$launch" = 1 ] && [ -e "$app" ]; then
    is_app=1
    rm -f "$RUN/crash.txt"
    log=/dev/null
    if [ -n "$name" ] && mkdir -p "$AGENT/run" "$AGENT/logs"; then log=$AGENT/logs/$name.log; fi
    if [ -f "$app/run.sh" ]; then
      setsid /bin/bash -c '/bin/sh "$1/run.sh" 2>&1 | tee "$2" "$3"; exit ${PIPESTATUS[0]}' _ "$app" "$RUN/app.log" "$log" &
    else
      setsid /bin/bash -c 'zinc run "$1" 2>&1 | tee "$2" "$3"; exit ${PIPESTATUS[0]}' _ "$app" "$RUN/app.log" "$log" &
    fi
  else
    rm -f "$RUN/player-ready"
    ZINC_PLAYER_READY_FILE="$RUN/player-ready" setsid zinc run "$PLAYER" 0<&0 &
  fi
  foreground=$!
  pidfile=''
  if [ "$is_app" = 1 ] && [ -n "$name" ]; then pidfile=$AGENT/run/$name.pid; printf '%s\n' "$foreground" >"$pidfile"; fi
  yielded=0
  while kill -0 "$foreground" 2>/dev/null; do
    if yield_screen; then yielded=1; break; fi
    sleep 0.1
  done
  [ -z "$pidfile" ] || rm -f "$pidfile"
  if [ "$yielded" = 1 ]; then launch=0; continue; fi
  wait "$foreground"
  status=$?
  foreground=0
  # 143: ended by SIGTERM (zinc device stop, the agent's stopApp), no crash
  if [ "$is_app" = 1 ] && [ "$status" -ne 0 ] && [ "$status" -ne 143 ]; then
    { echo "app=$app"; echo "status=$status"; echo "time=$(date '+%Y-%m-%d %H:%M:%S')"; echo; tail -n 80 "$RUN/app.log"; } >"$RUN/crash.txt"
  fi
  case $status in
    10) launch=1 ;;
    0) launch=0 ;;
    *) launch=0; sleep 1 ;;
  esac
done
