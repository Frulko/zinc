#!/bin/bash
# zinc-admin: what the player (image/player) reads of the system and changes in it, as one command with fixed verbs.
# The reading verbs run as the caller (the zinc user); the others run as root through sudo, which /etc/sudoers.d/zinc
# allows for this file alone, without a password. Every argument is checked here before it reaches a system tool.
# The network itself (interfaces, addresses, the Wi-Fi networks, joining one) is zinc:network's (plugins/network), which
# drives NetworkManager as the zinc user (/etc/polkit-1/rules.d/50-zinc-network.rules allows it).
#   status                 key=value lines: hostname, model, os, kernel, uptime (minutes), temperature (degrees C),
#                          memory and disk (available and total MiB), ssh and agent (on/off), country (Wi-Fi)
#   wifi-country <CC>      the Wi-Fi country (two capital letters)
#   ssh on|off             SSH now and at boot
#   agent on|off           the Zinc agent now and at boot
#   shell on|off           the player as the shell (ZINC_SHELL in /etc/zinc/session.conf), then the session starts again
#   hostname <name>        the name on the network (<name>.local)
#   pair                   a new pairing code of the Zinc agent (the player reads it from the agent's pairing.json)
#   mac-usb                lets a Mac's USB-C cable be a network link (builds cdc_ncm for this kernel: zinc-mac-usb)
#   reboot | poweroff
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
die() { echo "$*" >&2; exit 1; }
verb=${1:-}
case $verb in
  status | pair | update-status | update-check) ;;
  *) [ "$(id -u)" = 0 ] || exec sudo -n "$0" "$@" ;;
esac

case $verb in
  identity)
    /usr/bin/python3 -I - <<'PY_IDENTITY'
from pathlib import Path
import os
import re
import secrets
import subprocess

marker = Path('/boot/firmware/zinc-auto-name')
saved = Path('/etc/zinc/device-name')
data = Path('/boot/firmware/user-data')
custom = {}
if data.exists():
    import yaml  # Installed with cloud-init; Imager can replace our JSON with YAML.
    custom = yaml.safe_load(data.read_text()) or {}
if custom.get('hostname'):
    name = custom['hostname']
elif saved.exists():
    name = saved.read_text().strip()
elif marker.exists():
    token = secrets.token_hex(8)[:15]
    name = token[:4] + '-' + token[4:10] + '-' + token[10:]
else:
    raise SystemExit(0)  # An update does not rename an already provisioned card.
if not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', name):
    raise ValueError('Invalid saved device name')
saved.parent.mkdir(parents=True, exist_ok=True)
temporary = saved.with_suffix('.tmp')
with temporary.open('w') as stream:
    stream.write(name + '\n')
    stream.flush()
    os.fsync(stream.fileno())
os.replace(temporary, saved)
directory = os.open(saved.parent, os.O_RDONLY)
try:
    os.fsync(directory)
finally:
    os.close(directory)
Path('/etc/hostname').write_text(name + '\n')
hosts = Path('/etc/hosts')
lines = [line for line in hosts.read_text().splitlines() if not re.match(r'^127\.0\.1\.1\s', line)]
hosts.write_text('\n'.join(lines) + '\n127.0.1.1\t' + name + '\n')
subprocess.run(['/bin/hostname', name], check=True)
marker.unlink(missing_ok=True)
PY_IDENTITY
    ;;
  status)
    echo "hostname=$(hostname)"
    echo "model=$(tr -d '\0' </proc/device-tree/model 2>/dev/null)"
    # shellcheck source=/dev/null
    os=$(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-}")
    echo "os=$os"
    echo "kernel=$(uname -r)"
    read -r up _ </proc/uptime
    echo "uptime=$((${up%.*} / 60))"
    if t=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null); then echo "temperature=$(((t + 500) / 1000))"; fi
    awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { printf "memory=%d %d\n", a / 1024, t / 1024 }' /proc/meminfo
    df -Pk / | awk 'NR == 2 { printf "disk=%d %d\n", $4 / 1024, $2 / 1024 }'
    echo "ssh=$(systemctl is-active -q ssh.service && echo on || echo off)"
    echo "agent=$(systemctl is-active -q zinc-agent.service && echo on || echo off)"
    country=$(iw reg get 2>/dev/null | awk '/^country/ { sub(":", "", $2); print $2; exit }')
    [ "$country" = 00 ] && country=
    echo "country=$country"
    # the boot: "starting" with the job systemd runs (the home page says it), then "running" or "degraded"
    boot=$(systemctl is-system-running 2>/dev/null)
    echo "boot=$boot"
    if [ "$boot" = starting ] || [ "$boot" = initializing ]; then
      unit=$(systemctl list-jobs --no-legend --no-pager 2>/dev/null | awk '$4 == "running" { print $2; exit }')
      [ -z "$unit" ] || echo "activity=$(systemctl show -p Description --value "$unit")"
    fi
    ;;
  wifi-country)
    [[ ${2:-} =~ ^[A-Z]{2}$ ]] || die "A country is two capital letters (FR, US, GB...)."
    raspi-config nonint do_wifi_country "$2"
    ;;
  ssh)
    case ${2:-} in
      on) systemctl enable --now ssh.service ;;
      off) systemctl disable --now ssh.service ;;
      *) die "ssh on or ssh off" ;;
    esac
    ;;
  agent)
    case ${2:-} in
      on) install -o zinc -g zinc -m 644 /dev/null /var/lib/zinc/agent.enabled && systemctl start zinc-agent.service ;;
      off) rm -f /var/lib/zinc/agent.enabled /boot/firmware/zinc-agent && systemctl stop zinc-agent.service ;;
      *) die "agent on or agent off" ;;
    esac
    ;;
  shell)
    case ${2:-} in on) v=1 ;; off) v=0 ;; *) die "shell on or shell off" ;; esac
    conf=/etc/zinc/session.conf
    mkdir -p /etc/zinc && touch "$conf"
    { grep -v '^[[:space:]]*ZINC_SHELL=' "$conf"; echo "ZINC_SHELL=$v"; } > "$conf.tmp" && chmod 644 "$conf.tmp" && mv -f "$conf.tmp" "$conf"
    systemctl restart zinc-shell.service
    ;;
  hostname)
    name=${2:-}
    [[ $name =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || die "A name has small letters, digits and hyphens (not at its ends)."
    hostnamectl set-hostname "$name"
    sed -i "s/^127\.0\.1\.1\s.*/127.0.1.1\t$name/" /etc/hosts
    printf '%s\n' "$name" >/etc/zinc/device-name.tmp && mv -f /etc/zinc/device-name.tmp /etc/zinc/device-name
    rm -f /boot/firmware/zinc-auto-name
    systemctl try-restart avahi-daemon.service
    systemctl try-restart zinc-agent.service
    ;;
  pair)
    zinc agent pair
    ;;
  mac-usb)
    exec /usr/lib/zinc/zinc-mac-usb
    ;;
  update-status | update-check)
    action=status
    [ "$verb" != update-check ] || action=catalog
    exec /usr/bin/python3 -I /usr/lib/zinc/zinc-player-update "$action"
    ;;
  network-restart)
    systemctl reset-failed NetworkManager.service wpa_supplicant.service
    systemctl restart wpa_supplicant.service NetworkManager.service
    ;;
  update-install)
    [[ ${2:-} =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || die "Choose a stable version (X.Y.Z)."
    systemctl start --no-block "zinc-update@$2.service"
    ;;
  update-rollback)
    systemctl start --no-block zinc-update@rollback.service
    ;;
  reboot) systemctl reboot ;;
  poweroff) systemctl poweroff ;;
  *) die "zinc-admin: unknown verb \"$verb\"" ;;
esac
