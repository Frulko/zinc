#!/bin/sh
# Quiet runner: one PASS/FAIL line per test, details in next/.logs/. See next/TESTING.md.
# Tests are executables tests/<tier>/<name>.sh that get $ZINC; tiers are cumulative (t1 includes t0).
# Usage: tests/run [--tier t0|t1|t2] [--only <name>] [--changed]   (env ZINC = binary, default build/zinc)
here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$here")
tier=t0; only=; changed=
while [ $# -gt 0 ]; do
  case $1 in
    --tier) tier=$2; shift 2 ;;
    --only) only=$2; shift 2 ;;
    --changed) changed=1; tier=t1; shift ;;   # only the tests that cover the files changed since HEAD (tests/affected.json)
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done
case $tier in t0) tiers="t0" ;; t1) tiers="t0 t1" ;; t2) tiers="t0 t1 t2" ;; *) echo "bad tier: $tier" >&2; exit 2 ;; esac
export ZINC=${ZINC:-$root/build/zinc}
export ZINC_DETERMINISTIC=1   # the goldens read the virtual clock; tests/t0/clock_real.sh checks both clocks itself
if [ -n "$changed" ]; then   # the names of the tests covering the changed files, one per line
  wanted=$(cd "$root/.." && { git diff --name-only HEAD; git ls-files --others --exclude-standard; } | python3 "$here/affected.py" "$here/affected.json")
  echo "affected tests: $(echo "$wanted" | grep -v '^canary' | tr '\n' ' ')" >&2
  echo "$wanted" | grep -q '^canary$' && echo "pixel canary: tools/proto-capture compare --canary (run it if the change is visible)" >&2
fi
mkdir -p "$root/.logs"
log=$root/.logs/$(date +%Y%m%d-%H%M%S).log
: > "$log"
pass=0; fail=0; skip=0
for t in $tiers; do
  for f in "$here/$t"/*.sh; do
    [ -e "$f" ] || continue
    name=$(basename "$f" .sh)
    [ -z "$only" ] || [ "$only" = "$name" ] || continue
    [ -z "$changed" ] || echo "$wanted" | grep -qx "$name" || continue
    sh "$f" >"$log.tmp" 2>&1; rc=$?
    if [ $rc -eq 0 ]; then
      echo "PASS $name"; pass=$((pass + 1))
    elif [ $rc -eq 77 ]; then
      echo "SKIP $name ($(head -c 80 "$log.tmp"))"; skip=$((skip + 1))   # exit 77: a prerequisite of the machine is missing, said in the first line
    else
      echo "FAIL $name"; fail=$((fail + 1))
      { echo "=== $name"; cat "$log.tmp"; } >> "$log"
    fi
  done
done
rm -f "$log.tmp"
extra=""; [ "$skip" -gt 0 ] && extra=", $skip skipped"
echo "$pass passed, $fail failed$extra"
if [ "$fail" -gt 0 ]; then echo "log: $log"; head -20 "$log"; exit 1; fi
rm -f "$log"
