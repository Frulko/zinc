{
  "format": "zinc-pinball-table",
  "version": 1,
  "name": "New table",
  "playfield": { "surface": "wood", "look": "board" },
  "physics": { "ball": { "look": "chrome" } },
  "surfaces": [
    { "id": "wood", "friction": 0.2, "restitution": 0.3 },
    { "id": "metal", "friction": 0.25, "restitution": 0.45 },
    { "id": "rubber", "friction": 0.6, "restitution": 0.75 },
    { "id": "plastic", "restitution": 0.35 },
    { "id": "bat", "friction": 0.7, "restitution": 0.55 }
  ],
  "looks": [
    { "id": "board", "color": "#1b2a4a" },
    { "id": "steel", "color": "#9aa4b4", "specular": "#8090a8", "shininess": 60 },
    { "id": "chrome", "color": "#d8dce4", "specular": "#ffffff", "shininess": 140 },
    { "id": "rubber", "color": "#c8283c", "shading": "flat" },
    { "id": "bat", "color": "#f0f0f6", "specular": "#606070" },
    { "id": "bumper", "color": "#20386e", "glow": "#7fd8ff" },
    { "id": "cap", "color": "#ff7a33", "specular": "#553a22", "shininess": 40 },
    { "id": "target", "color": "#b37a14", "glow": "#ffd866" },
    { "id": "ramp", "color": "#2a62b8" }
  ],
  "walls": [
    { "id": "shooterLane", "points": [[46.7, 106], [46.7, 30]] }
  ],
  "gates": [
    { "id": "laneGate", "a": [50, 28.5], "b": [46.7, 28.5] }
  ],
  "flippers": [
    { "id": "flipper1", "group": "flippers", "pivot": [14.5, 94], "surface": "bat", "look": "bat" },
    { "id": "flipper2", "group": "flippers", "pivot": [33.1, 94], "rest": 155, "stroke": 50, "button": "right", "surface": "bat", "look": "bat" }
  ],
  "plunger": { "at": [48.35, 100], "surface": "metal", "look": "steel" },
