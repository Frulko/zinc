{
  "$comment": "First version of each browser that ships a web feature (null: not shipped), from MDN browser-compat-data and caniuse as read on 2026-10-17. Chrome stands for Chromium browsers (Edge, Opera, Brave, Samsung Internet follow it; edge is listed apart for the versions that differ), safari also answers for iOS (every iOS browser is WebKit). Names are the keys of features() in targets/web/runtime.js. 'note' is shown with a warning. Only Chrome is tested by the project; the rest of the table is research, not a run.",
  "browsers": ["chrome", "edge", "firefox", "safari"],
  "baseline": "chrome >= 111, edge >= 111, firefox >= 115, safari >= 16.4",
  "core": ["modules", "importmap", "canvas2d", "roundRect", "pointerEvents", "resizeObserver"],
  "features": {
    "modules":           {"chrome": 61, "edge": 16, "firefox": 60, "safari": 11, "note": "ES modules"},
    "importmap":         {"chrome": 89, "edge": 89, "firefox": 108, "safari": 16.4, "note": "import maps (the page resolves zinc:native with one)"},
    "canvas2d":          {"chrome": 1, "edge": 12, "firefox": 1.5, "safari": 2},
    "roundRect":         {"chrome": 99, "edge": 99, "firefox": 112, "safari": 16, "note": "CanvasRenderingContext2D.roundRect"},
    "conicGradient":     {"chrome": 99, "edge": 99, "firefox": 112, "safari": 16.4, "note": "conic-gradient fills in canvas mode"},
    "letterSpacing":     {"chrome": 99, "edge": 99, "firefox": 115, "safari": 18.4, "note": "canvas letterSpacing (tracking); without it text is drawn without tracking"},
    "pointerEvents":     {"chrome": 55, "edge": 12, "firefox": 59, "safari": 13},
    "resizeObserver":    {"chrome": 64, "edge": 79, "firefox": 69, "safari": 13.1},
    "offscreenCanvas":   {"chrome": 69, "edge": 79, "firefox": 105, "safari": 16.4},
    "webgl2":            {"chrome": 56, "edge": 79, "firefox": 51, "safari": 15},
    "webgpu":            {"chrome": 113, "edge": 113, "firefox": 141, "safari": 26, "note": "Firefox: Windows first; Safari 26"},
    "getUserMedia":      {"chrome": 53, "edge": 12, "firefox": 36, "safari": 11, "note": "needs a secure context (https or localhost)"},
    "screenCapture":     {"chrome": 72, "edge": 79, "firefox": 66, "safari": 13},
    "audio":             {"chrome": 35, "edge": 12, "firefox": 25, "safari": 14.1, "note": "Web Audio; starts after the first click or key (autoplay policy)"},
    "audioWorklet":      {"chrome": 66, "edge": 79, "firefox": 76, "safari": 14.1},
    "webrtc":            {"chrome": 56, "edge": 79, "firefox": 44, "safari": 11},
    "websocket":         {"chrome": 4, "edge": 12, "firefox": 11, "safari": 5},
    "webusb":            {"chrome": 61, "edge": 79, "firefox": null, "safari": null, "note": "Chromium browsers only, secure context"},
    "webserial":         {"chrome": 89, "edge": 89, "firefox": null, "safari": null, "note": "Chromium browsers only, secure context"},
    "webbluetooth":      {"chrome": 56, "edge": 79, "firefox": null, "safari": null, "note": "Chromium browsers only (not on iOS)"},
    "webhid":            {"chrome": 89, "edge": 89, "firefox": null, "safari": null, "note": "Chromium browsers only"},
    "webmidi":           {"chrome": 43, "edge": 79, "firefox": 108, "safari": null, "note": "asks for permission"},
    "fileSystemAccess":  {"chrome": 86, "edge": 86, "firefox": null, "safari": null, "note": "showOpenFilePicker and friends; Safari and Firefox have only the origin-private file system"},
    "clipboard":         {"chrome": 66, "edge": 79, "firefox": 63, "safari": 13.1, "note": "async clipboard, on a user gesture"},
    "notifications":     {"chrome": 22, "edge": 14, "firefox": 22, "safari": 16, "note": "iOS: only for an installed web app (16.4)"},
    "gamepad":           {"chrome": 21, "edge": 12, "firefox": 29, "safari": 10.1},
    "vibrate":           {"chrome": 32, "edge": 79, "firefox": 16, "safari": null, "note": "Firefox: Android only"},
    "wakeLock":          {"chrome": 84, "edge": 84, "firefox": 126, "safari": 16.4},
    "share":             {"chrome": 89, "edge": 93, "firefox": null, "safari": 12.1, "note": "Firefox desktop has no Web Share"},
    "serviceWorker":     {"chrome": 45, "edge": 17, "firefox": 44, "safari": 11.1, "note": "the offline cache; the app runs without it"},
    "indexedDB":         {"chrome": 24, "edge": 12, "firefox": 16, "safari": 10},
    "wasm":              {"chrome": 57, "edge": 16, "firefox": 52, "safari": 11, "note": "WebAssembly (plugins compiled to wasm)"},
    "crossOriginIsolated": {"chrome": 92, "edge": 92, "firefox": 79, "safari": 15.2, "note": "SharedArrayBuffer and wasm threads: the page must be served with COOP and COEP (the exported service worker adds them where the host cannot)"},
    "compressionStreams": {"chrome": 80, "edge": 80, "firefox": 113, "safari": 16.4},
    "speechRecognition": {"chrome": 33, "edge": 79, "firefox": null, "safari": 14.1, "note": "prefixed in Chrome and Safari"},
    "speechSynthesis":   {"chrome": 33, "edge": 14, "firefox": 49, "safari": 7},
    "batteryStatus":     {"chrome": 38, "edge": 79, "firefox": null, "safari": null}
  }
}
