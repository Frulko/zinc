# cmake -DZBC=program.zbc [-DRES=resources.bin] -DOUT=embedded_program.c -P embed.cmake: the program as C arrays for a core that reads no file
# (core_main.cpp's zn_console_program and zn_console_resources).
function(zn_array var file out)
  file(READ ${file} hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
  file(APPEND ${out} "static const unsigned char ${var}_bytes[${bytes} + 1] = {${body}0};\nconst unsigned char* zn_console_${var} = ${var}_bytes;\nunsigned long zn_console_${var}_size = ${bytes};\n")
endfunction()
file(WRITE ${OUT} "/* generated by targets/console/embed.cmake */\n")
zn_array(program ${ZBC} ${OUT})
if(RES)
  zn_array(resources ${RES} ${OUT})
endif()
