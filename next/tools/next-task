#!/usr/bin/env python3
"""Print the task to work on: `TASK ZN-xxx <title>` or `STOP nothing left`.

Order: the task In Progress, else the lowest-ordinal Ready or Backlog task that is not parked and whose dependencies are all Done or Review.
(Review counts: its follow-up tasks hold what is left.) Labels: `parked` (needs a board, Windows or the owner; see RULES.md) is skipped.
`next-task --list [N]` prints the next N startable tasks; `--why` explains what is skipped and why. Used by /zn-start, /zn-end and tools/status.
"""
import glob, os, re, sys

root = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "backlog", "tasks")

def parse(path):
    text = open(path, encoding="utf-8").read()
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    if not m:
        return None
    fm, cur, t = {}, None, {}
    for line in m.group(1).split("\n"):
        if re.match(r"^\s+- ", line) and cur:
            t.setdefault(cur, []).append(line.strip()[2:].strip().strip("'\""))
            continue
        k = re.match(r"^([a-z_]+):\s*(.*)$", line)
        if k:
            cur = k.group(1)
            v = k.group(2).strip()
            if v in ("[]", ""):
                t[cur] = []
            elif v == ">-":
                t[cur] = ""
            else:
                t[cur] = v.strip("'\"")
        elif cur and line.startswith("  ") and isinstance(t.get(cur), str):
            t[cur] += " " + line.strip()
    t["title"] = " ".join(str(t.get("title", "")).split())
    t["path"] = path
    return t

tasks = {}
for p in glob.glob(os.path.join(root, "zn-*.md")):
    t = parse(p)
    if t and t.get("id"):
        tasks[t["id"]] = t

def ordinal(t):
    try:
        return float(t.get("ordinal", 1e12))
    except ValueError:
        return 1e12

def status(t):
    return t.get("status", "")

def skipped(t):
    if "parked" in t.get("labels", []):
        return "parked"
    for d in t.get("dependencies", []):
        dt = tasks.get(d)
        if dt is None:
            return "unknown dependency " + d
        if status(dt) not in ("Done", "Review"):
            return "waits for " + d
    return None

import json
try:
    groups = json.load(open(os.path.join(root, "..", "priority.json")))["groups"]
except (OSError, ValueError, KeyError):
    groups = []

def group_of(t):
    """Index of the first priority group (backlog/priority.json) the task belongs to; len(groups) when none."""
    for i, g in enumerate(groups):
        title = t.get("title", "")
        if g.get("exclude_title") and re.search(g["exclude_title"], title):
            continue
        if t.get("milestone") in g.get("milestones", []) or any(l in t.get("labels", []) for l in g.get("labels", [])) or (g.get("title") and re.search(g["title"], title)):
            return 1000 + i if g.get("last") else i   # a "last" group sorts after the tasks no group claims
    return len(groups)

def startable():
    cands = [t for t in tasks.values() if status(t) in ("Ready", "Backlog") and skipped(t) is None]
    return sorted(cands, key=lambda t: (group_of(t), ordinal(t)))

args = sys.argv[1:]
working = sorted([t for t in tasks.values() if status(t) == "In Progress"], key=ordinal)
if "--list" in args:
    n = int(args[args.index("--list") + 1]) if len(args) > args.index("--list") + 1 else 10
    for t in (working + startable())[:n]:
        print("%s %-11s %s" % (t["id"], status(t), t["title"]))
    sys.exit(0)
if "--why" in args:
    for t in sorted(tasks.values(), key=ordinal):
        if status(t) in ("Ready", "Backlog"):
            print("%s %s: %s" % (t["id"], t["title"][:60], skipped(t) or "startable"))
    sys.exit(0)
pick = working[0] if working else (startable()[0] if startable() else None)
if pick is None:
    waiting = [t for t in tasks.values() if status(t) in ("Ready", "Backlog")]
    print("STOP nothing left (%d tasks parked or waiting on dependencies)" % len(waiting))
else:
    print("TASK %s %s" % (pick["id"], pick["title"]))
