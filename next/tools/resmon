#!/usr/bin/env python3
"""resmon: CPU, RSS and energy of a command (ZN-046).

usage: tools/resmon [--interval S] [--energy] [--no-samples] -- <command> [args...]
Prints a JSON object (see tools/zn_resmon.py) on stdout and a one-line summary on stderr. The command's own output is discarded.
Works with anything: `tools/resmon -- build/zinc run prog.zbc`, `tools/resmon -- ./compiled-program`.
"""
import json, os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import zn_resmon

args = sys.argv[1:]
interval, energy, keep = 0.05, False, True
while args and args[0] != "--":
    a = args.pop(0)
    if a == "--interval": interval = float(args.pop(0))
    elif a == "--energy": energy = True
    elif a == "--no-samples": keep = False
    else: sys.exit(__doc__)
if not args or len(args) < 2:
    sys.exit(__doc__)
r = zn_resmon.measure(args[1:], interval, energy)
if not keep: r["samples"] = []
print(json.dumps(r, indent=1))
sys.stderr.write(f"resmon: {r['wall_s']:.2f} s wall, {r['user_s']:.2f} s user, {r['sys_s']:.2f} s system, peak RSS {r['peak_rss_mb']:.1f} MB" +
                 (f", energy {r['energy_mj']:.0f} mJ" if r["energy_mj"] is not None else f" (energy: {r['energy_note'] or 'n/a'})") + f", exit {r['exit']}\n")
sys.exit(r["exit"])
