#!/bin/sh
# zinc for Linux, built on this machine in a container (ZN-729.07): the engine for a Raspberry Pi or another Linux device, with no build there.
#   tools/linux-build [--arch arm64|amd64] [--jobs n] [--test name]... [--no-package] [target...]     (default: arm64, the target zinc, then the package)
#   tools/linux-build --shell                                                              a shell in the container, in next/
# The container is Debian trixie (the system of the Raspberry Pi OS of 2025, glibc 2.41): what it builds runs on that system and newer ones.
# It builds from the checkout this script is in, through tools/build, in next/build-linux-<arch> (never the machine's own next/build), then
# tools/package writes next/dist/linux-<arch>/zinc-<version>-linux-<machine>.tar.gz (bin/zinc, lib, share/zinc) and the last line says where.
# --test runs tests/run --tier t1 --only <name> in the container, as a plain user (the agent refuses root), with the engine just built.
# It stays polite beside other work: 4 compile jobs and 4 CPUs for the container, whatever the machine has (--jobs n or ZN_BUILD_JOBS for more).
# ccache, the pinned tools and the container's home are kept in the Docker volume zinc-linux-build-<arch>, so a second tree or a second run reuses
# them. ZN_LINUX_IMAGE names another base image (an older Debian for an older device); DOCKER another command (podman).
here=$(cd "$(dirname "$0")" && pwd -P)
repo=$(dirname "$(dirname "$here")")
docker=${DOCKER:-docker}
arch=arm64 tests= package=1 shell= jobs=${ZN_BUILD_JOBS:-4}
while [ $# -gt 0 ]; do
  case $1 in
    --arch) arch=${2:?--arch arm64|amd64}; shift 2 ;;
    --jobs) jobs=${2:?--jobs n}; shift 2 ;;
    --test) tests="$tests ${2:?--test name}"; shift 2 ;;
    --no-package) package=; shift ;;
    --shell) shell=1; shift ;;
    -*) sed -n '2,4p' "$0" >&2; exit 2 ;;
    *) break ;;
  esac
done
base=${ZN_LINUX_IMAGE:-debian:trixie}
image=zinc/linux-build-$(printf %s "$base" | tr -c 'a-z0-9.\n' -)-$arch
# the libraries SDL3 looks for when it is configured (X11, KMS/DRM, EGL, udev): it loads them at run time, so zinc starts without them.
# No Wayland: third_party/SDL3 is vendored without its wayland-protocols, so with libwayland-dev installed its configure turns on a backend it cannot build
"$docker" image inspect "$image" >/dev/null 2>&1 || "$docker" build --platform "linux/$arch" -t "$image" --build-arg "UID=$(id -u)" - <<EOF || exit 2
FROM $base
ARG UID=1000
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates cmake make g++ ccache python3 curl xz-utils file patchelf pkg-config git \
      libx11-dev libxext-dev libxcursor-dev libxi-dev libxfixes-dev libxrandr-dev libxss-dev libxtst-dev libgl1-mesa-dev \
      libegl1-mesa-dev libgles2-mesa-dev libdrm-dev libgbm-dev libudev-dev \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u \$UID -s /bin/sh zinc && mkdir /cache && chown zinc /cache
USER zinc
ENV HOME=/cache CCACHE_DIR=/cache/ccache ZINC_HOME=/cache/zinc
EOF
tty=; [ -t 0 ] && [ -t 1 ] && tty=-it
run() { "$docker" run --rm $tty --platform "linux/$arch" --cpus "$jobs" -v "$repo:/zinc" -v "zinc-linux-build-$arch:/cache" -w /zinc/next \
          -e "ZN_BUILD_JOBS=$jobs" -e ZN_BUILD_LOAD -e ZINC_VERSION -e "BUILD_DIR=/zinc/next/build-linux-$arch" "$image" "$@"; }
[ -z "$shell" ] || { run sh; exit $?; }
run tools/build "$@" || exit 1
for t in $tests; do
  run sh -c "ZINC=\$BUILD_DIR/zinc tests/run --tier t1 --only $t" || exit 1
done
[ -n "$package" ] || { echo "linux-build: $repo/next/build-linux-$arch/zinc"; exit 0; }
run tools/package --build "build-linux-$arch" --out "dist/linux-$arch"
case $? in 0) ;; 3) echo "linux-build: over the size budget of a release (above); the package is usable" >&2 ;; *) exit 1 ;; esac
echo "linux-build: $(ls -t "$repo/next/dist/linux-$arch"/zinc-*.tar.gz | head -1)"
