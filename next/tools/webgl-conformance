#!/usr/bin/env python3
"""Khronos WebGL conformance pages on the QuickJS engine (ZN-203.04).

usage: tools/webgl-conformance [--list tests/golden/webgl/conformance-pass.txt] [--dir conformance/buffers ...] [--write-lists] [--timeout 20] [page.html ...]
The suite is vendored in third_party/webgl-conformance (pinned commit in PIN, MIT). Each page is parsed (scripts in order, the elements that have an id), bundled with
tests/webgl-conformance/dom-shim.js and run by `zinc run --engine quickjs`; results come from window.parent.webglTestHarness (@R lines), a page passes when it reports at least
one PASS, no FAIL, no uncaught error and finishes. Without --write-lists: exit 1 when a page of the pass list (tests/golden/webgl/conformance-pass.txt) fails: the gate.
--write-lists: rewrite the pass list and tests/golden/webgl/conformance-failures.txt (page, first reason) from this run.
"""
import html.parser, json, os, subprocess, sys, tempfile, time, concurrent.futures

HERE = os.path.dirname(os.path.abspath(__file__)); NEXT = os.path.dirname(HERE)
SUITE = os.path.join(NEXT, "third_party", "webgl-conformance", "sdk", "tests")
SHIM = os.path.join(NEXT, "tests", "webgl-conformance", "dom-shim.js")
PASS_LIST = os.path.join(NEXT, "tests", "golden", "webgl", "conformance-pass.txt")
FAIL_LIST = os.path.join(NEXT, "tests", "golden", "webgl", "conformance-failures.txt")
zinc = os.environ.get("ZINC", os.path.join(NEXT, "build", "zinc"))
DIRS = ["attribs", "buffers", "context", "limits", "misc", "programs", "reading", "renderbuffers", "rendering", "state", "typedarrays", "uniforms"]
DIRS2 = ["attribs", "buffers", "context", "misc", "programs", "query", "reading", "renderbuffers", "rendering", "samplers", "state", "sync", "transform_feedback", "uniforms", "vertex_arrays"]   # conformance2: pages are named conformance2/<dir>/<page>

class Page(html.parser.HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.scripts = []; self.elements = []; self._cur = None; self._text = []; self.title = ""; self.body_onload = ""
    def handle_starttag(self, tag, attrs):
        a = dict((k, v if v is not None else "") for k, v in attrs)
        if tag == "body" and a.get("onload"): self.body_onload = a["onload"]
        if tag == "title": self._intitle = True
        if tag == "script":
            t = a.get("type", "").lower()
            self._cur = {"src": a.get("src"), "type": t, "id": a.get("id"), "attrs": a, "text": ""}
            return
        if a.get("id"): self.elements.append({"tag": tag, "id": a["id"], "attrs": a, "text": ""})
    def handle_endtag(self, tag):
        if tag == "title": self._intitle = False
        if tag == "script" and self._cur is not None:
            c = self._cur; self._cur = None
            if c["type"] in ("", "text/javascript", "application/javascript", "module"):
                self.scripts.append(c)
            elif c["id"]:   # shader sources and data blocks: elements with a text
                self.elements.append({"tag": "script", "id": c["id"], "attrs": c["attrs"], "text": c["text"]})
    def handle_data(self, data):
        if getattr(self, "_intitle", False): self.title += data
        if self._cur is not None: self._cur["text"] += data

import re
def sloppy(code):
    # a browser makes the top-level vars of a "use strict" script global; an indirect eval keeps them local, so the directive is dropped (the pages are written to pass either way)
    code = re.sub(r"""(["'])use strict\1;?""", "", code[:700], count=1) + code[700:]
    # the same for the lexical top level of a classic script (shared by the scripts of a page, local to an eval): column-0 const/let/class become var
    code = re.sub(r"^(const|let) ", "var ", code, flags=re.M)
    return re.sub(r"^class (\w+)", r"var \1 = class \1", code, flags=re.M)

def read(p): return open(p, encoding="utf-8", errors="replace").read()

SLOW = {"rendering/multisample-corruption.html": 90}   # 25 contexts and a 16 MB pixel check in script: about 35 s

def run_page(rel, timeout):
    timeout = max(timeout, SLOW.get(rel, 0))
    path = rel if os.path.isabs(rel) else os.path.join(SUITE, rel) if rel.startswith("conformance2/") else os.path.join(SUITE, "conformance", rel)
    p = Page(); p.feed(read(path))
    base = os.path.dirname(path)
    p.elements = [{"tag": "script", "id": "", "attrs": {"src": sc["src"]}, "text": ""} for sc in p.scripts if sc["src"]] + p.elements
    p.elements.append({"tag": "title", "id": "", "attrs": {}, "text": p.title})   # document.getElementsByTagName("title")   # getResourcePath() finds js/webgl-test-utils.js among the script elements
    parts = ["globalThis.__pageDir = %s; globalThis.__pagePath = %s;" % (json.dumps(base), json.dumps("/" + os.path.relpath(path, os.path.dirname(SUITE)))), read(SHIM), "__buildPage(%s);" % json.dumps(p.elements), "globalThis.__postJs = %s;" % json.dumps(read(os.path.join(SUITE, "js", "js-test-post.js")))]
    for s in p.scripts:
        if s["src"]:
            f = os.path.normpath(os.path.join(base, s["src"].split("?")[0]))
            if not os.path.isfile(f): parts.append("console.log('@E missing script %s');" % s["src"]); continue
            code = read(f)
        else: code = s["text"]
        code = sloppy(code)
        parts.append("try { (0, eval)(%s); } catch (e) { console.log('@E', String(e && e.message || e), '|', String(e && e.stack || '').split('\\n').slice(0, 2).join(' | ')); }" % json.dumps(code))
    if p.body_onload: parts.append("globalThis.__bodyOnload = %s;" % json.dumps(p.body_onload))   # <body onload="init()">
    parts.append("__fireLoad();")
    with tempfile.TemporaryDirectory() as d:
        b = os.path.join(d, "bundle.js"); open(b, "w").write("\n".join(parts))
        if os.environ.get("WGC_BUNDLE"): open(os.environ["WGC_BUNDLE"], "w").write("\n".join(parts))   # keep the bundle to run it by hand
        try:
            for attempt in range(60):   # a machine out of memory refuses to start the process: wait for it
                try: r = subprocess.run([zinc, "run", b, "--engine", "quickjs"], capture_output=True, text=True, timeout=timeout, env=dict(os.environ, ZINC_HEADLESS="1")); break
                except OSError as e:
                    if e.errno not in (11, 12) or attempt == 59: raise
                    time.sleep(3)
            out, code = r.stdout + r.stderr, r.returncode
        except subprocess.TimeoutExpired as e:
            out, code = (e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")), -9
    if os.environ.get("WGC_SHOW"): print(out if os.environ["WGC_SHOW"] == "full" else out[-3000:], "exit", code)
    passes = fails = 0; reason = ""; finished = False
    for line in out.splitlines():
        if line.startswith("@R 1"): passes += 1
        elif line.startswith("@R 0"):
            fails += 1; reason = reason or line[5:140]
        elif line.startswith("@E"): fails += 1; reason = reason or line[:160]
        elif line.startswith("@F"): finished = True
    if code == -9: reason = reason or "timeout"
    elif code != 0: reason = reason or "exit %d: %s" % (code, out.strip().splitlines()[-1][:100] if out.strip() else "")
    ok = passes > 0 and fails == 0 and code == 0 and finished
    if not ok and not reason: reason = "no PASS" if passes == 0 else "did not finish"
    return rel, ok, passes, fails, reason

NEWDIRS = ["extensions", "glsl", "textures"]; NEWDIRS2 = ["extensions", "glsl3", "textures"]   # the lists of these honour --min-version / --max-version (the suite is 1.0.4 / 2.0.1) and nested 00_test_list.txt; the older dirs above skip every line that has a flag (pages not run)
def vtuple(v): return tuple(int(x) for x in v.split("."))
def walk(root, d, ver):
    out = []; lst = os.path.join(root, d, "00_test_list.txt")
    if not os.path.isfile(lst): return out
    for line in read(lst).splitlines():
        t = line.strip().split("#")[0].split()
        if not t: continue
        lo = hi = None; i = 0
        while i < len(t) - 1:
            if t[i] == "--min-version": lo = vtuple(t[i + 1])
            elif t[i] == "--max-version": hi = vtuple(t[i + 1])
            i += 2 if t[i] in ("--min-version", "--max-version") else 1
        if (lo and lo > ver) or (hi and hi < ver): continue
        f = t[-1]
        if f.endswith("00_test_list.txt"): out += walk(root, os.path.normpath(os.path.join(d, os.path.dirname(f))), ver)
        elif f.endswith(".html") and os.path.isfile(os.path.join(root, d, f)): out.append(os.path.normpath(os.path.join(d, f)))
    return out

def pages(args):
    if args: return args
    out = []
    for d in DIRS:
        lst = os.path.join(SUITE, "conformance", d, "00_test_list.txt")
        for line in read(lst).splitlines():
            line = line.strip().split("#")[0].strip()
            if not line or line.startswith("--") or not line.endswith(".html"): continue
            if os.path.isfile(os.path.join(SUITE, "conformance", d, line)): out.append(d + "/" + line)
    for d in DIRS2:
        lst = os.path.join(SUITE, "conformance2", d, "00_test_list.txt")
        if not os.path.isfile(lst): continue
        for line in read(lst).splitlines():
            line = line.strip().split("#")[0].strip()
            if not line or line.startswith("--") or not line.endswith(".html"): continue
            if os.path.isfile(os.path.join(SUITE, "conformance2", d, line)): out.append("conformance2/" + d + "/" + line)
    for d in NEWDIRS: out += walk(os.path.join(SUITE, "conformance"), d, (1, 0, 4))
    for d in NEWDIRS2: out += ["conformance2/" + p for p in walk(os.path.join(SUITE, "conformance2"), d, (2, 0, 1))]
    return out

def main(argv):
    timeout, write, only, rest = 20, False, [], []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--timeout": timeout = int(argv[i + 1]); i += 2
        elif a == "--write-lists": write = True; i += 1
        elif a == "--dir": only.append(argv[i + 1]); i += 2
        else: rest.append(a); i += 1
    todo = pages(rest)
    if only: todo = [t for t in todo if t.split("/")[0] in only or "/".join(t.split("/")[:2]) in only]
    with concurrent.futures.ThreadPoolExecutor(max_workers=int(os.environ.get("WGC_JOBS", "4"))) as ex: results = list(ex.map(lambda t: run_page(t, timeout), todo))
    npass = sum(1 for r in results if r[1])
    for rel, ok, p, f, why in results: print("%s %-60s %3d pass %3d fail %s" % ("PASS" if ok else "FAIL", rel, p, f, "" if ok else why))
    print("webgl-conformance: %d of %d pages pass" % (npass, len(results)))
    import resource
    if os.environ.get("WGC_RSS"): print("largest child: %d MB" % (resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss // 1048576))
    if write:
        os.makedirs(os.path.dirname(PASS_LIST), exist_ok=True)
        open(PASS_LIST, "w").write("".join(r[0] + "\n" for r in sorted(results) if r[1]))
        open(FAIL_LIST, "w").write("".join("%s\t%s\n" % (r[0], r[4]) for r in sorted(results) if not r[1]))
        return 0
    expected = set(l.strip() for l in read(PASS_LIST).splitlines()) if os.path.isfile(PASS_LIST) else set()
    bad = [r for r in results if r[0] in expected and not r[1]]
    for r in bad: print("REGRESSION", r[0], r[4])
    return 1 if bad else 0

sys.exit(main(sys.argv[1:]))
