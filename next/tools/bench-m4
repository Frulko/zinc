#!/usr/bin/env python3
"""M4 benchmark table (ZN-024): interpreter, AOT, QuickJS and the current native toolchain on the bench kernels.

usage: tools/bench-m4 [--runs N] [--out bench/m4.json] [--md docs]   (default 11 runs, one warm-up each, median reported)
Interpreter time is `zinc run kernel.zbc` (compile excluded); AOT is the program `zinc build` writes; QuickJS is `qjs` on the
kernel with its types stripped by Node; native is the old toolchain's release binary in tests/bench/kernels/build/<k>-macos when
present. Every engine's output is compared with corpus/bench/<k>.out first. Losses are printed and kept in the artifact.
Thresholds (TESTING.md, M4): AOT within 3x of native on fib, nbody, binarytrees, sort; interpreter at least 5x faster than
QuickJS on the numeric kernels (fib, nbody, mandelbrot, spectralnorm, fannkuchredux) and not slower on strings, jsonout and dynsum.
"""
import json, math, os, platform, shlex, statistics, subprocess, sys, tempfile, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import zn_resmon

args = sys.argv[1:]
runs, out, md = 11, "bench/m4.json", "../docs/reports/zinc-next-m4-benchmarks.md"
baseline, baseline_zinc, check, tolerance = None, None, False, 0.15
only, inject, relative, startup_on = None, 1.0, False, True
while args:
    a = args.pop(0)
    if a == "--runs": runs = int(args.pop(0))
    elif a == "--out": out = args.pop(0)
    elif a == "--md": md = args.pop(0)
    elif a == "--baseline": baseline = args.pop(0)      # a bench json to compare with (default: the one committed at HEAD)
    elif a == "--baseline-zinc": baseline_zinc = os.path.abspath(args.pop(0))  # measure a fixed reference build on this machine
    elif a == "--check-regressions": check = True       # exit 3 when a time or peak RSS is more than `tolerance` worse than the baseline
    elif a == "--tolerance": tolerance = float(args.pop(0))
    elif a == "--kernels": only = args.pop(0).split(",")   # a subset (the CI gate)
    elif a == "--inject-slowdown": inject = float(args.pop(0))   # multiplies the interpreter and AOT times: the test that the gate fails on a 20% slowdown
    elif a == "--relative": relative = True              # compare each engine's time with QuickJS's of the same run, so the baseline of another machine still means something
    elif a == "--no-startup": startup_on = False
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(root)
zinc = os.environ.get("ZINC", os.path.join(root, "build/zinc"))
os.environ["ZINC_RUN"] = "interp"  # benchmark bytecode, independently of zinc run's compiled-run default
if baseline_zinc:
    relative = False  # the reference and candidate use this machine; no cross-engine hardware normalization
kernels = ["fib", "nbody", "mandelbrot", "spectralnorm", "fannkuchredux", "binarytrees", "sort", "mapset", "strings", "jsonout", "dynsum"]
if only: kernels = [k for k in kernels if k in only]
if not kernels or runs < 1:
    print("Benchmark requires known kernels and at least one run", file=sys.stderr)
    sys.exit(2)
numeric = {"fib", "nbody", "mandelbrot", "spectralnorm", "fannkuchredux"}
aot_native = {"fib", "nbody", "binarytrees", "sort"}
no_slower = {"strings", "jsonout", "dynsum"}
tmp = tempfile.mkdtemp()

def run(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)

diagnostics = []

def valid_output(cmd, r, expect):
    if r.returncode == 0 and r.stdout == expect:
        return True
    diagnostics.append(f"{cmd}: exit {r.returncode}, stdout {r.stdout[:1000]!r}, stderr {r.stderr[:1000]!r}")
    return False

def medians_of(cmds, expect):
    valid = [valid_output(cmd, run(cmd), expect) for cmd in cmds]
    samples = [[] for cmd in cmds]
    for sample in range(runs):
        order = range(len(cmds)) if sample % 2 == 0 else reversed(range(len(cmds)))
        for i in order:  # warm both builds, then alternate paired samples to avoid first/last timing bias
            if not valid[i]: continue
            t = time.perf_counter(); r = run(cmds[i]); elapsed = time.perf_counter() - t
            valid[i] = valid_output(cmds[i], r, expect)
            samples[i].append(elapsed)
    measured = []
    for cmd, ok, times in zip(cmds, valid, samples):
        if not ok:
            measured.append(None)
            continue
        res = zn_resmon.measure(shlex.split(cmd), interval=0.02)  # one extra run: CPU time and peak RSS
        if res["exit"] != 0:
            diagnostics.append(f"{cmd}: resource sample exited {res['exit']}")
            measured.append(None)
            continue
        measured.append({"median_s": statistics.median(times), "min_s": min(times), "max_s": max(times), "runs_s": times,
                         "user_s": res["user_s"], "sys_s": res["sys_s"], "peak_rss_mb": res["peak_rss_mb"]})
    return measured

def median_of(cmd, expect):
    return medians_of([cmd], expect)[0]

results, reference_results, failures = {}, {}, []
for k in kernels:
    src = f"../tests/bench/kernels/{k}.ts"
    expect = open(f"corpus/bench/{k}.out").read()
    js = f"{tmp}/{k}.js"
    if not baseline_zinc:
        open(js, "w").write(run(f"node -e \"const m=require('module');process.stdout.write(m.stripTypeScriptTypes(require('fs').readFileSync('{src}','utf8')))\"").stdout)
    zbc = f"{tmp}/{k}.zbc"
    compiled = run(f"{zinc} --emit=zbc-bin {src} {zbc}")
    aot = f"{tmp}/{k}.aot"
    b = run(f"{zinc} build {src} -o {aot}")
    nat = f"../tests/bench/kernels/build/{k}-macos/cmake/app"
    cell = {e: None for e in ("interp", "aot", "quickjs", "native")}
    for label, r in (("bytecode", compiled), ("AOT", b)):
        if r.returncode: diagnostics.append(f"{k}: {label} compile exited {r.returncode}: {r.stderr[:1000]}")
    if baseline_zinc:
        ref = shlex.quote(baseline_zinc)
        ref_zbc, ref_aot = f"{tmp}/{k}.reference.zbc", f"{tmp}/{k}.reference.aot"
        rc = run(f"{ref} --emit=zbc-bin {src} {ref_zbc}")
        rb = run(f"{ref} build {src} -o {ref_aot}")
        reference_results[k] = {}
        for e, cmd, ref_cmd, built, ref_built in (
                ("interp", f"{zinc} run {zbc}", f"{ref} run {ref_zbc}", compiled, rc),
                ("aot", aot, ref_aot, b, rb)):
            if built.returncode == 0 and ref_built.returncode == 0:
                cell[e], reference_results[k][e] = medians_of([cmd, ref_cmd], expect)
            else:
                cell[e] = median_of(cmd, expect) if built.returncode == 0 else None
                reference_results[k][e] = median_of(ref_cmd, expect) if ref_built.returncode == 0 else None
        for e, v in reference_results[k].items():
            if v is None: failures.append(f"{k}: reference {e} did not run or printed a different output")
        for label, r in (("bytecode", rc), ("AOT", rb)):
            if r.returncode: diagnostics.append(f"{k}: reference {label} compile exited {r.returncode}: {r.stderr[:1000]}")
    else:
        cell = {
            "interp": median_of(f"{zinc} run {zbc}", expect) if compiled.returncode == 0 else None,
            "aot": median_of(aot, expect) if b.returncode == 0 else None,
            "quickjs": median_of(f"qjs {js}", expect),
            "native": median_of(nat, expect) if os.path.exists(nat) else None,
        }
    for e in ("interp", "aot"):
        if inject != 1.0 and cell.get(e): cell[e]["median_s"] *= inject
    results[k] = cell
    for e, v in cell.items():
        if baseline_zinc and e not in ("interp", "aot"): continue
        if v is None and not (e == "native" and not os.path.exists(nat)): failures.append(f"{k}: {e} did not run or printed a different output")

def ms(c): return "n/a" if c is None else f"{c['median_s']*1000:.1f}"
rows, verdicts = [], []
for k in kernels:
    c = results[k]
    med = {e: (v["median_s"] if v else None) for e, v in c.items()}
    r_aot = med["aot"] / med["native"] if med["aot"] and med["native"] else None
    r_q = med["quickjs"] / med["interp"] if med["quickjs"] and med["interp"] else None
    ok = []
    if k in aot_native: ok.append(("AOT within 3x of native", r_aot is not None and r_aot <= 3.0, r_aot))
    if k in numeric: ok.append(("interpreter at least 5x QuickJS", r_q is not None and r_q >= 5.0, r_q))
    if k in no_slower: ok.append(("interpreter not slower than QuickJS", r_q is not None and r_q >= 1.0, r_q))
    for what, passed, val in ok: verdicts.append({"kernel": k, "threshold": what, "value": val, "pass": bool(passed)})
    rows.append((k, ms(c["interp"]), ms(c["aot"]), ms(c["quickjs"]), ms(c["native"]), r_aot, r_q))

# regressions against the previous numbers (the file committed at HEAD unless --baseline): median time and peak RSS per kernel and engine
regressions = []
def has_time(cell):
    value = cell.get("median_s") if isinstance(cell, dict) else None
    return type(value) in (int, float) and math.isfinite(value) and value > 0

if baseline_zinc:
    old = {"results": reference_results}
else:
    try:
        old = json.load(open(baseline)) if baseline else json.loads(subprocess.run(["git", "show", "HEAD:next/" + out], capture_output=True, text=True, check=True).stdout)
        if not isinstance(old.get("results"), dict): raise ValueError("missing results object")
    except Exception as error:
        if check:
            print(f"Cannot read benchmark baseline: {error}", file=sys.stderr)
            sys.exit(2)
        old = None
if old:
    for k, cell in results.items():
        for e, v in cell.items():
            o = (old.get("results", {}).get(k) or {}).get(e)
            if check and e in ("interp", "aot") and not has_time(o):
                failures.append(f"{k}: baseline {e} measurement is missing or invalid")
                continue
            if not v or not o: continue
            if relative:   # historic cross-machine QuickJS ratios (CI uses a same-runner reference instead)
                q, oq = cell.get("quickjs"), (old.get("results", {}).get(k) or {}).get("quickjs")
                if check and e in ("interp", "aot") and not has_time(oq):
                    failures.append(f"{k}: baseline QuickJS measurement is missing or invalid")
                    continue
                if e != "quickjs" and q and oq and o.get("median_s") and v.get("median_s") and q.get("median_s") and oq.get("median_s"):
                    r_new, r_old = v["median_s"] / q["median_s"], o["median_s"] / oq["median_s"]
                    if r_new > r_old * (1 + tolerance): regressions.append(f"{k} {e} time / QuickJS: {r_old:.3f} -> {r_new:.3f} (+{(r_new / r_old - 1) * 100:.0f}%)")
                continue
            metrics = (("median_s", "time"),) if baseline_zinc else (("median_s", "time"), ("peak_rss_mb", "peak RSS"))
            for key, label in metrics:
                if o.get(key) and v.get(key) and v[key] > o[key] * (1 + tolerance):
                    regressions.append(f"{k} {e} {label}: {o[key]:.3f} -> {v[key]:.3f} (+{(v[key] / o[key] - 1) * 100:.0f}%)")

# start-up (ZN-146): a program that prints one line, the compiled program and `zinc run`, against an empty C program, median of 200 launches
startup = {}
one = os.path.join(tmp, "one.ts"); open(one, "w").write("console.log(1);\n")
empty_c = os.path.join(tmp, "empty.c"); open(empty_c, "w").write("int main(void) { return 0; }\n")
if startup_on and run(f"cc -O2 {empty_c} -o {tmp}/empty_c").returncode == 0 and run(f"{zinc} build {one} -o {tmp}/one_aot").returncode == 0:
    def launches(cmd, n=200):
        ts = []
        for _ in range(n):
            t = time.perf_counter(); subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL); ts.append(time.perf_counter() - t)
        return statistics.median(ts) * 1000
    startup = {"empty_c_ms": launches([f"{tmp}/empty_c"]), "aot_ms": launches([f"{tmp}/one_aot"]), "run_ms": launches([zinc, "run", one], 100)}
    print("startup: empty C %.2f ms, console.log(1) AOT %.2f ms, zinc run %.2f ms" % (startup["empty_c_ms"], startup["aot_ms"], startup["run_ms"]))

failures.extend(diagnostics)
doc = {"startup": startup, "runs": runs, "machine": platform.platform(), "processor": platform.processor(), "results": results, "thresholds": verdicts, "failures": failures, "regressions": regressions}
if baseline_zinc: doc.update(reference_zinc=baseline_zinc, reference_results=reference_results)
os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
json.dump(doc, open(out, "w"), indent=1)
lines = ["# Zinc Next: M4 benchmarks", "", f"Median of {runs} runs (one warm-up), wall clock, ms. Machine: {platform.platform()}. Interpreter: `zinc run` of the compiled bytecode; AOT: `zinc build`; QuickJS: `qjs` on the stripped kernel; native: the old toolchain's release build. `tools/bench-m4` regenerates this file and `next/bench/m4.json`.", "",
         "| kernel | interp | AOT | QuickJS | native | AOT / native | QuickJS / interp |", "|---|---:|---:|---:|---:|---:|---:|"]
for k, i, a, q, n, ra, rq in rows:
    lines.append(f"| {k} | {i} | {a} | {q} | {n} | {'n/a' if ra is None else f'{ra:.2f}x'} | {'n/a' if rq is None else f'{rq:.2f}x'} |")
lines += ["", "## Thresholds", "", "| kernel | threshold | measured | result |", "|---|---|---:|---|"]
for v in verdicts:
    lines.append(f"| {v['kernel']} | {v['threshold']} | {'n/a' if v['value'] is None else format(v['value'], '.2f') + 'x'} | {'pass' if v['pass'] else '**LOSS**'} |")
lines += ["", "## Resources (one extra run per cell)", "", "| kernel | interp RSS MB | AOT RSS MB | interp user s | AOT user s |", "|---|---:|---:|---:|---:|"]
for k in kernels:
    c = results[k]
    g = lambda e, key: "n/a" if not c.get(e) else f"{c[e][key]:.2f}"
    lines.append(f"| {k} | {g('interp', 'peak_rss_mb')} | {g('aot', 'peak_rss_mb')} | {g('interp', 'user_s')} | {g('aot', 'user_s')} |")
if regressions: lines += ["", f"## Regressions against the previous numbers (more than {tolerance * 100:.0f}% worse)", ""] + [f"- {r}" for r in regressions]
if failures: lines += ["", "## Failed runs", ""] + [f"- {f}" for f in failures]
if md != "none": open(md, "w").write("\n".join(lines) + "\n")
print("\n".join(lines))
sys.exit(1 if failures else 3 if check and regressions else 0 if check or all(v["pass"] for v in verdicts) else 1)
