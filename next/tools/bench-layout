#!/usr/bin/env python3
"""layout-175 benchmark and the size job of zn_yoga (ZN-281).

usage: tools/bench-layout [--runs N] [--out bench/layout.json] [--baseline file] [--check-regressions] [--tolerance 0.15] [--no-size]
Yoga: build/layout_bench (tests/bench/layout_bench.cpp); classic: bench/layout-classic.ts on the interpreter and as an AOT program. Cases: full relayout, one leaf changed, clean.
Size: the Yoga objects compiled with the pinned zig for armv6 (arm-linux-musleabihf -mcpu=arm1176jzf_s), aarch64-linux and wasm32; code + data bytes of the objects; fails above 90 KB each.
--check-regressions: exit 3 when a time is more than the tolerance (15%, RULES 7) worse than the baseline (the committed file by default).
"""
import json, os, struct, subprocess, sys, tempfile, glob

args = sys.argv[1:]
runs, out, baseline, check, tol, size_job = 1000, "bench/layout.json", None, False, 0.15, True
while args:
    a = args.pop(0)
    if a == "--runs": runs = int(args.pop(0))
    elif a == "--out": out = args.pop(0)
    elif a == "--baseline": baseline = args.pop(0)
    elif a == "--check-regressions": check = True
    elif a == "--tolerance": tol = float(args.pop(0))
    elif a == "--no-size": size_job = False
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(root)
zinc = os.environ.get("ZINC", os.path.join(root, "build/zinc"))
tmp = tempfile.mkdtemp()

def run(cmd, env=None):
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, env=env)
    if r.returncode != 0:
        sys.exit("bench-layout: %s failed: %s" % (cmd, (r.stdout + r.stderr)[-400:]))
    return r.stdout

def last_json(text):
    return json.loads([l for l in text.splitlines() if l.startswith("{")][-1])

def median(cmd, n=5, env=None):
    rows = [last_json(run(cmd, env)) for _ in range(n)]
    best = rows[0]
    for k in ("full_us", "one_leaf_us", "clean_us"):
        v = sorted(r[k] for r in rows)
        best[k] = v[len(v) // 2]
    return best

env = dict(os.environ, ZINC_HEADLESS="1")
result = {"yoga": median("build/layout_bench %d" % runs), "classic_interp": median("%s run bench/layout-classic.ts" % zinc, env=env)}
run("%s build bench/layout-classic.ts -o %s/classic" % (zinc, tmp), env)
result["classic_aot"] = median("%s/classic" % tmp, env=env)

def elf_bytes(path):   # loadable code and data of an ELF object: the sizes of the allocated PROGBITS sections
    d = open(path, "rb").read()
    is64 = d[4] == 2
    if is64:
        shoff, shentsize, shnum = struct.unpack_from("<QHH", d, 0x28)[0], *struct.unpack_from("<HH", d, 0x3A)
        fmt, off_size, off_flags = "<IIQQQQ", 0x20, 8
    else:
        shoff = struct.unpack_from("<I", d, 0x20)[0]
        shentsize, shnum = struct.unpack_from("<HH", d, 0x2E)
        fmt = None
    total = 0
    for i in range(shnum):
        b = shoff + i * shentsize
        if is64:
            typ, flags, size = struct.unpack_from("<I", d, b + 4)[0], struct.unpack_from("<Q", d, b + 8)[0], struct.unpack_from("<Q", d, b + 32)[0]
        else:
            typ, flags, size = struct.unpack_from("<I", d, b + 4)[0], struct.unpack_from("<I", d, b + 8)[0], struct.unpack_from("<I", d, b + 20)[0]
        if typ == 1 and flags & 2: total += size   # SHT_PROGBITS and SHF_ALLOC
    return total

def wasm_bytes(path):  # code (10) and data (11) sections
    d = open(path, "rb").read()
    i, total = 8, 0
    def leb(i):
        r = s = 0
        while True:
            b = d[i]; i += 1; r |= (b & 127) << s; s += 7
            if not b & 128: return r, i
    while i < len(d):
        sid = d[i]; size, j = leb(i + 1)
        if sid in (10, 11): total += size
        i = j + size
    return total

sizes = {}
if size_job:
    zig = run("%s toolchain path" % zinc).strip().splitlines()[-1]
    srcs = glob.glob("third_party/yoga/yoga/**/*.cpp", recursive=True)
    for name, target, extra, reader in (("armv6", "arm-linux-musleabihf", "-mcpu=arm1176jzf_s", elf_bytes), ("aarch64", "aarch64-linux-gnu", "", elf_bytes), ("wasm32", "wasm32-wasi", "", wasm_bytes)):
        total = 0
        for s in srcs:
            o = os.path.join(tmp, "y.o")
            run("'%s' c++ -target %s %s -std=c++20 -Os -fno-exceptions -fno-rtti -w -I third_party/yoga -c %s -o %s" % (zig, target, extra, s, o))
            total += reader(o)
        sizes[name] = total
    result["size_bytes"] = sizes
    for name, v in sizes.items():
        print("zn_yoga %-8s %6d bytes" % (name, v))
    if any(v > 90 * 1024 for v in sizes.values()):
        print("zn_yoga is larger than 90 KB")
        sys.exit(1)

result["machine"] = os.uname().machine
for k in ("yoga", "classic_interp", "classic_aot"):
    r = result[k]
    print("%-15s %d nodes  full %9.1f us  one leaf %9.1f us  clean %9.3f us" % (k, r["nodes"], r["full_us"], r["one_leaf_us"], r["clean_us"]))
if check:
    base = baseline or out
    try:
        old = json.load(open(base)) if baseline else json.loads(subprocess.run("git show HEAD:next/%s" % out, shell=True, capture_output=True, text=True).stdout)
    except ValueError:
        sys.exit("bench-layout: no baseline (%s)" % base)
    bad = []
    for k in ("yoga", "classic_interp", "classic_aot"):
        for m in ("full_us", "one_leaf_us"):
            if result[k][m] > old[k][m] * (1 + tol): bad.append("%s %s: %.1f us vs %.1f us" % (k, m, result[k][m], old[k][m]))
    if bad:
        print("regressions:\n  " + "\n  ".join(bad)); sys.exit(3)
    print("no regression above %d%%" % int(tol * 100))
else:
    json.dump(result, open(out, "w"), indent=1)
    print("written", out)
