#!/usr/bin/env python3
"""pngdiff A.png B.png [--tol N] [--report diff.png] [--max-diff K]

Compares two 8-bit RGB/RGBA PNGs (any filter). Prints the number of pixels whose largest per-channel difference exceeds N (default 0 = exact), the largest
difference, the mean absolute error and the PSNR. --report writes a diff image (differing pixels red over a dimmed copy of A). Exit 1 when more than K pixels
(default 0) exceed the tolerance or the sizes differ. Standard library only.
"""
import sys, zlib, struct, math

def dec(p):
    d = open(p, 'rb').read(); i = 8; idat = b''; w = h = ct = 0
    while i < len(d):
        n, = struct.unpack('>I', d[i:i+4]); t = d[i+4:i+8]; b = d[i+8:i+8+n]; i += 12 + n
        if t == b'IHDR': w, h, bd, ct = struct.unpack('>IIBB', b[:10])
        if t == b'IDAT': idat += b
    raw = zlib.decompress(idat); bpp = 3 if ct == 2 else 4; stride = w * bpp; out = bytearray(); prev = bytearray(stride)
    for y in range(h):
        f = raw[y*(stride+1)]; row = bytearray(raw[y*(stride+1)+1:(y+1)*(stride+1)])
        for x in range(stride):
            a = row[x-bpp] if x >= bpp else 0; b = prev[x]; c = prev[x-bpp] if x >= bpp else 0
            if f == 1: row[x] = (row[x] + a) & 255
            elif f == 2: row[x] = (row[x] + b) & 255
            elif f == 3: row[x] = (row[x] + (a + b) // 2) & 255
            elif f == 4:
                pa = abs(b-c); pb = abs(a-c); pc = abs(a+b-2*c)
                pr = a if pa <= pb and pa <= pc else (b if pb <= pc else c)
                row[x] = (row[x] + pr) & 255
        out += row; prev = row
    return w, h, bpp, bytes(out)

def write_rgb(p, w, h, rgb):
    def chunk(t, b): return struct.pack('>I', len(b)) + t + b + struct.pack('>I', zlib.crc32(t + b) & 0xffffffff)
    raw = b''.join(b'\0' + rgb[y*w*3:(y+1)*w*3] for y in range(h))
    open(p, 'wb').write(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)) + chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))

def compare(a, b, tol=0):
    """-> (pixels above tol, max diff, mean abs error, psnr, mask of differing pixels)"""
    w, h, ba, da = a; bb, db = b[2], b[3]
    n = w * h; over = 0; mx = 0; tot = 0; sq = 0; mask = bytearray(n)
    for i in range(n):
        pa = da[i*ba:i*ba+3]; pb = db[i*bb:i*bb+3]
        if pa == pb: continue
        d0 = abs(pa[0]-pb[0]); d1 = abs(pa[1]-pb[1]); d2 = abs(pa[2]-pb[2]); m = max(d0, d1, d2)
        tot += d0 + d1 + d2; sq += d0*d0 + d1*d1 + d2*d2
        if m > mx: mx = m
        if m > tol: over += 1; mask[i] = 1
    mae = tot / (3 * n) if n else 0
    mse = sq / (3 * n) if n else 0
    psnr = float('inf') if mse == 0 else 10 * math.log10(255 * 255 / mse)
    return over, mx, mae, psnr, mask

def main(argv):
    pos = []; tol = 0; report = None; maxdiff = 0; i = 0
    while i < len(argv):
        if argv[i] == '--tol': tol = int(argv[i+1]); i += 2
        elif argv[i] == '--report': report = argv[i+1]; i += 2
        elif argv[i] == '--max-diff': maxdiff = int(argv[i+1]); i += 2
        else: pos.append(argv[i]); i += 1
    if len(pos) != 2: print(__doc__); return 2
    a = dec(pos[0]); b = dec(pos[1])
    if a[:2] != b[:2]: print('size differs', a[:2], b[:2]); return 1
    over, mx, mae, psnr, mask = compare(a, b, tol)
    print('differing pixels: %d (tolerance %d, max diff %d, mae %.3f, psnr %s)' % (over, tol, mx, mae, 'inf' if psnr == float('inf') else '%.1f dB' % psnr))
    if report and over:
        w, h, ba, da = a; out = bytearray(w*h*3)
        for k in range(w*h):
            if mask[k]: out[k*3:k*3+3] = b'\xff\x00\x00'
            else: out[k*3:k*3+3] = bytes(c // 3 + 80 for c in da[k*ba:k*ba+3])
        write_rgb(report, w, h, bytes(out))
        print('diff image:', report)
    return 1 if over > maxdiff else 0

if __name__ == "__main__": sys.exit(main(sys.argv[1:]))
