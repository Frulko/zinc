#!/bin/sh
# A profile-guided build of zinc (ZN-424): an instrumented zinc (build-pgogen) runs the training set below, llvm-profdata merges what it wrote, and
# build-pgo compiles zinc again with -fprofile-instr-use. The training set covers what the profile is meant to speed up: the interpreter (the M4
# kernels), the compiler (a compile of examples/hero) and the UI and raster paths (headless frames of hero, nuxt-ui and bouncing-ball).
# usage: tools/pgo [--train-only]    the profile lands in build-pgo/zinc.profdata, the zinc in build-pgo/zinc
cd "$(dirname "$0")/.." || exit 2
set -e
gen=build-pgogen use=build-pgo prof="$PWD/$use/profile"
profdata=$(xcrun --find llvm-profdata 2>/dev/null || command -v llvm-profdata)
[ -n "$profdata" ] || { echo "pgo: llvm-profdata is missing (Xcode command line tools, or an LLVM install)"; exit 1; }
flags="-fprofile-instr-generate"
cmake -S . -B "$gen" -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS="$flags" -DCMAKE_CXX_FLAGS="$flags" -DCMAKE_EXE_LINKER_FLAGS="$flags" -DCMAKE_SHARED_LINKER_FLAGS="$flags" >/dev/null
cmake --build "$gen" --target zinc -j"${JOBS:-8}" >/dev/null
rm -rf "$prof" && mkdir -p "$prof"
export LLVM_PROFILE_FILE="$prof/%p.profraw" ZINC_HEADLESS=1 ZINC_RUN=interp ZINC_NO_CACHE=1
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
for k in ../tests/bench/kernels/*.ts; do
  "$gen/zinc" --emit=zbc-bin "$k" "$tmp/k.zbc" >/dev/null 2>&1 && "$gen/zinc" run "$tmp/k.zbc" >/dev/null 2>&1 || true
done
"$gen/zinc" --emit=zbc-bin ../examples/hero/src/main.tsx "$tmp/hero.zbc" >/dev/null 2>&1 || true
for e in hero nuxt-ui bouncing-ball; do (cd "../examples/$e" && ZINC_ASSETS="$PWD/assets" ZINC_FRAMES=90 "../../next/$gen/zinc" run . >/dev/null 2>&1) || true; done
"$profdata" merge -o "$use/zinc.profdata" "$prof"/*.profraw
echo "pgo: profile $use/zinc.profdata ($(ls "$prof" | wc -l | tr -d ' ') runs)"
[ "$1" = --train-only ] && exit 0
flags="-fprofile-instr-use=$PWD/$use/zinc.profdata -Wno-profile-instr-out-of-date -Wno-profile-instr-unprofiled -Wno-backend-plugin"
cmake -S . -B "$use" -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS="$flags" -DCMAKE_CXX_FLAGS="$flags" >/dev/null
cmake --build "$use" --target zinc -j"${JOBS:-8}" >/dev/null
echo "pgo: $use/zinc"
