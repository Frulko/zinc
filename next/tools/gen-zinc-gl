def parse(params):
    out = []
    for tok in params.split():
        n, t = tok.split(":")
        out.append((n, t))
    return out

LETTER = {"u32": "u", "i32": "i", "f32": "d", "f64": "d", "bool": "b", "str": "s", "Loc": "i", "farr": "D", "iarr": "D", "uarr": "D", "sarr": "s"}

def tsType(t):
    if t in ("u32", "i32"): return t
    if t in ("f32", "f64"): return "number"
    if t == "bool": return "boolean"
    if t == "str": return "string"
    if t == "Loc": return "WebGLUniformLocation | null"
    if t in ("farr", "iarr", "uarr"): return "number[]"
    if t == "sarr": return "string[]"
    if t == "data": return "GLArray | null"
    if t == "out": return "GLArray"
    obj = t.rstrip("?")
    return TSCLASS[obj] + (" | null" if t.endswith("?") else "")

def rowLetters(t):
    if t in LETTER: return LETTER[t]
    if t in ("data", "out"): return "Di"
    return "i"

def tsArgs(n, t):
    if t == "Loc": return [n + " === null ? 0 : " + n + ".id"]
    if t == "sarr": return [n + ".join('\\n')"]
    if t == "data": return [n + " === null ? [] : " + n + ".data", n + " === null ? 0 : " + n + ".kind"]
    if t == "out": return [n + ".data", n + ".kind"]
    if t.rstrip("?") in OBJECTS: return [n + " === null ? 0 : " + n + ".id"] if t.endswith("?") else [n + ".id"]
    return [n]

def cppArgs(ps):
    """The C++ value of each parameter ({k}), the extra forms ({k}n, {k}null) and the statements that prepare them."""
    vals, extra, pre, post, k = {}, {}, [], [], 1
    for idx, (n, t) in enumerate(ps, 1):
        a = "a[%d]" % k
        if t == "u32": vals[idx] = "U(%s)" % a
        elif t == "i32": vals[idx] = "I(%s)" % a
        elif t == "f32": vals[idx] = "F(%s)" % a
        elif t == "f64": vals[idx] = "%s.d" % a
        elif t == "bool": vals[idx] = "(%s.i != 0)" % a
        elif t == "str": vals[idx] = "S(%s)" % a
        elif t == "Loc": vals[idx] = "loc(*c, %s.i)" % a
        elif t in ("farr", "iarr", "uarr"):
            fn = {"farr": "floats", "iarr": "ints", "uarr": "uints"}[t]
            pre.append("const auto& v%d = %s(%s);" % (idx, fn, a)); vals[idx] = "v%d.data()" % idx; extra["%dn" % idx] = "v%d.size()" % idx
        elif t == "sarr": pre.append("const auto v%d = lines(S(%s));" % (idx, a)); vals[idx] = "v%d" % idx
        elif t == "data":
            pre.append("const Bytes v%d = bytesIn(%s, a[%d]);" % (idx, a, k + 1)); vals[idx] = "v%d.p" % idx; extra["%dn" % idx] = "v%d.n" % idx; extra["%dnull" % idx] = "v%d.null" % idx; k += 1
        elif t == "out":
            pre.append("Bytes v%d = bytesOut(%s, a[%d]);" % (idx, a, k + 1)); vals[idx] = "v%d.p" % idx; extra["%dn" % idx] = "v%d.n" % idx
            post.append("bytesBack(v%d, %s);" % (idx, a)); k += 1
        else: vals[idx] = "U(%s)" % a   # an object id
        k += 1
    return vals, extra, pre, post

def gen():
    rows, cases, ts = [], [], []
    for name, params, cpp, ret, row in M:
        if name.startswith("="):   # an extension method: the same as a WebGL 2 one
            js = name[1:]
            target = next(x for x in M if x[0] == params)
            ps = parse(target[1])
            sig = ", ".join("%s: %s" % (n, tsType(t)) for n, t in ps)
            call = "this.%s(%s)" % (params, ", ".join(n for n, _ in ps))
            rt = tsRet(target[3])
            ts.append("  %s(%s): %s { %s%s; }" % (js, sig, rt, "return " if rt != "void" else "", call))
            continue
        ps = parse(params)
        letters = "i" + "".join(rowLetters(t) for _, t in ps)
        rl = {"u32": "i", "i32": "i", "bool": "b", "f64": "d", "str": "s", "param": "n", "active": "n", "Loc": "i", "attrs": "i", "strs": "s", "precision": "n", "shaders": "s",
              "strnull": "s", "u32s": "s"}.get(ret, "i" if ret else "n")
        rows.append('X(HostGl%s, "host.gl%s", "%s>%s", 2)' % (row, row, letters, rl))
        vals, extra, pre, post = cppArgs(ps)
        body = cpp
        for key, v in sorted(extra.items(), key=lambda kv: -len(kv[0])):   # "{2}null" and "{2}n" before "{2}"
            num, suffix = re.match(r"(\d+)(\w+)", key).groups()
            body = body.replace("{%s}%s" % (num, suffix), v)
        for i, v in sorted(vals.items(), key=lambda kv: -kv[0]): body = body.replace("{%d}" % i, v)
        cases.append("    case Rt::HostGl%s: { %s }" % (row, " ".join(pre + [body] + post + ["break;"])))
        if name in PRIVATE: continue
        sig = ", ".join("%s: %s" % (n, tsType(t)) for n, t in ps)
        args = ", ".join(["this.ctx"] + [x for n, t in ps for x in tsArgs(n, t)])
        call = "__host_gl%s(%s)" % (row, args)
        rt = tsRet(ret)
        if ret is None: body = call + ";"
        elif ret in ("u32",): body = "return %s as u32;" % call
        elif ret in ("i32", "bool", "f64", "str"): body = "return %s;" % call
        elif ret == "param": body = "%s; return this.param();" % call
        elif ret == "active": body = "%s; return this.active();" % call
        elif ret == "Loc": body = "const id = %s; return id === 0 ? null : new WebGLUniformLocation(id);" % call
        elif ret == "attrs": body = "return WebGLContextAttributes.of(%s);" % call
        elif ret == "strs": body = "return words(%s);" % call
        elif ret == "precision": body = "%s; const p = this.param(); return new WebGLShaderPrecisionFormat(p.numbers[0] as i32, p.numbers[1] as i32, p.numbers[2] as i32);" % call
        elif ret == "shaders": body = "const out: WebGLShader[] = []; for (const w of words(%s)) out.push(new WebGLShader(parseInt(w) as i32)); return out;" % call
        elif ret == "strnull": body = "const s = %s; return s === '\\x01' ? null : s;" % call
        elif ret == "u32s": body = "const out: u32[] = []; for (const w of words(%s)) out.push(parseInt(w) as u32); return out;" % call
        else: body = "return new %s(%s);" % (TSCLASS[ret], call)
        ts.append("  %s(%s): %s { %s }" % (name, sig, rt, body))
    return rows, cases, ts

def tsRet(ret):
    return {None: "void", "u32": "u32", "i32": "i32", "bool": "boolean", "f64": "number", "str": "string", "param": "GLParam", "active": "WebGLActiveInfo | null",
            "Loc": "WebGLUniformLocation | null", "attrs": "WebGLContextAttributes", "strs": "string[]", "precision": "WebGLShaderPrecisionFormat",
            "shaders": "WebGLShader[]", "strnull": "string | null", "u32s": "u32[]"}.get(ret) or TSCLASS[ret]

CHECK = "--check" in sys.argv
STALE = []

def splice(path, begin, end, text):
    s = open(path).read()
    i, j = s.index(begin), s.index(end)
    t = s[:i + len(begin)] + "\n" + text + "\n" + s[j:]
    if CHECK:
        if t != s: STALE.append(os.path.relpath(path, NEXT))
    else:
        open(path, "w").write(t)

def main():
    rows, cases, ts = gen()
    rows.insert(0, 'X(HostGlCreate, "host.glCreate", "iiii>i", 2)')   # (width, height, version, attributes): served by hand in webgl_host.cpp
    lines = []
    for k in range(0, len(rows), 3): lines.append("  " + " ".join(rows[k:k + 3]) + " \\")
    splice(os.path.join(NEXT, "include/zn/runtime.h"), "/* zinc:gl rows: generated by tools/gen-zinc-gl */ \\", "  /* end of the zinc:gl rows */", "\n".join(lines))
    splice(os.path.join(NEXT, "src/gl/webgl_host_rows.inc"), "// generated by tools/gen-zinc-gl: the Rt::HostGl* rows (do not edit)", "// end of the generated rows", "\n".join(cases))
    splice(os.path.join(NEXT, "..", "lib", "std", "gl.ts"), "  // ---- methods: generated by tools/gen-zinc-gl", "  // ---- end of the generated methods", "\n".join(ts))
    if CHECK and STALE: print("gen-zinc-gl: out of date (run tools/gen-zinc-gl): " + " ".join(STALE)); sys.exit(1)
    print("gen-zinc-gl: %d rows, %d methods%s" % (len(rows), len(ts), ", up to date" if CHECK else ""))

if __name__ == "__main__":
    main()
