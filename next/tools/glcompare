#!/usr/bin/env python3
"""glcompare A B [--tol N]: compares two frames (24-bit BMP or PNG) whose sizes differ by an integer factor, e.g. a frame of the GL display driver and the software frame.
The larger one is box-averaged down to the size of the other first. Prints the fraction of pixels whose largest channel difference exceeds N (default 24), the mean
absolute error and the largest difference; exit 0 always (the caller applies its thresholds). Standard library only; PNG decoding is tools/pngdiff's."""
import sys, struct, importlib.machinery, importlib.util, os
l = importlib.machinery.SourceFileLoader("pngdiff", os.path.join(os.path.dirname(os.path.abspath(__file__)), "pngdiff")); s = importlib.util.spec_from_loader("pngdiff", l)
pd = importlib.util.module_from_spec(s); l.exec_module(pd)

def bmp(p):
    d = open(p, "rb").read(); off = struct.unpack("<I", d[10:14])[0]; w, h = struct.unpack("<ii", d[18:26]); bpp = struct.unpack("<H", d[28:30])[0] // 8
    row = (w * bpp + 3) & ~3; out = bytearray(w * h * 3)
    for y in range(h):
        src = off + row * (h - 1 - y) if h > 0 else off + row * y   # bottom-up
        for x in range(w):
            b, g, r = d[src + x * bpp: src + x * bpp + 3]
            o = (y * w + x) * 3; out[o] = r; out[o + 1] = g; out[o + 2] = b
    return w, abs(h), bytes(out)

def load(p):
    if p.lower().endswith(".bmp"): return bmp(p)
    w, h, bpp, d = pd.dec(p)
    return w, h, d if bpp == 3 else b"".join(d[k:k + 3] for k in range(0, len(d), 4))

def down(img, k):
    w, h, d = img
    if k == 1: return img
    nw, nh = w // k, h // k; out = bytearray(nw * nh * 3); kk = k * k
    for y in range(nh):
        for x in range(nw):
            acc = [0, 0, 0]
            for j in range(k):
                base = ((y * k + j) * w + x * k) * 3
                for i in range(k):
                    o = base + i * 3; acc[0] += d[o]; acc[1] += d[o + 1]; acc[2] += d[o + 2]
            o = (y * nw + x) * 3; out[o] = acc[0] // kk; out[o + 1] = acc[1] // kk; out[o + 2] = acc[2] // kk
    return nw, nh, bytes(out)

def main(a):
    tol = int(a[a.index("--tol") + 1]) if "--tol" in a else 24
    A = load(a[0]); B = load(a[1])
    (aw, ah, _), (bw, bh, _) = A, B
    big, small = (A, B) if aw >= bw else (B, A)
    if big[0] % small[0] or big[1] % small[1] or big[0] // small[0] != big[1] // small[1]: print("size mismatch: %dx%d and %dx%d" % (aw, ah, bw, bh)); return 1
    k = big[0] // small[0]; big = down(big, k)
    sw, sh, g = small; d2 = big[2]; n = sw * sh; over = 0; tot = 0; mx = 0
    for i in range(n):
        o = i * 3; d = [abs(g[o + c] - d2[o + c]) for c in range(3)]; m = max(d); tot += sum(d); mx = max(mx, m); over += m > tol
    print("scale %d, pixels over %d: %.3f%%, mae %.3f, max %d" % (k, tol, 100.0 * over / n, tot / (3.0 * n), mx))
    return 0
sys.exit(main(sys.argv[1:]))
