#!/usr/bin/env python3
"""gen-web-gl [--check]: targets/web/rows-gl.js, the browser's answer to the zinc:gl host rows (`__host_gl*`, lib/std/gl.ts), from the same table as
tools/gen-zinc-gl. Each row forwards to the real WebGLRenderingContext of a canvas the page makes (ids for objects as the engine's rows have them, typed
arrays for GLArray, the last query's answer kept for the paramKind/paramNumber... rows). Run it after editing the table of gen-zinc-gl."""
import importlib.machinery, importlib.util, os, sys

HERE = os.path.dirname(os.path.abspath(__file__))
NEXT = os.path.dirname(HERE)
spec = importlib.util.spec_from_loader("genzinc", importlib.machinery.SourceFileLoader("genzinc", os.path.join(HERE, "gen-zinc-gl")))
G = importlib.util.module_from_spec(spec)
spec.loader.exec_module(G)

KIND = {"Buffer": 1, "Shader": 2, "Program": 3, "Texture": 4, "Framebuffer": 5, "Renderbuffer": 7, "VertexArray": 8, "Sampler": 9, "Query": 10, "Sync": 11, "TransformFeedback": 12}
# a method WebGL 1 has only as an extension: the extension and the method's name there
FALLBACK = {"createVertexArray": ("OES_vertex_array_object", "createVertexArrayOES"), "deleteVertexArray": ("OES_vertex_array_object", "deleteVertexArrayOES"),
            "isVertexArray": ("OES_vertex_array_object", "isVertexArrayOES"), "bindVertexArray": ("OES_vertex_array_object", "bindVertexArrayOES"),
            "drawArraysInstanced": ("ANGLE_instanced_arrays", "drawArraysInstancedANGLE"), "drawElementsInstanced": ("ANGLE_instanced_arrays", "drawElementsInstancedANGLE"),
            "vertexAttribDivisor": ("ANGLE_instanced_arrays", "vertexAttribDivisorANGLE"), "drawBuffers": ("WEBGL_draw_buffers", "drawBuffersWEBGL")}
EXT_ROWS = {"enableiOES", "disableiOES", "isEnablediOES", "blendEquationiOES", "blendEquationSeparateiOES", "blendFunciOES", "blendFuncSeparateiOES", "colorMaskiOES"}
HAND = {"present", "destroy", "loseContext", "restoreContext", "getContextAttributes", "isContextLost", "getExtension", "getSupportedExtensions", "getShaderPrecisionFormat",
        "getAttachedShaders", "getUniformIndices", "getActiveUniformBlockName", "paramKind", "paramCount", "paramNumber", "paramText", "paramObject", "paramObjectKind", "activeInfo", "getUniformLocation"}

HEAD = r'''// Generated by tools/gen-web-gl from the table of tools/gen-zinc-gl (do not edit): the host rows of zinc:gl (`__host_gl*`, lib/std/gl.ts) over the browser's own
// WebGL context. A context is a canvas the page makes (WebGL 2 for version 2, WebGL 1 for 1; a WebGL 1 context reaches VAOs, instancing and draw buffers through
// their extensions); objects have ids as they have in the engine's rows; present(image) draws the canvas into a zinc:gfx image, so the program shows it in canvas
// and DOM mode alike (docs/targets/web.md). three.js does not come through here: it takes the browser's WebGL2RenderingContext itself (plugins/three/web).
const Z = globalThis.__zincWeb, G = globalThis;
const CTORS = [null, Int8Array, Uint8Array, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array];
const ctxs = [null];
const ta = (a, kind) => (kind >= 1 && kind <= 7 ? new CTORS[kind](a) : null);
const rec = (id) => { const c = ctxs[id]; return c && !c.gone ? c : null; };
const mk = (c, kind, o) => { if (!o) return 0; const id = c.o[kind].length; c.o[kind].push(o); c.rev.set(o, [kind, id]); return id; };
const ob = (c, kind, id) => (id ? c.o[kind][id] || null : null);
const ext = (c, name) => c.ext[name] || (c.ext[name] = c.gl.getExtension(name));
const fn = (c, name, extName, extMethod) => (typeof c.gl[name] === 'function' ? c.gl[name].bind(c.gl) : ext(c, extName)[extMethod].bind(ext(c, extName)));
const P = (k, v, s, o, ok) => ({ k, v, s, o, ok });
function par(c, v) {   // a getParameter-style answer as the engine keeps it: kind b i f a s o n
  if (v === null || v === undefined) return (c.p = P('n', [], '', 0, 0));
  if (typeof v === 'boolean') return (c.p = P('b', [v ? 1 : 0], '', 0, 0));
  if (typeof v === 'number') return (c.p = P(Number.isInteger(v) ? 'i' : 'f', [v], '', 0, 0));
  if (typeof v === 'string') return (c.p = P('s', [], v, 0, 0));
  if (ArrayBuffer.isView(v) || Array.isArray(v)) return (c.p = P('a', Array.from(v, (x) => (typeof x === 'boolean' ? +x : x)), '', 0, 0));
  const r = c.rev.get(v);
  return (c.p = r ? P('o', [], '', r[1], r[0]) : P('n', [], '', 0, 0));
}
const act = (c, i) => (c.a = i ? i.size + ' ' + i.type + ' ' + i.name : '');
// a row never throws what WebGL throws for a bad argument (a TypeError): the engine sets an error flag and goes on
const safe = (f, dflt) => function (...a) { try { return f.apply(null, a); } catch (e) { if (e instanceof TypeError) return dflt; throw e; } };
const attrs = (bits) => ({ alpha: !!(bits & 1), depth: !!(bits & 2), stencil: !!(bits & 4), premultipliedAlpha: !!(bits & 8), preserveDrawingBuffer: !!(bits & 16), antialias: !!(bits & 32), failIfMajorPerformanceCaveat: false });
function create(w, h, version, bits) {
  const cv = document.createElement('canvas');
  cv.width = Math.max(1, w | 0); cv.height = Math.max(1, h | 0);
  const gl = cv.getContext(version === 2 ? 'webgl2' : 'webgl', attrs(bits));
  if (!gl) return 0;
  const c = { gl, cv, version, o: [], rev: new WeakMap(), locs: [null], ext: {}, p: P('n', [], '', 0, 0), a: '', gone: false, lost: false };
  for (let k = 0; k <= 12; k++) c.o[k] = [null];
  cv.addEventListener('webglcontextlost', (e) => { e.preventDefault(); c.lost = true; });
  cv.addEventListener('webglcontextrestored', () => { c.lost = false; c.ext = {}; for (let k = 0; k <= 12; k++) c.o[k] = [null]; c.locs = [null]; c.rev = new WeakMap(); });
  ctxs.push(c);
  return ctxs.length - 1;
}
function present(c, image) {   // the drawing buffer into a gfx image, resized to the canvas, without alpha (as the engine's present does)
  const cv = Z.images.canvas(image);
  if (!cv) return;
  if (cv.width !== c.cv.width || cv.height !== c.cv.height) Z.images.resize(image, c.cv.width, c.cv.height);
  const g = cv.getContext('2d');
  g.globalCompositeOperation = 'source-over'; g.fillStyle = '#000'; g.fillRect(0, 0, cv.width, cv.height);
  g.drawImage(c.cv, 0, 0);
  Z.images.touch(image);
}
const R = {
  glCreate: (w, h, v, b) => create(w, h, v, b),
'''


def js_arg(t, idx):
    """The JS expression of parameter `idx` and how many row slots it takes (a GLArray takes two: its numbers and its kind)."""
    a = "a%d" % idx
    if t in ("u32", "i32", "f32", "f64", "str"): return a, 1
    if t == "bool": return "!!%s" % a, 1
    if t == "Loc": return "(%s ? c.locs[%s] : null)" % (a, a), 1
    if t == "farr": return "new Float32Array(%s)" % a, 1
    if t == "iarr": return "new Int32Array(%s)" % a, 1
    if t == "uarr": return "new Uint32Array(%s)" % a, 1
    if t == "sarr": return "%s.split('\\n')" % a, 1
    if t in ("data", "out"): return "ta(%s, %s_k)" % (a, a), 2
    return "ob(c, %d, %s)" % (KIND[t.rstrip("?")], a), 1


def gen_row(name, params, ret, row):
    ps = G.parse(params)
    names, exprs, pre, post = [], [], "", ""
    for i, (n, t) in enumerate(ps):
        e, w = js_arg(t, i)
        names.append("a%d" % i)
        if w == 2: names.append("a%d_k" % i)
        if t == "out":
            pre += "const o%d = %s; " % (i, e)
            e = "o%d" % i
            post += "for (let q = 0; q < a%d.length; q++) a%d[q] = o%d[q]; " % (i, i, i)
        exprs.append(e)
    if name in FALLBACK:
        ex, m = FALLBACK[name]
        callee = "fn(c, '%s', '%s', '%s')" % (name, ex, m)
    elif name in EXT_ROWS:
        callee = "ext(c, 'OES_draw_buffers_indexed').%s.bind(ext(c, 'OES_draw_buffers_indexed'))" % name
    else:
        callee = "c.gl.%s.bind(c.gl)" % name
    call = "%s(%s)" % (callee, ", ".join(exprs))
    if ret is None: body = "%s%s; %s" % (pre, call, post)
    elif ret in ("u32", "i32"): body = "%sconst r = %s; %sreturn +r;" % (pre, call, post)
    elif ret == "f64": body = "return %s;" % call
    elif ret == "bool": body = "return !!%s;" % call
    elif ret == "str": body = "return String(%s);" % call
    elif ret == "param": body = "par(c, %s); return 0;" % call
    elif ret == "active": body = "act(c, %s); return 0;" % call
    elif ret in KIND: body = "return mk(c, %d, %s);" % (KIND[ret], call)
    else: raise SystemExit("gen-web-gl: no JS for the return %s of %s" % (ret, name))
    dflt = {None: "undefined", "bool": "false", "str": "''"}.get(ret, "0")
    arglist = ", ".join(names)
    return "  gl%s: safe((id%s) => { const c = rec(id); if (!c || c.lost) return %s; %s}, %s)," % (row, "".join(", " + x for x in names), dflt, body, dflt)


def gen():
    out = []
    for name, params, cpp, ret, row in G.M:
        if name.startswith("=") or name in HAND: continue
        out.append(gen_row(name, params, ret, row))
    hand = r'''
  glGetUniformLocation: safe((id, p, name) => { const c = rec(id); if (!c || c.lost) return 0; const l = c.gl.getUniformLocation(ob(c, 3, p), name); if (!l) return 0; c.locs.push(l); return c.locs.length - 1; }, 0),
  glGetContextAttributes: (id) => { const c = rec(id); if (!c) return 0; const a = c.gl.getContextAttributes() || {}; return (a.alpha ? 1 : 0) | (a.depth ? 2 : 0) | (a.stencil ? 4 : 0) | (a.premultipliedAlpha ? 8 : 0) | (a.preserveDrawingBuffer ? 16 : 0) | (a.antialias ? 32 : 0); },
  glIsContextLost: (id) => { const c = ctxs[id]; return !c || c.gone || c.gl.isContextLost(); },
  glGetExtension: (id, name) => { const c = rec(id); return !!c && !c.lost && !!ext(c, name); },
  glGetSupportedExtensions: (id) => { const c = rec(id); return c ? (c.gl.getSupportedExtensions() || []).join(' ') : ''; },
  glGetShaderPrecisionFormat: safe((id, t, p) => { const c = rec(id); if (!c || c.lost) return 0; const f = c.gl.getShaderPrecisionFormat(t, p); par(c, f ? [f.rangeMin, f.rangeMax, f.precision] : null); return 0; }, 0),
  glGetAttachedShaders: safe((id, p) => { const c = rec(id); if (!c || c.lost) return ''; return (c.gl.getAttachedShaders(ob(c, 3, p)) || []).map((s) => (c.rev.get(s) || [0, 0])[1]).join(' '); }, ''),
  glGetUniformIndices: safe((id, p, names) => { const c = rec(id); return c && !c.lost ? Array.from(c.gl.getUniformIndices(ob(c, 3, p), names.split('\n')) || []).join(' ') : ''; }, ''),
  glGetActiveUniformBlockName: safe((id, p, i) => { const c = rec(id); if (!c || c.lost) return '\x01'; const s = c.gl.getActiveUniformBlockName(ob(c, 3, p), i); return s === null ? '\x01' : s; }, '\x01'),
  glLoseContext: (id) => { const c = rec(id); if (c) { const e = ext(c, 'WEBGL_lose_context'); if (e) e.loseContext(); } },
  glRestoreContext: (id) => { const c = ctxs[id]; if (c && !c.gone) { const e = c.ext.WEBGL_lose_context; if (e) e.restoreContext(); } },
  glPresent: (id, image) => { const c = rec(id); if (c && !c.lost) present(c, image); },
  glDestroy: (id) => { const c = rec(id); if (c) { const e = c.gl.getExtension('WEBGL_lose_context'); if (e) e.loseContext(); c.gone = true; } },
  glParamKind: (id) => { const c = rec(id); return c ? c.p.k.charCodeAt(0) : 110; },
  glParamCount: (id) => { const c = rec(id); return c ? c.p.v.length : 0; },
  glParamNumber: (id, k) => { const c = rec(id); return c && k >= 0 && k < c.p.v.length ? c.p.v[k] : 0; },
  glParamText: (id) => { const c = rec(id); return c ? c.p.s : ''; },
  glParamObject: (id) => { const c = rec(id); return c ? c.p.o : 0; },
  glParamObjectKind: (id) => { const c = rec(id); return c ? c.p.ok : 0; },
  glActiveInfo: (id) => { const c = rec(id); return c ? c.a : ''; },'''
    tail = "\n};\nfor (const [n, f] of Object.entries(R)) G['__host_' + n] = f;\nZ.gl = { contexts: ctxs, canvasOf: (id) => (ctxs[id] ? ctxs[id].cv : null) };\n"
    return HEAD + "\n".join(out) + hand + tail


def main():
    text = gen()
    path = os.path.join(NEXT, "targets", "web", "rows-gl.js")
    if "--check" in sys.argv:
        if not os.path.exists(path) or open(path).read() != text:
            print("gen-web-gl: out of date (run tools/gen-web-gl)")
            sys.exit(1)
        print("gen-web-gl: up to date")
        return
    open(path, "w").write(text)
    print("gen-web-gl: %d rows" % text.count("\n  gl"))


if __name__ == "__main__":
    main()
