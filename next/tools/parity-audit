#!/usr/bin/env python3
"""parity-audit: the parity audits of docs/reports/parity re-run as one script (ZN-155, the parity gate).

  tools/parity-audit [--only A,C,D,E,F,X,P] [--jobs N] [--out FILE] [--zinc PATH]

Sections (each row: PASS, PARTIAL, MISSING, or a reason it does not count):
  A  table A of 01-language-cli-std.md: each snippet run by the prototype (node compiler/src/cli.ts run main.ts --target sim, the oracle)
     and by `zinc run`: PASS same stdout, PARTIAL zinc runs it and prints otherwise, MISSING zinc refuses it or crashes; a snippet the
     prototype itself refuses is not a prototype feature (PROTO-FAIL, listed, not counted)
  C  table C, diagnostics: one program per row, the same verdicts (a program both refuse is PASS; one zinc accepts and the prototype
     refuses is PARTIAL: more permissive)
  D  table D, the prototype's CLI: one probe per command or flag (`zinc help <command>` for the commands, a run for the flags)
  E  table E, host modules and std packages: a program importing the module compiles
  F  tests/conformance: each program's output (stdout, then `[exit N] stderr` on failure) equals its frozen .out
  X  examples (02-examples.md): tests/examples.lst, which tools/examples-status --check keeps true, has every entry OK
  P  plugins (03-plugins-targets.md): zinc plugins lists every plugin of plugins/, and a program importing each module plugin compiles
Rows the decision records rule out (D13: no JIT) are BY-DECISION; cross-target probes wait for the cross-platform pass (DEFERRED).
Writes docs/reports/parity/gate.md (or --out) and exits 1 when anything is MISSING or blocked.
"""
import concurrent.futures, os, re, subprocess, sys, tempfile, time

HERE = os.path.dirname(os.path.abspath(__file__)); NEXT = os.path.dirname(HERE); ROOT = os.path.dirname(NEXT)
REPORT01 = os.path.join(ROOT, "docs", "reports", "parity", "01-language-cli-std.md")
ZINC = os.path.join(NEXT, "build", "zinc")
PROTO = ["node", os.path.join(ROOT, "compiler", "src", "cli.ts"), "run", "main.ts", "--target", "sim"]
ENV = dict(os.environ, ZINC_HEADLESS="1", ZINC_DETERMINISTIC="1", ZINC_STEPS="0")

def sh(cmd, cwd=None, timeout=120, stdin=subprocess.DEVNULL):
    try:
        r = subprocess.run(cmd, cwd=cwd, env=ENV, capture_output=True, text=True, timeout=timeout, stdin=stdin, shell=isinstance(cmd, str))
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"

def first_error(text):
    for line in text.splitlines():
        if "error" in line.lower() or "panic" in line or "Segmentation" in line: return line.strip()[:160]
    return (text.strip().splitlines() or [""])[0][:160]

def compare(rid, src, zinc_args=()):
    """Both toolchains on one program: (verdict, note)."""
    d = tempfile.mkdtemp(prefix="parity-%s-" % rid)
    open(os.path.join(d, "main.ts"), "w").write(src)
    prc, pout, perr = sh(PROTO, cwd=d)
    zrc, zout, zerr = sh([ZINC, "run", *zinc_args, "main.ts"], cwd=d)
    if prc != 0:
        if zrc != 0: return "PASS", "both refuse"
        return "PARTIAL", "the prototype refuses it (%s), zinc accepts it" % first_error(perr + pout)
    if zrc != 0: return "MISSING", first_error(zerr + zout)
    if zout == pout: return "PASS", ""
    return "PARTIAL", "prints %r, the prototype %r" % (zout.strip()[:80], pout.strip()[:80])

# ---- A: the snippets of table A, from the report itself
def table_rows(title):
    text = open(REPORT01).read()
    start = text.index(title); body = text[start:text.index("\n## ", start + 1)]
    for line in body.splitlines():
        if not line.startswith("| ") or line.startswith("| id ") or line.startswith("|---"): continue
        yield [c.strip() for c in re.split(r"(?<!\\)\|", line.strip()[1:-1])]   # cells; a `\|` inside a snippet is not a separator

def snippet(cell):
    m = re.match(r"^(`+)\s?(.*?)\s?\1$", cell)
    return m.group(2).replace("\\|", "|") if m else None

def section_a(jobs):
    rows = []
    for cells in table_rows("## Table A"):
        if len(cells) < 4: continue
        src = snippet(cells[1])
        if src: rows.append((cells[0], src))
    def one(r):
        rid, src = r
        v, note = compare(rid, src + "\n")
        if v == "PARTIAL" and note.startswith("the prototype refuses"): v = "PROTO-FAIL"
        return (rid, src, v, note)
    with concurrent.futures.ThreadPoolExecutor(jobs) as ex: return list(ex.map(one, rows))

# ---- C: diagnostics, one program per row of table C
C_PROBES = [
    ("abstract class instantiation", "abstract class A {}\nnew A();"),
    ("missing property", "const o = {a: 1};\nconsole.log(o.b);"),
    ("wrong argument count", "function f(a: number): void {}\nf();"),
    ("assign to const", "const x = 1;\nx = 2;"),
    ("assign to getter-only property", "class A { get v(): number { return 1; } }\nconst a = new A();\na.v = 2;"),
    ("duplicate declaration", "let x = 1;\nlet x = 2;"),
    ("undefined name", "console.log(nope);"),
    ("missing return path", "function f(b: boolean): number { if (b) return 1; }\nconsole.log(f(true));"),
    ("type mismatch", "const x: number = 'a';"),
    ("class does not implement interface", "interface I { f(): void; }\nclass C implements I {}"),
    ("possibly null deref", "function f(s: string | null): void { console.log(s.length); }\nf('a');"),
    ("private member access", "class A { private x = 1; }\nconsole.log(new A().x);"),
    ("missing module", "import { a } from './nope';\nconsole.log(a);"),
    ("tuple index out of range", "const t: [number, number] = [1, 2];\nconsole.log(t[2]);"),
    ("throw non-Error", "throw 1;"),
    ("instanceof on primitive", "const n = 1;\nconsole.log(n instanceof Number);"),
    ("eval", "eval('1');"),
    ("globalThis", "console.log(globalThis);"),
    ("arguments", "function f(): void { console.log(arguments.length); }\nf();"),
    ("delete", "const o: { a?: number } = { a: 1 };\ndelete o.a;\nconsole.log(o.a);"),
    ("any in gradual profile", "let x: any = 1;\nconsole.log(x);"),
    ("anonymous object literal type", "const o = { a: 1, b: 'x' };\nconsole.log(o.a, o.b);"),
    ("union of primitives", "let v: number | string = 1;\nv = 'a';\nconsole.log(v);"),
    ("unreachable code / unused variable", "function f(): number { return 1; console.log('x'); }\nlet u = 2;\nconsole.log(f());"),
    ("var", "var x = 1;\nconsole.log(x);"),
    ("dynamic import()", "import('./m').then((m) => console.log(m));"),
    ("regex literal", "console.log(/a+/.test('aa'));"),
    ("holey array [1,,2]", "const a = [1, , 2];\nconsole.log(a.length);"),
    ("in operator", "const o = { a: 1 };\nconsole.log('a' in o);"),
    ("labeled statement", "outer: for (let i = 0; i < 2; i++) { for (let j = 0; j < 2; j++) { if (j == 1) continue outer; console.log(i, j); } }"),
    ("rest parameter", "function f(...xs: number[]): void { console.log(xs.length); }\nf(1, 2);"),
    ("spread call arguments", "function f(...xs: number[]): void { console.log(xs.length); }\nconst a = [1, 2];\nf(...a);"),
    ("rest in destructuring", "const [a, ...rest] = [1, 2, 3];\nconsole.log(a, rest.length);"),
    ("string enum", "enum E { A = 'a' }\nconsole.log(E.A);"),
    ("await in loop condition", "async function f(): Promise<boolean> { return false; }\nasync function main(): Promise<void> { while (await f()) {} console.log('done'); }\nmain();"),
    ("`with`", "with (Math) { console.log(1); }"),
    ("`#x` access outside class", "class A { #x = 1; }\nconsole.log(new A().#x);"),
    ("`object` type", "const o: object = { a: 1 };\nconsole.log(o);"),
    ("`new Function(...)`", "const f = new Function('return 1');"),
    ("exhaustive-switch missing return", "type K = 'a' | 'b';\nfunction f(k: K): number { switch (k) { case 'a': return 1; case 'b': return 2; } }\nconsole.log(f('a'));"),
    ("async generator", "async function* g() { yield 1; }\nasync function main(): Promise<void> { for await (const x of g()) console.log(x); }\nmain();"),
    ("`readonly number[]` type", "const a: readonly number[] = [1, 2];\nconsole.log(a[0]);"),
    ("`typeof X` in type position", "const p = { x: 1 };\nconst q: typeof p = { x: 2 };\nconsole.log(q.x);"),
    ("non-null assertion `!`", "const m = new Map<string, number>([['a', 1]]);\nconsole.log(m.get('a')!);"),
    ("try/finally around await", "async function f(): Promise<void> { try { await Promise.resolve(1); } finally { console.log('fin'); } }\nf();"),
    ("`// @ts-ignore`", "// @ts-ignore\nconst x: number = 'a';\nconsole.log(x);"),
    ("comma operator with unused left side", "let a = (1, 2);\nconsole.log(a);"),
    ("multi-error cascades", "const a: number = 'x';\nconst b: string = 1;\nconsole.log(a, b);"),
]
C_DECIDED = {"`// @ts-ignore`": "BY-DECISION D88: compiled types; an ignored type error has nothing correct to run"}
def section_c(jobs):
    def one(p):
        name, src = p
        if name in C_DECIDED: return (name, src, C_DECIDED[name].split(":")[0], C_DECIDED[name].split(": ", 1)[1])
        v, note = compare("c", src + "\n")
        return (name, src, v, note)
    with concurrent.futures.ThreadPoolExecutor(jobs) as ex: return list(ex.map(one, C_PROBES))

# ---- D: the prototype's CLI (compiler/src/cli.ts), one probe each
def section_d():
    d = tempfile.mkdtemp(prefix="parity-cli-")
    proj = os.path.join(d, "app")
    sh([ZINC, "new", "cli", proj])
    os.makedirs(os.path.join(d, "f"), exist_ok=True)
    f = os.path.join(d, "f", "main.ts"); open(f, "w").write("import * as sys from 'zinc:sys';\nconsole.log('args', sys.args().join(' '));\n")
    probes = [
        ("zinc run <file> [-- args]", [ZINC, "run", f, "--", "a", "b"], None, "args a b"),
        ("zinc run --engine quickjs", [ZINC, "run", f, "--engine", "quickjs"], None, "args"),
        ("zinc run --engine zinc-vm / --jit / --vm-tier", None, None, "BY-DECISION D13: no JIT; the interpreter and the AOT are the engines"),
        ("zinc run (no entry, zinc.json project)", [ZINC, "run"], proj, None),
        ("zinc run --profile", [ZINC, "run", "--profile", "sim", f], None, "args"),
        ("zinc run --strict", [ZINC, "run", "--strict", f], None, "args"),
        ("zinc run --target sim", [ZINC, "run", "--target", "sim", f], None, "args"),
        ("zinc run --target esp32", None, None, "DEFERRED: a board target (the cross-platform pass)"),
        ("zinc build <file> -o out", [ZINC, "build", f, "-o", os.path.join(d, "out1")], None, None),
        ("zinc build [entry] (project, no -o)", [ZINC, "build"], proj, None),
        ("zinc build --target <t>", None, None, "DEFERRED: cross builds (the cross-platform pass)"),
        ("--emit=cpp", [ZINC, "--emit=cpp", f], None, None),
        ("--emit=hir|mir", [ZINC, "--emit=ir", f], None, None),
        ("--emit=js (sim)", None, None, "BY-DECISION: no JS back end; --engine quickjs runs the TypeScript with its types stripped"),
        ("zinc check [entry]", [ZINC, "check", f], None, None),
        ("zinc check --json", [ZINC, "check", "--json", f], None, None),
    ]
    for c in ["infer", "dev", "test", "bench", "compat", "capture", "export", "deploy", "flash", "monitor", "init", "plugins", "doctor", "tsconfig", "ui", "help"]:
        probes.append(("zinc %s" % c, [ZINC, "help", c], None, None))
    probes.append(("zinc --version", [ZINC, "--version"], None, None))
    out = []
    for name, cmd, cwd, want in probes:
        if cmd is None:
            out.append((name, "", want.split(":")[0], want.split(": ", 1)[1])); continue
        rc, so, se = sh(cmd, cwd=cwd, timeout=600)
        ok = rc == 0 and (want is None or want in so)
        out.append((name, " ".join(os.path.basename(c) if c == ZINC else c for c in cmd), "PASS" if ok else "MISSING", "" if ok else "exit %d: %s" % (rc, first_error(se + so))))
    return out

# ---- E: host modules and std packages
E_MODULES = ["zinc:sys", "zinc:fs", "zinc:storage", "zinc:os", "zinc:assets", "zinc:net", "zinc:osc", "zinc:mqtt", "zinc:telemetry", "zinc:gpio",
             "zinc:events", "zinc:native", "zinc:platform", "zinc:web", "zinc:wasm", "zinc:path", "zinc:signals", "zinc:assert", "zinc:ui",
             "zinc:ui/react", "zinc:ui/solid", "zinc:ui/kit", "zinc:canvas", "zinc:3d", "zinc:script", "zinc:ffi", "zinc:socket", "zinc:sqlite", "three"]   # the plugins' own import names (canvas2d: zinc:canvas)
def section_e(jobs):
    def one(m):
        d = tempfile.mkdtemp(prefix="parity-mod-")
        open(os.path.join(d, "main.ts"), "w").write("import * as m from '%s';\nconsole.log('ok');\n" % m)
        rc, so, se = sh([ZINC, "check", "main.ts"], cwd=d, timeout=600)
        return (m, "", "PASS" if rc == 0 else "MISSING", "" if rc == 0 else first_error(se + so))
    with concurrent.futures.ThreadPoolExecutor(jobs) as ex: return list(ex.map(one, E_MODULES))

# ---- F: tests/conformance against the frozen outputs
def section_f(jobs):
    conf = os.path.join(ROOT, "tests", "conformance")
    progs = sorted(p for p in os.listdir(conf) if p.endswith((".ts", ".tsx")) and os.path.exists(os.path.join(conf, os.path.splitext(p)[0] + ".out")))
    def one(p):
        name = os.path.splitext(p)[0]
        rc, so, se = sh([ZINC, "run", os.path.join(conf, p)], cwd=conf, timeout=300)
        got = so + ("[exit %d] %s" % (rc, se) if rc != 0 else se)
        wants = [open(os.path.join(d, name + ".out")).read() for d in (conf, os.path.join(NEXT, "corpus", "conformance")) if os.path.exists(os.path.join(d, name + ".out"))]
        norm = lambda s: s.rstrip("\n")
        if any(norm(got) == norm(w) or norm(so) == norm(w) for w in wants): return (p, "", "PASS", "")
        if rc != 0: return (p, "", "MISSING", first_error(se + so))
        w = wants[0].splitlines(); g = got.splitlines()
        k = next((i for i in range(min(len(w), len(g))) if w[i] != g[i]), min(len(w), len(g)))
        return (p, "", "PARTIAL", "line %d: %r, frozen %r" % (k + 1, (g[k] if k < len(g) else "<end>")[:70], (w[k] if k < len(w) else "<end>")[:70]))
    with concurrent.futures.ThreadPoolExecutor(jobs) as ex: return list(ex.map(one, progs))

# ---- X: examples
def section_x():
    out = []
    for line in open(os.path.join(NEXT, "tests", "examples.lst")):
        if line.startswith("#") or "|" not in line: continue
        path, status, reason, task = [c.strip() for c in line.split("|")[:4]]
        out.append((path, "", "PASS" if status == "OK" else "MISSING", "" if status == "OK" else "%s: %s (%s)" % (status, reason, task)))
    return out

# ---- P: plugins
def section_p(jobs):
    rc, listing, _ = sh([ZINC, "plugins"], cwd=NEXT)
    plugins = sorted(d for d in os.listdir(os.path.join(ROOT, "plugins")) if os.path.exists(os.path.join(ROOT, "plugins", d, "plugin.json")))
    def one(name):
        import json
        m = json.load(open(os.path.join(ROOT, "plugins", name, "plugin.json")))
        spec = m.get("module") or m.get("import") or "zinc:" + name
        shown = "display: " + name[len("display-"):] if m.get("kind") == "display" else spec   # how zinc plugins names it
        if not re.search(r"(^|\s)%s(\s|$)" % re.escape(shown), listing, re.M): return (name, "", "MISSING", "zinc plugins does not list %s" % shown)
        if m.get("kind", "module") != "module" or not (m.get("entry") or os.path.exists(os.path.join(ROOT, "plugins", name, "index.ts"))): return (name, "", "PASS", "listed (%s)" % m.get("kind", "module"))
        d = tempfile.mkdtemp(prefix="parity-plugin-")
        open(os.path.join(d, "main.ts"), "w").write("import * as p from '%s';\nconsole.log('ok');\n" % spec)
        rc, so, se = sh([ZINC, "check", "main.ts"], cwd=d, timeout=900)
        return (name, "", "PASS" if rc == 0 else "MISSING", "" if rc == 0 else first_error(se + so))
    with concurrent.futures.ThreadPoolExecutor(jobs) as ex: return list(ex.map(one, plugins))

SECTIONS = [("A", "Language, std library and web platform (01, table A)"), ("C", "Diagnostics (01, table C)"), ("D", "CLI (01, table D)"),
            ("E", "Host modules and std packages (01, table E)"), ("F", "tests/conformance (01, table F)"), ("X", "Examples (02)"), ("P", "Plugins (03)")]

def main():
    global ZINC
    args = sys.argv[1:]
    only = set(args[args.index("--only") + 1].split(",")) if "--only" in args else {s for s, _ in SECTIONS}
    jobs = int(args[args.index("--jobs") + 1]) if "--jobs" in args else 4
    out = args[args.index("--out") + 1] if "--out" in args else os.path.join(ROOT, "docs", "reports", "parity", "gate.md")
    if "--zinc" in args: ZINC = os.path.abspath(args[args.index("--zinc") + 1])
    t0 = time.time()
    results = {}
    for s, title in SECTIONS:
        if s not in only: continue
        results[s] = {"A": lambda: section_a(jobs), "C": lambda: section_c(jobs), "D": section_d, "E": lambda: section_e(jobs),
                      "F": lambda: section_f(jobs), "X": section_x, "P": lambda: section_p(jobs)}[s]()
        counts = {}
        for r in results[s]: counts[r[2]] = counts.get(r[2], 0) + 1
        print("%s %-55s %s" % (s, title, ", ".join("%s %d" % kv for kv in sorted(counts.items()))), flush=True)
    rev = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    lines = ["# Parity gate (ZN-155)", "",
             "Generated by `next/tools/parity-audit` on %s at %s (%.0f s). PASS: same behaviour as the prototype; PARTIAL: zinc runs it and prints otherwise, or accepts what the prototype refuses; MISSING: a prototype feature zinc refuses or crashes on. PROTO-FAIL rows are snippets the prototype itself refuses (not counted); BY-DECISION rows are ruled out by a decision record; DEFERRED rows wait for the cross-platform pass." % (time.strftime("%Y-%m-%d"), rev, time.time() - t0), "",
             "| section | PASS | PARTIAL | MISSING | other |", "|---|---|---|---|---|"]
    for s, title in SECTIONS:
        if s not in results: continue
        c = {}
        for r in results[s]: c[r[2]] = c.get(r[2], 0) + 1
        other = ", ".join("%s %d" % (k, v) for k, v in sorted(c.items()) if k not in ("PASS", "PARTIAL", "MISSING")) or "-"
        lines.append("| %s %s | %d | %d | %d | %s |" % (s, title, c.get("PASS", 0), c.get("PARTIAL", 0), c.get("MISSING", 0), other))
    for s, title in SECTIONS:
        if s not in results: continue
        bad = [r for r in results[s] if r[2] != "PASS"]
        if not bad: continue
        lines += ["", "## %s: %s, what is not PASS" % (s, title), "", "| row | status | note |", "|---|---|---|"]
        for r in bad: lines.append("| %s | %s | %s |" % (r[0].replace("|", "\\|"), r[2], r[3].replace("|", "\\|").replace("\n", " ")))
    open(out, "w").write("\n".join(lines) + "\n")
    print("report: %s" % out)
    missing = sum(1 for s in results for r in results[s] if r[2] == "MISSING")
    return 1 if missing else 0

if __name__ == "__main__":
    sys.exit(main())
