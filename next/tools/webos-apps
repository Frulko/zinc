#!/bin/sh
# Zinc programs on an HP TouchPad (webOS 3), with a launcher: tools/webos-apps <project dir>[=Title] ...
# Builds each project and examples/webos-shell for armv7-webos, installs them over novacom as webOS applications (org.zinc.<name>, hidden
# from the system's launcher; the shell is "Zinc" there) and writes the shell's list. An icon is the project's icon.png, else a picture of
# its first second on this machine. Needs: the tablet in developer mode and seen by `novacom -l`, tools/webos-sysroot run once, macOS (sips).
# A plugin whose native code does not build stops the build (ZINC_NATIVE=real): its simulation would be installed in its place, silently.
# docs/reports/hardware/hp-touchpad-webos.md
set -e
here=$(cd "$(dirname "$0")" && pwd -P); next=$(dirname "$here"); repo=$(dirname "$next")
ZINC=${ZINC:-$next/build/zinc}
APPS=/media/cryptofs/apps/usr/palm/applications
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
strip=$(command -v llvm-strip || ls /opt/homebrew/opt/llvm*/bin/llvm-strip 2>/dev/null | head -1 || true)
[ $# -gt 0 ] || { echo "usage: tools/webos-apps <project dir>[=Title] ..." >&2; exit 2; }
novacom -l | grep -q . || { echo "webos-apps: no device (novacomd running? developer mode?)" >&2; exit 1; }
field() { python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], sys.argv[3]))" "$1/zinc.json" "$2" "$3"; }
remote() { printf '%s\n' "$1" | novacom run file://bin/sh; }

# install <project dir> <title> <visible: true|false>: builds, makes the icon, pushes the application; prints its id
install() {
  dir=$1; title=$2; visible=$3
  name=$(field "$dir" name app | tr 'A-Z ' 'a-z-' | tr -cd 'a-z0-9-'); id=org.zinc.$name; out=$work/$name; mkdir -p "$out"
  echo "webos-apps: $title ($id)" >&2
  ZINC_DISPLAY= ZINC_NATIVE=real "$ZINC" build --target armv7-webos "$dir/$(field "$dir" entry src/main.ts)" -o "$out/$name" >"$work/build.log" 2>&1 || { tail -5 "$work/build.log" >&2; exit 1; }
  rm -f "$out/$name.components"
  [ -z "$strip" ] || "$strip" "$out/$name"
  if [ -f "$dir/icon.png" ]; then cp "$dir/icon.png" "$out/icon.png"
  else   # a picture of the program after a second, cut square
    ZINC_HEADLESS=1 ZINC_DETERMINISTIC=1 ZINC_SIZE=1024x768 ZINC_FRAMES=60 ZINC_SHOT="$out/icon.png" "$ZINC" run "$dir" >/dev/null 2>&1 || true
    [ -f "$out/icon.png" ] && sips -c 768 768 "$out/icon.png" >/dev/null 2>&1
  fi
  [ -f "$out/icon.png" ] && { sips -z 128 128 "$out/icon.png" >/dev/null 2>&1; sips -z 64 64 "$out/icon.png" --out "$out/icon64.png" >/dev/null 2>&1; }
  [ -d "$dir/assets" ] && cp -R "$dir/assets" "$out/assets"
  printf '{\n\t"title": "%s",\n\t"type": "pdk",\n\t"main": "%s",\n\t"id": "%s",\n\t"version": "0.1.0",\n\t"vendor": "Zinc",\n\t"icon": "icon64.png",\n\t"visible": %s,\n\t"requiredMemory": 64\n}\n' "$title" "$name" "$id" "$visible" > "$out/appinfo.json"
  # the program may be running: it is stopped, and its file is replaced by a rename, which a file still in use allows
  remote "killall $name 2>/dev/null; sleep 1; killall -9 $name 2>/dev/null; mkdir -p $APPS/$id"
  (cd "$out" && find . -type d ! -name . | while read -r d; do remote "mkdir -p '$APPS/$id/${d#./}'"; done
   find . -type f ! -name "$name" | while read -r f; do novacom put "file:/$APPS/$id/${f#./}" < "$f"; done)
  novacom put "file:/$APPS/$id/$name.new" < "$out/$name"
  remote "chmod 755 $APPS/$id/$name.new && mv -f $APPS/$id/$name.new $APPS/$id/$name"
  echo "$id"
}

: > "$work/apps.txt"; mkdir -p "$work/icons"
for arg in "$@"; do
  dir=${arg%%=*}; title=${arg#*=}; [ "$title" != "$arg" ] || title=$(field "$dir" name app)
  id=$(install "$dir" "$title" false)
  name=${id#org.zinc.}
  icon=""; [ -f "$work/$name/icon.png" ] && { cp "$work/$name/icon.png" "$work/icons/$name.png"; icon=icons/$name.png; }
  printf '%s\t%s\t%s\n' "$id" "$title" "$icon" >> "$work/apps.txt"
done
shell=$(install "$repo/examples/webos-shell" Zinc true)
remote "mkdir -p $APPS/$shell/icons"
novacom put "file:/$APPS/$shell/apps.txt" < "$work/apps.txt"
for f in "$work"/icons/*.png; do [ -f "$f" ] && novacom put "file:/$APPS/$shell/icons/$(basename "$f")" < "$f"; done
remote 'luna-send -n 1 palm://com.palm.applicationManager/rescan "{}" < /dev/null > /dev/null 2>&1'
echo "webos-apps: installed. Start the shell: the Zinc icon in the webOS launcher, or" >&2
echo "  echo 'luna-send -n 1 palm://com.palm.applicationManager/launch \"{\\\"id\\\":\\\"$shell\\\"}\" < /dev/null' | novacom run file://bin/sh" >&2
