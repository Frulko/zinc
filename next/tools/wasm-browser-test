#!/usr/bin/env python3
"""Breakout in headless Chrome on vm-web.wasm (ZN-135, tests/t2/wasm_browser.sh): serves next/ with COOP/COEP, loads the glue page for 90 ticks, reads the last frame from the page's #png and checks it."""
import base64, http.server, importlib.machinery, importlib.util, os, re, socketserver, subprocess, sys, tempfile, threading

HERE = os.path.dirname(os.path.abspath(__file__)); NEXT = os.path.dirname(HERE)
chrome = sys.argv[1]; zinc = os.environ.get("ZINC", os.path.join(NEXT, "build", "zinc"))
loader = importlib.machinery.SourceFileLoader("pngdiff", os.path.join(HERE, "pngdiff")); spec = importlib.util.spec_from_loader("pngdiff", loader); pd = importlib.util.module_from_spec(spec); loader.exec_module(pd)
tmp = tempfile.mkdtemp()
subprocess.run([zinc, "--emit=zbc-bin", os.path.join(NEXT, "..", "examples", "breakout", "src", "main.ts"), os.path.join(tmp, "breakout.zbc")], check=True)

class H(http.server.SimpleHTTPRequestHandler):
    extensions_map = dict(http.server.SimpleHTTPRequestHandler.extensions_map, **{'.mjs': 'text/javascript', '.js': 'text/javascript', '.wasm': 'application/wasm'})
    def __init__(self, *a, **k): super().__init__(*a, directory=NEXT, **k)
    def log_message(self, *a): pass
    def end_headers(self):
        self.send_header("Cross-Origin-Opener-Policy", "same-origin"); self.send_header("Cross-Origin-Embedder-Policy", "require-corp"); super().end_headers()
    def do_GET(self):
        if self.path.startswith("/breakout.zbc"):
            data = open(os.path.join(tmp, "breakout.zbc"), "rb").read()
            self.send_response(200); self.send_header("Content-Type", "application/octet-stream"); self.send_header("Content-Length", str(len(data))); self.end_headers(); self.wfile.write(data); return
        super().do_GET()
srv = socketserver.TCPServer(("127.0.0.1", 0), H); port = srv.server_address[1]; threading.Thread(target=srv.serve_forever, daemon=True).start()
url = "http://127.0.0.1:%d/targets/wasm/glue/index.html?zbc=/breakout.zbc&wasm=/build-wasm/vm-web.wasm&frames=90" % port

# Chrome over the DevTools pipe (--remote-debugging-pipe: JSON messages ending in a NUL on fds 3 and 4): open the page, collect its console, wait for the title "done", read the PNG the page published
import json, time
spare = [os.dup(0) for _ in range(6)]   # so the pipes do not land on fds 3 and 4
r_in, w_in = os.pipe(); r_out, w_out = os.pipe()
def child(): os.dup2(r_in, 3); os.dup2(w_out, 4); os.set_inheritable(3, True); os.set_inheritable(4, True)
proc = subprocess.Popen([chrome, "--headless=new", "--no-first-run", "--hide-scrollbars", "--window-size=480,320", "--remote-debugging-pipe", "about:blank"], preexec_fn=child, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=False)
os.close(r_in); os.close(w_out)
for f in spare: os.close(f)
buf = b""; msgid = 0; console = []; sessions = {}
def send(method, params=None, session=None):
    global msgid; msgid += 1
    m = {"id": msgid, "method": method, "params": params or {}}
    if session: m["sessionId"] = session
    os.write(w_in, json.dumps(m).encode() + b"\0"); return msgid
def recv(until_id=None, timeout=60):
    global buf
    end = time.time() + timeout
    while time.time() < end:
        while b"\0" in buf:
            raw, buf = buf.split(b"\0", 1); m = json.loads(raw)
            if m.get("method") == "Runtime.consoleAPICalled": console.append(" ".join(str(a.get("value", a.get("description", ""))) for a in m["params"]["args"]))
            if m.get("method") == "Runtime.exceptionThrown": console.append("EXCEPTION " + json.dumps(m["params"]["exceptionDetails"].get("exception", {}).get("description", ""))[:300])
            if until_id is not None and m.get("id") == until_id: return m
        if until_id is None: return None
        import select
        if select.select([r_out], [], [], 0.2)[0]: buf += os.read(r_out, 1 << 20)
    return None
def call(method, params=None, session=None):
    i = send(method, params, session); m = recv(i); return (m or {}).get("result", {})
t = call("Target.createTarget", {"url": "about:blank"})["targetId"]
sess = call("Target.attachToTarget", {"targetId": t, "flatten": True})["sessionId"]
call("Runtime.enable", session=sess); call("Page.enable", session=sess)
call("Page.navigate", {"url": url}, session=sess)
png = None; deadline = time.time() + 60
while time.time() < deadline:
    time.sleep(0.5)
    v = call("Runtime.evaluate", {"expression": "document.title + '|' + (document.getElementById('png') ? document.getElementById('png').textContent : '')", "returnByValue": True}, session=sess).get("result", {}).get("value", "")
    if v.startswith("done|") and len(v) > 10: png = v[5:]; break
proc.terminate()
if not png: print("wasm_browser: the page published no frame; console:", " / ".join(console)[:800]); sys.exit(1)
shot = os.path.join(tmp, "browser.png"); open(shot, "wb").write(base64.b64decode(png))
w, h, bpp, d = pd.dec(shot)
colours = set(d[i * bpp:i * bpp + 3] for i in range(0, w * h, 7))
if (w, h) != (480, 320) or len(colours) < 4: print("wasm_browser: the frame is %dx%d with %d colours" % (w, h, len(colours))); sys.exit(1)
print("wasm_browser: breakout drew %dx%d with %d colours on vm-web.wasm in a worker" % (w, h, len(colours)))
