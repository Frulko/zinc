#!/bin/sh
# Builds a project for the consoles as a person plays it (no frame budget: it runs until the console quits it) and copies each build where the
# emulators' game lists look (ZN-753):
#   tools/console-demos <project> <name> [--title NAME] [--id ABCD12345] [psp vita ps2 n3ds]
#   -> $ZINC_DEMOS (default ~/Documents)/psp/<name>/EBOOT.PBP, vita/<name>.vpk, ps2/<name>.elf, 3ds/<name>.3dsx
# --title: the name in the PSP and Vita menus (default <name>); --id: the Vita title id, one per demo (default ZINC00001).
# Each console's program is packed with its profile (zinc pack --profile) and linked into the core (tools/build-console-core --embed).
set -e
here=$(cd "$(dirname "$0")/.." && pwd -P)
project=$1; name=$2
[ -d "$project" ] && [ -n "$name" ] || { echo "usage: tools/console-demos <project> <name> [--title NAME] [--id ABCD12345] [psp vita ps2 n3ds]" >&2; exit 2; }
shift 2
title=$name; id=ZINC00001
while [ $# -gt 0 ]; do case $1 in --title) title=$2; shift 2 ;; --id) id=$2; shift 2 ;; *) break ;; esac; done
[ $# -gt 0 ] || set -- psp vita ps2 n3ds
Z=${ZINC:-$here/build/zinc}
out=${ZINC_DEMOS:-$HOME/Documents}
tmp=$(mktemp -d "${TMPDIR:-/tmp}/zinc-console-demos.XXXXXX"); trap 'rm -rf "$tmp"' EXIT
for c in "$@"; do
  mkdir -p "$tmp/$c"
  "$Z" pack --profile "$c" "$project" -o "$tmp/$c.zapp" >"$tmp/$c.log" 2>&1 || { cat "$tmp/$c.log" >&2; exit 1; }
  tar -xf "$tmp/$c.zapp" -C "$tmp/$c" program.zbc resources.bin
  # zinc.json targets.<console>.width / height: the program's surface when it is not the screen's
  size=$(python3 -I -c "import json,sys; t=json.load(open(sys.argv[1])).get('targets',{}).get(sys.argv[2],{}); print('%dx%d' % (t['width'],t['height']) if 'width' in t and 'height' in t else '')" "$project/zinc.json" "$c")
  bin=$("$here/tools/build-console-core" "$c" --embed "$tmp/$c/program.zbc" "$tmp/$c/resources.bin" --title "$title" --id "$id" ${size:+--size "$size"} -B "$here/build/console-demo-$c" | tail -1)
  case $c in
    psp)  mkdir -p "$out/psp/$name"; cp "$bin" "$out/psp/$name/EBOOT.PBP"; echo "$out/psp/$name/EBOOT.PBP" ;;
    vita) mkdir -p "$out/vita"; cp "$bin" "$out/vita/$name.vpk"; echo "$out/vita/$name.vpk" ;;
    ps2)  mkdir -p "$out/ps2"; cp "$bin" "$out/ps2/$name.elf"; echo "$out/ps2/$name.elf" ;;
    n3ds) mkdir -p "$out/3ds"; cp "$bin" "$out/3ds/$name.3dsx"; echo "$out/3ds/$name.3dsx" ;;
  esac
done
