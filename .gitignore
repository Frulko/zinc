node_modules/
.zinc/
build/
dist/
.DS_Store
.claude/
.opencode/
zinc.storage
*.swp
*.swo
zinc.speedscope.json
/examples/camera/cli/captures/
/showcase-data/

# Chataigne autosaves next to the example project
examples/chataigne/chataigne-project/*_autosave/

# zinc compat: fetched suites (test262, WPT, quickjs-ng) and scratch programs
tests/compat/cache/

# Big Buck Bunny for the Video tab (see README.md), an asset read at runtime, not embedded
examples/hero/media/

# PDFium of zinc:pdf, fetched by plugins/pdf/vendor/fetch (plugins/pdf/vendor/PIN)
/plugins/pdf/vendor/pdfium/

# test reports downloaded from CI runs (the artifacts stay on GitHub)
docs/reports/ci-run-*/

# the engine (what next/.gitignore held before the engine moved to the root)
/build*/
# SDL's own sources, not a build directory: the CI configure fails without them
!/third_party/SDL3/include/build_config/
/.logs/
/.paused
/build-wasm/
__pycache__/
/bench/qjs/matter.mjs
/keys.json   # the index keys (tools/index-repo keys): a secret, kept outside the repository
