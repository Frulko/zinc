-- horizontal swipe on a dragAxis="x" row: the row drags, the list stays
swipe drag phase=0 dx=10 dy=1 x=646
swipe drag phase=1 dx=20 dy=2 x=656
swipe drag phase=1 dx=30 dy=2 x=666
swipe drag phase=1 dx=40 dy=3 x=676
swipe drag phase=2 dx=40 dy=3 x=676
scrollTop 0
-- vertical move on the same row: the scroll takes it
scrollTop 60
-- raw onPointerDown row: cancelled when the scroll takes over
raw move 636,10
raw down 636,10
raw cancel 636,0
scrollTop 40
-- grab="keep": the row keeps the pointer, the list stays
keep move 10
keep down
keep move -10
keep move -30
keep up
scrollTop 0
-- tap, then a long press (no tap after it)
tap 639,12
after 300 ms
long press 636,10
-- button: a small move still clicks, a scroll does not
click
scrollTop 50
-- pinch: two fingers spread and turn
pinch phase=0 scale=1 rot=0 at 640,290
pinch phase=1 scale=2 rot=0 at 690,290
pinch phase=1 scale=2.24 rot=0.46 at 690,240
pinch phase=2 scale=2.24 rot=0.46 at 690,240
-- one finger taps the pinch area
pinch area tap
-- a second finger does not pinch where nothing has onPinch
raw move 636,10
raw down 636,10
raw cancel 636,-20
scrollTop 30
