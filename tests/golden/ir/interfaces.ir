zir 1
selector .area() -> f64
selector .scale(f64) -> f64
interface Shape
  sel .area
  sel .scale
class Sq implements Shape { s: f64 }
  sel .area -> @Sq.area
  sel .scale -> @Sq.scale
class Circ implements Shape { r: f64 }
  sel .area -> @Circ.area
  sel .scale -> @Circ.scale
func @main() -> void {
bb0:
  %0: ref Sq = new Sq
  %1: f64 = const 2
  call @Sq.constructor(%0, %1)
  %2: ref Shape = refcast %0
  %3: ref Circ = new Circ
  %4: f64 = const 1
  call @Circ.constructor(%3, %4)
  %5: ref Shape = refcast %3
  %6: f64 = call @total(%2, %5)
  %7: ref Circ = new Circ
  %8: f64 = const 2
  call @Circ.constructor(%7, %8)
  %9: ref Shape = refcast %7
  %10: ref Sq = new Sq
  %11: f64 = const 3
  call @Sq.constructor(%10, %11)
  %12: ref Shape = refcast %10
  %13: f64 = call @total(%9, %12)
  builtin console.log(%6, %13)
  ret
}
func @Sq.constructor(%0: ref Sq, %1: f64) -> void {
bb0:
  setfield .0 %0, %1
  ret
}
func @Sq.area(%0: ref Sq) -> f64 {
bb0:
  %1: f64 = getfield .0 %0
  %2: f64 = getfield .0 %0
  %3: f64 = mul %1, %2
  ret %3
}
func @Sq.scale(%0: ref Sq, %1: f64) -> f64 {
bb0:
  %2: f64 = call @Sq.area(%0)
  %3: f64 = mul %2, %1
  ret %3
