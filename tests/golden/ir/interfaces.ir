func @Circ.constructor(%0: ref Circ, %1: f64) -> void {
bb0:
  setfield .0 %0, %1
  ret
}
func @Circ.area(%0: ref Circ) -> f64 {
bb0:
  %1: f64 = const 3
  %2: f64 = getfield .0 %0
  %3: f64 = mul %1, %2
  %4: f64 = getfield .0 %0
  %5: f64 = mul %3, %4
  ret %5
}
func @Circ.scale(%0: ref Circ, %1: f64) -> f64 {
bb0:
  %2: f64 = call @Circ.area(%0)
  %3: f64 = add %2, %1
  ret %3
}
func @total(%0: ref Shape, %1: ref Shape) -> f64 {
bb0:
  %2: f64 = callvirt .area(%0)
  %3: f64 = const 2
  %4: f64 = callvirt .scale(%1, %3)
  %5: f64 = add %2, %4
  ret %5
}
