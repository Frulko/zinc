+                    JSValueConst func_obj, JSValueConst this_obj, JSValueConst new_target, int argc, JSValueConst *argv, int flags,
+                    JSValue *arg_buf, JSValue *var_buf, JSVarRef **var_refs, JSValue *stack_buf, JSValue **psp, uint8_t **ppc,
+                    JSValue *pret);
