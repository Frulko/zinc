+    uint8_t ret;          /* a JSFastType: VOID, F64, I32, U32 or BOOL */
+    uint8_t argc;         /* at most JS_FAST_MAX_ARGS */
+    uint8_t args[JS_FAST_MAX_ARGS]; /* the JSFastType of each argument */
+} JSCFunctionFastDef;
