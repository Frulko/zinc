# Cross-build Zinc Next for Windows with the pinned zig (docs/reports/zinc-windows-port.md):
#   cmake -S next -B next/build-win -DCMAKE_TOOLCHAIN_FILE=next/cmake/zig-windows.cmake [-DZN_WIN_ARCH=aarch64]
#   BUILD_DIR=next/build-win next/tools/build zinc
# mingw-w64 (bundled with zig), libc++ and winpthreads linked statically: the .exe needs nothing installed.
# ZIG names the zig binary; by default the newest one `zinc toolchain` installed in $ZINC_HOME (~/.zinc).
set(CMAKE_SYSTEM_NAME Windows)
set(ZN_WIN_ARCH x86_64 CACHE STRING "x86_64 or aarch64")
set(CMAKE_SYSTEM_PROCESSOR ${ZN_WIN_ARCH})

if(NOT ZIG)
  set(ZIG $ENV{ZIG})
endif()
if(NOT ZIG)
  set(_home $ENV{ZINC_HOME})
  if(NOT _home AND DEFINED ENV{HOME})
    set(_home $ENV{HOME}/.zinc)
  elseif(NOT _home)
    set(_home $ENV{USERPROFILE}/.zinc)
  endif()
  file(TO_CMAKE_PATH "${_home}" _home)
  file(GLOB _zigs ${_home}/toolchains/zig-*/zig ${_home}/toolchains/zig-*/zig.exe)
  list(SORT _zigs)
  list(POP_BACK _zigs ZIG)
endif()
if(NOT ZIG OR NOT EXISTS "${ZIG}")
  message(FATAL_ERROR "zig-windows.cmake: no zig (run `zinc toolchain install`, or pass -DZIG=/path/to/zig)")
endif()
set(ZIG ${ZIG} CACHE FILEPATH "the zig that cross-compiles" FORCE)

# CMake takes one program per tool: small wrappers that name the zig command and the target (as src/tc/tc.cpp does for the Linux cross libraries)
set(_wrap ${CMAKE_BINARY_DIR}/zig-wrap)
file(MAKE_DIRECTORY ${_wrap})
set(_ext "")
if(CMAKE_HOST_WIN32)   # a Windows host (native build, no cross): .cmd wrappers, as Ninja and cmd.exe run them
  set(_ext ".cmd")
endif()
foreach(_tool cc c++ ar ranlib rc)
  set(_args ${_tool})
  if(_tool STREQUAL "cc" OR _tool STREQUAL "c++")
    set(_args "${_tool} -target ${ZN_WIN_ARCH}-windows-gnu")
  endif()
  if(CMAKE_HOST_WIN32)
    file(TO_NATIVE_PATH "${ZIG}" _zig_native)
    file(WRITE ${_wrap}/${_tool}${_ext} "@\"${_zig_native}\" ${_args} %*\r\n")
  else()
    file(WRITE ${_wrap}/${_tool} "#!/bin/sh\nexec '${ZIG}' ${_args} \"$@\"\n")
    file(CHMOD ${_wrap}/${_tool} PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE)
  endif()
endforeach()
set(CMAKE_C_COMPILER ${_wrap}/cc${_ext})
set(CMAKE_CXX_COMPILER ${_wrap}/c++${_ext})
set(CMAKE_AR ${_wrap}/ar${_ext} CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB ${_wrap}/ranlib${_ext} CACHE FILEPATH "" FORCE)
set(CMAKE_RC_COMPILER ${_wrap}/rc${_ext})

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)   # host tools (python, the wrappers) come from the build machine
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
