# Writes the .def zinc.exe links with (Windows): the hand list of src/zinc.def plus every defined external zrt::, hal_ and zn_host_ symbol of
# libzn_host_gfx.a, read with nm at each link, so a new engine function a plugin calls is exported without anyone editing the list
# (v0.7.2: zrt::gfx::matrix was missing and the svg plugin did not link). Run by the PRE_LINK step of zinc: cmake -DNM= -DLIB= -DSEED= -DOUT= -P
execute_process(COMMAND ${NM} -g -P --defined-only ${LIB} OUTPUT_VARIABLE _syms RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "zinc-def: ${NM} failed on ${LIB}")
endif()
file(STRINGS ${SEED} _seed REGEX "^  [^ ;]")
set(_names "")
set(_lines "")
foreach(_l IN LISTS _seed)
  string(REGEX MATCH "^  ([^ ]+)" _ ${_l})
  list(APPEND _names ${CMAKE_MATCH_1})
  list(APPEND _lines "${_l}")
endforeach()
string(REPLACE "\n" ";" _syms "${_syms}")
foreach(_l IN LISTS _syms)   # nm -P: "name type [value size]"; a member header "lib.a[obj]:" has no type
  if(NOT _l MATCHES "^([^ ]+) ([A-Za-z])")
    continue()
  endif()
  set(_n ${CMAKE_MATCH_1})
  set(_t ${CMAKE_MATCH_2})
  if(NOT _n MATCHES "^(_ZN(K|VK?)?3zrt|_ZT[VIS]N3zrt|hal_|zn_host_)" OR _n IN_LIST _names)
    continue()
  endif()
  list(APPEND _names ${_n})
  if(_t MATCHES "^[DdBbRrVv]$")
    list(APPEND _lines "  ${_n} DATA")
  else()
    list(APPEND _lines "  ${_n}")
  endif()
endforeach()
list(SORT _lines)
list(JOIN _lines "\n" _body)
file(WRITE ${OUT}.tmp "LIBRARY zinc.exe\nEXPORTS\n${_body}\n")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
