+#ifdef ZN_QJS_IC
+/* zinc patch 0003: a table of about four entries per site, so that two sites rarely share one */
+static void zn_ic_alloc(JSContext *ctx, JSFunctionBytecode *b)
+{
+    uint32_t pos = 0, sites = 0, bits = 2;
+    while (pos < (uint32_t)b->byte_code_len) {
+        int op = b->byte_code_buf[pos];
+        if (op == OP_get_field || op == OP_get_field2 || op == OP_put_field || op == OP_get_var || op == OP_get_var_undef)
+            sites++;
+        pos += short_opcode_info(op).size;
+    }
+    if (!sites)
+        return;
+    while ((1u << bits) < 4 * sites && bits < 16)
+        bits++;
+    b->zn_ic = js_mallocz(ctx, sizeof(ZnIC) << bits);
+    b->zn_ic_bits = bits;
+}
