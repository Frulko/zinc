 /* argv[] is modified if (flags & JS_CALL_FLAG_COPY_ARGV) = 0. */
+#ifdef ZN_QJS_IC
+/* zinc patch 0003: monomorphic inline caches for get_field, get_field2, put_field and get_var. A function gets a table of entries
+   keyed by the site (the bytecode offset after the operand) once it has been called or has looped ZN_IC_WARM times, so code that runs
+   once pays nothing. An entry holds the index of the property in the shape of the object that holds it. An own property is checked
+   by its atom at that index (a shape only grows in place; a deleted property loses its atom), so no reference is kept. A property of
+   a prototype also needs the path from the receiver to be the same: the entry references the hashed shapes of the receiver and of the
+   prototypes before the holder, and a hashed shape that is referenced is never changed in place (add_property and
+   js_shape_prepare_update clone it), so equal pointers mean the same properties and the same next prototype. */
+
+static void zn_ic_alloc(JSContext *ctx, JSFunctionBytecode *b);
+
+static inline ZnIC *zn_ic_slot(JSFunctionBytecode *b, uint32_t pc)
+{
+    return &b->zn_ic[(pc * 0x9E3779B1u) >> (32 - b->zn_ic_bits)];
+}
+
+static void zn_ic_clear(JSRuntime *rt, ZnIC *e)
+{
+    uint32_t d;
+    if (e->depth <= ZN_IC_DEPTH) {
+        for (d = 0; d < e->depth; d++)
+            js_free_shape(rt, e->sh[d]);
+    }
+    e->depth = 0;
+}
+
+static void zn_ic_free(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    uint32_t k;
+    if (!b->zn_ic)
+        return;
+    for (k = 0; k < (1u << b->zn_ic_bits); k++)
+        zn_ic_clear(rt, &b->zn_ic[k]);
+    js_free_rt(rt, b->zn_ic);
+    b->zn_ic = NULL;
+}
+
+static inline void zn_ic_heat(JSContext *ctx, JSFunctionBytecode *b)
+{
+    if (unlikely(!b->zn_ic) && unlikely(++b->zn_ic_heat == ZN_IC_WARM))
+        zn_ic_alloc(ctx, b);
+}
+
+/* the property of `p` (or of its prototype) that the site cached, or NULL */
+static inline JSProperty *zn_ic_get(JSFunctionBytecode *b, uint32_t pc, JSObject *p, JSAtom atom)
+{
+    ZnIC *e = zn_ic_slot(b, pc);
+    JSObject *h = p;
+    JSShape *hs;
+    JSShapeProperty *prs;
+    uint32_t d;
+    if (e->pc != pc)
+        return NULL;
+    if (e->depth) {
+        if (p->shape != e->sh[0] || p->is_exotic)
+            return NULL;
+        h = e->sh[0]->proto;
+        for (d = 1; d < e->depth; d++) {
+            if (h->shape != e->sh[d])
+                return NULL;
+            h = e->sh[d]->proto;
+        }
+    }
+    hs = h->shape;
+    if (e->idx >= hs->prop_count)
+        return NULL;
+    prs = &get_shape_prop(hs)[e->idx];
+    if (prs->atom != atom || (prs->flags & JS_PROP_TMASK))
+        return NULL;
+    return &h->prop[e->idx];
+}
+
+/* the own writable property of `p` that the site cached, or NULL */
+static inline JSProperty *zn_ic_put(JSFunctionBytecode *b, uint32_t pc, JSObject *p, JSAtom atom)
+{
+    ZnIC *e = zn_ic_slot(b, pc);
+    JSShape *sh = p->shape;
+    JSShapeProperty *prs;
+    if (e->pc != pc || e->depth || e->idx >= sh->prop_count)
+        return NULL;
+    prs = &get_shape_prop(sh)[e->idx];
+    if (prs->atom != atom || (prs->flags & (JS_PROP_TMASK | JS_PROP_WRITABLE | JS_PROP_LENGTH)) != JS_PROP_WRITABLE)
+        return NULL;
+    return &p->prop[e->idx];
+}
+
+/* after a lookup from `p` found `prs` in `h`, `depth` prototypes up */
+static no_inline void zn_ic_fill(JSContext *ctx, JSFunctionBytecode *b, uint32_t pc, JSObject *p, JSObject *h, uint32_t depth,
+                                 JSShapeProperty *prs)
+{
+    ZnIC *e = zn_ic_slot(b, pc);
+    JSShape *path[ZN_IC_DEPTH];
+    JSObject *o = p;
+    uint32_t d;
+    if (depth > ZN_IC_DEPTH || (e->pc == pc && e->fills >= ZN_IC_MAX_FILLS))
+        return;
+    for (d = 0; d < depth; d++) {
+        if (!o->shape->is_hashed || o->is_exotic)
+            return;
+        path[d] = o->shape;
+        o = o->shape->proto;
+    }
+    zn_ic_clear(ctx->rt, e);
+    e->fills = e->pc == pc ? e->fills + 1 : 1;
+    e->pc = pc;
+    e->idx = prs - get_shape_prop(h->shape);
+    e->depth = depth;
+    for (d = 0; d < depth; d++)
+        e->sh[d] = js_dup_shape(path[d]);
+}
+
+/* get_var: the lexical or global object property the site cached, or NULL */
+static inline JSProperty *zn_ic_global(JSContext *ctx, JSFunctionBytecode *b, uint32_t pc, JSAtom atom)
+{
+    ZnIC *e = zn_ic_slot(b, pc);
+    JSObject *gv = JS_VALUE_GET_OBJ(ctx->global_var_obj), *h;
+    JSShape *hs;
+    JSShapeProperty *prs;
+    if (e->pc != pc)
+        return NULL;
+    if (e->depth == ZN_IC_GVAR) {
+        h = gv;
+    } else if (e->depth == ZN_IC_GOBJ && gv->shape == e->sh[0] && gv->shape->prop_count == e->aux) {
+        h = JS_VALUE_GET_OBJ(ctx->global_obj);
+    } else {
+        return NULL;
+    }
+    hs = h->shape;
+    if (e->idx >= hs->prop_count)
+        return NULL;
+    prs = &get_shape_prop(hs)[e->idx];
+    if (prs->atom != atom || (prs->flags & JS_PROP_TMASK) || JS_IsUninitialized(h->prop[e->idx].u.value))
+        return NULL;
+    return &h->prop[e->idx];
+}
+
+static no_inline void zn_ic_fill_global(JSContext *ctx, JSFunctionBytecode *b, uint32_t pc, JSAtom atom)
+{
+    ZnIC *e = zn_ic_slot(b, pc);
+    JSObject *gv = JS_VALUE_GET_OBJ(ctx->global_var_obj), *go = JS_VALUE_GET_OBJ(ctx->global_obj);
+    JSShapeProperty *prs;
+    JSProperty *pr;
+    if (e->pc == pc && e->fills >= ZN_IC_MAX_FILLS)
+        return;
+    zn_ic_clear(ctx->rt, e);
+    e->fills = e->pc == pc ? e->fills + 1 : 1;
+    e->pc = 0;
+    if ((prs = find_own_property(&pr, gv, atom))) {
+        e->depth = ZN_IC_GVAR;
+        e->idx = prs - get_shape_prop(gv->shape);
+    } else if ((prs = find_own_property(&pr, go, atom))) {
+        e->depth = ZN_IC_GOBJ;
+        e->idx = prs - get_shape_prop(go->shape);
+        e->sh[0] = gv->shape;   /* compared, not referenced: global_var_obj lives as long as the context */
+        e->aux = gv->shape->prop_count;
+    } else {
+        e->depth = 0;
+        return;
+    }
+    e->pc = pc;
+}
+#endif
