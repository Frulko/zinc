---
import Base from '../layouts/Base.astro';
import { INSTALL, demos, img, cli } from '../data/site';
const b = import.meta.env.BASE_URL;
const feats = [
  ['🚀', 'Native, not embedded', 'Interpreted while you work, compiled to C++ when you ship: one executable, no JavaScript engine or browser inside.'],
  ['🌍', 'One program, every screen', 'A Mac, Windows, Linux, every Raspberry Pi, a reMarkable, an HP TouchPad from 2011, an ESP32, a PS2.'],
  ['🧰', 'Batteries included', 'One zinc command builds, runs, debugs, tests, packages and flashes. Cross builds need no Docker and no SDK.'],
  ['🎨', 'UI people already know', 'Solid or React models, Tailwind-like classes, a shadcn-style kit, Nuxt UI 4 and React Native components, on a GPU renderer.'],
  ['🔌', 'Web APIs on real devices', 'fetch, WebSocket, crypto.subtle, localStorage, and the battery, sensors, vibration and notifications of the device.'],
  ['📦', '45 plugins', 'three.js, video, sound, MIDI, maps, physics, SQLite, Sonos, Spotify, and drivers for LED matrices, e-ink and OLED screens.'],
];
const picks = ['zed-editor.png', 'museum-table-full.jpg', 'pinball3d-play.png', 'navigation.png', 'remarkable-notes.png', 'esp32-2432s022-home.png'].map((f) => demos.find((d) => d.f === f)!);
---
<Base title="Zinc">
  <section class="hero"><div class="wrap">
    <span class="eyebrow">TypeScript in, native out</span>
    <h1>Write it once. Run it natively <span class="hl">everywhere.</span></h1>
    <p class="lead">Desktop and mobile apps the way Electron makes them, without shipping a browser. UI, games, 3D, video and hardware, from one strict, typed subset of TypeScript and JSX, from a Mac to an ESP32.</p>
    <div class="cta">
      <div class="install"><code><i>$</i> {INSTALL}</code><button class="copy" type="button" data-copy={INSTALL}>copy</button></div>
    </div>
    <div class="cta" style="margin-top:0">
      <a class="btn primary" href={`${b}get-started/`}>Get started</a>
      <a class="btn" href={`${b}demos/`}>See the demos</a>
      <span style="color:var(--muted);font-size:.9rem">macOS and Linux, nothing to compile.</span>
    </div>
    <div class="split" style="margin-top:48px">
      <div class="term" aria-label="A terminal session">
        <div class="bar"><i></i><i></i><i></i></div>
        <pre><code><span class="l" style="animation-delay:.2s"><span class="p">$</span> zinc new desktop-app my-app && cd my-app</span>
<span class="l d" style="animation-delay:.9s">created my-app (desktop-app); next: cd my-app && zinc run</span>
<span class="l" style="animation-delay:1.6s"><span class="p">$</span> zinc run</span>
<span class="l d" style="animation-delay:2.2s">a window opens; edit, save, it reloads</span>
<span class="l" style="animation-delay:3s"><span class="p">$</span> zinc build --target aarch64-linux</span>
<span class="l" style="animation-delay:3.8s"><span class="p">$</span> zinc flash --target esp32</span>
<span class="l o" style="animation-delay:4.4s">same source, another screen</span></code></pre>
      </div>
      <img class="shot" src={img('hero.png')} alt="The hero demo: an app with an intro, screens, transitions and a gallery" width="1200" height="800" />
    </div>
  </div></section>

  <section class="section"><div class="wrap">
    <span class="eyebrow">Why Zinc</span>
    <h2 class="big">Fast to start, small to ship, wide to run.</h2>
    <div class="grid">
      {feats.map(([i, t, d]) => <div class="card"><span class="ico">{i}</span><h3>{t}</h3><p>{d}</p></div>)}
    </div>
    <p><a href={`${b}philosophy/`}>Read the philosophy →</a></p>
  </div></section>

  <section class="section" style="padding-top:0"><div class="wrap">
    <span class="eyebrow">One program, every screen</span>
    <h2 class="big">From a desktop app to a microcontroller.</h2>
    <p class="lead">The same engine and the same language. Cross builds use a pinned zig toolchain that <code>zinc toolchain</code> downloads.</p>
    <div class="gallery">
      {picks.map((d) => <figure><img src={img(d.f)} alt={d.t} loading="lazy" /><figcaption><b>{d.t}</b>{d.d}<code>{d.cmd}</code></figcaption></figure>)}
    </div>
    <p><a href={`${b}demos/`}>All demos →</a> · <a href={`${b}uses/`}>What people can make →</a></p>
  </div></section>

  <section class="section" style="padding-top:0"><div class="wrap">
    <span class="eyebrow">The CLI</span>
    <h2 class="big">Everything goes through one command.</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>I want to...</th><th>Command</th></tr></thead>
      <tbody>{cli.slice(0, 6).map(([w, c]) => <tr><td>{w}</td><td><code>{c}</code></td></tr>)}</tbody>
    </table></div>
    <p><a href={`${b}cli/`}>Full cheat sheet →</a></p>
  </div></section>

  <section class="section" style="padding-top:0"><div class="wrap">
    <div class="card" style="padding:32px">
      <h3>An honest note</h3>
      <p>Zinc has been a project of several years, and of many failures. It exists today thanks to intensive help from AI; the direction, the design choices and the tests on real hardware stay human. <a href={`${b}about/`}>Read the whole note.</a></p>
    </div>
  </div></section>
</Base>
