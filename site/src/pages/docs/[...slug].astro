---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((d) => ({ params: { slug: d.id }, props: { d } }));
}
const { d } = Astro.props;
const { Content } = await render(d);
const b = import.meta.env.BASE_URL;
const all = await getCollection('docs');
const title = d.id.split('/').pop()!.replace(/^\d+-/, '').replace(/-/g, ' ');
const fix: Record<string, string> = { Ui: 'UI', 'Ui kit': 'UI kit', 'Ui apps': 'UI apps', '3d': '3D', Canvas2d: 'Canvas 2D', Gl: 'GL', Perf: 'Performance', Svg: 'SVG', Gphoto2: 'gphoto2', Ps1: 'PS1' };
const nice = (id: string) => { const n = id.split('/').pop()!.replace(/^\d+-/, '').replace(/-/g, ' '); const t = n.charAt(0).toUpperCase() + n.slice(1); return fix[t] ?? t.replace(/\b(fbdev|gl)\b/i, (m) => m.toUpperCase()).replace(/^Display /, 'Display: '); };
const groups: [string, string[]][] = [
  ['Guide', all.filter((x) => x.id.startsWith('guide/')).map((x) => x.id).sort()],
  ['Reference', ['ui', 'ui-kit', 'plugins', 'boards', 'studio', 'dev-mode']],
  ['Plugins', all.filter((x) => x.id.startsWith('plugins/')).map((x) => x.id).sort()],
  ['Targets', all.filter((x) => x.id.startsWith('targets/')).map((x) => x.id).sort()],
  ['Reports', [...all.filter((x) => x.id.startsWith('reports/')).map((x) => x.id).sort(), 'licenses']],
  ['Decisions', all.filter((x) => x.id.startsWith('decisions/')).map((x) => x.id).sort()],
];
---
<Base title={nice(d.id)}>
  <div class="wrap docs">
    <aside class="side">
      {groups.map(([g, ids]) => <><h4>{g}</h4>{ids.map((id) => <a href={`${b}docs/${id}/`} class={id === d.id ? 'on' : ''}>{id === 'guide/readme' ? 'Overview' : nice(id)}</a>)}</>)}
    </aside>
    <article class="prose"><Content />
      <p style="margin-top:56px;font-size:.9rem"><a href={`https://github.com/Frulko/zinc/edit/main/docs/${d.filePath?.replace(/^.*docs\//, '')}`}>Edit this page on GitHub ↗</a></p>
    </article>
  </div>
</Base>
