---
import { getCollection } from 'astro:content';
import DocPage from '../../components/DocPage.astro';

// An entry id is the lower-cased path ("guide/02-language"); learn/README is the index of /docs/learn/.
export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((d) => ({ params: { slug: d.id.toLowerCase().replace(/^learn\/readme$/, 'learn') }, props: { d } }));
}
const { d } = Astro.props;
---
<DocPage d={d} lang="en" />
