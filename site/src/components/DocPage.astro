---
// A docs page in any language. `d` is the English entry; `tr` the translated entry of `lang` when there is one (else the English page is
// shown with a notice). The sidebar lists the English pages in the language's routes, with the translated titles when they exist.
import { getCollection, render } from 'astro:content';
import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { examples } from '../data/catalog';
import { slugOf, groupsOf } from '../../docs-map.mjs';
import { strings, route } from '../i18n';

const { d, tr, lang = 'en' } = Astro.props;
const shown = tr ?? d;
const { Content } = await render(shown);
const s = strings(lang);
const b = import.meta.env.BASE_URL;
const all = await getCollection('docs');
const ids = all.map((x) => x.id);
const trs = lang === 'en' ? [] : (await getCollection('docsI18n')).filter((x) => x.id.startsWith(`${lang}/`));
const h1 = new Map(trs.map((x) => [x.id.slice(lang.length + 1).toLowerCase(), /^# (.+)$/m.exec(x.body ?? '')?.[1]]));
const slug = (id: string) => slugOf(`${id}.md`);
const fix: Record<string, string> = {
  Ui: 'UI', 'Ui kit': 'UI kit', 'Ui apps': 'UI apps', '3d': '3D', Canvas2d: 'Canvas 2D', Gl: 'GL', Perf: 'Performance', Svg: 'SVG', Gphoto2: 'gphoto2', Ps1: 'PS1',
  Zapp: '.zapp files', 'Nuxt ui': 'Nuxt UI', 'React native': 'React Native',
  'Diagnostics vs tsc': 'Diagnostics versus tsc', 'Ir format': 'IR and ZBC formats', Zpk: 'ZPK packs', 'Figma ui': 'Figma to Zinc UI', 'Dev mode': 'Dev mode',
};
const nice = (id: string) => {
  if (h1.get(id)) return h1.get(id)!;
  if (/\/readme$/.test(id)) return s['docs.overview'];
  const n = id.split('/').pop()!.replace(/^\d+-/, '').replace(/-/g, ' ');
  const t = n.charAt(0).toUpperCase() + n.slice(1);
  if (t === 'Choose') return s['docs.title.choose'];
  if (t === 'Syntax') return s['docs.title.syntax'];
  return fix[t] ?? t.replace(/\b(fbdev|gl)\b/i, (m) => m.toUpperCase()).replace(/^Display /, 'Display: ');
};
// Learn, Start, Guides, Reference, Concepts. Reports and decisions are not published: they stay on GitHub.
const groups: [string, string[]][] = groupsOf(ids);

// A translation records the commit of the English file it came from (frontmatter `source`); stale = the English file differs now.
// An unknown commit (a shallow clone) is not reported here: tools/i18n-docs-check is the gate.
let stale = false;
if (tr && tr.data.source) {
  try { execFileSync('git', ['diff', '--quiet', String(tr.data.source), 'HEAD', '--', `docs/${d.filePath?.replace(/^.*docs\//, '')}`], { cwd: '..', stdio: 'ignore' }); }
  catch (e: any) { stale = e.status === 1; }
}
const enHref = `${b}docs/${slug(d.id)}/`;

// A lesson whose sample the gallery exports (public/play/<name>/, tools/site-examples): a Run button beside its picture runs it in the page.
// The export is the program as JavaScript on the browser's engine: no wasm and no cross-origin isolation, unless its config lists wasm modules.
const lessonName = d.id.startsWith('learn/') ? d.id.slice(6) : '';
const lesson = examples.find((e) => e.name === lessonName && e.path === `docs/learn/samples/${lessonName}`);
let lessonWasm = false;
if (lesson) {
  try { lessonWasm = /"wasm":\[[^\]]/.test(fs.readFileSync(path.resolve('public/play', lesson.name, 'index.html'), 'utf8')); } catch {}
}
---
<Base title={nice(d.id)} lang={lang}>
  <link slot="head" rel="alternate" type="text/markdown" href={`${route(b, lang, `docs/${slug(d.id)}/`)}index.md`} />
  <link slot="head" rel="describedby" type="text/markdown" href={`${b}${lang === 'en' ? '' : `${lang}/`}llms.txt`} />
  <div class="wrap docs">
    <aside class="side" data-pagefind-ignore>
      {groups.map(([g, list]) => <><h4>{s['docs.group.' + g]}</h4>{list.map((id) => <a href={route(b, lang, `docs/${slug(id)}/`)} class={id === d.id ? 'on' : ''}>{nice(id)}</a>)}</>)}
    </aside>
    <article class="prose" data-pagefind-weight={d.id.startsWith("reference/") ? "3" : undefined}>
      {lang !== 'en' && !tr && <p class="notice" role="note" data-pagefind-ignore>{s['docs.untranslated']}</p>}
      {stale && <p class="notice" role="note" data-pagefind-ignore>{s['docs.stale']} <a href={enHref} hreflang="en">{s['docs.stale.link']}</a></p>}
      <Content />
      {lesson && (
        <div id="learn-run" class="learn-run" data-pagefind-ignore data-name={lesson.name} data-src={`${b}play/${lesson.name}/`} data-w={lesson.width} data-h={lesson.height}
             data-wasm={lessonWasm ? '1' : ''} data-title={lesson.title} hidden>
          {lesson.missing.length > 0
            ? <p class="learn-note">{s['learn.home'].replace('{side}', lesson.missing.join(', '))}</p>
            : <>
                <p class="learn-note learn-cannot" hidden>{s['learn.cannot']} <code>zinc run {lesson.path}</code></p>
                <div class="learn-bar" hidden>
                  <button type="button" class="btn learn-start">{s['learn.run']}</button>
                  <button type="button" class="btn learn-reset" hidden>{s['learn.reset']}</button>
                  <button type="button" class="btn learn-stop" hidden>{s['learn.picture']}</button>
                  <span class="learn-hint" hidden>{s['learn.hint']}</span>
                </div>
              </>}
          <span class="learn-live" aria-live="polite" data-running={s['learn.running']} data-stopped={s['learn.stopped']}></span>
        </div>
      )}
      <p style="margin-top:56px;font-size:.9rem" data-pagefind-ignore><a href={`https://github.com/Frulko/zinc/edit/main/docs/${shown.filePath?.replace(/^.*docs\//, '')}`}>{s['docs.edit']}</a></p>
    </article>
  </div>
  {lesson && <>
    <style is:global>
      .learn-run { margin: -8px 0 24px; }
      .learn-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
      .learn-bar .btn { cursor: pointer; font: inherit; font-size: .92rem; }
      .learn-run [hidden] { display: none; }   /* .btn sets a display */
      .learn-hint, .learn-note { color: var(--muted); font-size: .9rem; margin: 0; }
      .learn-frame { position: relative; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface-2); margin: 0 0 12px; }
      .learn-frame iframe { position: absolute; left: 0; top: 0; border: 0; transform-origin: 0 0; }
      .learn-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    </style>
    <script is:inline>
      // The lesson's Run button (ZN-774.25): the picture stays until Run, which puts the program's web export in a frame in its place (made on the
      // click, one per page); Restart makes a new frame, the picture button removes it (its loops, sound and canvas go with it).
      (function () {
        var box = document.getElementById('learn-run'); if (!box) return;
        var img = Array.prototype.find.call(document.querySelectorAll('article.prose img'), function (i) { return i.getAttribute('src').indexOf(box.dataset.name) >= 0; });
        if (!img) return;
        var at = img.closest('p') || img;
        at.after(box); box.hidden = false;
        var bar = box.querySelector('.learn-bar'); if (!bar) return;   // runs at home only: the note says why
        var ok = !!(window.HTMLScriptElement && HTMLScriptElement.supports && HTMLScriptElement.supports('importmap')) && (!box.dataset.wasm || typeof WebAssembly === 'object');
        if (!ok) { box.querySelector('.learn-cannot').hidden = false; return; }
        bar.hidden = false;
        var w = Number(box.dataset.w), h = Number(box.dataset.h), live = box.querySelector('.learn-live'), frame = null;
        var start = bar.querySelector('.learn-start'), reset = bar.querySelector('.learn-reset'), stop = bar.querySelector('.learn-stop'), hint = bar.querySelector('.learn-hint');
        function fit() { if (frame) frame.firstChild.style.transform = 'scale(' + frame.clientWidth / w + ')'; }
        function run() {
          if (frame) frame.remove();
          frame = document.createElement('div'); frame.className = 'learn-frame'; frame.style.aspectRatio = w + '/' + h;
          var f = document.createElement('iframe');
          f.src = box.dataset.src; f.title = box.dataset.title; f.width = w; f.height = h; f.tabIndex = 0; f.allow = 'autoplay; fullscreen';
          f.addEventListener('load', function () { f.focus(); });
          frame.appendChild(f); at.hidden = true; box.before(frame); fit(); f.focus();
          start.hidden = true; reset.hidden = stop.hidden = hint.hidden = false; live.textContent = live.dataset.running;
        }
        start.addEventListener('click', run);
        reset.addEventListener('click', run);
        stop.addEventListener('click', function () {
          if (frame) frame.remove(); frame = null; at.hidden = false;
          start.hidden = false; reset.hidden = stop.hidden = hint.hidden = true; live.textContent = live.dataset.stopped; start.focus();
        });
        addEventListener('resize', fit);
      })();
    </script>
  </>}
</Base>
