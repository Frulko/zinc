{
  "name": "ipod",
  "entry": "src/main.tsx",
  "text": "shaped",
  "scheme": "auto",
  "app": {
    "name": "iPod",
    "id": "dev.zinc.ipod",
    "version": "0.1.0",
    "icon": "icon.png",
    "orientation": "landscape"
  },
  "targets": {
    "macos": { "width": 1180, "height": 760, "resize": "fill", "growDrawCommands": true },
    "linux": { "width": 1180, "height": 760, "resize": "fill", "growDrawCommands": true }
  },
  "permissions": ["fs", "dialog", "net", "opener"],
  "requires": ["keyboard", "pointer", "fs", "audio"],
  "icons": ["loader-circle", "arrow-up", "arrow-down", "list-music", "sparkles", "hard-drive", "info", "disc-3", "music", "usb", "radio", "book-audio", "clapperboard", "images", "image", "notebook-pen", "contact", "calendar", "mic", "play", "pause", "skip-back", "skip-forward", "volume", "volume-2", "plus", "download", "archive", "rotate-ccw", "x", "shield-check", "wrench", "arrow-down-up", "circle-check", "circle-x", "lock", "lock-open", "scroll-text", "file-plus", "folder-open", "list-checks", "eject", "check", "chevron-down", "chevron-right", "dot", "copy", "tag", "file-x", "wifi", "trash", "laptop", "speaker", "volume-1", "refresh-cw", "settings"]
}
