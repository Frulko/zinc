{
  "name": "rn-showcase",
  "entry": "src/main.tsx",
  "ui": {
    "preset": "react-native"
  },
  "requires": [
    "display",
    "pointer|touch",
    "heap>=32M"
  ],
  "targets": {
    "macos": {
      "width": 420,
      "height": 860,
      "resize": "fill"
    },
    "linux": {
      "width": 420,
      "height": 860
    },
    "sim": {
      "width": 420,
      "height": 860
    },
    "wasm": {
      "width": 420,
      "height": 860
    }
  },
  "permissions": [
    "opener",
    "deep-link"
  ],
  "scopes": {
    "opener": {
      "allow": [
        "https://*"
      ]
    }
  },
  "icons": [
    "activity",
    "bell",
    "calendar",
    "camera",
    "check",
    "chevron-down",
    "chevron-left",
    "chevron-right",
    "circle-alert",
    "circle-check",
    "clipboard-list",
    "copy",
    "database",
    "external-link",
    "grip-vertical",
    "hand",
    "heart",
    "house",
    "image",
    "info",
    "layout-grid",
    "mail",
    "minus",
    "music",
    "pause",
    "play",
    "plus",
    "radio-tower",
    "refresh-cw",
    "rotate-ccw",
    "search",
    "send",
    "shapes",
    "share-2",
    "skip-back",
    "skip-forward",
    "smartphone",
    "sparkles",
    "trash",
    "user",
    "vibrate",
    "wifi",
    "wifi-off",
    "x",
    "zap"
  ]
}
