    "player_hint_1_en": " (C) cannot be on the Beach and she cannot be in the Lifeguard's Tower per (F)'s clue. She can only be sitting in the Changing Room, in R2 C7.",
    "player_hint_1_markers": "[{\"type\":\"circle\",\"row\":1,\"col\":6,\"color\":\"#4ECDC4\"},{\"type\":\"letter_big\",\"row\":1,\"col\":6,\"color\":\"#4ECDC4\",\"letter\":\"C\"}]",
    "player_hint_2_en": "This leaves one square left for (F) to be in the Lifeguard’s Tower, so (F) is in R1 C1.",
    "player_hint_2_markers": "[{\"type\":\"letter_big\",\"row\":0,\"col\":0,\"color\":\"#4ECDC4\",\"letter\":\"F\"},{\"type\":\"circle\",\"row\":0,\"col\":0,\"color\":\"#4ECDC4\"}]",
    "player_hint_3_en": "The only square left for (A) to be beside a boulder is R6 C2.",
    "player_hint_3_markers": "[{\"type\":\"letter_big\",\"row\":5,\"col\":1,\"color\":\"#4ECDC4\",\"letter\":\"A\"},{\"type\":\"circle\",\"row\":5,\"col\":1,\"color\":\"#4ECDC4\"}]",
    "player_hint_4_en": "This also narrows down (B) to R5 C6, the last carpet square.",
    "player_hint_4_markers": "[{\"type\":\"letter_big\",\"row\":4,\"col\":5,\"color\":\"#4ECDC4\",\"letter\":\"B\"},{\"type\":\"circle\",\"row\":4,\"col\":5,\"color\":\"#4ECDC4\"}]",
    "player_hint_5_en": "Now, the only square left for (E) to be beside a chair is R4 C3.",
    "player_hint_5_markers": "[{\"type\":\"letter_big\",\"row\":3,\"col\":2,\"color\":\"#4ECDC4\",\"letter\":\"E\"},{\"type\":\"circle\",\"row\":3,\"col\":2,\"color\":\"#4ECDC4\"}]",
