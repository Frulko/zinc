      {
        "id": "mission1",
        "name": "Carousel Ride",
        "award": 20000,
        "steps": [{ "text": "Ride the carousel: hit the bumpers", "on": "bumpers", "event": "hit", "count": 10, "light": "carouselLight" }]
      },
      {
        "id": "mission2",
        "name": "Ring the Bell",
        "award": 30000,
        "steps": [{ "text": "Shoot the high striker", "on": "striker", "event": "capture", "count": 2, "light": "strikerLight" }]
      },
      {
        "id": "mission3",
        "name": "Coconut Shy",
        "award": 30000,
        "steps": [{ "text": "Knock down the coconuts", "on": "coconuts", "event": "down", "count": 3, "light": "coconutLight" }]
      },
      {
        "id": "mission4",
        "name": "Duck Pond",
        "steps": [{ "text": "Hook the ducks", "on": "ducks", "event": "hit", "count": 4, "light": "duckLight" }]
      }
    ],
    "when": [
      { "on": "bumpers", "event": "hit", "do": [{ "do": "score", "value": 500 }] },
      { "on": "ducks", "event": "hit", "do": [{ "do": "score", "value": 1000 }] },
      { "on": "slings", "event": "hit", "do": [{ "do": "score", "value": 110 }] },
      { "on": "bumpers", "event": "hit", "do": [{ "do": "light", "target": "bulbs", "mode": "flash", "seconds": 0.25 }] },
      { "on": "lanes", "event": "roll", "do": [{ "do": "score", "value": 300 }, { "do": "light", "target": "self", "mode": "on" }] },
      { "on": "flippers", "event": "flip", "do": [{ "do": "rotate", "target": "lanes", "value": 1 }] },
      { "on": "coconuts", "event": "down", "do": [{ "do": "score", "value": 2000 }] },
      {
        "on": "striker",
        "event": "capture",
        "do": [
          { "do": "score", "value": 5000 },
          { "do": "bonus", "value": 500 },
          { "do": "light", "target": "bulbs", "mode": "flash", "seconds": 0.8 }
        ]
      },
      { "on": "bells", "event": "hit", "do": [{ "do": "score", "value": 2500 }, { "do": "say", "target": "DING!" }] },
      { "on": "spinner", "event": "spin", "do": [{ "do": "score", "value": 100 }] },
      {
        "on": "game",
        "event": "start",
        "do": [
          { "do": "sound", "target": "jingleStart" },
          { "do": "light", "target": "general", "mode": "on" },
          { "do": "say", "target": "ROLL UP, ROLL UP" }
        ]
      },
      { "on": "game", "event": "ballStart", "do": [{ "do": "light", "target": "general", "mode": "on" }] },
      { "on": "game", "event": "drain", "do": [{ "do": "sound", "target": "drainWhistle" }] },
      { "on": "game", "event": "ballSaved", "do": [{ "do": "sound", "target": "jingleSaved" }] },
      { "on": "game", "event": "bump", "do": [{ "do": "sound", "target": "cabinetKnock" }] },
      {
        "on": "game",
        "event": "tilt",
        "do": [{ "do": "sound", "target": "jingleTilt" }, { "do": "light", "target": "general", "mode": "off" }, { "do": "say", "target": "TILT" }]
      },
      {
        "on": "game",
        "event": "missionDone",
        "do": [{ "do": "sound", "target": "jingleMission" }, { "do": "light", "target": "bulbs", "mode": "flash", "seconds": 1.5 }]
      },
      { "on": "game", "event": "rankUp", "do": [{ "do": "sound", "target": "jingleRank" }] },
      { "on": "game", "event": "extraBall", "do": [{ "do": "sound", "target": "jingleExtra" }] },
      { "on": "game", "event": "jackpot", "do": [{ "do": "sound", "target": "jingleJackpot" }] },
