  "goals": [
    { "id": "wood", "title": "Du bois", "text": "Posez une cabane de bûcheron au bord de la route, près des arbres : les habitants coupent le bois. Ensuite, la scierie.",
      "when": [ { "building": "lumberhut" } ], "give": { "log": 4 } },
    { "id": "planks", "title": "Des planches", "text": "Posez la scierie près de la cabane : elle change le bois en planches. Réunissez-en douze, puis posez trois maisons le long de la route.", "requires": ["wood"],
      "when": [ { "building": "sawmill" }, { "stock": "plank", "count": 12 } ], "unlock": ["lodge", "fishery"], "give": { "plank": 6 } },
    { "id": "street", "title": "Une rue", "text": "Posez trois maisons le long de la route : les habitants arrivent par la porte dès qu’une maison est reliée. Gardez planches et bois pour la suite.", "requires": ["planks"],
      "when": [ { "building": "house", "count": 3 } ], "unlock": ["smokehouse", "farm", "claypit", "forager", "mine"] },
    { "id": "hunt", "title": "À la chasse", "text": "Posez un atelier de chasse près des arbres : il rapporte du gibier et des peaux. Ensuite, la tannerie.", "requires": ["planks"],
      "when": [ { "building": "lodge" } ], "unlock": ["tannery"], "give": { "log": 5 } },
    { "id": "leather", "title": "Du cuir", "text": "Posez la tannerie, à l’écart des maisons : elle fait du cuir avec les peaux, et chaque marché en demande un morceau. Le premier est déjà payé par vos réserves.", "requires": ["hunt"],
      "when": [ { "building": "tannery" } ], "unlock": ["market"] },
    { "id": "bread", "title": "Du pain", "text": "Posez d’abord une ferme : elle donne du blé. Le moulin en fait de la farine et la boulangerie du pain, qui nourrit mieux les maisons.", "requires": ["street"],
      "when": [ { "building": "farm" } ], "unlock": ["mill", "bakery"] },
    { "id": "square", "title": "La place du marché", "text": "Posez le marché au milieu des maisons : son marchand fait la ronde et sert celles qu’il croise. Le puits est offert au même moment : posez-le près des maisons.", "requires": ["leather"],
      "when": [ { "building": "market" } ], "unlock": ["well"], "give": { "plank": 10 } },
    { "id": "growth", "title": "Le hameau grandit", "text": "Deux maisons de niveau 2 : elles veulent le marché, un puits à portée, deux sortes de nourriture et un quartier agréable (arbres, eau). Cliquez une maison : elle dit ce qui lui manque.", "requires": ["square"],
      "when": [ { "houses": 2, "level": 1 } ], "give": { "plank": 10, "stone": 4 } },
    { "id": "prosperity", "title": "Un village prospère", "text": "Quatorze habitants et une demeure de niveau 3 : continuez de poser des maisons et variez la nourriture (poisson, pain, viande fumée, miel) pour qu’une maison devienne une demeure.", "requires": ["growth"],
      "when": [ { "population": 14 }, { "houses": 1, "level": 2 } ], "give": { "plank": 10, "log": 10 } },
    { "id": "iron", "title": "Du fer", "text": "Une mine tire le minerai de la roche ; la forge (il faut de l’argile) en fait des outils.", "requires": ["street"],
      "when": [ { "building": "mine" } ], "unlock": ["forge"], "give": { "log": 4 } },
    { "id": "bees", "title": "Des abeilles", "text": "Un cueilleur sait où fleurissent les prés : posez un rucher près des fleurs.", "requires": ["street"],
      "when": [ { "building": "forager" } ], "unlock": ["apiary"], "give": { "plank": 4 } },
    { "id": "honey", "title": "Du miel", "text": "Le rucher donne du miel (les maisons l’aiment) et de la cire ; la cire fait des bougies, le miel avec du blé fait de l’hydromel.", "requires": ["bees", "planks"],
      "when": [ { "building": "apiary" } ], "unlock": ["chandlery", "meadery"], "give": { "log": 4, "plank": 4 } },
    { "id": "light", "title": "De la lumière", "text": "Les bougies éclairent les maisons : le quartier en devient plus agréable.", "requires": ["honey"],
      "when": [ { "building": "chandlery" } ], "unlock": ["chapel"], "give": { "plank": 4 } },
    { "id": "mead", "title": "Une taverne", "text": "Faites de l’hydromel, puis ouvrez une taverne : elle l’achète et réjouit le voisinage.", "requires": ["honey"],
      "when": [ { "building": "meadery" } ], "unlock": ["tavern", "theatre"], "give": { "plank": 6 } },
    { "id": "tools", "title": "Des outils", "text": "La forge change le minerai en outils : la carrière en demande.", "requires": ["iron"],
      "when": [ { "building": "forge" }, { "stock": "tools", "count": 2 } ], "unlock": ["quarry"], "give": { "plank": 6 } },
    { "id": "stone", "title": "De la pierre", "text": "Une carrière tire la pierre des rochers veinés, pour les puits et les gros chantiers.", "requires": ["tools"],
      "when": [ { "building": "quarry" } ], "give": { "plank": 6 } },
    { "id": "fire", "title": "Contre le feu", "text": "Dès seize habitants, le feu menace : posez un poste d’incendie au bord de la route, ses pompiers font la ronde.", "requires": ["street"],
      "when": [ { "population": 16 } ], "unlock": ["firehouse"], "give": { "plank": 4 } },
    { "id": "watch", "title": "Veiller sur le hameau", "text": "Un poste d’incendie en service, douze habitants : l’atelier répare les murs, le guet chasse les voleurs.", "requires": ["fire"],
      "when": [ { "building": "firehouse" }, { "population": 12 } ], "unlock": ["works", "watchpost"], "give": { "plank": 6 } },
    { "id": "town", "title": "Un bourg", "text": "Trente habitants et quatre demeures de niveau 3 : du pain, de l’eau, un marché, un quartier agréable (arbres, eau, bougies, taverne).", "requires": ["prosperity", "bread"],
      "when": [ { "population": 30 }, { "houses": 4, "level": 2 } ], "give": { "plank": 12, "stone": 4 } },
    { "id": "feast", "title": "Il fait bon vivre", "text": "Quarante habitants, six demeures de niveau 3 et une taverne ouverte : le hameau est devenu un village où l’on s’installe pour de bon.", "requires": ["town", "mead"],
      "when": [ { "population": 40 }, { "houses": 6, "level": 2 }, { "building": "tavern" } ], "final": true }
  ],
