{
  "name": "notes",
  "entry": "src/main.tsx",
  "description": "Handwritten notes with the Marker, saved on the tablet.",
  "app": { "id": "dev.zinc.notes", "version": "0.1.0", "author": "Zinc", "icon": "icon.svg" },
  "display": {
    "driver": "rmpp",
    "refresh_mode": "fast"
  },
  "targets": {
    "macos": {
      "width": 1620,
      "height": 2160
    },
    "linux": {
      "width": 1620,
      "height": 2160
    }
  },
  "permissions": ["fs"]
}
