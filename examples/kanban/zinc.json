{
  "name": "kanban",
  "entry": "src/main.tsx",
  "app": {
    "name": "Zinc Project Room",
    "id": "dev.zinc.kanban",
    "version": "0.1.0",
    "icon": "assets/icon.png",
    "orientation": "landscape"
  },
  "targets": {
    "macos": {
      "width": 1560,
      "height": 940,
      "resize": "fill"
    }
  },
  "permissions": [
    "fs",
    "process"
  ],
  "requires": [
    "keyboard",
    "pointer",
    "fs"
  ],
  "icons": [
    "square-check",
    "square",
    "refresh-cw",
    "x",
    "copy",
    "pencil",
    "send",
    "check"
  ],
  "scheme": "light"
}
