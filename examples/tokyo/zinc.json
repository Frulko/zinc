{
  "name": "tokyo",
  "entry": "src/main.ts",
  "app": { "name": "Pocket Tokyo", "id": "dev.zinc.tokyo", "version": "0.1.0", "orientation": "landscape" },
  "assets": {
    "dir": "assets",
    "rules": [
      { "match": "city/*.png", "as": "texture", "mipmaps": false },
      { "match": "city/c*.near.zwc", "targets": { "psp": { "skip": true }, "n3ds": { "skip": true }, "vita": { "skip": true } } },
      { "match": "city/b*.png", "targets": { "psp": { "skip": true }, "n3ds": { "skip": true }, "vita": { "skip": true } } },
      { "match": "city/g*.png", "targets": { "psp": { "maxSize": 128 }, "n3ds": { "maxSize": 256 }, "vita": { "maxSize": 256 } } },
      { "match": "city/facade*.png", "targets": { "psp": { "maxSize": 256 }, "n3ds": { "maxSize": 256 } } }
    ]
  },
  "targets": {
    "macos": { "width": 960, "height": 544 },
    "linux": { "width": 960, "height": 544 }
  }
}
