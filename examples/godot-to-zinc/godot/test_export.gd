extends SceneTree

func _initialize():
    var scene = load("res://yard.tscn").instantiate()
    var exporter = preload("res://addons/zinc_export/exporter.gd").new()
    var output = OS.get_cmdline_user_args()[0]
    assert(exporter.publish(scene, output) == OK)
    var original = FileAccess.get_file_as_bytes(output.path_join("scene.json"))
    assert(exporter.publish(scene, output) == OK)
    assert(original == FileAccess.get_file_as_bytes(output.path_join("scene.json")))
    scene.get_node("Stacks/CrateB").set_meta("zinc_id", "crate-a")
    assert(exporter.publish(scene, output) != OK)
    assert(original == FileAccess.get_file_as_bytes(output.path_join("scene.json")))
    scene.get_node("Stacks/CrateB").set_meta("zinc_id", "crate-b")
    var material = ShaderMaterial.new()
    scene.get_node("Gate").material_override = material
    assert(exporter.publish(scene, output) != OK)
    assert(original == FileAccess.get_file_as_bytes(output.path_join("scene.json")))
    scene.get_node("Gate").material_override = null
    var script = GDScript.new()
    script.source_code = "extends Node3D\n"
    assert(script.reload() == OK)
    scene.get_node("Spawn").set_script(script)
    assert(exporter.publish(scene, output) != OK)
    assert(original == FileAccess.get_file_as_bytes(output.path_join("scene.json")))
    scene.get_node("Spawn").set_script(null)
    scene.get_node("Stacks").set_meta("zinc_world", {"cell":16.0,"levels":["near","mid","far"]})
    scene.get_node("Stacks/CrateC").set_meta("zinc_dynamic", true)
    assert(exporter.publish(scene, output) == OK)
    var world = JSON.parse_string(FileAccess.get_file_as_string(output.path_join("scene.json")))
    assert(world.nodes[2].metadata.world.cell == 16.0)
    assert(world.nodes[2].metadata.world.levels == ["near","mid","far"])
    assert(world.nodes[5].dynamic == true)
    assert(world.worldSources.size() == 1)
    assert(world.worldSources[0].node == "crate-b")
    assert(world.worldSources[0].source.object == "Stacks/CrateB")
    var world_bytes = FileAccess.get_file_as_bytes(output.path_join("scene.json"))
    scene.get_node("Stacks").set_meta("zinc_world", {"cell":0.0})
    assert(exporter.publish(scene, output) != OK)
    assert(world_bytes == FileAccess.get_file_as_bytes(output.path_join("scene.json")))
    scene.free()
    print("PASS Godot export: stable, shared, duplicate/script/shader failures preserve publication")
    quit()
